@[expose] public section

/-!
# B3c from Tau Ceti: the dyadic orientation

Ticket B3c of the Tau Ceti discharge campaign (`docs/orchestration/tauceti-tickets.md`). This
module builds `dyadicOrientation_tauceti`, a term of `GQ2.DyadicOrientation` whose type is that
of the `dyadicOrientation` field of `GQ2.LiteratureInputs`, from Tau Ceti's marked classification
`TauCeti.absoluteGaloisGroupProP_two_ratPadic_marked`: an isomorphism
`G_ℚ₂(2) ≃ₜ* D₀` under which Tau Ceti's standard orientation of `D₀` is the descended cyclotomic
character, which is surjective.

The bridge has three parts.

* `absGalProPEquiv : maxProPQuotient 2 AbsGalQ2 ≃ₜ* TauCeti.absoluteGaloisGroupProP 2 ℚ_[2]`:
  the two maximal pro-2 quotients are quotients of the same group by the same subgroup
  (`proPKernel` on both sides is the same `⨅`; Tau Ceti's is not exposed, so the equality goes
  through `TauCeti.mem_proPKernel_iff`).
* `demushkinD0Equiv : TauCeti.demushkinD0 ≃ₜ* D0`, generators to generators. gq2's `D0` is the
  maximal pro-2 quotient of the profinite presentation `⟨A,S,Y ∣ A²S⁴[S,Y]⟩`; Tau Ceti's is the
  pro-2 presentation on the same word (the relators agree, `T2` memo section B3c). Forward is
  Tau Ceti's `d0Lift`, backward is gq2's `presentationLift`/`quotientLift`; the round trips are
  `TauCeti.d0_hom_ext` and `d0_hom_ext` (extensionality on `A, S, Y` for continuous homs out of
  `GQ2.D0`, proved here from the density of the discrete free group).
* The assembly: `equiv` is the composite with Tau Ceti's marked isomorphism, `chiTwo` is
  `TauCeti.cyclotomicOrientation` transported, and the values `(-1, 1, (-3)⁻¹)` on `A, S, Y`
  are `TauCeti.standardD0Orientation_d0A/_d0S/_d0Y`.

Only `dyadicOrientation_tauceti` is public (board rule: no duplicate public names in
`GQ2.TauCetiBridge`). Every helper is `private`: the `IsProP`/`proPKernel`/pro-2-quotient and
`D0` identifications duplicate the P1 dictionary (`GQ2/TauCeti/ProPDict.lean`: `isProP_iff_tauCeti`,
`proPKernel_eq`, `absGalQ2ProPEquiv`, `d0Equiv`), and the three topological-generation lemmas are
copies from `GQ2/Prop32.lean`, which adapters may not import (its closure reaches
`GQ2.Foundations.Interfaces`). Since exposed bodies may not mention private declarations, the main
definition is `@[no_expose]`; downstream files use it only as a term (its fields carry all the
propositional content).
-/

namespace GQ2.TauCetiBridge

/-! ## Pro-`p` identifications (private; duplicates of the P1 dictionary) -/

/-- gq2's and Tau Ceti's `IsProP` are the same predicate (Tau Ceti's is not exposed, so this is
`isProP_iff`, not `Iff.rfl`). Duplicates P1. -/
private theorem isProP_iff (p : ℕ) (P : Type*) [Group P] [TopologicalSpace P] :
    IsProP p P ↔ TauCeti.IsProP p P :=
  TauCeti.isProP_iff.symm

/-- gq2's and Tau Ceti's pro-`p` kernels agree. Duplicates P1. -/
private theorem proPKernel_eq (p : ℕ) (G : Type*) [Group G] [TopologicalSpace G] :
    proPKernel p G = TauCeti.proPKernel p G := by
  ext x
  rw [TauCeti.mem_proPKernel_iff, proPKernel, Subgroup.mem_iInf]
  exact ⟨fun h U hU => h ⟨U, hU⟩, fun h U => h U.1 U.2⟩

/-! ## Topological generation (private copies of `GQ2.SectionThree` lemmas)

`GQ2.SectionThree.topGen_freeProfiniteGroup`, `topGen_map` and `monoidHom_eq_of_topGen` live in
`GQ2/Prop32.lean`, whose import closure reaches `GQ2.Foundations.Interfaces`; adapters may not
import it, so they are copied here. -/

/-- The free profinite group is topologically generated by its generators (copy of
`GQ2.SectionThree.topGen_freeProfiniteGroup`). -/
private theorem topGen_freeProfiniteGroup (X : Type) :
    (Subgroup.closure (Set.range (FreeProfiniteGroup.of (X := X)))).topologicalClosure = ⊤ := by
  set g : FreeGroup X →* FreeProfiniteGroup X :=
    (ProfiniteGrp.ProfiniteCompletion.eta (GrpCat.of (FreeGroup X))).hom with hg
  have h1 : Set.range (FreeProfiniteGroup.of (X := X))
      = ⇑g '' Set.range (FreeGroup.of : X → FreeGroup X) := by
    rw [← Set.range_comp]; rfl
  have hrange : Subgroup.closure (Set.range (FreeProfiniteGroup.of (X := X))) = g.range := by
    rw [h1, ← MonoidHom.map_closure, FreeGroup.closure_range_of X, ← MonoidHom.range_eq_map]
  rw [hrange]
  have hdense : DenseRange g := ProfiniteGrp.ProfiniteCompletion.denseRange _
  rw [SetLike.ext'_iff]
  simpa only [Subgroup.topologicalClosure_coe, Subgroup.coe_top, MonoidHom.coe_range]
    using hdense.closure_range

/-- Topological generation transfers along a continuous surjective homomorphism (copy of
`GQ2.SectionThree.topGen_map`). -/
private theorem topGen_map {G H : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    [Group H] [TopologicalSpace H] [IsTopologicalGroup H]
    (f : G →* H) (hcont : Continuous f) (hsurj : Function.Surjective f) {S : Set G}
    (hS : (Subgroup.closure S).topologicalClosure = ⊤) :
    (Subgroup.closure (f '' S)).topologicalClosure = ⊤ := by
  rw [← MonoidHom.map_closure]
  exact hsurj.denseRange.topologicalClosure_map_subgroup hcont hS

/-- Two continuous homomorphisms agreeing on a topologically generating set agree everywhere
(copy of `GQ2.SectionThree.monoidHom_eq_of_topGen`). -/
private theorem monoidHom_eq_of_topGen {G H : Type*} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [Group H] [TopologicalSpace H] [T2Space H] {f g : G →* H}
    (hf : Continuous f) (hg : Continuous g)
    {S : Set G} (hS : (Subgroup.closure S).topologicalClosure = ⊤)
    (h : ∀ x ∈ S, f x = g x) : ∀ x, f x = g x := by
  let E : Subgroup G :=
    { carrier := {x | f x = g x}
      one_mem' := by simp
      mul_mem' := fun ha hb => by
        simp only [Set.mem_ofPred_eq] at *
        rw [map_mul, map_mul, ha, hb]
      inv_mem' := fun ha => by
        simp only [Set.mem_ofPred_eq] at *
        rw [map_inv, map_inv, ha] }
  have hE : (Subgroup.closure S).topologicalClosure ≤ E :=
    Subgroup.topologicalClosure_minimal _
      ((Subgroup.closure_le E).mpr fun x hx => h x hx) (isClosed_eq hf hg)
  intro x
  exact hE (hS ▸ Subgroup.mem_top x)

/-! ## Extensionality for `GQ2.D0` -/

/-- The evaluation `F̂₃ → D0`, `of 0, of 1, of 2 ↦ A, S, Y` (copy of the non-`module`
`GQ2.SectionThree.evalD0`). -/
private noncomputable def evalD0 : FreeProfiniteGroup (Fin 3) →ₜ* D0 :=
  (maxProPMk 2 D0Full).comp (quotientMk (relatorSubgroup {d0Relator}))

private theorem evalD0_surjective : Function.Surjective evalD0 :=
  (quotientMk_surjective _).comp (quotientMk_surjective _)

/-- `GQ2.D0` is topologically generated by `d0A, d0S, d0Y` (copy of the non-`module`
`GQ2.SectionThree.topGen_d0`). -/
private theorem topGen_d0 : (Subgroup.closure {d0A, d0S, d0Y}).topologicalClosure = ⊤ := by
  have h := topGen_map (f := evalD0.toMonoidHom) evalD0.continuous evalD0_surjective
    (topGen_freeProfiniteGroup (Fin 3))
  have h1 : (⇑evalD0.toMonoidHom) '' Set.range (FreeProfiniteGroup.of (X := Fin 3))
      = {d0A, d0S, d0Y} := by
    rw [← Set.range_comp]
    ext z; constructor
    · rintro ⟨i, rfl⟩; fin_cases i
      · exact Set.mem_insert _ _
      · exact Set.mem_insert_of_mem _ (Set.mem_insert _ _)
      · exact Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl)
    · rintro (rfl | rfl | rfl)
      exacts [⟨0, rfl⟩, ⟨1, rfl⟩, ⟨2, rfl⟩]
  rwa [h1] at h

/-- Continuous homomorphisms out of `GQ2.D0` are determined by their values on `A, S, Y`
(the gq2 counterpart of `TauCeti.d0_hom_ext`). -/
private theorem d0_hom_ext {Q : Type*} [Group Q] [TopologicalSpace Q] [T2Space Q]
    {φ ψ : D0 →ₜ* Q} (hA : φ d0A = ψ d0A) (hS : φ d0S = ψ d0S) (hY : φ d0Y = ψ d0Y) : φ = ψ := by
  ext x
  refine monoidHom_eq_of_topGen (f := φ.toMonoidHom) (g := ψ.toMonoidHom) φ.continuous
    ψ.continuous topGen_d0 ?_ x
  rintro z (rfl | rfl | rfl)
  exacts [hA, hS, hY]

/-! ## `D0 ≅ demushkinD0`, generators to generators -/

/-- `GQ2.D0` is pro-2, in Tau Ceti's spelling. -/
private theorem isProP_D0 : TauCeti.IsProP 2 D0 :=
  (isProP_iff 2 _).mp isProP_maxProPQuotient

/-- Tau Ceti's `D₀` is pro-2, in gq2's spelling. -/
private theorem isProP_demushkinD0 : IsProP 2 TauCeti.demushkinD0 :=
  (isProP_iff 2 _).mpr TauCeti.isProP_demushkinD0

/-- Tau Ceti's `D₀ → GQ2.D0`, `A, S, Y ↦ A, S, Y`, by Tau Ceti's universal property `d0Lift`
(gq2's `d0_relation` is the relator hypothesis verbatim, since `commP` unfolds to `x⁻¹y⁻¹xy`). -/
private noncomputable def demushkinD0ToD0 : TauCeti.demushkinD0 →ₜ* D0 :=
  TauCeti.d0Lift isProP_D0 d0A d0S d0Y d0_relation

@[simp] private theorem demushkinD0ToD0_d0A : demushkinD0ToD0 TauCeti.d0A = d0A :=
  TauCeti.d0Lift_d0A _ _ _ _ _
@[simp] private theorem demushkinD0ToD0_d0S : demushkinD0ToD0 TauCeti.d0S = d0S :=
  TauCeti.d0Lift_d0S _ _ _ _ _
@[simp] private theorem demushkinD0ToD0_d0Y : demushkinD0ToD0 TauCeti.d0Y = d0Y :=
  TauCeti.d0Lift_d0Y _ _ _ _ _

/-- The free-profinite map `F̂₃ → D₀(TauCeti)`, `of 0, of 1, of 2 ↦ A, S, Y`. -/
private noncomputable def freeToDemushkinD0 :
    FreeProfiniteGroup (Fin 3) ⟶ ProfiniteGrp.of TauCeti.demushkinD0 :=
  (FreeProfiniteGroup.homEquiv (Fin 3) (ProfiniteGrp.of TauCeti.demushkinD0)).symm
    ![TauCeti.d0A, TauCeti.d0S, TauCeti.d0Y]

private theorem freeToDemushkinD0_of (i : Fin 3) :
    freeToDemushkinD0.hom.toMonoidHom (FreeProfiniteGroup.of i) =
      ![TauCeti.d0A, TauCeti.d0S, TauCeti.d0Y] i :=
  FreeProfiniteGroup.homEquiv_symm_of _ _ i

private theorem freeToDemushkinD0_relator :
    freeToDemushkinD0.hom.toMonoidHom d0Relator = 1 := by
  rw [d0Relator]
  simp only [commP, map_mul, map_pow, map_inv]
  rw [freeToDemushkinD0_of 0, freeToDemushkinD0_of 1, freeToDemushkinD0_of 2]
  exact TauCeti.d0_relation

/-- `GQ2.D0 → D₀(TauCeti)`, `A, S, Y ↦ A, S, Y`, by gq2's universal properties of the profinite
presentation and of the maximal pro-2 quotient. -/
private noncomputable def d0ToDemushkinD0 : D0 →ₜ* TauCeti.demushkinD0 :=
  quotientLift (proPKernel 2 D0Full)
    (presentationLift {d0Relator} freeToDemushkinD0.hom
      (fun r hr => by rcases hr with rfl; exact freeToDemushkinD0_relator))
    (proPKernel_le_ker isProP_demushkinD0 _)

@[simp] private theorem d0ToDemushkinD0_d0A : d0ToDemushkinD0 d0A = TauCeti.d0A :=
  freeToDemushkinD0_of 0
@[simp] private theorem d0ToDemushkinD0_d0S : d0ToDemushkinD0 d0S = TauCeti.d0S :=
  freeToDemushkinD0_of 1
@[simp] private theorem d0ToDemushkinD0_d0Y : d0ToDemushkinD0 d0Y = TauCeti.d0Y :=
  freeToDemushkinD0_of 2

private theorem d0ToDemushkinD0_comp_demushkinD0ToD0 :
    d0ToDemushkinD0.comp demushkinD0ToD0 = ContinuousMonoidHom.id _ :=
  TauCeti.d0_hom_ext
    (show d0ToDemushkinD0 (demushkinD0ToD0 TauCeti.d0A) = TauCeti.d0A by simp)
    (show d0ToDemushkinD0 (demushkinD0ToD0 TauCeti.d0S) = TauCeti.d0S by simp)
    (show d0ToDemushkinD0 (demushkinD0ToD0 TauCeti.d0Y) = TauCeti.d0Y by simp)

private theorem demushkinD0ToD0_comp_d0ToDemushkinD0 :
    demushkinD0ToD0.comp d0ToDemushkinD0 = ContinuousMonoidHom.id _ :=
  d0_hom_ext
    (show demushkinD0ToD0 (d0ToDemushkinD0 d0A) = d0A by simp)
    (show demushkinD0ToD0 (d0ToDemushkinD0 d0S) = d0S by simp)
    (show demushkinD0ToD0 (d0ToDemushkinD0 d0Y) = d0Y by simp)

/-- **`D₀(TauCeti) ≅ GQ2.D0`**, generators to generators (`A, S, Y ↦ A, S, Y`). -/
private noncomputable def demushkinD0Equiv : TauCeti.demushkinD0 ≃ₜ* D0 where
  toFun := demushkinD0ToD0
  invFun := d0ToDemushkinD0
  left_inv x := DFunLike.congr_fun d0ToDemushkinD0_comp_demushkinD0ToD0 x
  right_inv x := DFunLike.congr_fun demushkinD0ToD0_comp_d0ToDemushkinD0 x
  map_mul' := map_mul demushkinD0ToD0
  continuous_toFun := demushkinD0ToD0.continuous
  continuous_invFun := d0ToDemushkinD0.continuous

@[simp] private theorem demushkinD0Equiv_d0A : demushkinD0Equiv TauCeti.d0A = d0A :=
  demushkinD0ToD0_d0A
@[simp] private theorem demushkinD0Equiv_d0S : demushkinD0Equiv TauCeti.d0S = d0S :=
  demushkinD0ToD0_d0S
@[simp] private theorem demushkinD0Equiv_d0Y : demushkinD0Equiv TauCeti.d0Y = d0Y :=
  demushkinD0ToD0_d0Y

@[simp] private theorem demushkinD0Equiv_symm_d0A : demushkinD0Equiv.symm d0A = TauCeti.d0A :=
  d0ToDemushkinD0_d0A
@[simp] private theorem demushkinD0Equiv_symm_d0S : demushkinD0Equiv.symm d0S = TauCeti.d0S :=
  d0ToDemushkinD0_d0S
@[simp] private theorem demushkinD0Equiv_symm_d0Y : demushkinD0Equiv.symm d0Y = TauCeti.d0Y :=
  d0ToDemushkinD0_d0Y

/-! ## The maximal pro-2 quotient of `G_ℚ₂` -/

/-- gq2's and Tau Ceti's pro-2 kernels of `G_ℚ₂` agree. -/
private theorem proPKernel_two_absGalQ2 :
    proPKernel 2 AbsGalQ2 = TauCeti.proPKernel 2 AbsGalQ2 :=
  proPKernel_eq 2 AbsGalQ2

section AbsGal
variable [CompactSpace AbsGalQ2] [TotallyDisconnectedSpace AbsGalQ2]

/-- gq2's `G_ℚ₂(2)` is Tau Ceti's: both are `G_ℚ₂ ⧸ proPKernel 2 G_ℚ₂`, and the two kernels are
equal (`proPKernel_two_absGalQ2`). Specializes the P1 dictionary's `maxProPEquiv` to `AbsGalQ2`. -/
private noncomputable def absGalProPEquiv :
    maxProPQuotient 2 AbsGalQ2 ≃ₜ* TauCeti.absoluteGaloisGroupProP 2 ℚ_[2] where
  toMulEquiv := QuotientGroup.quotientMulEquivOfEq proPKernel_two_absGalQ2
  continuous_toFun :=
    (QuotientGroup.isQuotientMap_mk (proPKernel 2 AbsGalQ2)).continuous_iff.mpr
      QuotientGroup.continuous_mk
  continuous_invFun :=
    (QuotientGroup.isQuotientMap_mk (TauCeti.proPKernel 2 AbsGalQ2)).continuous_iff.mpr
      QuotientGroup.continuous_mk

@[simp] private theorem absGalProPEquiv_maxProPMk (g : AbsGalQ2) :
    absGalProPEquiv (maxProPMk 2 AbsGalQ2 g) =
      (QuotientGroup.mk g : TauCeti.absoluteGaloisGroupProP 2 ℚ_[2]) :=
  rfl

/-- `chiTwo`: Tau Ceti's descended cyclotomic character `cyclotomicOrientation 2 ℚ_[2] _`,
transported along `absGalProPEquiv`. -/
private noncomputable def chiTwo_tauceti : maxProPQuotient 2 AbsGalQ2 →* ℤ_[2]ˣ :=
  ((TauCeti.cyclotomicOrientation 2 ℚ_[2] TauCeti.ratPadicTwo_hasPrimitiveRoot).comp
    (absGalProPEquiv : maxProPQuotient 2 AbsGalQ2 →ₜ* TauCeti.absoluteGaloisGroupProP 2 ℚ_[2])
    ).toMonoidHom

private theorem chiTwo_tauceti_apply (x : maxProPQuotient 2 AbsGalQ2) :
    chiTwo_tauceti x =
      TauCeti.cyclotomicOrientation 2 ℚ_[2] TauCeti.ratPadicTwo_hasPrimitiveRoot
        (absGalProPEquiv x) :=
  rfl

private theorem continuous_chiTwo_tauceti : Continuous chiTwo_tauceti :=
  (map_continuous (TauCeti.cyclotomicOrientation 2 ℚ_[2] _)).comp
    (map_continuous absGalProPEquiv)

/-- **Descent**: `chiTwo_tauceti` factors gq2's cyclotomic character `chiCyc` (both are Mathlib's
`cyclotomicCharacter (AlgebraicClosure ℚ_[2]) 2` on `σ.toRingEquiv`; Tau Ceti's is not exposed,
so the identification is `localCyclotomicCharacter_apply`). -/
private theorem chiTwo_tauceti_maxProPMk (g : AbsGalQ2) :
    chiTwo_tauceti (maxProPMk 2 AbsGalQ2 g) = chiCyc g := by
  rw [chiTwo_tauceti_apply, absGalProPEquiv_maxProPMk, TauCeti.cyclotomicOrientation_mk]
  exact TauCeti.localCyclotomicCharacter_apply 2 ℚ_[2] g

end AbsGal

/-! ## Tau Ceti's marked isomorphism `G_ℚ₂(2) ≅ D₀` -/

/-- Tau Ceti's marked isomorphism `G_ℚ₂(2) ≃ₜ* D₀`, chosen from
`TauCeti.absoluteGaloisGroupProP_two_ratPadic_marked`. -/
private noncomputable def markedEquiv :
    TauCeti.absoluteGaloisGroupProP 2 ℚ_[2] ≃ₜ* TauCeti.demushkinD0 :=
  Classical.choose TauCeti.absoluteGaloisGroupProP_two_ratPadic_marked

/-- Under `markedEquiv`, Tau Ceti's standard orientation of `D₀` is the descended cyclotomic
character. -/
private theorem standardD0Orientation_markedEquiv (x : TauCeti.absoluteGaloisGroupProP 2 ℚ_[2]) :
    TauCeti.standardD0Orientation (markedEquiv x) =
      TauCeti.cyclotomicOrientation 2 ℚ_[2] TauCeti.ratPadicTwo_hasPrimitiveRoot x := by
  rw [← (Classical.choose_spec TauCeti.absoluteGaloisGroupProP_two_ratPadic_marked).1]
  rfl

/-- The descended cyclotomic character of `ℚ₂` is surjective onto `ℤ₂ˣ`. -/
private theorem surjective_cyclotomicOrientation_two_ratPadic :
    Function.Surjective
      (TauCeti.cyclotomicOrientation 2 ℚ_[2] TauCeti.ratPadicTwo_hasPrimitiveRoot) :=
  (Classical.choose_spec TauCeti.absoluteGaloisGroupProP_two_ratPadic_marked).2

/-! ## The dyadic orientation -/

section Orientation
variable [CompactSpace AbsGalQ2] [TotallyDisconnectedSpace AbsGalQ2]

/-- The value of `chiTwo_tauceti` on the preimage of a `GQ2.D0` element under the composite
isomorphism is Tau Ceti's standard orientation of the corresponding `D₀(TauCeti)` element. -/
private theorem chiTwo_tauceti_equiv_symm (a : TauCeti.demushkinD0) :
    chiTwo_tauceti (((absGalProPEquiv.trans markedEquiv).trans demushkinD0Equiv).symm
      (demushkinD0Equiv a)) = TauCeti.standardD0Orientation a := by
  rw [chiTwo_tauceti_apply, ← standardD0Orientation_markedEquiv]
  simp

/-- **B3c from Tau Ceti**: the marked dyadic orientation. The statement is the type of the
`dyadicOrientation` field of `GQ2.LiteratureInputs`. -/
@[no_expose] noncomputable def dyadicOrientation_tauceti : DyadicOrientation where
  equiv := (absGalProPEquiv.trans markedEquiv).trans demushkinD0Equiv
  chiTwo := chiTwo_tauceti
  continuous_chiTwo := continuous_chiTwo_tauceti
  chiTwo_factors := chiTwo_tauceti_maxProPMk
  surjective_chiTwo := surjective_cyclotomicOrientation_two_ratPadic.comp absGalProPEquiv.surjective
  chi_A := by
    rw [← demushkinD0Equiv_d0A, chiTwo_tauceti_equiv_symm, TauCeti.standardD0Orientation_d0A]
  chi_S := by
    rw [← demushkinD0Equiv_d0S, chiTwo_tauceti_equiv_symm, TauCeti.standardD0Orientation_d0S]
  chi_Y := fun y hy => by
    rw [← demushkinD0Equiv_d0Y, chiTwo_tauceti_equiv_symm, TauCeti.standardD0Orientation_d0Y]
    congr 1
    exact (Units.ext (by rw [hy, TauCeti.negThreeUnit_coe])).symm

end Orientation

end GQ2.TauCetiBridge
