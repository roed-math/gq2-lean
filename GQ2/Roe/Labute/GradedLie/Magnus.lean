/-!
# GL-D: the Magnus coefficient algebra (Lazard fragment; insurance lane)

Design record: `docs/orchestration/span-gradedlie-plan.md` §4.  **Interface NOT
frozen** — the GL-D worker has latitude; nothing in the main lane cites this file.
Review with the orchestrator before anything else consumes it.

Content (Serre 252 §6, "la méthode de Lazard", at q = p = 2):
* the coefficient ring `MagnusA := FreeMonoid (Fin 3) → ℤ_[2]` under convolution (finite
  sums over word splits; no topology needed for the ring operations);
* the mixed filtration `magnusFil j = {f | ∀ w, 2^(j − |w|) ∣ f w}` (the ideal
  generated by `2` and the letters, `j`-th power);
* the congruence unit group `MagnusU = 1 + m₀` with the product topology: a profinite
  pro-2 group carrying the instance pack that `freeProTwoLift` requires;
* the Magnus morphism `magnusHom := freeProTwoLift _ (fun i ↦ 1 + ξᵢ)` and the
  filtration estimate `λ_j(MagnusU) ≤ congrSub j`, which combined with
  `map_twoCentralSeries_le` gives coefficient valuations
  `v₂(coeff_w (μ z)) ≥ j − |w|` for `z ∈ λ_j(F₃)`;
* per-(word, level) coordinate functionals `Zₖ → 𝔽₂`: additive, `λ_{k+1}`-killing.

Numerically validated end to end (memo §5: `span_model.py` — filtration, PBW
separation `rank = N_k`, column span, `coker(d̄) = 2`).

Role: fallback certificate route for the k = 3 base case should GL-C snag, and the
`ker(ab)`-sensitive functional infrastructure the (out-of-scope) SL1 design gap will
want later.  Do NOT build Lyndon-word combinatorics unless the orchestrator
re-scopes.

## Design decisions (GL-D, recorded per the dispatch spec)

* **Bespoke ring, not `MonoidAlgebra`.**  The unit group needs *full-support* series:
  `(1 + ξ₀)⁻¹ = 1 − ξ₀ + ξ₀² − …` has infinite support, so a finitely-supported model
  (`MonoidAlgebra ℤ_[2] (FreeMonoid (Fin 3))`) is not closed under the group operation.
  Mathlib has no non-commutative power-series ring (`MvPowerSeries` is indexed by
  `σ →₀ ℕ`, i.e. commuting variables), so `MagnusA` is built here from scratch,
  following the `MvPowerSeries` boilerplate pattern (`def` + `Pi` additive structure +
  bespoke `Mul`/`One`, `mul_assoc` by `Finset.sum_sigma'`/`Finset.sum_nbij'`).
* **Split indexing by prefix length.**  A split `w = u · v` is recorded by the single
  natural number `i = |u| ∈ {0, …, |w|}`, so the convolution is a `Finset.range` sum and
  no word-antidiagonal `Finset` (which would need `DecidableEq` gymnastics through the
  `FreeMonoid` type synonym) is required.
* **The unit group is `1 + m₀`, `m₀ = {a | a 1 = 0}`, i.e. `{f | f 1 = 1}`.**  The
  dispatch spec's `{f // f 1 = 1 ∧ f − 1 ∈ magnusFil 1}` has a redundant second clause
  (`f 1 = 1` already forces `2 ∣ (f − 1) 1 = 0`, and at `|w| ≥ 1` the divisor is `2⁰`):
  see `mem_magnusFil_one_iff` and `sub_one_mem_magnusFil_one`.  Restricting to constant
  term *exactly* `1` (rather than the larger `1 + magnusFil 1 = {f | f 1 ≡ 1 mod 2}`,
  which is also a group) makes the inverse a **finite geometric sum** with no scalar
  inversion in `ℤ_[2]`: `a := 1 − f` is coefficientwise nilpotent (`aⁿ w = 0` for
  `n > |w|`, `coeff_pow_eq_zero`), so `f⁻¹ w = ∑_{n ≤ |w|} (aⁿ) w`.  The Magnus image
  lands in this smaller group anyway (`1 + ξᵢ` has constant term `1`).
-/

namespace GQ2.Roe.Labute.Magnus

/-! ## Words in three letters

`Word` is the index monoid of the Magnus algebra.  It is definitionally `List (Fin 3)`;
`wlen`, `wtake`, `wdrop` are `List.length`, `List.take`, `List.drop` transported through
the `FreeMonoid` type synonym (all the lemmas below are the `List` ones, by `rfl`). -/

/-- The index monoid of the Magnus algebra: words in the three marked letters. -/
abbrev Word : Type := FreeMonoid (Fin 3)

instance : DecidableEq Word := inferInstanceAs (DecidableEq (List (Fin 3)))

/-- The length `|w|` of a word. -/
def wlen (w : Word) : ℕ := (FreeMonoid.toList w).length

/-- The prefix of `w` of length `i` (all of `w` if `i ≥ |w|`). -/
def wtake (i : ℕ) (w : Word) : Word := FreeMonoid.ofList ((FreeMonoid.toList w).take i)

/-- The suffix of `w` after its first `i` letters (empty if `i ≥ |w|`). -/
def wdrop (i : ℕ) (w : Word) : Word := FreeMonoid.ofList ((FreeMonoid.toList w).drop i)

@[simp] theorem wlen_one : wlen 1 = 0 := rfl

@[simp] theorem wtake_zero (w : Word) : wtake 0 w = 1 := rfl

@[simp] theorem wdrop_zero (w : Word) : wdrop 0 w = w := rfl

@[simp] theorem wlen_wtake (i : ℕ) (w : Word) : wlen (wtake i w) = min i (wlen w) :=
  List.length_take

@[simp] theorem wlen_wdrop (i : ℕ) (w : Word) : wlen (wdrop i w) = wlen w - i :=
  List.length_drop

@[simp] theorem wtake_wlen (w : Word) : wtake (wlen w) w = w := List.take_length

@[simp] theorem wdrop_wlen (w : Word) : wdrop (wlen w) w = 1 := List.drop_length

theorem wtake_wtake (i j : ℕ) (w : Word) : wtake i (wtake j w) = wtake (min i j) w :=
  List.take_take

theorem wdrop_wtake (i j : ℕ) (w : Word) : wdrop i (wtake j w) = wtake (j - i) (wdrop i w) :=
  List.drop_take

theorem wdrop_wdrop (i j : ℕ) (w : Word) : wdrop i (wdrop j w) = wdrop (j + i) w :=
  List.drop_drop

theorem wtake_mul_wdrop (i : ℕ) (w : Word) : wtake i w * wdrop i w = w :=
  List.take_append_drop i w

theorem wlen_eq_zero {w : Word} : wlen w = 0 ↔ w = 1 := List.length_eq_zero_iff

/-- A nonzero-length prefix is a nonempty word. -/
theorem wtake_ne_one {i : ℕ} {w : Word} (hi : i ≠ 0) (hiw : i ≤ wlen w) : wtake i w ≠ 1 := by
  intro h
  have h2 := wlen_wtake i w
  rw [h, wlen_one] at h2
  omega

/-- A proper suffix is a nonempty word. -/
theorem wdrop_ne_one {i : ℕ} {w : Word} (hi : i < wlen w) : wdrop i w ≠ 1 := by
  intro h
  have h2 := wlen_wdrop i w
  rw [h, wlen_one] at h2
  omega

/-! ## The coefficient ring `MagnusA` -/

/-- The **Magnus coefficient ring** `ℤ₂⟪ξ₀, ξ₁, ξ₂⟫`: all (not necessarily finitely
supported) `ℤ_[2]`-valued functions on words, with the convolution product
`(f * g) w = ∑_{w = u·v} f u · g v`. -/
def MagnusA : Type := Word → ℤ_[2]

/-- Coefficient extraction: `coeff f w` is the coefficient of the word `w` in `f`. -/
def coeff (f : MagnusA) (w : Word) : ℤ_[2] := f w

@[ext] theorem MagnusA.ext {f g : MagnusA} (h : ∀ w, coeff f w = coeff g w) : f = g := funext h

noncomputable instance : AddCommGroup MagnusA := inferInstanceAs (AddCommGroup (Word → ℤ_[2]))

@[simp] theorem coeff_zero (w : Word) : coeff (0 : MagnusA) w = 0 := rfl

@[simp] theorem coeff_add (f g : MagnusA) (w : Word) :
    coeff (f + g) w = coeff f w + coeff g w := rfl

@[simp] theorem coeff_neg (f : MagnusA) (w : Word) : coeff (-f) w = -coeff f w := rfl

@[simp] theorem coeff_sub (f g : MagnusA) (w : Word) :
    coeff (f - g) w = coeff f w - coeff g w := rfl

noncomputable instance : One MagnusA := ⟨fun w ↦ if w = 1 then 1 else 0⟩

noncomputable instance : Mul MagnusA :=
  ⟨fun f g w ↦ ∑ i ∈ Finset.range (wlen w + 1), coeff f (wtake i w) * coeff g (wdrop i w)⟩

theorem coeff_one (w : Word) : coeff (1 : MagnusA) w = if w = 1 then 1 else 0 := rfl

@[simp] theorem coeff_one_self : coeff (1 : MagnusA) 1 = 1 := by rw [coeff_one, if_pos rfl]

@[simp] theorem coeff_one_of_ne {w : Word} (hw : w ≠ 1) : coeff (1 : MagnusA) w = 0 := by
  rw [coeff_one, if_neg hw]

theorem coeff_mul (f g : MagnusA) (w : Word) :
    coeff (f * g) w =
      ∑ i ∈ Finset.range (wlen w + 1), coeff f (wtake i w) * coeff g (wdrop i w) := rfl

/-! ### Ring axioms -/

theorem coeff_one_mul (f : MagnusA) (w : Word) : coeff (1 * f) w = coeff f w := by
  rw [coeff_mul, Finset.sum_eq_single 0]
  · rw [wtake_zero, wdrop_zero, coeff_one_self, one_mul]
  · intro i hi hne
    have hi' : i ≤ wlen w := by have := Finset.mem_range.mp hi; omega
    rw [coeff_one_of_ne (wtake_ne_one hne hi'), zero_mul]
  · intro h
    exact absurd (Finset.mem_range.mpr (Nat.succ_pos _)) h

theorem coeff_mul_one (f : MagnusA) (w : Word) : coeff (f * 1) w = coeff f w := by
  rw [coeff_mul, Finset.sum_eq_single (wlen w)]
  · rw [wtake_wlen, wdrop_wlen, coeff_one_self, mul_one]
  · intro i hi hne
    have hi' : i < wlen w := by have := Finset.mem_range.mp hi; omega
    rw [coeff_one_of_ne (wdrop_ne_one hi'), mul_zero]
  · intro h
    exact absurd (Finset.self_mem_range_succ _) h

theorem coeff_zero_mul (f : MagnusA) (w : Word) : coeff (0 * f) w = 0 := by
  simp [coeff_mul]

theorem coeff_mul_zero (f : MagnusA) (w : Word) : coeff (f * 0) w = 0 := by
  simp [coeff_mul]

theorem coeff_add_mul (f g h : MagnusA) (w : Word) :
    coeff ((f + g) * h) w = coeff (f * h) w + coeff (g * h) w := by
  simp only [coeff_mul, coeff_add, add_mul, Finset.sum_add_distrib]

theorem coeff_mul_add (f g h : MagnusA) (w : Word) :
    coeff (f * (g + h)) w = coeff (f * g) w + coeff (f * h) w := by
  simp only [coeff_mul, coeff_add, mul_add, Finset.sum_add_distrib]

/-- The triple-convolution normal form of `(f * g) * h`, indexed by pairs `j ≤ i ≤ |w|`
(the two cut points of the three-fold split `w = u·v·x`). -/
theorem coeff_mul_mul_left (f g h : MagnusA) (w : Word) :
    coeff (f * g * h) w =
      ∑ i ∈ Finset.range (wlen w + 1), ∑ j ∈ Finset.range (i + 1),
        coeff f (wtake j w) * coeff g (wtake (i - j) (wdrop j w)) * coeff h (wdrop i w) := by
  rw [coeff_mul]
  refine Finset.sum_congr rfl fun i hi ↦ ?_
  have hi' : i ≤ wlen w := by have := Finset.mem_range.mp hi; omega
  rw [coeff_mul, Finset.sum_mul, wlen_wtake, min_eq_left hi']
  refine Finset.sum_congr rfl fun j hj ↦ ?_
  have hj' : j ≤ i := by have := Finset.mem_range.mp hj; omega
  rw [wtake_wtake, min_eq_left hj', wdrop_wtake]

/-- The triple-convolution normal form of `f * (g * h)`, indexed by pairs `j`, `l` with
`j + l ≤ |w|`. -/
theorem coeff_mul_mul_right (f g h : MagnusA) (w : Word) :
    coeff (f * (g * h)) w =
      ∑ j ∈ Finset.range (wlen w + 1), ∑ l ∈ Finset.range (wlen w - j + 1),
        coeff f (wtake j w) * (coeff g (wtake l (wdrop j w)) * coeff h (wdrop (j + l) w)) := by
  rw [coeff_mul]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [coeff_mul, Finset.mul_sum, wlen_wdrop]
  exact Finset.sum_congr rfl fun l _ ↦ by rw [wdrop_wdrop]

theorem coeff_mul_assoc (f g h : MagnusA) (w : Word) :
    coeff (f * g * h) w = coeff (f * (g * h)) w := by
  rw [coeff_mul_mul_left, coeff_mul_mul_right]
  simp only [Finset.sum_sigma']
  refine Finset.sum_nbij' (fun x ↦ (⟨x.2, x.1 - x.2⟩ : (_ : ℕ) × ℕ))
    (fun y ↦ (⟨y.1 + y.2, y.1⟩ : (_ : ℕ) × ℕ)) ?_ ?_ ?_ ?_ ?_
  · rintro ⟨i, j⟩ hij
    simp only [Finset.mem_sigma, Finset.mem_range] at hij ⊢
    omega
  · rintro ⟨j, l⟩ hjl
    simp only [Finset.mem_sigma, Finset.mem_range] at hjl ⊢
    omega
  · rintro ⟨i, j⟩ hij
    simp only [Finset.mem_sigma, Finset.mem_range] at hij
    have h1 : j + (i - j) = i := by omega
    simp [h1]
  · rintro ⟨j, l⟩ hjl
    simp
  · rintro ⟨i, j⟩ hij
    simp only [Finset.mem_sigma, Finset.mem_range] at hij
    have h1 : j + (i - j) = i := by omega
    rw [h1, mul_assoc]

noncomputable instance : Ring MagnusA where
  one_mul f := MagnusA.ext fun w ↦ coeff_one_mul f w
  mul_one f := MagnusA.ext fun w ↦ coeff_mul_one f w
  mul_assoc f g h := MagnusA.ext fun w ↦ coeff_mul_assoc f g h w
  left_distrib f g h := MagnusA.ext fun w ↦ coeff_mul_add f g h w
  right_distrib f g h := MagnusA.ext fun w ↦ coeff_add_mul f g h w
  zero_mul f := MagnusA.ext fun w ↦ coeff_zero_mul f w
  mul_zero f := MagnusA.ext fun w ↦ coeff_mul_zero f w

/-! ### The letters -/

/-- The `i`-th Magnus letter `ξᵢ`: the indicator function of the one-letter word `i`. -/
noncomputable def xi (i : Fin 3) : MagnusA := fun w ↦ if w = FreeMonoid.of i then 1 else 0

theorem coeff_xi (i : Fin 3) (w : Word) :
    coeff (xi i) w = if w = FreeMonoid.of i then 1 else 0 := rfl

@[simp] theorem coeff_xi_self (i : Fin 3) : coeff (xi i) (FreeMonoid.of i) = 1 := by
  rw [coeff_xi, if_pos rfl]

@[simp] theorem wlen_of (i : Fin 3) : wlen (FreeMonoid.of i) = 1 := rfl

@[simp] theorem coeff_xi_one (i : Fin 3) : coeff (xi i) 1 = 0 := by
  refine (coeff_xi i 1).trans (if_neg fun h ↦ ?_)
  simpa using congrArg wlen h

/-! ## The filtration `m^j`

`magnusFil j` is the `j`-th power of the maximal ideal `m = (2, ξ₀, ξ₁, ξ₂)`, described
by the valuation bound `v₂(f w) ≥ j − |w|` (truncated subtraction).  Only the two
containments actually used downstream are proved: additivity in `j` under multiplication
(`mul_mem_magnusFil`, the core estimate) and the trivial monotonicity. -/

/-- The two-sided filtration ideal `m^j = {f | ∀ w, 2^(j − |w|) ∣ f w}`, as an additive
subgroup of `MagnusA`. -/
noncomputable def magnusFil (j : ℕ) : AddSubgroup MagnusA where
  carrier := {f | ∀ w, (2 : ℤ_[2]) ^ (j - wlen w) ∣ coeff f w}
  zero_mem' w := by simp
  add_mem' {a b} ha hb w := by rw [coeff_add]; exact dvd_add (ha w) (hb w)
  neg_mem' {a} ha w := by rw [coeff_neg]; exact (ha w).neg_right

theorem mem_magnusFil {j : ℕ} {f : MagnusA} :
    f ∈ magnusFil j ↔ ∀ w, (2 : ℤ_[2]) ^ (j - wlen w) ∣ coeff f w := Iff.rfl

@[simp] theorem magnusFil_zero : magnusFil 0 = ⊤ := by
  ext f
  simp [mem_magnusFil]

theorem magnusFil_antitone {i j : ℕ} (h : i ≤ j) : magnusFil j ≤ magnusFil i := by
  intro f hf w
  exact dvd_trans (pow_dvd_pow _ (by omega)) (hf w)

/-- At level `1` the filtration only constrains the constant term: `m = {f | 2 ∣ f 1}`. -/
theorem mem_magnusFil_one_iff {f : MagnusA} :
    f ∈ magnusFil 1 ↔ (2 : ℤ_[2]) ∣ coeff f 1 := by
  refine ⟨fun h ↦ by simpa using h 1, fun h w ↦ ?_⟩
  rcases eq_or_ne w 1 with rfl | hw
  · simpa using h
  · have : wlen w ≠ 0 := fun h0 ↦ hw (wlen_eq_zero.mp h0)
    rw [show 1 - wlen w = 0 by omega, pow_zero]
    exact one_dvd _

/-- **The convolution valuation estimate** (the core filtration lemma):
`m^p · m^q ⊆ m^{p+q}`. -/
theorem mul_mem_magnusFil {p q : ℕ} {a b : MagnusA} (ha : a ∈ magnusFil p)
    (hb : b ∈ magnusFil q) : a * b ∈ magnusFil (p + q) := by
  intro w
  rw [coeff_mul]
  refine Finset.dvd_sum fun i hi ↦ ?_
  have hi' : i ≤ wlen w := by have := Finset.mem_range.mp hi; omega
  have h1 : (2 : ℤ_[2]) ^ (p - min i (wlen w)) ∣ coeff a (wtake i w) := by
    have := ha (wtake i w); rwa [wlen_wtake] at this
  have h2 : (2 : ℤ_[2]) ^ (q - (wlen w - i)) ∣ coeff b (wdrop i w) := by
    have := hb (wdrop i w); rwa [wlen_wdrop] at this
  have hexp : p + q - wlen w ≤ (p - min i (wlen w)) + (q - (wlen w - i)) := by omega
  exact dvd_trans (pow_dvd_pow _ hexp) (by rw [pow_add]; exact mul_dvd_mul h1 h2)

/-- Doubling deepens the filtration by one (the `2 ∈ m` half of the ideal). -/
theorem add_self_mem_magnusFil {p : ℕ} {a : MagnusA} (ha : a ∈ magnusFil p) :
    a + a ∈ magnusFil (p + 1) := by
  intro w
  have h := ha w
  have hexp : p + 1 - wlen w ≤ (p - wlen w) + 1 := by omega
  refine dvd_trans (pow_dvd_pow _ hexp) ?_
  have hc : coeff (a + a) w = coeff a w * 2 := by rw [coeff_add]; ring
  rw [hc, pow_succ]
  exact mul_dvd_mul h dvd_rfl

/-- The letters lie in `m`. -/
theorem xi_mem_magnusFil_one (i : Fin 3) : xi i ∈ magnusFil 1 := by
  rw [mem_magnusFil_one_iff, coeff_xi_one]
  exact dvd_zero _

end GQ2.Roe.Labute.Magnus
