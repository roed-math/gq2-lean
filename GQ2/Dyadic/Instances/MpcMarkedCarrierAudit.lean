/-!
# Carrier and density reductions for the marked Mpc successor

`MpcMarkedUnrestricted.lean` reduces the three crossed-derivation kernels to an unrestricted
four-slot cost witness.  This module separates the routine carrier issues from the remaining
graded mathematics.

First, the two marked carriers have exact ordinary-abelian descriptions.  The pivot carrier
`mpcMkDerived` is the ordinary commutator subgroup, while `mpcSxMarked` is the inverse image
of the subgroup generated by the class of `B̄²` in the ordinary abelianization.  Second, the
difference between ordinary and topological abelianization causes no loss at one graded rung:
an element of the topological closure of either carrier can be approximated by an actual
carrier element modulo the open subgroup `λ_(r+1)`.  The resulting correction remains in
`λ_r`.  Finally, changing any of the four unrestricted inputs modulo `λ_(r+1)` does not change
its cost in `Q_(r+2)`.

## Exact remaining graded theorem

These reductions do not prove marked carrier reflection.  Let
`R_r = (λ_r / λ_(r+1))^4`, let `c_r` be the graded unrestricted cost, and let `M_r` be the
mixed source subspace whose four abelian residues lie in
`(B̄²-line, B̄²-line, 0, B̄²-line)`.  The remaining theorem is the source exactness equation

`ker ((nu, chi) ∘ c_r) = M_r + ker c_r`.

The left side says that the two secondary obstruction digits vanish.  The right side says
that the same cost has a representative in the marked source subspace.  Once that equation is
proved, the density and congruence theorems below turn the graded representative into actual
members of `mpcSxKill r`, `mpcSxKill r`, `mpcMkPivotKill r`, and `mpcSxKill r` without
changing the cost.  No existing neutral-span theorem proves this mixed four-slot kernel
identity, and it is not introduced here as an axiom or proposition-valued placeholder.

Declaration prefix `mpcMk` (namespace `GQ2.Dyadic.Instances.MpcMk`).  No `sorry`, no new
axiom, no `native_decide`, and no heartbeat or recursion override.
-/

namespace GQ2.Dyadic.Instances.MpcMk

open GQ2 GQ2.Dyadic GQ2.Dyadic.MarkedCore Multiplicative
open GQ2.Dyadic.Instances.MpcWord GQ2.Dyadic.Instances.MpcBld
open GQ2.Dyadic.Instances.MpcLad GQ2.Dyadic.Instances.MpcSx
open GQ2.Roe.Labute GQ2.Dyadic.SqCore
open GQ2.Dyadic.StageGeneric
open scoped commutatorElement

noncomputable section

/-! ## 1. Exact ordinary-abelian carrier descriptions -/

/-- The pivot carrier is exactly the ordinary commutator subgroup. -/
theorem mpcMkDerived_eq_commutator :
    mpcMkDerived = commutator (DM 2 0 : Type) := by
  rw [mpcMkDerived, commutator_eq_closure]
  congr 1
  ext x
  constructor
  · rintro ⟨a, b, rfl⟩
    exact ⟨a⁻¹, b⁻¹, by simp [commP, commutatorElement_def]⟩
  · rintro ⟨a, b, rfl⟩
    exact ⟨a⁻¹, b⁻¹, by simp [commP, commutatorElement_def]⟩

/-- The line generated by the ordinary abelianization class of `B̄²`. -/
def mpcMkMarkedAbelianLine : Subgroup (Abelianization (DM 2 0 : Type)) :=
  Subgroup.closure {Abelianization.of (dmB 2 0 ^ 2)}

/-- The three free-slot carrier is the inverse image of the `B̄²` line under ordinary
abelianization. -/
theorem mpcSxMarked_eq_comap_markedAbelianLine :
    mpcSxMarked = mpcMkMarkedAbelianLine.comap Abelianization.of := by
  let ab := Abelianization.of (G := (DM 2 0 : Type))
  have hker : ab.ker ≤ mpcSxMarked := by
    rw [Abelianization.ker_of, ← mpcMkDerived_eq_commutator,
      mpcMkDerived, mpcSxMarked]
    apply Subgroup.closure_mono
    rintro x ⟨a, b, rfl⟩
    exact Or.inr ⟨a, b, rfl⟩
  have hmap : mpcSxMarked.map ab = mpcMkMarkedAbelianLine := by
    rw [mpcSxMarked, MonoidHom.map_closure]
    apply le_antisymm
    · rw [Subgroup.closure_le]
      rintro y ⟨x, rfl | ⟨a, b, rfl⟩, rfl⟩
      · exact Subgroup.subset_closure rfl
      · have hone : ab (commP a b) = 1 := by
          rw [show commP a b = ⁅a⁻¹, b⁻¹⁆ by
            simp [commP, commutatorElement_def], map_commutatorElement]
          exact commutatorElement_eq_one_iff_mul_comm.mpr (mul_comm _ _)
        rw [hone]
        exact Subgroup.one_mem _
    · rw [mpcMkMarkedAbelianLine, Subgroup.closure_le]
      rintro y rfl
      exact Subgroup.subset_closure ⟨dmB 2 0 ^ 2, Or.inl rfl, rfl⟩
  calc
    mpcSxMarked = (mpcSxMarked.map ab).comap ab :=
      (Subgroup.comap_map_eq_self hker).symm
    _ = mpcMkMarkedAbelianLine.comap Abelianization.of := by rw [hmap]

/-! ## 2. Density rounding at one graded rung -/

/-- An element in the topological closure of a subgroup can be represented by an actual
subgroup element modulo any open subgroup. -/
theorem mpcMk_exists_subgroup_approx_mod_open
    {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    (H K : Subgroup G) (hK : IsOpen (K : Set G)) {x : G}
    (hx : x ∈ H.topologicalClosure) :
    ∃ y ∈ H, x * y⁻¹ ∈ K := by
  let U : Set G := {y | x * y⁻¹ ∈ K}
  have hU : IsOpen U := by
    exact hK.preimage (continuous_const.mul continuous_inv)
  have hxU : x ∈ U := by
    change x * x⁻¹ ∈ K
    rw [mul_inv_cancel]
    exact Subgroup.one_mem K
  have hx' : x ∈ closure (H : Set G) := hx
  obtain ⟨y, hyU, hyH⟩ := (mem_closure_iff.mp hx') U hU hxU
  exact ⟨y, hyH, hyU⟩

/-- A depth-`r` element in the topological commutator closure has an actual pivot-carrier
representative with the same class modulo `λ_(r+1)`. -/
theorem mpcMk_exists_pivotKill_approx {r : ℕ} {x : (DM 2 0 : Type)}
    (hx : x ∈ twoCentralSeries (DM 2 0 : Type) r)
    (hxtop : x ∈ (commutator (DM 2 0 : Type)).topologicalClosure) :
    ∃ y ∈ mpcMkPivotKill r,
      x * y⁻¹ ∈ twoCentralSeries (DM 2 0 : Type) (r + 1) := by
  obtain ⟨y, hyder, hxy⟩ := mpcMk_exists_subgroup_approx_mod_open
    (commutator (DM 2 0 : Type))
    (twoCentralSeries (DM 2 0 : Type) (r + 1))
    (isOpen_twoCentralSeries (DM 2 0 : Type)
      (dmFinsetTopGen 2 0) (isProP_DM 2 0) (r + 1)) hxtop
  have hder : y ∈ mpcMkDerived := by
    rw [mpcMkDerived_eq_commutator]
    exact hyder
  have hydepth : y ∈ twoCentralSeries (DM 2 0 : Type) r := by
    have hxy' : x * y⁻¹ ∈ twoCentralSeries (DM 2 0 : Type) r :=
      twoCentralSeries_antitone (G := (DM 2 0 : Type)) (by omega) hxy
    have hmem := Subgroup.mul_mem (twoCentralSeries (DM 2 0 : Type) r)
      (Subgroup.inv_mem _ hxy') hx
    rw [show (x * y⁻¹)⁻¹ * x = y by group] at hmem
    exact hmem
  exact ⟨y, ⟨hder, hydepth⟩, hxy⟩

/-- A depth-`r` element in the topological closure of the marked free-slot carrier has an
actual marked representative with the same class modulo `λ_(r+1)`. -/
theorem mpcMk_exists_sxKill_approx {r : ℕ} {x : (DM 2 0 : Type)}
    (hx : x ∈ twoCentralSeries (DM 2 0 : Type) r)
    (hxtop : x ∈ mpcSxMarked.topologicalClosure) :
    ∃ y ∈ mpcSxKill r,
      x * y⁻¹ ∈ twoCentralSeries (DM 2 0 : Type) (r + 1) := by
  obtain ⟨y, hymarked, hxy⟩ := mpcMk_exists_subgroup_approx_mod_open
    mpcSxMarked (twoCentralSeries (DM 2 0 : Type) (r + 1))
    (isOpen_twoCentralSeries (DM 2 0 : Type)
      (dmFinsetTopGen 2 0) (isProP_DM 2 0) (r + 1)) hxtop
  have hydepth : y ∈ twoCentralSeries (DM 2 0 : Type) r := by
    have hxy' : x * y⁻¹ ∈ twoCentralSeries (DM 2 0 : Type) r :=
      twoCentralSeries_antitone (G := (DM 2 0 : Type)) (by omega) hxy
    have hmem := Subgroup.mul_mem (twoCentralSeries (DM 2 0 : Type) r)
      (Subgroup.inv_mem _ hxy') hx
    rw [show (x * y⁻¹)⁻¹ * x = y by group] at hmem
    exact hmem
  exact ⟨y, ⟨hymarked, hydepth⟩, hxy⟩

/-! ## 3. Cost is unchanged by density rounding -/

/-- Four depth-`r` inputs that agree modulo `λ_(r+1)` have the same unrestricted cost in
`Q_(r+2)`. -/
theorem mpcMk_rawCost_congr_of_mod_succ {r : ℕ} (hr : 2 ≤ r)
    (t n xs xt xm xn ys yt ym yn : (DM 2 0 : Type))
    (hxs : xs ∈ twoCentralSeries (DM 2 0 : Type) r)
    (hxt : xt ∈ twoCentralSeries (DM 2 0 : Type) r)
    (hxm : xm ∈ twoCentralSeries (DM 2 0 : Type) r)
    (hxn : xn ∈ twoCentralSeries (DM 2 0 : Type) r)
    (hys : ys ∈ twoCentralSeries (DM 2 0 : Type) r)
    (hyt : yt ∈ twoCentralSeries (DM 2 0 : Type) r)
    (hym : ym ∈ twoCentralSeries (DM 2 0 : Type) r)
    (hyn : yn ∈ twoCentralSeries (DM 2 0 : Type) r)
    (hs : xs * ys⁻¹ ∈ twoCentralSeries (DM 2 0 : Type) (r + 1))
    (ht : xt * yt⁻¹ ∈ twoCentralSeries (DM 2 0 : Type) (r + 1))
    (hm : xm * ym⁻¹ ∈ twoCentralSeries (DM 2 0 : Type) (r + 1))
    (hn : xn * yn⁻¹ ∈ twoCentralSeries (DM 2 0 : Type) (r + 1)) :
    levelMk (DM 2 0 : Type) (r + 2) (mpcBldIncr t n xs xt xm xn) =
      levelMk (DM 2 0 : Type) (r + 2) (mpcBldIncr t n ys yt ym yn) := by
  let X := mpcMkRawCorrection r xs xt xm xn hxs hxt hxm hxn
  let Y := mpcMkRawCorrection r ys yt ym yn hys hyt hym hyn
  let F := evenRawDepthShiftHom (mpcMkRawBase r t n) (by omega)
  have hdeep : ∀ i, (X * Y⁻¹).correction i ∈
      zLayer (DM 2 0 : Type) (r + 1) := by
    intro i
    fin_cases i
    · change levelMk (DM 2 0 : Type) (r + 2) xs *
          (levelMk (DM 2 0 : Type) (r + 2) ys)⁻¹ ∈ _
      rw [← map_inv, ← map_mul]
      exact ⟨xs * ys⁻¹, hs, rfl⟩
    · change levelMk (DM 2 0 : Type) (r + 2) xt *
          (levelMk (DM 2 0 : Type) (r + 2) yt)⁻¹ ∈ _
      rw [← map_inv, ← map_mul]
      exact ⟨xt * yt⁻¹, ht, rfl⟩
    · change levelMk (DM 2 0 : Type) (r + 2) xm *
          (levelMk (DM 2 0 : Type) (r + 2) ym)⁻¹ ∈ _
      rw [← map_inv, ← map_mul]
      exact ⟨xm * ym⁻¹, hm, rfl⟩
    · change levelMk (DM 2 0 : Type) (r + 2) xn *
          (levelMk (DM 2 0 : Type) (r + 2) yn)⁻¹ ∈ _
      rw [← map_inv, ← map_mul]
      exact ⟨xn * yn⁻¹, hn, rfl⟩
  have hzero : F (X * Y⁻¹) = 1 := by
    apply Subtype.ext
    exact evenDigit_dbarWord_eq_one_of_zLayer
      (mpcMkRawBase r t n) (X * Y⁻¹).correction hdeep
  have hXY : F X = F Y := by
    apply eq_of_mul_inv_eq_one
    rw [← map_inv, ← map_mul]
    exact hzero
  rw [← mpcMk_rawShift_eq_cost r hr t n xs xt xm xn hxs hxt hxm hxn,
    ← mpcMk_rawShift_eq_cost r hr t n ys yt ym yn hys hyt hym hyn]
  exact congrArg Subtype.val hXY

