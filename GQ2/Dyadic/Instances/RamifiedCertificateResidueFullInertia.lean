import GQ2.Dyadic.Instances.RamifiedCertificateResidueReciprocity

/-!
# Full tame inertia, the 2-primary unramified kernel, and residue lifts

`nuTq : Tq q → Ztwo` and `MarkedRecip.nu_ur` record only the `2`-primary component of the
unramified coordinate.  Their kernels are therefore larger than full inertia: they also contain
the prime-to-`2` part of the unramified procyclic group.  Consequently the W170 predicate
`TameInertiaAbsoluteResidueTrivialAt`, which asks every element of `ker (nuTq ∘ tame)` to be
absolutely residue-trivial, is a useful sufficient hypothesis but is not the standard theorem
that inertia acts trivially on residues.

This module records the distinction formally.  For every `q`, the element

`x = sigma * (sigma ^ omega2)⁻¹`

lies in `ker nuTq`: `omega2` extracts the `2`-primary part in every finite quotient.  But the
unramified quotient `Tq q → C3` sending `sigma` to a generator and `tau` to one detects `x`.
Since that quotient kills the closed normal subgroup `inertiaPartQ q` generated by `tau`, this
proves

`ker (nuTq q) ⊈ inertiaPartQ q`.

The corrected field predicate is `TameFullInertiaAbsoluteResidueTrivialAt`: only elements whose
tame image lies in `inertiaPartQ` must be residue-trivial.  This is enough to choose a
residue-trivial lift of `tqTau`, hence enough for the full `CompatibleResidueLiftAt` packet.
At the narrowest level, the exact input is simply one lift of `tqTau` fixing odd-order roots of
unity; W171's odd-root equivalence identifies this with `TameTauAbsoluteResidueLiftAt`.

No currently exported `MarkedRecip` or finite local-CFT supply proves the corrected field
predicate.  In particular, `FiniteTwoLocalReciprocitySupply` only controls finite `2`-group
quotients, while the formal obstruction below is already the prime-to-`2` quotient `C3`.
-/

namespace GQ2.Dyadic

noncomputable section

open GQ2

/-! ## The correct full-inertia predicate -/

/-- The tame generator belongs to the full inertia subgroup. -/
theorem tqTau_mem_inertiaPartQ (q : ℕ) : tqTau q ∈ inertiaPartQ q :=
  Subgroup.le_topologicalClosure _
    (Subgroup.subset_normalClosure (Set.mem_singleton (tqTau q)))

/-- The `2`-primary unramified coordinate kills full inertia.  The converse is false below. -/
theorem nuTq_kills_inertiaPartQ (q : ℕ) :
    inertiaPartQ q ≤ (nuTq q).toMonoidHom.ker := by
  have hclosed : IsClosed (((nuTq q).toMonoidHom.ker : Subgroup (Tq q)) : Set (Tq q)) := by
    rw [MonoidHom.coe_ker]
    exact IsClosed.preimage (nuTq q).continuous_toFun isClosed_singleton
  refine Subgroup.topologicalClosure_minimal _ ?_ hclosed
  refine Subgroup.normalClosure_le_normal ?_
  intro z hz
  rcases Set.mem_singleton_iff.mp hz with rfl
  exact MonoidHom.mem_ker.mpr (nuTq_tqTau q)

/-- The mathematically standard residue statement: the preimage of full tame inertia, rather
than the whole kernel of its `2`-primary unramified coordinate, acts trivially on residues. -/
def TameFullInertiaAbsoluteResidueTrivialAt (P : FieldParameters)
    (U : Subgroup AbsGalQ2) (tame : ContinuousMonoidHom ↑U (Tq P.qK)) : Prop :=
  ∀ g : ↑U, tame g ∈ inertiaPartQ P.qK →
    IsResidueTrivial (⊥ : Subgroup AbsGalQ2) (subtypeAnc U g)

/-- The stronger W170 `ker nuTq` hypothesis implies the corrected full-inertia hypothesis. -/
theorem tameFullInertiaAbsoluteResidueTrivialAt_of_nuKernel
    (P : FieldParameters) (U : Subgroup AbsGalQ2)
    (tame : ContinuousMonoidHom ↑U (Tq P.qK))
    (hnu : TameInertiaAbsoluteResidueTrivialAt P U tame) :
    TameFullInertiaAbsoluteResidueTrivialAt P U tame := by
  intro g hg
  apply hnu g
  exact MonoidHom.mem_ker.mp (nuTq_kills_inertiaPartQ P.qK hg)

/-- Full-inertia residue-triviality and tame surjectivity select an absolutely residue-trivial
lift of `tqTau`. -/
theorem tameTauAbsoluteResidueLiftAt_of_fullInertia
    (P : FieldParameters) (U : Subgroup AbsGalQ2)
    (tame : ContinuousMonoidHom ↑U (Tq P.qK)) (htame : Function.Surjective tame)
    (hfull : TameFullInertiaAbsoluteResidueTrivialAt P U tame) :
    TameTauAbsoluteResidueLiftAt P U tame := by
  obtain ⟨g₀, hg₀⟩ := htame (tqTau P.qK)
  refine ⟨g₀, hg₀, hfull g₀ ?_⟩
  rw [hg₀]
  exact tqTau_mem_inertiaPartQ P.qK

/-- The corrected full-inertia statement is sufficient for the compatible residue-lift packet. -/
theorem compatibleResidueLiftAt_of_fullInertia
    (P : FieldParameters) (U : Subgroup AbsGalQ2)
    (tame : ContinuousMonoidHom ↑U (Tq P.qK)) (htame : Function.Surjective tame)
    (hfull : TameFullInertiaAbsoluteResidueTrivialAt P U tame) :
    CompatibleResidueLiftAt P U tame :=
  compatibleResidueLiftAt_of_absolute_tameTau_lift P U tame
    (tameTauAbsoluteResidueLiftAt_of_fullInertia P U tame htame hfull)

/-! ## The exact selected-lift formulation -/

/-- The narrow odd-root input: one lift of the tame generator fixes all Teichmüller roots. -/
def TameTauFixesOddRootsLiftAt (P : FieldParameters) (U : Subgroup AbsGalQ2)
    (tame : ContinuousMonoidHom ↑U (Tq P.qK)) : Prop :=
  ∃ g₀ : ↑U, tame g₀ = tqTau P.qK ∧
    FixesOddRootsOfUnity (subtypeAnc U g₀)

/-- The selected odd-root formulation is exactly W170's selected absolute-residue lift. -/
theorem tameTauFixesOddRootsLiftAt_iff_absoluteResidueLiftAt
    (P : FieldParameters) (U : Subgroup AbsGalQ2)
    (tame : ContinuousMonoidHom ↑U (Tq P.qK)) :
    TameTauFixesOddRootsLiftAt P U tame ↔ TameTauAbsoluteResidueLiftAt P U tame := by
  constructor
  · rintro ⟨g₀, hg₀, hfix⟩
    exact ⟨g₀, hg₀,
      (fixesOddRootsOfUnity_iff_isResidueTrivial_bot (subtypeAnc U g₀)).mp hfix⟩
  · rintro ⟨g₀, hg₀, hres⟩
    exact ⟨g₀, hg₀,
      (fixesOddRootsOfUnity_iff_isResidueTrivial_bot (subtypeAnc U g₀)).mpr hres⟩

/-- One lift of `tqTau` fixing odd-order roots is the narrowest direct producer for the
compatible residue-lift packet. -/
theorem compatibleResidueLiftAt_of_tameTauFixesOddRoots
    (P : FieldParameters) (U : Subgroup AbsGalQ2)
    (tame : ContinuousMonoidHom ↑U (Tq P.qK))
    (hfix : TameTauFixesOddRootsLiftAt P U tame) :
    CompatibleResidueLiftAt P U tame :=
  compatibleResidueLiftAt_of_absolute_tameTau_lift P U tame
    ((tameTauFixesOddRootsLiftAt_iff_absoluteResidueLiftAt P U tame).mp hfix)

/-! ## The `Ztwo`-kernel is strictly larger than full inertia -/

namespace FullInertiaCounterexample

open NpcJet

/-- The relation for the pure unramified `C3` quotient: `sigma` maps to the generator and
`tau` maps to one. -/
private theorem pin_unramified_relation (q : ℕ) :
    conjP (1 : PinC) pinG = (1 : PinC) ^ q := by
  simp [conjP]

/-- A prime-to-`2` unramified quotient of every `Tq q`. -/
noncomputable def tqUnramifiedThree (q : ℕ) :
    ContinuousMonoidHom (Tq q) PinC :=
  tqClassify q (ProfiniteGrp.of PinC) (pin_unramified_relation q)

@[simp] theorem tqUnramifiedThree_tqSigma (q : ℕ) :
    tqUnramifiedThree q (tqSigma q) = pinG :=
  tqClassify_tqSigma q (ProfiniteGrp.of PinC) (pin_unramified_relation q)

@[simp] theorem tqUnramifiedThree_tqTau (q : ℕ) :
    tqUnramifiedThree q (tqTau q) = 1 :=
  tqClassify_tqTau q (ProfiniteGrp.of PinC) (pin_unramified_relation q)

/-- The pure unramified quotient kills the closed normal subgroup generated by `tau`. -/
theorem tqUnramifiedThree_kills_inertiaPartQ (q : ℕ) :
    inertiaPartQ q ≤ (tqUnramifiedThree q).toMonoidHom.ker := by
  have hclosed : IsClosed
      (((tqUnramifiedThree q).toMonoidHom.ker : Subgroup (Tq q)) : Set (Tq q)) := by
    rw [MonoidHom.coe_ker]
    exact IsClosed.preimage (tqUnramifiedThree q).continuous_toFun isClosed_singleton
  refine Subgroup.topologicalClosure_minimal _ ?_ hclosed
  refine Subgroup.normalClosure_le_normal ?_
  intro z hz
  rcases Set.mem_singleton_iff.mp hz with rfl
  exact MonoidHom.mem_ker.mpr (tqUnramifiedThree_tqTau q)

/-- The prime-to-`2` part of the Frobenius generator: remove its `omega2`-primary component. -/
noncomputable def oddUnramifiedKernelElement (q : ℕ) : Tq q :=
  tqSigma q * ((tqSigma q) ^ᶻ omega2)⁻¹

/-- The odd unramified element lies in the kernel of every finite `2`-group quotient. -/
theorem oddUnramifiedKernelElement_mem_proPKernel (q : ℕ) :
    oddUnramifiedKernelElement q ∈ proPKernel 2 (Tq q) := by
  rw [proPKernel, Subgroup.mem_iInf]
  intro U
  let mk : ContinuousMonoidHom (Tq q) (Tq q ⧸ U.1.toSubgroup) :=
    ⟨QuotientGroup.mk' U.1.toSubgroup, QuotientGroup.continuous_mk⟩
  have hpow : mk ((tqSigma q) ^ᶻ omega2) = mk (tqSigma q) := by
    rw [map_zpowHat, zpowHat_omega2]
    obtain ⟨k, hk⟩ := (IsPGroup.iff_orderOf.mp U.2) (mk (tqSigma q))
    exact powOmega2_eq_self_of_orderOf_two_pow hk
  apply (QuotientGroup.eq_one_iff _).mp
  change mk (oddUnramifiedKernelElement q) = 1
  rw [oddUnramifiedKernelElement, map_mul, map_inv, hpow, mul_inv_cancel]

/-- Hence the odd unramified element is invisible to `nuTq`. -/
theorem oddUnramifiedKernelElement_nuTq (q : ℕ) :
    nuTq q (oddUnramifiedKernelElement q) = 1 := by
  exact MonoidHom.mem_ker.mp
    (proPKernel_le_ker isProP_maxProPQuotient (nuTq q)
      (oddUnramifiedKernelElement_mem_proPKernel q))

/-- The `C3` unramified quotient detects the odd unramified element. -/
theorem oddUnramifiedKernelElement_detected (q : ℕ) :
    tqUnramifiedThree q (oddUnramifiedKernelElement q) ≠ 1 := by
  rw [oddUnramifiedKernelElement, map_mul, map_inv, map_zpowHat_omega2,
    tqUnramifiedThree_tqSigma, powOmega2_eq_one_of_odd (pinOddOrder pinG), inv_one, mul_one]
  decide

/-- Formal no-go: the kernel of the `2`-primary unramified coordinate is not contained in full
tame inertia. -/
theorem ker_nuTq_not_le_inertiaPartQ (q : ℕ) :
    ¬ (nuTq q).toMonoidHom.ker ≤ inertiaPartQ q := by
  intro hle
  have hxI : oddUnramifiedKernelElement q ∈ inertiaPartQ q :=
    hle (MonoidHom.mem_ker.mpr (oddUnramifiedKernelElement_nuTq q))
  have hxker := tqUnramifiedThree_kills_inertiaPartQ q hxI
  exact oddUnramifiedKernelElement_detected q (MonoidHom.mem_ker.mp hxker)

/-- Every surjection to `Tq q` has source elements in the `nuTq`-kernel whose tame image lies
outside full inertia. -/
theorem exists_nuTq_kernel_outside_inertiaPartQ {q : ℕ} {U : Subgroup AbsGalQ2}
    (tame : ContinuousMonoidHom ↑U (Tq q)) (htame : Function.Surjective tame) :
    ∃ g : ↑U, nuTq q (tame g) = 1 ∧ tame g ∉ inertiaPartQ q := by
  obtain ⟨g, hg⟩ := htame (oddUnramifiedKernelElement q)
  refine ⟨g, ?_, ?_⟩
  · rw [hg]
    exact oddUnramifiedKernelElement_nuTq q
  · intro hI
    have hxker := tqUnramifiedThree_kills_inertiaPartQ q (hg ▸ hI)
    exact oddUnramifiedKernelElement_detected q (MonoidHom.mem_ker.mp hxker)

end FullInertiaCounterexample

