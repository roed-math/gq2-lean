import GQ2.Dyadic.Instances.MpcGeneralAbelianDecomposition
import GQ2.Dyadic.Instances.MpcGeneralRowKernel

/-!
# Uniform reduction of `C` absorption to the M-frame tower word

The preceding abelian decomposition writes every deep `chiM`-neutral `C` correction as a
deep derived correction times a canonical word supported on `B`, `C`, and the handles.  This
module transports that equality through the finite first-variation homomorphism.

Consequently the general head-completion theorem is reduced to absorption of the canonical
M-frame tower word, uniformly in the degree, handle count, and filtration stage.
-/

namespace GQ2.Dyadic.Instances.MpcGeneralTowerReduction

noncomputable section

open GQ2 GQ2.Dyadic Multiplicative
open GQ2.Dyadic.MarkedCore
open GQ2.Dyadic.Instances.MpcGeneralAbelianDecomposition
open GQ2.Dyadic.Instances.MpcGeneralFiniteSpan
open GQ2.Dyadic.Instances.MpcGeneralHeadCompletion
open GQ2.Dyadic.Instances.MpcGeneralHeadSpan
open GQ2.Dyadic.Instances.MpcGeneralMarkedSpan
open GQ2.Dyadic.Instances.MpcGeneralRowKernel
open GQ2.Roe.Labute

/-- A one-coordinate head correction in the distinguished `C` slot. -/
def mpcGeneralHeadSingleC {alpha h k : ℕ} (x : DM alpha h)
    (hx : x ∈ twoCentralSeries (DM alpha h : Type) (k - 1))
    (hchi : chiM alpha h x = 1) :
    MpcGeneralHeadLevelCorrection alpha h k := fun i => by
  classical
  by_cases hi : i = 2
  · subst hi
    exact ⟨levelMk (DM alpha h) (k + 1) x,
      (mem_mpcGeneralHeadCorrectionImage_iff_exists _).mpr
        ⟨x, hx, hchi, fun H => (mCoreZero_ne_two H.symm).elim, rfl⟩⟩
  · exact ⟨1, Subgroup.one_mem _⟩

/-- A one-coordinate fully marked correction in the distinguished `C` slot. -/
def mpcGeneralMarkedSingleC {alpha h k : ℕ} (d : DM alpha h)
    (hd : d ∈ twoCentralSeries (DM alpha h : Type) (k - 1))
    (hab : GQ2.SectionThree.abMk d = 1) :
    MpcGeneralMarkedLevelCorrection alpha h k := fun i => by
  classical
  by_cases hi : i = 2
  · subst hi
    exact ⟨levelMk (DM alpha h) (k + 1) d,
      (mem_mpcGeneralMarkedCorrectionImage_iff_exists _).mpr
        ⟨d, hd, by
          have H := congrArg (GQ2.SectionThree.abLiftG (chiM alpha h)) hab
          simpa only [GQ2.SectionThree.abLiftG_abMk, map_one] using H,
        fun _ f => by
          have H := congrArg (GQ2.SectionThree.abLiftG f) hab
          simpa only [GQ2.SectionThree.abLiftG_abMk, map_one] using H,
        fun H => (mCoreZero_ne_two H.symm).elim, rfl⟩⟩
  · exact ⟨1, Subgroup.one_mem _⟩

/-- Forgetting the marked singleton gives the corresponding head singleton. -/
theorem mpcGeneralMarkedSingleC_toHead {alpha h k : ℕ}
    (d : DM alpha h) (hd : d ∈ twoCentralSeries (DM alpha h : Type) (k - 1))
    (hab : GQ2.SectionThree.abMk d = 1) :
    mpcGeneralMarkedLevelToHead (mpcGeneralMarkedSingleC d hd hab) =
      mpcGeneralHeadSingleC d hd (by
        have H := congrArg (GQ2.SectionThree.abLiftG (chiM alpha h)) hab
        simpa only [GQ2.SectionThree.abLiftG_abMk, map_one] using H) := by
  classical
  funext i
  apply Subtype.ext
  by_cases hi : i = 2
  · subst hi
    simp [mpcGeneralMarkedLevelToHead, mpcGeneralMarkedSingleC,
      mpcGeneralHeadSingleC]
  · simp [mpcGeneralMarkedLevelToHead, mpcGeneralMarkedSingleC,
      mpcGeneralHeadSingleC, hi]

/-- Singleton `C` corrections multiply exactly as their group representatives do. -/
theorem mpcGeneralHeadSingleC_mul {alpha h k : ℕ}
    (d y : DM alpha h)
    (hd : d ∈ twoCentralSeries (DM alpha h : Type) (k - 1))
    (hy : y ∈ twoCentralSeries (DM alpha h : Type) (k - 1))
    (hchid : chiM alpha h d = 1) (hchiy : chiM alpha h y = 1) :
    mpcGeneralHeadSingleC (d * y) (Subgroup.mul_mem _ hd hy)
        (by rw [map_mul, hchid, hchiy, one_mul]) =
      mpcGeneralHeadSingleC d hd hchid * mpcGeneralHeadSingleC y hy hchiy := by
  classical
  funext i
  apply Subtype.ext
  by_cases hi : i = 2
  · subst hi
    simp [mpcGeneralHeadSingleC, map_mul]
  · simp [mpcGeneralHeadSingleC, hi]

/-- The exact remaining tower statement: the singleton shift generated by the canonical
`B,C,handles` word lies in the fully marked range. -/
def MpcGeneralTowerCAbsorptionSupply (alpha h : ℕ) : Prop :=
  ∀ (halpha : 2 ≤ alpha) k (hk : 3 ≤ k)
    (m : Fin (coreRank h) → (DM alpha h : Type))
    (x : DM alpha h) (hx : x ∈ twoCentralSeries (DM alpha h : Type) (k - 1))
    (hchi : chiM alpha h x = 1),
    let y := mpcGeneralGroupWord alpha h
      (mpcGeneralChiNeutralVec (by omega : 1 ≤ alpha) x)
    mpcGeneralHeadLevelShiftHom m k hk
        (mpcGeneralHeadSingleC y
          (mpcGeneralGroupWord_mem_depth (by omega)
            (mpcGeneralChiNeutralVec_dvd (by omega) hx))
          (by
            rw [← hchi]
            exact congrArg (GQ2.SectionThree.abLiftG (chiM alpha h))
              (abMk_mpcGeneralChiNeutralWord_eq (by omega) hx (by omega) hchi))) ∈
      (mpcGeneralMarkedLevelShiftHom m k hk).range

/-- Tower-word absorption implies the complete one-slot `C` absorption theorem. -/
theorem mpcGeneralCAbsorptionSupply_of_tower
    {alpha h : ℕ} (halpha : 2 ≤ alpha)
    (H : MpcGeneralTowerCAbsorptionSupply alpha h) :
    MpcGeneralCAbsorptionSupply alpha h := by
  intro k hk m E
  obtain ⟨x, hx, hchi, -, hlevel⟩ :=
    (mem_mpcGeneralHeadCorrectionImage_iff_exists (E 2).1).mp (E 2).2
  obtain ⟨d, y, hd, hab, hy, hxy, hydef⟩ :=
    exists_mpcGeneral_derived_mul_tower halpha hx (by omega) hchi
  subst y
  let y := mpcGeneralGroupWord alpha h
    (mpcGeneralChiNeutralVec (by omega : 1 ≤ alpha) x)
  change y ∈ twoCentralSeries (DM alpha h : Type) (k - 1) at hy
  change x = d * y at hxy
  have hchid : chiM alpha h d = 1 := by
    have Hd := congrArg (GQ2.SectionThree.abLiftG (chiM alpha h)) hab
    simpa only [GQ2.SectionThree.abLiftG_abMk, map_one] using Hd
  have hchiy : chiM alpha h y = 1 := by
    rw [← hchi, hxy, map_mul, hchid, one_mul]
  have hsingle : mpcGeneralHeadOnlyC E =
      mpcGeneralHeadSingleC x hx hchi := by
    classical
    funext i
    apply Subtype.ext
    by_cases hi : i = 2
    · subst hi
      simpa [mpcGeneralHeadOnlyC, mpcGeneralHeadSingleC] using hlevel.symm
    · simp [mpcGeneralHeadOnlyC, mpcGeneralHeadSingleC, hi]
  have hsplit : mpcGeneralHeadSingleC x hx hchi =
      mpcGeneralHeadSingleC d hd hchid *
        mpcGeneralHeadSingleC y hy hchiy := by
    classical
    funext i
    apply Subtype.ext
    by_cases hi : i = 2
    · subst hi
      simp [mpcGeneralHeadSingleC, map_mul, hxy]
    · simp [mpcGeneralHeadSingleC, hi]
  obtain ⟨Q, hQ⟩ := H halpha k hk m x hx hchi
  refine ⟨mpcGeneralMarkedSingleC d hd hab * Q, ?_⟩
  rw [map_mul, ← mpcGeneralMarkedLevelToHead_shift]
  rw [mpcGeneralMarkedSingleC_toHead]
  change mpcGeneralHeadLevelShiftHom m k hk
      (mpcGeneralHeadSingleC d hd hchid) *
      mpcGeneralMarkedLevelShiftHom m k hk Q = _
  rw [hQ, ← map_mul, ← hsplit, ← hsingle]

/-- The uniform tower theorem proves the general pivot shift. -/
theorem mpcPivShiftH_of_generalTowerCAbsorption
    {alpha h : ℕ} (halpha : 2 ≤ alpha)
    (H : MpcGeneralTowerCAbsorptionSupply alpha h) :
    MpcGeneralHandlePivotBoundary.MpcPivShiftH alpha h :=
  mpcPivShiftH_of_generalCAbsorption halpha
    (mpcGeneralCAbsorptionSupply_of_tower halpha H)

end

end GQ2.Dyadic.Instances.MpcGeneralTowerReduction

