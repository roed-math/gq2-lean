import GQ2.Dyadic.Instances.MpcGeneralMarkedObstruction

/-!
# The uniform head-reflection and head-completion split

The marked successor problem has two logically different parts.  First, an exact-character
correction must be adjusted so that its square-bearing head has zero additive `D` row.
Second, its distinguished `C` correction must be replaced by a deep-derived correction.

This module packages the intermediate head-marked correction range for arbitrary `alpha`,
handle count, and stage.  The final theorem proves that uniform head reflection and uniform
head completion imply the marked finite-range supply.  No nilpotency class is selected.
-/

namespace GQ2.Dyadic.Instances.MpcGeneralHeadSpan

noncomputable section

open GQ2 GQ2.Dyadic Multiplicative
open GQ2.Dyadic.MarkedCore
open GQ2.Dyadic.StageGeneric
open GQ2.Dyadic.Instances.MpcGeneralHandlePivotBoundary
open GQ2.Dyadic.Instances.MpcGeneralFiniteStages
open GQ2.Dyadic.Instances.MpcGeneralFiniteSpan
open GQ2.Dyadic.Instances.MpcGeneralChiCorrection
open GQ2.Dyadic.Instances.MpcGeneralMarkedStages
open GQ2.Dyadic.Instances.MpcGeneralMarkedSpan
open GQ2.Dyadic.Instances.MpcGeneralMarkedObstruction
open GQ2.Roe.Labute

/-- Exact-character corrections with the secondary constraint only at the head. -/
def mpcGeneralHeadCorrectionSource (alpha h j : ℕ)
    (i : Fin (coreRank h)) : Subgroup (DM alpha h : Type) :=
  if i = 0 then
    (twoCentralSeries (DM alpha h : Type) j ⊓ mpcGeneralChiKer alpha h) ⊓
      (mpcGeneralDeltaD alpha h).toMonoidHom.ker
  else
    twoCentralSeries (DM alpha h : Type) j ⊓ mpcGeneralChiKer alpha h

/-- Finite image of the head-marked source in one coordinate. -/
def mpcGeneralHeadCorrectionImage (alpha h j n : ℕ)
    (i : Fin (coreRank h)) : Subgroup (levelQuot (DM alpha h) n) :=
  (mpcGeneralHeadCorrectionSource alpha h j i).map (levelMk (DM alpha h) n)

theorem mem_mpcGeneralHeadCorrectionImage_iff_exists
    {alpha h j n : ℕ} {i : Fin (coreRank h)} (x : levelQuot (DM alpha h) n) :
    x ∈ mpcGeneralHeadCorrectionImage alpha h j n i ↔
      ∃ e : DM alpha h,
        e ∈ twoCentralSeries (DM alpha h : Type) j ∧
        chiM alpha h e = 1 ∧
        (i = 0 → mpcGeneralDeltaD alpha h e = 1) ∧
        levelMk (DM alpha h) n e = x := by
  constructor
  · rintro ⟨e, he, rfl⟩
    by_cases hi : i = 0
    · rw [mpcGeneralHeadCorrectionSource, if_pos hi] at he
      exact ⟨e, he.1.1, MonoidHom.mem_ker.mp he.1.2,
        fun _ => MonoidHom.mem_ker.mp he.2, rfl⟩
    · rw [mpcGeneralHeadCorrectionSource, if_neg hi] at he
      exact ⟨e, he.1, MonoidHom.mem_ker.mp he.2, fun H => (hi H).elim, rfl⟩
  · rintro ⟨e, hdepth, hchi, hdelta, rfl⟩
    refine ⟨e, ?_, rfl⟩
    by_cases hi : i = 0
    · rw [mpcGeneralHeadCorrectionSource, if_pos hi]
      exact ⟨⟨hdepth, MonoidHom.mem_ker.mpr hchi⟩,
        MonoidHom.mem_ker.mpr (hdelta hi)⟩
    · rw [mpcGeneralHeadCorrectionSource, if_neg hi]
      exact ⟨hdepth, MonoidHom.mem_ker.mpr hchi⟩

/-- All head-marked choices at one finite stage. -/
abbrev MpcGeneralHeadLevelCorrection (alpha h k : ℕ) :=
  ∀ i : Fin (coreRank h),
    mpcGeneralHeadCorrectionImage alpha h (k - 1) (k + 1) i

/-- Forget the exact constraints and retain a raw depth correction. -/
def mpcGeneralHeadLevelToRaw {alpha h k : ℕ}
    (E : MpcGeneralHeadLevelCorrection alpha h k) :
    EvenRawDepthCorrection (DM alpha h) h k where
  correction i := (E i).1
  depth i := by
    obtain ⟨e, hdepth, -, -, hlevel⟩ :=
      (mem_mpcGeneralHeadCorrectionImage_iff_exists (E i).1).mp (E i).2
    exact ⟨e, hdepth, hlevel⟩

/-- The head-marked forgetful map is a homomorphism. -/
noncomputable def mpcGeneralHeadLevelToRawHom (alpha h k : ℕ) :
    MpcGeneralHeadLevelCorrection alpha h k →*
      EvenRawDepthCorrection (DM alpha h) h k where
  toFun := mpcGeneralHeadLevelToRaw
  map_one' := by ext i; rfl
  map_mul' _ _ := by ext i; rfl

/-- The finite shift generated by head-marked corrections. -/
noncomputable def mpcGeneralHeadLevelShiftHom {alpha h : ℕ}
    (m : Fin (coreRank h) → (DM alpha h : Type)) (k : ℕ) (hk : 3 ≤ k) :
    MpcGeneralHeadLevelCorrection alpha h k →* zLayer (DM alpha h) k :=
  (evenRawDepthShiftHom
    (fun i => levelMk (DM alpha h) (k + 1) (m i)) hk).comp
      (mpcGeneralHeadLevelToRawHom alpha h k)

/-- Fully marked corrections forget to head-marked corrections. -/
def mpcGeneralMarkedLevelToHead {alpha h k : ℕ}
    (E : MpcGeneralMarkedLevelCorrection alpha h k) :
    MpcGeneralHeadLevelCorrection alpha h k := fun i =>
  ⟨(E i).1, (mem_mpcGeneralHeadCorrectionImage_iff_exists _).mpr (by
    obtain ⟨e, hdepth, hchi, -, hdelta, hlevel⟩ :=
      (mem_mpcGeneralMarkedCorrectionImage_iff_exists (E i).1).mp (E i).2
    exact ⟨e, hdepth, hchi, hdelta, hlevel⟩)⟩

/-- Forgetting the derived `C` condition does not change the shift value. -/
theorem mpcGeneralMarkedLevelToHead_shift
    {alpha h k : ℕ} (m : Fin (coreRank h) → (DM alpha h : Type))
    (hk : 3 ≤ k) (E : MpcGeneralMarkedLevelCorrection alpha h k) :
    mpcGeneralHeadLevelShiftHom m k hk (mpcGeneralMarkedLevelToHead E) =
      mpcGeneralMarkedLevelShiftHom m k hk E :=
  rfl

/-- Uniform head reflection: the target of every marked stage is hit after imposing only
the exact-character and secondary head constraints. -/
def MpcGeneralHeadReflectionSupply (alpha h : ℕ) : Prop :=
  ∀ k (hk : 3 ≤ k) m (hm : m ∈ mpcGeneralMarkedStage alpha h k),
    mpcGeneralLevelTarget hm.1 ∈ (mpcGeneralHeadLevelShiftHom m k hk).range

/-- Uniform head completion: every head-marked shift is already a fully marked shift. -/
def MpcGeneralHeadCompletionSupply (alpha h : ℕ) : Prop :=
  ∀ k (hk : 3 ≤ k) (m : Fin (coreRank h) → (DM alpha h : Type)),
    (mpcGeneralHeadLevelShiftHom m k hk).range ≤
      (mpcGeneralMarkedLevelShiftHom m k hk).range

/-- The reverse range inclusion is formal: full marking only restricts the source. -/
theorem mpcGeneralMarkedRange_le_headRange {alpha h k : ℕ}
    (m : Fin (coreRank h) → (DM alpha h : Type)) (hk : 3 ≤ k) :
    (mpcGeneralMarkedLevelShiftHom m k hk).range ≤
      (mpcGeneralHeadLevelShiftHom m k hk).range := by
  rintro _ ⟨E, rfl⟩
  exact ⟨mpcGeneralMarkedLevelToHead E,
    mpcGeneralMarkedLevelToHead_shift m hk E⟩

/-- Head completion is equivalently equality of the two finite shift ranges. -/
theorem mpcGeneralHeadCompletionSupply_iff_range_eq {alpha h : ℕ} :
    MpcGeneralHeadCompletionSupply alpha h ↔
      ∀ k (hk : 3 ≤ k) (m : Fin (coreRank h) → (DM alpha h : Type)),
        (mpcGeneralHeadLevelShiftHom m k hk).range =
          (mpcGeneralMarkedLevelShiftHom m k hk).range := by
  constructor
  · intro H k hk m
    exact le_antisymm (H k hk m) (mpcGeneralMarkedRange_le_headRange m hk)
  · intro H k hk m
    rw [H k hk m]

/-- The two uniform statements give the exact marked finite-range theorem. -/
theorem mpcGeneralMarkedFiniteRangeSupply_of_head
    {alpha h : ℕ} (hreflect : MpcGeneralHeadReflectionSupply alpha h)
    (hcomplete : MpcGeneralHeadCompletionSupply alpha h) :
    MpcGeneralMarkedFiniteRangeSupply alpha h := by
  intro k hk m hm
  exact hcomplete k hk m (hreflect k hk m hm)

/-- Consequently, uniform head reflection and completion prove the general pivot shift. -/
theorem mpcPivShiftH_of_generalHeadReflectionCompletion
    {alpha h : ℕ} (halpha : 2 ≤ alpha)
    (hreflect : MpcGeneralHeadReflectionSupply alpha h)
    (hcomplete : MpcGeneralHeadCompletionSupply alpha h) :
    MpcPivShiftH alpha h :=
  mpcPivShiftH_of_generalMarkedFiniteRange halpha
    (mpcGeneralMarkedFiniteRangeSupply_of_head hreflect hcomplete)

end

end GQ2.Dyadic.Instances.MpcGeneralHeadSpan

