/-! ## The four coordinate inclusions -/

/-- Include a relative class in the `A` coordinate. -/
noncomputable def oneHandleBalancedCoreCoordA (k : ℕ) :
    oneHandleRelativeLambdaImage (k - 1) (k + 1) →*
      OneHandleBalancedCoreLevelCorrection k where
  toFun x := ⟨x, 1, 1, 1⟩
  map_one' := by ext <;> rfl
  map_mul' x y := by ext <;> rfl

/-- Include a relative class in the `B` coordinate. -/
noncomputable def oneHandleBalancedCoreCoordB (k : ℕ) :
    oneHandleRelativeLambdaImage (k - 1) (k + 1) →*
      OneHandleBalancedCoreLevelCorrection k where
  toFun x := ⟨1, x, 1, 1⟩
  map_one' := by ext <;> rfl
  map_mul' x y := by ext <;> rfl

/-- Include a character-neutral relative class in the `C` coordinate. -/
noncomputable def oneHandleBalancedCoreCoordC (k : ℕ) :
    oneHandleNeutralRelativeLambdaImage (k - 1) (k + 1) →*
      OneHandleBalancedCoreLevelCorrection k where
  toFun x := ⟨1, 1, x, 1⟩
  map_one' := by ext <;> rfl
  map_mul' x y := by ext <;> rfl

/-- Include a relative class in the `D` coordinate. -/
noncomputable def oneHandleBalancedCoreCoordD (k : ℕ) :
    oneHandleRelativeLambdaImage (k - 1) (k + 1) →*
      OneHandleBalancedCoreLevelCorrection k where
  toFun x := ⟨1, 1, 1, x⟩
  map_one' := by ext <;> rfl
  map_mul' x y := by ext <;> rfl

/-- Every finite four-core correction is the product of its four coordinate inclusions. -/
theorem oneHandleBalancedCoreLevelCorrection_eq_coords
    {k : ℕ} (E : OneHandleBalancedCoreLevelCorrection k) :
    E = oneHandleBalancedCoreCoordA k E.corrA *
        oneHandleBalancedCoreCoordB k E.corrB *
        oneHandleBalancedCoreCoordC k E.corrC *
        oneHandleBalancedCoreCoordD k E.corrD := by
  ext <;> simp [oneHandleBalancedCoreCoordA, oneHandleBalancedCoreCoordB,
    oneHandleBalancedCoreCoordC, oneHandleBalancedCoreCoordD]

/-! ## Coordinate shift homomorphisms and their span -/

noncomputable def oneHandleBalancedCoreRelativeShiftA
    (p : OneHandleBalancedPoint) (k : ℕ) (hk : 3 ≤ k) :
    oneHandleRelativeLambdaImage (k - 1) (k + 1) →*
      oneHandleRelativeZLayer k :=
  (oneHandleBalancedCoreRelativeShiftHom p k hk).comp
    (oneHandleBalancedCoreCoordA k)

noncomputable def oneHandleBalancedCoreRelativeShiftB
    (p : OneHandleBalancedPoint) (k : ℕ) (hk : 3 ≤ k) :
    oneHandleRelativeLambdaImage (k - 1) (k + 1) →*
      oneHandleRelativeZLayer k :=
  (oneHandleBalancedCoreRelativeShiftHom p k hk).comp
    (oneHandleBalancedCoreCoordB k)

noncomputable def oneHandleBalancedCoreRelativeShiftC
    (p : OneHandleBalancedPoint) (k : ℕ) (hk : 3 ≤ k) :
    oneHandleNeutralRelativeLambdaImage (k - 1) (k + 1) →*
      oneHandleRelativeZLayer k :=
  (oneHandleBalancedCoreRelativeShiftHom p k hk).comp
    (oneHandleBalancedCoreCoordC k)

noncomputable def oneHandleBalancedCoreRelativeShiftD
    (p : OneHandleBalancedPoint) (k : ℕ) (hk : 3 ≤ k) :
    oneHandleRelativeLambdaImage (k - 1) (k + 1) →*
      oneHandleRelativeZLayer k :=
  (oneHandleBalancedCoreRelativeShiftHom p k hk).comp
    (oneHandleBalancedCoreCoordD k)

/-- The subgroup generated by the four constrained coordinate shift ranges. -/
def oneHandleBalancedCoreCoordinateSpan
    (p : OneHandleBalancedPoint) (k : ℕ) (hk : 3 ≤ k) :
    Subgroup (oneHandleRelativeZLayer k) :=
  ((oneHandleBalancedCoreRelativeShiftA p k hk).range ⊔
    (oneHandleBalancedCoreRelativeShiftB p k hk).range) ⊔
  ((oneHandleBalancedCoreRelativeShiftC p k hk).range ⊔
    (oneHandleBalancedCoreRelativeShiftD p k hk).range)

/-- The full finite relative shift range is exactly the four-coordinate span. -/
theorem oneHandleBalancedCoreRelativeShift_range_eq_coordinateSpan
    (p : OneHandleBalancedPoint) (k : ℕ) (hk : 3 ≤ k) :
    (oneHandleBalancedCoreRelativeShiftHom p k hk).range =
      oneHandleBalancedCoreCoordinateSpan p k hk := by
  apply le_antisymm
  · rintro y ⟨E, rfl⟩
    rw [oneHandleBalancedCoreLevelCorrection_eq_coords E]
    simp only [map_mul]
    apply Subgroup.mul_mem
    · apply Subgroup.mul_mem
      · apply Subgroup.mul_mem
        · exact (show (oneHandleBalancedCoreRelativeShiftA p k hk).range ≤
              oneHandleBalancedCoreCoordinateSpan p k hk from
            le_trans le_sup_left le_sup_left) ⟨E.corrA, rfl⟩
        · exact (show (oneHandleBalancedCoreRelativeShiftB p k hk).range ≤
              oneHandleBalancedCoreCoordinateSpan p k hk from
            le_trans le_sup_right le_sup_left) ⟨E.corrB, rfl⟩
      · exact (show (oneHandleBalancedCoreRelativeShiftC p k hk).range ≤
            oneHandleBalancedCoreCoordinateSpan p k hk from
          le_trans le_sup_left le_sup_right) ⟨E.corrC, rfl⟩
    · exact (show (oneHandleBalancedCoreRelativeShiftD p k hk).range ≤
          oneHandleBalancedCoreCoordinateSpan p k hk from
        le_trans le_sup_right le_sup_right) ⟨E.corrD, rfl⟩
  · apply sup_le
    · apply sup_le
      · rintro y ⟨x, rfl⟩
        exact ⟨oneHandleBalancedCoreCoordA k x, rfl⟩
      · rintro y ⟨x, rfl⟩
        exact ⟨oneHandleBalancedCoreCoordB k x, rfl⟩
    · apply sup_le
      · rintro y ⟨x, rfl⟩
        exact ⟨oneHandleBalancedCoreCoordC k x, rfl⟩
      · rintro y ⟨x, rfl⟩
        exact ⟨oneHandleBalancedCoreCoordD k x, rfl⟩

/-! ## Literal coordinate formulas -/

private theorem balancedCoreIdx_ne {i j : Fin (coreRank 1)}
    (hij : (i : ℕ) ≠ (j : ℕ)) : i ≠ j :=
  fun h ↦ hij (congrArg Fin.val h)

@[simp] private theorem balancedIdx01 : (0 : Fin (coreRank 1)) ≠ 1 :=
  balancedCoreIdx_ne (by rw [coreVal_zero, coreVal_one]; omega)
@[simp] private theorem balancedIdx10 : (1 : Fin (coreRank 1)) ≠ 0 := balancedIdx01.symm
@[simp] private theorem balancedIdx02 : (0 : Fin (coreRank 1)) ≠ 2 :=
  balancedCoreIdx_ne (by rw [coreVal_zero, coreVal_two]; omega)
@[simp] private theorem balancedIdx20 : (2 : Fin (coreRank 1)) ≠ 0 := balancedIdx02.symm
@[simp] private theorem balancedIdx03 : (0 : Fin (coreRank 1)) ≠ 3 :=
  balancedCoreIdx_ne (by rw [coreVal_zero, coreVal_three]; omega)
@[simp] private theorem balancedIdx30 : (3 : Fin (coreRank 1)) ≠ 0 := balancedIdx03.symm
@[simp] private theorem balancedIdx12 : (1 : Fin (coreRank 1)) ≠ 2 :=
  balancedCoreIdx_ne (by rw [coreVal_one, coreVal_two]; omega)
@[simp] private theorem balancedIdx21 : (2 : Fin (coreRank 1)) ≠ 1 := balancedIdx12.symm
@[simp] private theorem balancedIdx13 : (1 : Fin (coreRank 1)) ≠ 3 :=
  balancedCoreIdx_ne (by rw [coreVal_one, coreVal_three]; omega)
@[simp] private theorem balancedIdx31 : (3 : Fin (coreRank 1)) ≠ 1 := balancedIdx13.symm
@[simp] private theorem balancedIdx23 : (2 : Fin (coreRank 1)) ≠ 3 :=
  balancedCoreIdx_ne (by rw [coreVal_two, coreVal_three]; omega)
@[simp] private theorem balancedIdx32 : (3 : Fin (coreRank 1)) ≠ 2 := balancedIdx23.symm

private theorem balancedHandleU_ne_core (j : Fin 1) {i : Fin (coreRank 1)}
    (hi : (i : ℕ) < 4) : handleIdxU j ≠ i := by
  intro h
  have hv := congrArg Fin.val h
  rw [handleIdxU_val] at hv
  omega

private theorem balancedHandleV_ne_core (j : Fin 1) {i : Fin (coreRank 1)}
    (hi : (i : ℕ) < 4) : handleIdxV j ≠ i := by
  intro h
  have hv := congrArg Fin.val h
  rw [handleIdxV_val] at hv
  omega

/-- The raw correction underlying the `A` inclusion is supported at coordinate zero. -/
theorem oneHandleBalancedCoreLevelToRaw_coordA
    {k : ℕ} (x : oneHandleRelativeLambdaImage (k - 1) (k + 1)) :
    oneHandleBalancedCoreLevelToRaw (oneHandleBalancedCoreCoordA k x) =
      evenRawDepthCoordinateCorrection 0 ⟨x.1, x.2.1⟩ := by
  apply EvenRawDepthCorrection.ext
  funext i
  rcases mIdx_cases i with rfl | rfl | rfl | rfl | ⟨j, rfl⟩
  · simp [oneHandleBalancedCoreLevelToRaw,
      oneHandleBalancedCoreLevelCorrectionMark, oneHandleBalancedCoreCoordA]
  · rw [evenRawDepthCoordinateCorrection_apply, if_neg balancedIdx10]
    simp [oneHandleBalancedCoreLevelToRaw,
      oneHandleBalancedCoreLevelCorrectionMark, oneHandleBalancedCoreCoordA]
  · simp [oneHandleBalancedCoreLevelToRaw,
      oneHandleBalancedCoreLevelCorrectionMark, oneHandleBalancedCoreCoordA]
  · simp [oneHandleBalancedCoreLevelToRaw,
      oneHandleBalancedCoreLevelCorrectionMark, oneHandleBalancedCoreCoordA]
  · rcases mHandleCoord_cases j with ⟨j, rfl⟩ | ⟨j, rfl⟩ <;>
      simp [oneHandleBalancedCoreLevelToRaw,
        oneHandleBalancedCoreLevelCorrectionMark, oneHandleBalancedCoreCoordA,
        mHandleIdx_coordU, mHandleIdx_coordV,
        balancedHandleU_ne_core j (by rw [coreVal_zero]; omega),
        balancedHandleV_ne_core j (by rw [coreVal_zero]; omega)]

/-- The raw correction underlying the `B` inclusion is supported at coordinate one. -/
theorem oneHandleBalancedCoreLevelToRaw_coordB
    {k : ℕ} (x : oneHandleRelativeLambdaImage (k - 1) (k + 1)) :
    oneHandleBalancedCoreLevelToRaw (oneHandleBalancedCoreCoordB k x) =
      evenRawDepthCoordinateCorrection 1 ⟨x.1, x.2.1⟩ := by
  apply EvenRawDepthCorrection.ext
  funext i
  rcases mIdx_cases i with rfl | rfl | rfl | rfl | ⟨j, rfl⟩
  · rw [evenRawDepthCoordinateCorrection_apply, if_neg balancedIdx01]
    simp [oneHandleBalancedCoreLevelToRaw,
      oneHandleBalancedCoreLevelCorrectionMark, oneHandleBalancedCoreCoordB]
  · simp [oneHandleBalancedCoreLevelToRaw,
      oneHandleBalancedCoreLevelCorrectionMark, oneHandleBalancedCoreCoordB]
  · simp [oneHandleBalancedCoreLevelToRaw,
      oneHandleBalancedCoreLevelCorrectionMark, oneHandleBalancedCoreCoordB]
  · simp [oneHandleBalancedCoreLevelToRaw,
      oneHandleBalancedCoreLevelCorrectionMark, oneHandleBalancedCoreCoordB]
  · rcases mHandleCoord_cases j with ⟨j, rfl⟩ | ⟨j, rfl⟩ <;>
      simp [oneHandleBalancedCoreLevelToRaw,
        oneHandleBalancedCoreLevelCorrectionMark, oneHandleBalancedCoreCoordB,
        mHandleIdx_coordU, mHandleIdx_coordV,
        balancedHandleU_ne_core j (by rw [coreVal_one]; omega),
        balancedHandleV_ne_core j (by rw [coreVal_one]; omega)]

/-- The raw correction underlying the `C` inclusion is supported at coordinate two. -/
theorem oneHandleBalancedCoreLevelToRaw_coordC
    {k : ℕ} (x : oneHandleNeutralRelativeLambdaImage (k - 1) (k + 1)) :
    oneHandleBalancedCoreLevelToRaw (oneHandleBalancedCoreCoordC k x) =
      evenRawDepthCoordinateCorrection 2
        ⟨x.1, oneHandleNeutralRelativeLambdaImage_le_lambdaImage _ _ x.2⟩ := by
  apply EvenRawDepthCorrection.ext
  funext i
  rcases mIdx_cases i with rfl | rfl | rfl | rfl | ⟨j, rfl⟩
  · simp [oneHandleBalancedCoreLevelToRaw,
      oneHandleBalancedCoreLevelCorrectionMark, oneHandleBalancedCoreCoordC]
  · simp [oneHandleBalancedCoreLevelToRaw,
      oneHandleBalancedCoreLevelCorrectionMark, oneHandleBalancedCoreCoordC]
  · simp [oneHandleBalancedCoreLevelToRaw,
      oneHandleBalancedCoreLevelCorrectionMark, oneHandleBalancedCoreCoordC]
  · simp [oneHandleBalancedCoreLevelToRaw,
      oneHandleBalancedCoreLevelCorrectionMark, oneHandleBalancedCoreCoordC]
  · rcases mHandleCoord_cases j with ⟨j, rfl⟩ | ⟨j, rfl⟩ <;>
      simp [oneHandleBalancedCoreLevelToRaw,
        oneHandleBalancedCoreLevelCorrectionMark, oneHandleBalancedCoreCoordC,
        mHandleIdx_coordU, mHandleIdx_coordV,
        balancedHandleU_ne_core j (by rw [coreVal_two]; omega),
        balancedHandleV_ne_core j (by rw [coreVal_two]; omega)]

/-- The raw correction underlying the `D` inclusion is supported at coordinate three. -/
theorem oneHandleBalancedCoreLevelToRaw_coordD
    {k : ℕ} (x : oneHandleRelativeLambdaImage (k - 1) (k + 1)) :
    oneHandleBalancedCoreLevelToRaw (oneHandleBalancedCoreCoordD k x) =
      evenRawDepthCoordinateCorrection 3 ⟨x.1, x.2.1⟩ := by
  apply EvenRawDepthCorrection.ext
  funext i
  rcases mIdx_cases i with rfl | rfl | rfl | rfl | ⟨j, rfl⟩
  · simp [oneHandleBalancedCoreLevelToRaw,
      oneHandleBalancedCoreLevelCorrectionMark, oneHandleBalancedCoreCoordD]
  · simp [oneHandleBalancedCoreLevelToRaw,
      oneHandleBalancedCoreLevelCorrectionMark, oneHandleBalancedCoreCoordD]
  · simp [oneHandleBalancedCoreLevelToRaw,
      oneHandleBalancedCoreLevelCorrectionMark, oneHandleBalancedCoreCoordD]
  · simp [oneHandleBalancedCoreLevelToRaw,
      oneHandleBalancedCoreLevelCorrectionMark, oneHandleBalancedCoreCoordD]
  · rcases mHandleCoord_cases j with ⟨j, rfl⟩ | ⟨j, rfl⟩ <;>
      simp [oneHandleBalancedCoreLevelToRaw,
        oneHandleBalancedCoreLevelCorrectionMark, oneHandleBalancedCoreCoordD,
        mHandleIdx_coordU, mHandleIdx_coordV,
        balancedHandleU_ne_core j (by rw [coreVal_three]; omega),
        balancedHandleV_ne_core j (by rw [coreVal_three]; omega)]

/-- The relative `A`-row is the square-and-two-brackets row. -/
theorem oneHandleBalancedCoreRelativeShiftA_apply
    (p : OneHandleBalancedPoint) (k : ℕ) (hk : 3 ≤ k)
    (x : oneHandleRelativeLambdaImage (k - 1) (k + 1)) :
    (oneHandleBalancedCoreRelativeShiftA p k hk x).1 =
      x.1 ^ 2 *
        commP x.1 (levelMk (DM 2 1) (k + 1) (balancedCorrectedMark p 0)) *
        commP x.1 (levelMk (DM 2 1) (k + 1) (balancedCorrectedMark p 1)) := by
  change ((evenRawDepthShiftHom
    (fun i ↦ levelMk (DM 2 1) (k + 1) (balancedCorrectedMark p i)) hk)
      (oneHandleBalancedCoreLevelToRaw (oneHandleBalancedCoreCoordA k x))).1 = _
  rw [oneHandleBalancedCoreLevelToRaw_coordA]
  exact evenRawDepthShiftHom_zero_apply _ hk ⟨x.1, x.2.1⟩

/-- The relative `B`-row is the bracket against the current `A` letter. -/
theorem oneHandleBalancedCoreRelativeShiftB_apply
    (p : OneHandleBalancedPoint) (k : ℕ) (hk : 3 ≤ k)
    (x : oneHandleRelativeLambdaImage (k - 1) (k + 1)) :
    (oneHandleBalancedCoreRelativeShiftB p k hk x).1 =
      commP x.1 (levelMk (DM 2 1) (k + 1) (balancedCorrectedMark p 0)) := by
  change ((evenRawDepthShiftHom
    (fun i ↦ levelMk (DM 2 1) (k + 1) (balancedCorrectedMark p i)) hk)
      (oneHandleBalancedCoreLevelToRaw (oneHandleBalancedCoreCoordB k x))).1 = _
  rw [oneHandleBalancedCoreLevelToRaw_coordB]
  exact evenRawDepthShiftHom_one_apply _ hk ⟨x.1, x.2.1⟩

/-- The character-neutral relative `C`-row is the bracket against the current `D` letter. -/
theorem oneHandleBalancedCoreRelativeShiftC_apply
    (p : OneHandleBalancedPoint) (k : ℕ) (hk : 3 ≤ k)
    (x : oneHandleNeutralRelativeLambdaImage (k - 1) (k + 1)) :
    (oneHandleBalancedCoreRelativeShiftC p k hk x).1 =
      commP x.1 (levelMk (DM 2 1) (k + 1) (balancedCorrectedMark p 3)) := by
  change ((evenRawDepthShiftHom
    (fun i ↦ levelMk (DM 2 1) (k + 1) (balancedCorrectedMark p i)) hk)
      (oneHandleBalancedCoreLevelToRaw (oneHandleBalancedCoreCoordC k x))).1 = _
  rw [oneHandleBalancedCoreLevelToRaw_coordC]
  exact evenRawDepthShiftHom_two_apply _ hk
    ⟨x.1, oneHandleNeutralRelativeLambdaImage_le_lambdaImage _ _ x.2⟩

/-- The relative `D`-row is the bracket against the current `C` letter. -/
theorem oneHandleBalancedCoreRelativeShiftD_apply
    (p : OneHandleBalancedPoint) (k : ℕ) (hk : 3 ≤ k)
    (x : oneHandleRelativeLambdaImage (k - 1) (k + 1)) :
    (oneHandleBalancedCoreRelativeShiftD p k hk x).1 =
      commP x.1 (levelMk (DM 2 1) (k + 1) (balancedCorrectedMark p 2)) := by
  change ((evenRawDepthShiftHom
    (fun i ↦ levelMk (DM 2 1) (k + 1) (balancedCorrectedMark p i)) hk)
      (oneHandleBalancedCoreLevelToRaw (oneHandleBalancedCoreCoordD k x))).1 = _
  rw [oneHandleBalancedCoreLevelToRaw_coordD]
  exact evenRawDepthShiftHom_three_apply _ hk ⟨x.1, x.2.1⟩

/-! ## The exact target-specific coordinate-span boundary -/

/-- Uniform membership of every balanced target in the four constrained coordinate span. -/
def OneHandleBalancedCoreCoordinateSpanSupply
    (Psi0 : ContinuousMulEquiv (DM 2 0) (DM 2 0)) : Prop :=
  ∀ (k : ℕ) (hk : 3 ≤ k) (p : OneHandleBalancedPoint)
    (hp : p ∈ oneHandleBalancedSet Psi0 k),
      oneHandleBalancedCoreRelativeTarget p hp ∈
        oneHandleBalancedCoreCoordinateSpan p k hk

/-- The coordinate-span statement is exactly W209's relative range statement. -/
theorem coordinateSpanSupply_iff_relativeRangeSupply
    (Psi0 : ContinuousMulEquiv (DM 2 0) (DM 2 0)) :
    OneHandleBalancedCoreCoordinateSpanSupply Psi0 ↔
      OneHandleBalancedCoreRelativeRangeSupply Psi0 := by
  constructor <;> intro H k hk p hp
  · rw [oneHandleBalancedCoreRelativeShift_range_eq_coordinateSpan]
    exact H k hk p hp
  · rw [← oneHandleBalancedCoreRelativeShift_range_eq_coordinateSpan]
    exact H k hk p hp

/-- Exact coordinate-span coverage is enough for the one-handle pivot. -/
theorem mpcPivShiftH_two_one_of_balancedCoordinateSpan
    (Psi0 : ContinuousMulEquiv (DM 2 0) (DM 2 0))
    (hchi0 : ∀ x, chiM 2 0 (Psi0 x) = chiM 2 0 x)
    (hrow : ∀ f : ContinuousMonoidHom (DM 2 0) (Multiplicative ℤ_[2]),
      toAdd (f (Psi0 (dmC 2 0))) =
        toAdd (f (dmC 2 0)) + 2 * toAdd (f (dmB 2 0)))
    (Hspan : OneHandleBalancedCoreCoordinateSpanSupply Psi0) :
    MpcPivShiftH 2 1 :=
  mpcPivShiftH_two_one_of_balancedCoreRange Psi0 hchi0 hrow
    ((relativeRangeSupply_iff_rangeSupply Psi0).mp
      ((coordinateSpanSupply_iff_relativeRangeSupply Psi0).mp Hspan))

