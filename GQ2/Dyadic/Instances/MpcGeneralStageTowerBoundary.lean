open GQ2.Dyadic.Instances.MpcGeneralHeadCompletion
open GQ2.Dyadic.Instances.MpcGeneralHeadReflection
open GQ2.Dyadic.Instances.MpcGeneralHeadSpan
open GQ2.Dyadic.Instances.MpcGeneralMarkedSpan
open GQ2.Dyadic.Instances.MpcGeneralMarkedStages
open GQ2.Dyadic.Instances.MpcGeneralTowerAtoms
open GQ2.Dyadic.Instances.MpcGeneralTowerBracketBoundary
open GQ2.Dyadic.Instances.MpcGeneralTowerReduction
open GQ2.Roe.Labute

/-- The stage space actually generated by the correction induction.  In addition to the
marked-stage equations, every letter retains the Frattini class of the universal bare
marking. -/
def mpcGeneralFrattiniStage (alpha h k : ℕ) :
    Set (Fin (coreRank h) → (DM alpha h : Type)) :=
  {m | m ∈ mpcGeneralMarkedStage alpha h k ∧
    ∀ i, (dmGen alpha h i)⁻¹ * m i ∈
      twoCentralSeries (DM alpha h : Type) 2}

/-- The universal bare marking starts the Frattini-controlled ladder. -/
theorem mpcGeneralFrattiniStage_three_nonempty
    {alpha h : ℕ} (halpha : 2 ≤ alpha) :
    (mpcGeneralFrattiniStage alpha h 3).Nonempty := by
  have hstage : mpcBareShiftMark alpha h ∈ mpcGeneralStage alpha h 3 :=
    ⟨mpcBareShiftMark_indep alpha h, mpcBareShiftMark_chi alpha h,
      mpcBareShiftMark_row alpha h, mpcBareShiftMark_rel_three (by omega)⟩
  refine ⟨mpcBareShiftMark alpha h,
    ⟨hstage, mpcGeneralStage_headDelta halpha hstage⟩, ?_⟩
  intro i
  by_cases hi : i = 2
  · subst hi
    rw [mpcBareShiftMark_two]
    change (dmC alpha h)⁻¹ * (dmB alpha h ^ 2 * dmC alpha h) ∈
      twoCentralSeries (DM alpha h : Type) 2
    have hB2 : dmB alpha h ^ 2 ∈ twoCentralSeries (DM alpha h : Type) 2 :=
      sq_mem_twoCentralSeries_succ _ (Subgroup.mem_top _)
    have hconj := (twoCentralSeries_normal (DM alpha h : Type) 2).conj_mem
      (dmB alpha h ^ 2) hB2 (dmC alpha h)⁻¹
    simpa only [inv_inv, mul_assoc] using hconj
  · rw [mpcBareShiftMark_of_ne hi, inv_mul_cancel]
    exact Subgroup.one_mem _

/-- A marked correction preserves the fixed Frattini classes. -/
theorem mpcGeneralFrattiniStage_succ_of_correction
    {alpha h k : ℕ} {m : Fin (coreRank h) → (DM alpha h : Type)}
    (hm : m ∈ mpcGeneralFrattiniStage alpha h k)
    (E : MpcGeneralMarkedStageCorrection m k) (hk : 3 ≤ k) :
    mpcGeneralModify m E.factors ∈
      mpcGeneralFrattiniStage alpha h (k + 1) := by
  refine ⟨mpcGeneralMarkedStage_succ_of_correction hm.1 E hk, ?_⟩
  intro i
  have he : E.factors i ∈ twoCentralSeries (DM alpha h : Type) 2 :=
    twoCentralSeries_antitone (G := (DM alpha h : Type)) (by omega) (E.depth i)
  simpa only [mpcGeneralModify, mul_assoc] using
    Subgroup.mul_mem _ (hm.2 i) he

/-- The finite target-range statement on the Frattini-controlled ladder. -/
def MpcGeneralFrattiniFiniteRangeSupply (alpha h : ℕ) : Prop :=
  ∀ k (hk : 3 ≤ k) m (hm : m ∈ mpcGeneralFrattiniStage alpha h k),
    mpcGeneralLevelTarget hm.1.1 ∈
      (mpcGeneralMarkedLevelShiftHom m k hk).range

/-- Frattini-controlled finite-range supply produces stages at every depth and hence the
general pivot shift. -/
theorem mpcPivShiftH_of_generalFrattiniFiniteRange
    {alpha h : ℕ} (halpha : 2 ≤ alpha)
    (H : MpcGeneralFrattiniFiniteRangeSupply alpha h) :
    GQ2.Dyadic.Instances.MpcGeneralHandlePivotBoundary.MpcPivShiftH alpha h := by
  have hsupply : ∀ k, (mpcGeneralFrattiniStage alpha h k).Nonempty := by
    intro k
    by_cases hk : k ≤ 3
    · obtain ⟨m, hm⟩ := mpcGeneralFrattiniStage_three_nonempty halpha
      exact ⟨m, ⟨mpcGeneralMarkedStage_antitone hk hm.1, hm.2⟩⟩
    · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le (show 3 ≤ k by omega)
      clear hk
      induction d with
      | zero => simpa using mpcGeneralFrattiniStage_three_nonempty halpha
      | succ d ih =>
          obtain ⟨m, hm⟩ := ih
          obtain ⟨E⟩ :=
            (nonempty_mpcGeneralMarkedCorrection_iff_target_mem_range
              halpha hm.1 (by omega)).mpr (H (3 + d) (by omega) m hm)
          exact ⟨mpcGeneralModify m E.factors,
            mpcGeneralFrattiniStage_succ_of_correction hm E (by omega)⟩
  apply mpcPivShiftH_of_finiteStages
  intro k
  obtain ⟨m, hm⟩ := hsupply k
  exact ⟨m, hm.1.1⟩

/-- The exact `C`-absorption statement needed by the induction, restricted to reachable
marked stages. -/
def MpcGeneralStageCAbsorptionSupply (alpha h : ℕ) : Prop :=
  ∀ k (hk : 3 ≤ k) (m : Fin (coreRank h) → (DM alpha h : Type))
    (_hm : m ∈ mpcGeneralFrattiniStage alpha h k)
    (E : MpcGeneralHeadLevelCorrection alpha h k),
    mpcGeneralHeadLevelShiftHom m k hk (mpcGeneralHeadOnlyC E) ∈
      (mpcGeneralMarkedLevelShiftHom m k hk).range

/-- Reachable-stage `C` absorption is sufficient for the controlled finite-range theorem. -/
theorem mpcGeneralFrattiniFiniteRangeSupply_of_stageCAbsorption
    {alpha h : ℕ} (halpha : 2 ≤ alpha)
    (H : MpcGeneralStageCAbsorptionSupply alpha h) :
    MpcGeneralFrattiniFiniteRangeSupply alpha h := by
  intro k hk m hm
  obtain ⟨E, hE⟩ := mpcGeneral_headReflectionSupply halpha k hk m hm.1
  obtain ⟨Q, hQ⟩ := H k hk m hm E
  refine ⟨mpcGeneralHeadWithoutC E * Q, ?_⟩
  rw [map_mul, ← mpcGeneralMarkedLevelToHead_shift]
  change mpcGeneralHeadLevelShiftHom m k hk
      (mpcGeneralMarkedLevelToHead (mpcGeneralHeadWithoutC E)) *
        mpcGeneralMarkedLevelShiftHom m k hk Q = _
  rw [hQ, ← map_mul, mpcGeneralHead_split_C, hE]

/-- Reachable-stage `C` absorption proves the general pivot shift. -/
theorem mpcPivShiftH_of_generalStageCAbsorption
    {alpha h : ℕ} (halpha : 2 ≤ alpha)
    (H : MpcGeneralStageCAbsorptionSupply alpha h) :
    GQ2.Dyadic.Instances.MpcGeneralHandlePivotBoundary.MpcPivShiftH alpha h :=
  mpcPivShiftH_of_generalFrattiniFiniteRange halpha
    (mpcGeneralFrattiniFiniteRangeSupply_of_stageCAbsorption halpha H)

/-- Absorption of the canonical tower word, only at reachable marked stages. -/
def MpcGeneralStageTowerCAbsorptionSupply (alpha h : ℕ) : Prop :=
  ∀ (halpha : 2 ≤ alpha) k (hk : 3 ≤ k)
    (m : Fin (coreRank h) → (DM alpha h : Type))
    (_hm : m ∈ mpcGeneralFrattiniStage alpha h k)
    (x : DM alpha h) (hx : x ∈ twoCentralSeries (DM alpha h : Type) (k - 1))
    (hchi : chiM alpha h x = 1),
    let y := mpcGeneralGroupWord alpha h
      (mpcGeneralChiNeutralVec (by omega : 1 ≤ alpha) x)
    mpcGeneralHeadLevelShiftHom m k hk
        (mpcGeneralHeadSingleC y
          (mpcGeneralGroupWord_mem_depth (by omega)
            (mpcGeneralChiNeutralVec_dvd (by omega) hx))
          (by
            rw [← hchi]
            exact congrArg (GQ2.SectionThree.abLiftG (chiM alpha h))
              (abMk_mpcGeneralChiNeutralWord_eq (by omega) hx (by omega) hchi))) ∈
      (mpcGeneralMarkedLevelShiftHom m k hk).range

/-- The tower-word theorem gives every reachable-stage `C` absorption. -/
theorem mpcGeneralStageCAbsorptionSupply_of_tower
    {alpha h : ℕ} (halpha : 2 ≤ alpha)
    (H : MpcGeneralStageTowerCAbsorptionSupply alpha h) :
    MpcGeneralStageCAbsorptionSupply alpha h := by
  intro k hk m hm E
  obtain ⟨x, hx, hchi, -, hlevel⟩ :=
    (mem_mpcGeneralHeadCorrectionImage_iff_exists (E 2).1).mp (E 2).2
  obtain ⟨d, y, hd, hab, hy, hxy, hydef⟩ :=
    exists_mpcGeneral_derived_mul_tower halpha hx (by omega) hchi
  subst y
  let y := mpcGeneralGroupWord alpha h
    (mpcGeneralChiNeutralVec (by omega : 1 ≤ alpha) x)
  change y ∈ twoCentralSeries (DM alpha h : Type) (k - 1) at hy
  change x = d * y at hxy
  have hchid : chiM alpha h d = 1 := by
    have Hd := congrArg (GQ2.SectionThree.abLiftG (chiM alpha h)) hab
    simpa only [GQ2.SectionThree.abLiftG_abMk, map_one] using Hd
  have hchiy : chiM alpha h y = 1 := by
    rw [← hchi, hxy, map_mul, hchid, one_mul]
  have hsingle : mpcGeneralHeadOnlyC E =
      mpcGeneralHeadSingleC x hx hchi := by
    classical
    funext i
    apply Subtype.ext
    by_cases hi : i = 2
    · subst hi
      simpa [mpcGeneralHeadOnlyC, mpcGeneralHeadSingleC] using hlevel.symm
    · simp [mpcGeneralHeadOnlyC, mpcGeneralHeadSingleC, hi]
  have hsplit : mpcGeneralHeadSingleC x hx hchi =
      mpcGeneralHeadSingleC d hd hchid *
        mpcGeneralHeadSingleC y hy hchiy := by
    classical
    funext i
    apply Subtype.ext
    by_cases hi : i = 2
    · subst hi
      simp [mpcGeneralHeadSingleC, map_mul, hxy]
    · simp [mpcGeneralHeadSingleC, hi]
  obtain ⟨Q, hQ⟩ := H halpha k hk m hm x hx hchi
  refine ⟨mpcGeneralMarkedSingleC d hd hab * Q, ?_⟩
  rw [map_mul, ← mpcGeneralMarkedLevelToHead_shift]
  rw [mpcGeneralMarkedSingleC_toHead]
  change mpcGeneralHeadLevelShiftHom m k hk
      (mpcGeneralHeadSingleC d hd hchid) *
      mpcGeneralMarkedLevelShiftHom m k hk Q = _
  rw [hQ, ← map_mul, ← hsplit, ← hsingle]

/-- Atomic tower absorption on the reachable stage space. -/
def MpcGeneralStageTowerAtomAbsorptionSupply (alpha h : ℕ) : Prop :=
  ∀ (halpha : 2 ≤ alpha) k (hk : 3 ≤ k)
    (m : Fin (coreRank h) → (DM alpha h : Type))
    (_hm : m ∈ mpcGeneralFrattiniStage alpha h k)
    (x : DM alpha h) (hx : x ∈ twoCentralSeries (DM alpha h : Type) (k - 1))
    (hchi : chiM alpha h x = 1) (i : Fin (coreRank h)),
    mpcGeneralHeadLevelShiftHom m k hk
        (mpcGeneralHeadSingleCHom alpha h k
          ⟨mpcGeneralTowerAtom (by omega) x i,
            mpcGeneralTowerAtom_mem halpha hk hx hchi i⟩) ∈
      (mpcGeneralMarkedLevelShiftHom m k hk).range

/-- Atomic absorption gives tower-word absorption at every reachable stage. -/
theorem mpcGeneralStageTowerCAbsorptionSupply_of_atoms
    {alpha h : ℕ} (H : MpcGeneralStageTowerAtomAbsorptionSupply alpha h) :
    MpcGeneralStageTowerCAbsorptionSupply alpha h := by
  intro halpha k hk m hm x hx hchi
  let A : Fin (coreRank h) →
      ↥(twoCentralSeries (DM alpha h : Type) (k - 1) ⊓
        mpcGeneralChiKer alpha h) := fun i =>
    ⟨mpcGeneralTowerAtom (by omega) x i,
      mpcGeneralTowerAtom_mem halpha hk hx hchi i⟩
  have hprod : ((List.ofFn A).prod : DM alpha h) =
      mpcGeneralGroupWord alpha h
        (mpcGeneralChiNeutralVec (by omega) x) := by
    change (twoCentralSeries (DM alpha h : Type) (k - 1) ⊓
      mpcGeneralChiKer alpha h).subtype (List.ofFn A).prod = _
    rw [map_list_prod, List.map_ofFn]
    exact mpcGeneralTowerAtoms_prod (by omega) x
  have hychi : chiM alpha h
      (mpcGeneralGroupWord alpha h (mpcGeneralChiNeutralVec (by omega) x)) = 1 := by
    rw [← hchi]
    exact congrArg (GQ2.SectionThree.abLiftG (chiM alpha h))
      (abMk_mpcGeneralChiNeutralWord_eq halpha hx (by omega) hchi)
  change mpcGeneralHeadLevelShiftHom m k hk
      (mpcGeneralHeadSingleC _ _ _) ∈ _
  have hsingle : mpcGeneralHeadSingleC
      (mpcGeneralGroupWord alpha h (mpcGeneralChiNeutralVec (by omega) x))
        (mpcGeneralGroupWord_mem_depth (by omega)
          (mpcGeneralChiNeutralVec_dvd (by omega) hx))
        hychi = mpcGeneralHeadSingleCHom alpha h k (List.ofFn A).prod := by
    funext i
    apply Subtype.ext
    by_cases hi : i = 2
    · subst hi
      simpa [mpcGeneralHeadSingleC, mpcGeneralHeadSingleCHom] using
        congrArg (levelMk (DM alpha h) (k + 1)) hprod.symm
    · simp [mpcGeneralHeadSingleC, mpcGeneralHeadSingleCHom, hi]
  rw [hsingle, map_list_prod, map_list_prod]
  apply Subgroup.list_prod_mem
  intro z hz
  rw [List.mem_map] at hz
  obtain ⟨a, ha, rfl⟩ := hz
  rw [List.mem_map] at ha
  obtain ⟨i, hi, rfl⟩ := ha
  rw [List.mem_ofFn] at hi
  obtain ⟨j, rfl⟩ := hi
  exact H halpha k hk m hm x hx hchi j

/-- The precise remaining reachable-stage boundary, in explicit bracket form. -/
def MpcGeneralStageTowerAtomBracketSupply (alpha h : ℕ) : Prop :=
  ∀ (halpha : 2 ≤ alpha) k (hk : 3 ≤ k)
    (m : Fin (coreRank h) → (DM alpha h : Type))
    (_hm : m ∈ mpcGeneralFrattiniStage alpha h k)
    (x : DM alpha h) (hx : x ∈ twoCentralSeries (DM alpha h : Type) (k - 1))
    (hchi : chiM alpha h x = 1) (i : Fin (coreRank h)),
    let a := mpcGeneralTowerAtom (by omega : 1 ≤ alpha) x i
    let ha := (mpcGeneralTowerAtom_mem halpha hk hx hchi i).1
    (⟨commP (levelMk (DM alpha h) (k + 1) a)
        (levelMk (DM alpha h) (k + 1) (m 3)),
      commP_mem_zLayer k hk ⟨a, ha, rfl⟩ _⟩ : zLayer (DM alpha h) k) ∈
        (mpcGeneralMarkedLevelShiftHom m k hk).range

/-- On reachable stages, atomic absorption is exactly the explicit bracket statement. -/
theorem mpcGeneralStageTowerAtomAbsorptionSupply_iff_brackets {alpha h : ℕ} :
    MpcGeneralStageTowerAtomAbsorptionSupply alpha h ↔
      MpcGeneralStageTowerAtomBracketSupply alpha h := by
  constructor
  · intro H halpha k hk m hm x hx hchi i
    dsimp only
    have Hi := H halpha k hk m hm x hx hchi i
    rw [show (⟨commP
          (levelMk (DM alpha h) (k + 1)
            (mpcGeneralTowerAtom (by omega) x i))
          (levelMk (DM alpha h) (k + 1) (m 3)), _⟩ : zLayer (DM alpha h) k) =
        mpcGeneralHeadLevelShiftHom m k hk
          (mpcGeneralHeadSingleCHom alpha h k
            ⟨mpcGeneralTowerAtom (by omega) x i,
              mpcGeneralTowerAtom_mem halpha hk hx hchi i⟩) by
      apply Subtype.ext
      symm
      exact mpcGeneralHeadSingleC_shift_apply m hk _
        (mpcGeneralTowerAtom_mem halpha hk hx hchi i).1
        (MonoidHom.mem_ker.mp
          (mpcGeneralTowerAtom_mem halpha hk hx hchi i).2)]
    exact Hi
  · intro H halpha k hk m hm x hx hchi i
    have Hi := H halpha k hk m hm x hx hchi i
    rw [show mpcGeneralHeadLevelShiftHom m k hk
          (mpcGeneralHeadSingleCHom alpha h k
            ⟨mpcGeneralTowerAtom (by omega) x i,
              mpcGeneralTowerAtom_mem halpha hk hx hchi i⟩) =
        (⟨commP
          (levelMk (DM alpha h) (k + 1)
            (mpcGeneralTowerAtom (by omega) x i))
          (levelMk (DM alpha h) (k + 1) (m 3)), _⟩ : zLayer (DM alpha h) k) by
      apply Subtype.ext
      exact mpcGeneralHeadSingleC_shift_apply m hk _
        (mpcGeneralTowerAtom_mem halpha hk hx hchi i).1
        (MonoidHom.mem_ker.mp
          (mpcGeneralTowerAtom_mem halpha hk hx hchi i).2)]
    exact Hi

/-- The reachable-stage bracket theorem proves the general pivot shift. -/
theorem mpcPivShiftH_of_generalStageTowerBrackets
    {alpha h : ℕ} (halpha : 2 ≤ alpha)
    (H : MpcGeneralStageTowerAtomBracketSupply alpha h) :
    GQ2.Dyadic.Instances.MpcGeneralHandlePivotBoundary.MpcPivShiftH alpha h :=
  mpcPivShiftH_of_generalStageCAbsorption halpha
    (mpcGeneralStageCAbsorptionSupply_of_tower halpha
      (mpcGeneralStageTowerCAbsorptionSupply_of_atoms
        ((mpcGeneralStageTowerAtomAbsorptionSupply_iff_brackets).mpr H)))

end

