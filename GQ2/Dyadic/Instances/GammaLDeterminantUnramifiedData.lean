import GQ2.Dyadic.Instances.GammaLDeterminantHeadPhase

/-!
# The unramified head graph datum and its phase model

`LUnramifiedGraphData` (`GammaLDeterminantUnramified`) asks for `rho0 DD rho tau = 1` and
`rho0 DD rho (x_i) = 1` in `DD.C0`.  At the block enrichment `DD.C0` is the recursion frame's
`Y ⧸ K` and `rho0` is a *surjective* boundary lift, so those equations force `Y ⧸ K` to be
generated by the images of `sigma` and `tau` alone — a condition the certificate never supplies.
`LUnramifiedHeadData` is the same datum one level down, at the faithful head quotient: exactly
the statements the closed `ℚ₂` twins prove (`GQ2.SectionNine.blockProjF_thetaGR_x0` etc.).

`lSqUnramifiedPhaseModel_of_headData` is then the verbatim analogue of
`lSqUnramifiedPhaseModel_of_graphData`: the source comparison comes from the head-factored
graph normal form, and the sign is Proposition 6.9 at the finite action image, which is
cyclic because the head kills `tau` and every wild letter.
-/

namespace GQ2.Dyadic.LSquare

noncomputable section

open GQ2 GQ2.SectionEight
open SectionSeven AffineTLift CentralObstruction ContCoh FoxH
open GQ2.Dyadic GQ2.Dyadic.Words GQ2.Dyadic.Words.LSq
open GQ2.Dyadic.Certificates GQ2.Dyadic.Certificates.LSqStokes
open GQ2.Dyadic.Count
open GQ2.QuadraticFp2

local instance finiteSemiProdHeadDet {C V : Type} [Group C] [AddCommGroup V]
    [DistribMulAction C V] [Finite V] [Finite C] :
    Finite (SectionSix.SemiProd C V) := inferInstanceAs (Finite (V × C))

/-! ## The unramified specialization of the head comparison -/

set_option maxHeartbeats 1600000 in
/-- Closed unramified source phase comparison at the coefficient-independent uniform `C0` word,
with every lower marking condition taken after `π`.  Head-factored twin of
`sourceWordPhaseComparison_of_lSqUnramified_uniform`. -/
noncomputable def sourceWordPhaseComparison_of_lSqUnramifiedHead
    {h q : ℕ}
    {Bg : Type} [Group Bg] [Finite Bg] [TopologicalSpace Bg] [DiscreteTopology Bg]
    {D : RadicalCoverData Bg} {DD : DescData D}
    (rho : ContinuousMonoidHom ((gamma h q : Type)) (Bg ⧸ D.M))
    [TopologicalSpace DD.Vmod] [IsTopologicalAddGroup DD.Vmod]
    [DiscreteTopology DD.Vmod] [TopologicalSpace DD.C0] [DiscreteTopology DD.C0]
    [DistribMulAction ((gamma h q : Type)) DD.Vmod]
    [ContinuousSMul ((gamma h q : Type)) DD.Vmod]
    {Cbar : Type} [Group Cbar] [DistribMulAction Cbar DD.Vmod]
    (base : FactorSet Cbar DD.Vmod) (hbase : IsEquivariantFactorSet DD.qbar base)
    (π : DD.C0 →* Cbar) (hpi : ∀ (cc : DD.C0) (v : DD.Vmod), cc • v = π cc • v)
    (hf : ∀ a b : DD.Vmod, DD.dat.f a b = base.f a b)
    (hm : ∀ (cc : DD.C0) (v : DD.Vmod), DD.dat.m cc v = base.m (π cc) v)
    (hcompat : ∀ (g : (gamma h q : Type)) (v : DD.Vmod),
      g • v = rho0 DD rho g • v)
    (hA2 : ∀ v : DD.Vmod, v + v = 0)
    (hwildTwo : IsWildTwo (wildAlphabet (2 * h + 1))
      (fun i ↦ Count.rho0Continuous DD rho
        (gammaGen (2 * h + 1) q (lSqW h) i)))
    (hq : Even q)
    (htauHead : π (rho0 DD rho (gammaGen (2 * h + 1) q (lSqW h) .tau)) = 1)
    (hwildHead : ∀ i : Fin (2 * h + 1 + 1),
      π (rho0 DD rho (gammaGen (2 * h + 1) q (lSqW h) (.wild i))) = 1)
    (hsfpf : ∀ v : DD.Vmod,
      π (rho0 DD rho (gammaGen (2 * h + 1) q (lSqW h) .sigma)) • v = v → v = 0) :
    letI : TopologicalSpace (ZMod 2) := ⊥
    letI : DiscreteTopology (ZMod 2) := ⟨rfl⟩
    letI : DistribMulAction ((gamma h q : Type)) (ZMod 2) :=
      scalarActionZmodTwo ((gamma h q : Type))
    letI : ContinuousSMul ((gamma h q : Type)) (ZMod 2) :=
      scalarActionZmodTwo_continuousSMul ((gamma h q : Type))
    letI : Fintype DD.Vmod := Fintype.ofFinite DD.Vmod
    SourceWordPhaseComparison DD rho (scalarActionZmodTwo_triv _)
      (DD.Vmod × (Fin h → DD.Vmod × DD.Vmod))
      (lSqWallHandlePhase DD.qbar
        (smulAddEquiv
          ((π (rho0 DD rho (gammaGen (2 * h + 1) q (lSqW h) .sigma)) ^
            (omega2Exp
              (4 * Monoid.exponent
                (SectionSix.SemiProd DD.C0 DD.Vmod)) : ℤ))⁻¹)) h) := by
  let e := omega2Exp (4 * Monoid.exponent DD.C0)
  let theta := Count.rho0Continuous DD rho
  let t : Marking (2 * h + 1) DD.C0 :=
    ⟨fun i ↦ theta (gammaGen (2 * h + 1) q (lSqW h) i)⟩
  have hbaseOrd : ∀ g : DD.C0, orderOf g ∣ Monoid.exponent DD.C0 :=
    fun g ↦ Monoid.order_dvd_exponent g
  have horder : ∀ p : WordLift DD.Vmod DD.C0,
      orderOf p ∣ 4 * Monoid.exponent DD.C0 := fun p ↦
    (WordLift.orderOf_dvd_two_mul hA2 hbaseOrd p).trans ⟨2, by ring⟩
  have hres : ResolvesAt
      (gammaFam (2 * h + 1) q (lSqW h))
      (lSqFam h q e) (WordLift DD.Vmod DD.C0) :=
    Count.resolvesAt_lSqFam
      (Count.fourMulExponent_ne_zero_and_even DD.C0).1 horder h q
  have htauAct : ∀ v : DD.Vmod, t.τ • v = v := by
    intro v
    change rho0 DD rho (gammaGen (2 * h + 1) q (lSqW h) .tau) • v = v
    rw [hpi, htauHead, one_smul]
  have hwildAct : ∀ (i : Fin (2 * h + 1 + 1)) (v : DD.Vmod), t.x i • v = v := by
    intro i v
    change rho0 DD rho (gammaGen (2 * h + 1) q (lSqW h) (.wild i)) • v = v
    rw [hpi, hwildHead i, one_smul]
  have hsfpf' : ∀ v : DD.Vmod, t.σ • v = v → v = 0 := by
    intro v hv
    apply hsfpf v
    rw [← hpi]
    exact hv
  have hmem : ∀ p : DD.Vmod × (Fin h → DD.Vmod × DD.Vmod),
      heisD1
        (fun i ↦ theta (gammaGen (2 * h + 1) q (lSqW h) i))
        (lSqFam h q e) (lSqPhaseNormal h p) = 0 :=
    heisD1_lSqPhaseNormal_eq_zero_unramified
      t hA2 hq (resolverLifts_uniformWordLift hA2) hwildAct htauAct
  have hnf : ∀ x,
      heisD1
        (fun i ↦ theta (gammaGen (2 * h + 1) q (lSqW h) i))
        (lSqFam h q e) x = 0 →
      ∃! p : DD.Vmod × (Fin h → DD.Vmod × DD.Vmod),
        x - lSqPhaseNormal h p ∈ Set.range
          (heisD0 (A := DD.Vmod)
            (fun i ↦ theta (gammaGen (2 * h + 1) q (lSqW h) i))) :=
    lSqFam_unramified_phaseNormalForm
      t hA2 hq (resolverLifts_uniformWordLift hA2) hwildAct htauAct hsfpf'
  exact sourceWordPhaseComparison_of_lSqHeadNormalForm rho base hbase π hpi hf hm
    hcompat hres hA2 hwildTwo hq hwildHead hmem hnf

/-! ## Why the `C0`-level datum has no producer -/

/-- **No-go for the `C0`-level graph datum at a boundary lift.**

`LUnramifiedGraphData.tau_eq`/`wild_eq` (and `LRamifiedGraphData.wild_eq`) ask for the lower
marking to die in `DD.C0`.  At the block enrichment `DD.C0` is the recursion frame's `Y ⧸ K` and
`rho0` is the boundary lift itself, which is *surjective*; so those equations force the entire
`C`-stage to be procyclic on the image of `sigma`.

`AffineDeterminantCertificate` quantifies over all marked targets and all boundary lifts, and its
side conditions (`hsimple`, `hVne`, `hnt`, `hcard`) constrain only the *action* on `V`, never the
target itself.  Hence the `C0`-level datum is not derivable there, and the correct level is the
faithful head quotient — exactly what the closed `ℚ₂` twins prove
(`GQ2.SectionNine.blockProjF_thetaGR_x0`, `…_tau`), and what `LUnramifiedHeadData` records. -/
theorem yc_procyclic_of_c0_graphData
    {h q : ℕ} {P : ProfiniteGrp} {nuP : ContinuousMonoidHom P Ztwo}
    {H E : Type} [Group H] [TopologicalSpace H] [DiscreteTopology H] [Finite H]
    [CommGroup E] [TopologicalSpace E] [DiscreteTopology E] [Finite E]
    {Y : Type} [Group Y] [TopologicalSpace Y] [DiscreteTopology Y] [Finite Y]
    {T : MarkedTarget H E Y} {Blk : SectionSeven.MinimalBlock T.LY}
    [Blk.frattiniK.Normal] [(Blk.S.subgroupOf Blk.P).Normal] [Blk.K.Normal]
    {hE2 : ∀ e : E, e ^ 2 = 1} {F : BoundaryFrameK q P H E}
    {b : ContinuousMonoidHom ((gamma h q : Type)) ↥(boundarySubgroupQ q nuP)}
    (rho : BoundaryLiftsK b F (SectionNine.blockFrame T Blk hE2).TC)
    (htau : rho.1.1 (gammaGen (2 * h + 1) q (lSqW h) .tau) = 1)
    (hwild : ∀ i : Fin (2 * h + 1 + 1),
      rho.1.1 (gammaGen (2 * h + 1) q (lSqW h) (.wild i)) = 1) :
    ∀ x : (SectionNine.blockFrame T Blk hE2).YC,
      x ∈ Subgroup.zpowers (rho.1.1 (gammaGen (2 * h + 1) q (lSqW h) .sigma)) := by
  have hgen := (isAdmissibleMarkedPresentation_gammaR (2 * h + 1) q (lSqW h)).gen_top
  have hmap := TopGen.map (f := rho.1.1.toMonoidHom) rho.1.1.continuous_toFun rho.1.2 hgen
  have hclosure := TopGen.gen_of_discrete hmap
  have hsub : (⇑rho.1.1.toMonoidHom '' Set.range (gammaGen (2 * h + 1) q (lSqW h)))
      ⊆ (Subgroup.zpowers (rho.1.1 (gammaGen (2 * h + 1) q (lSqW h) .sigma)) : Set _) := by
    rintro _ ⟨_, ⟨g, rfl⟩, rfl⟩
    show rho.1.1 (gammaGen (2 * h + 1) q (lSqW h) g) ∈
      Subgroup.zpowers (rho.1.1 (gammaGen (2 * h + 1) q (lSqW h) .sigma))
    cases g with
    | sigma => exact Subgroup.mem_zpowers _
    | tau => rw [htau]; exact Subgroup.one_mem _
    | wild i => rw [hwild i]; exact Subgroup.one_mem _
  have hle := (Subgroup.closure_le _).mpr hsub
  rw [hclosure] at hle
  exact fun x => hle (Subgroup.mem_top x)

/-! ## The head graph datum -/

/-- The representation-theoretic input to the unramified source/word comparison, stated at the
faithful head quotient.  This is `LUnramifiedGraphData` with each lower marking equation moved
past `π`; the `sigma` value is not recorded separately because the phase already names it as
`π (rho0 sigma)`. -/
structure LUnramifiedHeadData
    {h q : ℕ}
    {Bg : Type} [Group Bg] [Finite Bg] [TopologicalSpace Bg] [DiscreteTopology Bg]
    {D : RadicalCoverData Bg} {DD : DescData D}
    (rho : ContinuousMonoidHom ((gamma h q : Type)) (Bg ⧸ D.M))
    [TopologicalSpace DD.C0] [DiscreteTopology DD.C0]
    {Cbar : Type} [Group Cbar] [DistribMulAction Cbar DD.Vmod]
    (π : DD.C0 →* Cbar) where
  tau_head : π (rho0 DD rho (gammaGen (2 * h + 1) q (lSqW h) .tau)) = 1
  wild_head : ∀ i : Fin (2 * h + 1 + 1),
    π (rho0 DD rho (gammaGen (2 * h + 1) q (lSqW h) (.wild i))) = 1
  sigma_fixedPointFree : ∀ v : DD.Vmod,
    π (rho0 DD rho (gammaGen (2 * h + 1) q (lSqW h) .sigma)) • v = v → v = 0
  wildTwo : IsWildTwo (wildAlphabet (2 * h + 1))
    (fun i ↦ Count.rho0Continuous DD rho
      (gammaGen (2 * h + 1) q (lSqW h) i))

set_option maxHeartbeats 2400000 in
/-- The complete unramified phase model at one finite descended representation, from head-level
data.  Verbatim analogue of `lSqUnramifiedPhaseModel_of_graphData`: the source comparison is the
head-factored graph normal form, and the sign is Proposition 6.9 applied to the finite action
image, which the head data makes cyclic. -/
theorem lSqUnramifiedPhaseModel_of_headData
    {h q : ℕ}
    {Bg : Type} [Group Bg] [Finite Bg] [TopologicalSpace Bg] [DiscreteTopology Bg]
    {D : RadicalCoverData Bg} {DD : DescData D}
    (rho : ContinuousMonoidHom ((gamma h q : Type)) (Bg ⧸ D.M))
    [TopologicalSpace DD.Vmod] [IsTopologicalAddGroup DD.Vmod]
    [DiscreteTopology DD.Vmod] [TopologicalSpace DD.C0] [DiscreteTopology DD.C0]
    [DistribMulAction ((gamma h q : Type)) DD.Vmod]
    [ContinuousSMul ((gamma h q : Type)) DD.Vmod]
    {Cbar : Type} [Group Cbar] [DistribMulAction Cbar DD.Vmod]
    (base : FactorSet Cbar DD.Vmod) (hbase : IsEquivariantFactorSet DD.qbar base)
    (π : DD.C0 →* Cbar) (hpi : ∀ (cc : DD.C0) (v : DD.Vmod), cc • v = π cc • v)
    (hf : ∀ a b : DD.Vmod, DD.dat.f a b = base.f a b)
    (hm : ∀ (cc : DD.C0) (v : DD.Vmod), DD.dat.m cc v = base.m (π cc) v)
    (hcompat : ∀ (g : (gamma h q : Type)) (v : DD.Vmod),
      g • v = rho0 DD rho g • v)
    (hA2 : ∀ v : DD.Vmod, v + v = 0)
    (hsimple : IsSimpleModTwo (gamma h q : Type) DD.Vmod)
    (hq : Even q) (m : ℕ) (hm1 : 1 ≤ m)
    (hcard : Nat.card DD.Vmod = 2 ^ (2 * m))
    (G : LUnramifiedHeadData (DD := DD) rho π) :
    letI : Fintype DD.Vmod := Fintype.ofFinite DD.Vmod
    letI : DistribMulAction ((gamma h q : Type)) (ZMod 2) :=
      scalarActionZmodTwo ((gamma h q : Type))
    ∃ (W : Type) (_ : Fintype W) (Q : W → ZMod 2),
      Nonempty (SourceWordPhaseComparison DD rho (scalarActionZmodTwo_triv _) W Q) ∧
      QuadraticFp2.gaussSum Q = (standardNumerics (2 * h + 1)).gaussUnram m := by
  letI : Fintype DD.Vmod := Fintype.ofFinite DD.Vmod
  letI : Module (ZMod 2) DD.Vmod :=
    AddCommGroup.zmodModule (fun v => by rw [two_nsmul]; exact hA2 v)
  letI : DistribMulAction ((gamma h q : Type)) (ZMod 2) :=
    scalarActionZmodTwo ((gamma h q : Type))
  let AI := FiniteActionImage h q DD.Vmod
  let t := finiteActionImageMarking h q DD.Vmod
  let s := π (rho0 DD rho (gammaGen (2 * h + 1) q (lSqW h) .sigma))
  have htau : t.τ = 1 := by
    apply finiteActionImage_eq_one_of_smul_eq
    intro v
    change gammaGen (2 * h + 1) q (lSqW h) .tau • v = v
    rw [hcompat, hpi, G.tau_head, one_smul]
  have hwild : ∀ i : Fin (2 * h + 1 + 1), t.x i = 1 := by
    intro i
    apply finiteActionImage_eq_one_of_smul_eq
    intro v
    change gammaGen (2 * h + 1) q (lSqW h) (.wild i) • v = v
    rw [hcompat, hpi, G.wild_head i, one_smul]
  have hgen : ∀ x : AI, x ∈ Subgroup.zpowers t.σ := by
    have hle : Subgroup.closure
        (Set.range (finiteActionImageGenerators h q DD.Vmod)) ≤ Subgroup.zpowers t.σ := by
      rw [Subgroup.closure_le]
      rintro _ ⟨i, rfl⟩
      cases i with
      | sigma => exact Subgroup.mem_zpowers _
      | tau => change t.τ ∈ Subgroup.zpowers t.σ; rw [htau]; exact Subgroup.one_mem _
      | wild i =>
          change t.x i ∈ Subgroup.zpowers t.σ
          rw [hwild i]
          exact Subgroup.one_mem _
    rw [finiteActionImageGenerators_generate] at hle
    exact fun x ↦ hle (Subgroup.mem_top x)
  have hsimpleAI : IsSimpleModTwo AI DD.Vmod :=
    isSimpleModTwo_finiteActionImage hsimple
  have hfaith : ∀ a : AI, (∀ v : DD.Vmod, a • v = v) → a = 1 :=
    finiteActionImage_eq_one_of_smul_eq
  have hinv : ∀ (a : AI) (v : DD.Vmod), DD.qbar (a • v) = DD.qbar v := by
    intro a v
    obtain ⟨g, rfl⟩ :=
      (finiteActionHom (G := (gamma h q : Type))
        (M := DD.Vmod)).toMonoidHom.rangeRestrict_surjective a
    change DD.qbar (g • v) = DD.qbar v
    rw [hcompat]
    exact factorSet_q_invariant DD.dat DD.hdat hA2 (rho0 DD rho g) v
  have hsigma2 : ∀ v : DD.Vmod, powOmega2 t.σ • v = v := by
    apply pow2_smul_trivial_of_stable hA2 hsimpleAI (powOmega2 t.σ)
      (isPGroup_zpowers_powOmega2 t.σ)
    intro a v hv
    have hc : powOmega2 t.σ * a = a * powOmega2 t.σ :=
      comm_of_cyclic t.σ hgen _ _
    calc
      powOmega2 t.σ • (a • v) = (powOmega2 t.σ * a) • v :=
        (mul_smul _ _ _).symm
      _ = (a * powOmega2 t.σ) • v := by rw [hc]
      _ = a • (powOmega2 t.σ • v) := mul_smul _ _ _
      _ = a • v := congrArg (a • ·) hv
  let L := SectionSix.SemiProd DD.C0 DD.Vmod
  let N := 4 * Monoid.exponent L
  have hN : N ≠ 0 := (Count.fourMulExponent_ne_zero_and_even L).1
  have htsigma : ∀ v : DD.Vmod, t.σ • v = s • v := by
    intro v
    change gammaGen (2 * h + 1) q (lSqW h) .sigma • v = s • v
    rw [hcompat, hpi]
  have hpow : ∀ (k : ℕ) (v : DD.Vmod), t.σ ^ k • v = s ^ k • v := by
    intro k
    induction k with
    | zero => intro v; simp
    | succ k ih =>
        intro v
        rw [pow_succ, pow_succ, mul_smul, mul_smul, htsigma, ih]
  have hc0Exp : rho0 DD rho (gammaGen (2 * h + 1) q (lSqW h) .sigma) ^ Monoid.exponent L = 1 := by
    let p : L := (0, rho0 DD rho (gammaGen (2 * h + 1) q (lSqW h) .sigma))
    have hp : p ^ Monoid.exponent L = 1 := Monoid.pow_exponent_eq_one p
    calc
      rho0 DD rho (gammaGen (2 * h + 1) q (lSqW h) .sigma) ^ Monoid.exponent L =
          sdSnd (p ^ Monoid.exponent L) := (map_pow sdSnd p _).symm
      _ = 1 := by rw [hp]; exact map_one sdSnd
  have hsExp : s ^ Monoid.exponent L = 1 := by
    change π (rho0 DD rho (gammaGen (2 * h + 1) q (lSqW h) .sigma)) ^ Monoid.exponent L = 1
    rw [← map_pow, hc0Exp, map_one]
  have hsN : s ^ N = 1 := by
    rw [show N = Monoid.exponent L * 4 by simp [N, Nat.mul_comm], pow_mul, hsExp, one_pow]
  have htN : t.σ ^ N = 1 := by
    apply finiteActionImage_eq_one_of_smul_eq
    intro v
    rw [hpow, hsN, one_smul]
  have hord : orderOf t.σ ∣ N := orderOf_dvd_of_pow_eq_one htN
  have hresolved : t.σ ^ omega2Exp N = powOmega2 t.σ :=
    powOmega2_pow_eq t.σ hord hN
  have hsUniform : ∀ v : DD.Vmod, s ^ omega2Exp N • v = v := by
    intro v
    rw [← hpow, hresolved]
    exact hsigma2 v
  have hU : ∀ v : DD.Vmod,
      smulAddEquiv ((s ^ (omega2Exp N : ℤ))⁻¹) v = v := by
    intro v
    change (s ^ (omega2Exp N : ℤ))⁻¹ • v = v
    rw [zpow_natCast]
    have hv := hsUniform v
    calc
      (s ^ omega2Exp N)⁻¹ • v =
          (s ^ omega2Exp N)⁻¹ •
            ((s ^ omega2Exp N) • v) := congrArg ((s ^ omega2Exp N)⁻¹ • ·) hv.symm
      _ = v := inv_smul_smul _ _
  let Q : DD.Vmod × (Fin h → DD.Vmod × DD.Vmod) → ZMod 2 :=
    lSqWallHandlePhase DD.qbar (smulAddEquiv ((s ^ (omega2Exp N : ℤ))⁻¹)) h
  let C : SourceWordPhaseComparison DD rho (scalarActionZmodTwo_triv _)
      (DD.Vmod × (Fin h → DD.Vmod × DD.Vmod)) Q :=
    sourceWordPhaseComparison_of_lSqUnramifiedHead rho base hbase π hpi hf hm hcompat hA2
      G.wildTwo hq G.tau_head G.wild_head G.sigma_fixedPointFree
  refine ⟨DD.Vmod × (Fin h → DD.Vmod × DD.Vmod), inferInstance, Q, ⟨C⟩, ?_⟩
  exact (lSqWallHandlePhase_unramified_of_cyclic DD.hquad DD.hns hA2 m hm1
    (by simpa only [Nat.card_eq_fintype_card] using hcard)
    t.σ hgen hfaith hsimpleAI.2 hinv
    (smulAddEquiv ((s ^ (omega2Exp N : ℤ))⁻¹)) hU h).2

/-! ## Boundary-lift packaging: the head data is a theorem at the block enrichment -/

set_option maxHeartbeats 2400000 in
/-- **The unramified word phase for the improved L presentation, with no per-lift input.**

At the head-inflated block enrichment every field of `LUnramifiedHeadData` is a theorem:

* the head factorization `boundaryLift_headK` tame-factors every boundary lift, so the lower
  values of `tau` and of the wild letters are the *fixed* `α`-images of their tame values;
* `hunram` says `α(τ_q)` acts trivially, i.e. it lies in `headActKer`, so `tau` dies in `H_V`;
* the tame specialization kills the wild letters, so they die in `H_V` as well;
* `H_V` is generated by the tame pair (`hv_genK`), hence by `σ` alone, so a `σ`-fixed vector is
  `C₀`-fixed and `hfix_of_simple_nt` kills it.

This is the exact analogue of the closed `ℚ₂` twin `gaussZResidueD_gammaR_unramified`, and it
replaces `wordPhaseResidueK_unramified_of_graphData`'s per-lift `LUnramifiedGraphData` binder. -/
theorem wordPhaseResidueK_unramified_lSq
    {h q : ℕ} {P : ProfiniteGrp} {nuP : ContinuousMonoidHom P Ztwo}
    {H E : Type} [Group H] [TopologicalSpace H] [DiscreteTopology H] [Finite H]
    [CommGroup E] [TopologicalSpace E] [DiscreteTopology E] [Finite E]
    {Y : Type} [Group Y] [TopologicalSpace Y] [DiscreteTopology Y] [Finite Y]
    (T : MarkedTarget H E Y) (Blk : SectionSeven.MinimalBlock T.LY)
    [Blk.frattiniK.Normal] [(Blk.S.subgroupOf Blk.P).Normal] [Blk.K.Normal]
    (hE2 : ∀ e : E, e ^ 2 = 1) (hq0 : q ≠ 0) (hqe : Even q)
    (F : BoundaryFrameK q P H E)
    (tame : ContinuousMonoidHom (gamma h q) (Tq q))
    (pro2 : ContinuousMonoidHom (gamma h q) P)
    (compat : ∀ g : (gamma h q : Type), nuTq q (tame g) = nuP (pro2 g))
    (htameSigma : tame (gammaGen (2 * h + 1) q (lSqW h) .sigma) = tqSigma q)
    (htameTau : tame (gammaGen (2 * h + 1) q (lSqW h) .tau) = tqTau q)
    (htameWild : ∀ i : Fin (2 * h + 1 + 1),
      tame (gammaGen (2 * h + 1) q (lSqW h) (.wild i)) = 1)
    (hsimple : ∀ W : AddSubgroup (blockEnrichmentDK T Blk hE2 hq0 hqe F).Vmod,
      (∀ g : (SectionNine.blockFrame T Blk hE2).YC, ∀ w ∈ W, g • w ∈ W) →
        W = ⊥ ∨ W = ⊤)
    (hVne : ∃ v : (blockEnrichmentDK T Blk hE2 hq0 hqe F).Vmod, v ≠ 0)
    (hnt : ∃ (g : (SectionNine.blockFrame T Blk hE2).YC)
      (v : (blockEnrichmentDK T Blk hE2 hq0 hqe F).Vmod), g • v ≠ v)
    (m : ℕ) (hm : 1 ≤ m)
    (hcard : Nat.card (blockEnrichmentDK T Blk hE2 hq0 hqe F).Vmod = 2 ^ (2 * m))
    (l : (SectionNine.blockFrame T Blk hE2).DR)
    (hl : l ≠ (SectionNine.blockFrame T Blk hE2).zeroDR)
    (hunram :
      letI := blockPS_commGroup Blk
      letI := SectionNine.headAct T Blk
      ∀ v : Additive (↥Blk.P ⧸ Blk.S.subgroupOf Blk.P), F.alpha (tqTau q) • v = v) :
    letI := scalarActionZmodTwo ((gamma h q : Type))
    WordPhaseResidueK (sourceBoundaryMapK tame pro2 compat) F
      (blockEnrichmentDK T Blk hE2 hq0 hqe F) l hl
      (scalarActionZmodTwo_triv _)
      ((standardNumerics (2 * h + 1)).gaussUnram m) := by
  letI := blockPS_commGroup Blk
  letI := blockActVY Blk
  letI := blockActV Blk
  letI := SectionNine.headAct T Blk
  letI := SectionNine.hvAct T Blk
  set b := sourceBoundaryMapK tame pro2 compat with hb
  set En := blockEnrichmentDK T Blk hE2 hq0 hqe F with hEn
  set DD := En.descData l hl with hDD
  have hl' : l.1 ≠ Blk.frattiniK := fun heq => hl (Subtype.ext heq)
  intro rho
  set rhoM := rhoPrimeK (SectionNine.blockFrame T Blk hE2) b F (En.radData l hl) rfl rho
    with hrhoM
  letI : TopologicalSpace DD.C0 :=
    (inferInstance : TopologicalSpace (SectionNine.blockFrame T Blk hE2).YC)
  haveI : DiscreteTopology DD.C0 :=
    (inferInstance : DiscreteTopology (SectionNine.blockFrame T Blk hE2).YC)
  letI : TopologicalSpace DD.Vmod := ⊥
  haveI : DiscreteTopology DD.Vmod := ⟨rfl⟩
  letI : DistribMulAction (SectionNine.blockFrame T Blk hE2).YC DD.Vmod := blockActV Blk
  letI : DistribMulAction (SectionNine.HVq T Blk) DD.Vmod := SectionNine.hvAct T Blk
  letI : DistribMulAction ((gamma h q : Type)) DD.Vmod :=
    DistribMulAction.compHom _ rho.1.1.toMonoidHom
  haveI : ContinuousSMul ((gamma h q : Type)) DD.Vmod := by
    constructor
    have hfac :
        (fun p : ((gamma h q : Type)) × DD.Vmod => p.1 • p.2) =
          (fun p : (SectionNine.blockFrame T Blk hE2).YC × DD.Vmod => p.1 • p.2) ∘
            (fun p : ((gamma h q : Type)) × DD.Vmod => (rho.1.1 p.1, p.2)) := by
      funext p
      rfl
    rw [hfac]
    exact continuous_of_discreteTopology.comp
      ((rho.1.1.continuous_toFun.comp continuous_fst).prodMk continuous_snd)
  have hround : ∀ γ : (gamma h q : Type), rho0 DD rhoM γ = rho.1.1 γ :=
    rho0_descData_rhoPrimeK b F En l hl rho
  have hcompat : ∀ (g : (gamma h q : Type)) (v : DD.Vmod),
      g • v = rho0 DD rhoM g • v := by
    intro g v
    exact congrArg (fun c : (SectionNine.blockFrame T Blk hE2).YC => c • v) (hround g).symm
  have hsimpleGamma : IsSimpleModTwo (gamma h q : Type) DD.Vmod := by
    obtain ⟨v, hv⟩ := hVne
    refine ⟨nontrivial_of_ne v 0 hv, ?_⟩
    intro W hW
    apply hsimple W
    intro c w hw
    obtain ⟨g, rfl⟩ := rho.1.2 c
    exact hW g w hw
  -- the head factorization of the boundary lift
  have hheadFac : ∀ γ : (gamma h q : Type),
      SectionNine.blockProjF T Blk (rho0 DD rhoM γ) = headTameSurjK T Blk F (tame γ) := by
    intro γ
    rw [hround γ]
    exact congrArg (⇑(QuotientGroup.mk' (SectionNine.headActKer T Blk)))
      (boundaryLift_headK T Blk hE2 b F rho γ)
  have htauHead :
      SectionNine.blockProjF T Blk
        (rho0 DD rhoM (gammaGen (2 * h + 1) q (lSqW h) .tau)) = 1 := by
    rw [hheadFac, htameTau]
    show QuotientGroup.mk' (SectionNine.headActKer T Blk) (F.alpha (tqTau q)) = 1
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact hunram
  have hwildHead : ∀ i : Fin (2 * h + 1 + 1),
      SectionNine.blockProjF T Blk
        (rho0 DD rhoM (gammaGen (2 * h + 1) q (lSqW h) (.wild i))) = 1 := by
    intro i
    rw [hheadFac, htameWild i]
    show QuotientGroup.mk' (SectionNine.headActKer T Blk) (F.alpha 1) = 1
    rw [map_one, map_one]
  have hsigmaHead :
      SectionNine.blockProjF T Blk
        (rho0 DD rhoM (gammaGen (2 * h + 1) q (lSqW h) .sigma)) = hvSigmaK T Blk F := by
    rw [hheadFac, htameSigma]
    rfl
  -- `H_V` is cyclic on the head `sigma`
  have hzp : ∀ x : SectionNine.HVq T Blk, x ∈ Subgroup.zpowers (hvSigmaK T Blk F) := by
    have hle : Subgroup.closure {hvSigmaK T Blk F, hvTauK T Blk F} ≤
        Subgroup.zpowers (hvSigmaK T Blk F) := by
      rw [Subgroup.closure_le, Set.pair_subset_iff]
      refine ⟨Subgroup.mem_zpowers _, ?_⟩
      show hvTauK T Blk F ∈ Subgroup.zpowers (hvSigmaK T Blk F)
      have : hvTauK T Blk F = 1 := by
        show QuotientGroup.mk' (SectionNine.headActKer T Blk) (F.alpha (tqTau q)) = 1
        rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
        exact hunram
      rw [this]
      exact Subgroup.one_mem _
    rw [hv_genK T Blk F] at hle
    exact fun x => hle (Subgroup.mem_top x)
  have hsurjrho : Function.Surjective (fun γ : (gamma h q : Type) => rho0 DD rhoM γ) :=
    fun y => by
      obtain ⟨γ, hγ⟩ := rho.1.2 y
      exact ⟨γ, (hround γ).trans hγ⟩
  have hfix : ∀ v : DD.Vmod, (∀ γ : (gamma h q : Type), rho0 DD rhoM γ • v = v) → v = 0 :=
    hfix_of_simple_nt hsurjrho hsimple hnt
  have hsfpf : ∀ v : DD.Vmod,
      SectionNine.blockProjF T Blk
        (rho0 DD rhoM (gammaGen (2 * h + 1) q (lSqW h) .sigma)) • v = v → v = 0 := by
    intro v hv
    rw [hsigmaHead] at hv
    refine hfix v fun γ => ?_
    have hstep : rho0 DD rhoM γ • v
        = SectionNine.blockProjF T Blk (rho0 DD rhoM γ) • v :=
      SectionNine.blockProjF_compat T Blk _ v
    rw [hstep]
    have hmemstab : hvSigmaK T Blk F ∈ MulAction.stabilizer (SectionNine.HVq T Blk) v :=
      MulAction.mem_stabilizer_iff.mpr hv
    exact (Subgroup.zpowers_le.mpr hmemstab)
      (hzp (SectionNine.blockProjF T Blk (rho0 DD rhoM γ)))
  have hwildTwo : IsWildTwo (wildAlphabet (2 * h + 1))
      (fun i ↦ Count.rho0Continuous DD rhoM (gammaGen (2 * h + 1) q (lSqW h) i)) :=
    isWildTwo_of_gammaGen (Count.rho0Continuous DD rhoM)
      (rho0Continuous_surjective DD rhoM
        (rhoPrimeK_surjective (SectionNine.blockFrame T Blk hE2) b F (En.radData l hl) rfl rho))
      (fun _ => rfl)
  exact lSqUnramifiedPhaseModel_of_headData rhoM
    (blockDatHVK T Blk hq0 hqe F l hl') (blockDatHV_specK T Blk hq0 hqe F l hl')
    (SectionNine.blockProjF T Blk) (SectionNine.blockProjF_compat T Blk)
    (fun _ _ => rfl) (fun _ _ => rfl) hcompat (Vmod_exp2 DD) hsimpleGamma hqe m hm hcard
    { tau_head := htauHead
      wild_head := hwildHead
      sigma_fixedPointFree := hsfpf
      wildTwo := hwildTwo }

end

