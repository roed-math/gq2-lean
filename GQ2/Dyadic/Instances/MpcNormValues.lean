import GQ2.Dyadic.Instances.MpcRowData

/-!
# W81-NORMS: the four norm-character values at the two procyclic fields

Wave 80 reduced the two procyclic quadratic rows to four named inputs, of which three are
values of the norm-group character of `ℚ₂(√±10)` and the fourth is the pivot.  This module
computes the three, from the **mod-8 congruence on norms of spectral units** and nothing else:
no Hilbert-symbol calculator is used, and none is needed.

Declaration prefix `mpcNorm`, namespace `GQ2.Dyadic.Instances.MpcNorm`.
-/

namespace GQ2.Dyadic.Instances.MpcNorm

open GQ2 GQ2.Dyadic GQ2.Dyadic.MarkedCore Multiplicative
open GQ2.Dyadic.Instances.MpcCert GQ2.Dyadic.Instances.MpcRow
open GQ2.Dyadic.FieldUnimod GQ2.Dyadic.FieldBranchId
open GQ2.Dyadic.Fields GQ2.Dyadic.LSquare GQ2.Dyadic.EvenRangePolish

local notation "ℚ̄₂" => AlgebraicClosure ℚ_[2]

noncomputable section

/-! ## §1 Squares modulo eight in `ℤ₂`

The whole arithmetic of this lane is the following pair of residue facts, and both are `decide`
over `ZMod 8`.  A `2`-adic *unit* squares to `1`; an arbitrary `2`-adic integer squares into
`{0, 1, 4}`.  Everything below is these two facts pushed through the norm form `t² − a s²`. -/

section ModEight

/-- **A `2`-adic unit squares to `1` modulo `8`.**  The reason the norm of a spectral unit of
`ℚ₂(√a)` has only two possible residues rather than four. -/
theorem mpcNorm_unit_sq_mod_eight (u : ℤ_[2]ˣ) :
    PadicInt.toZModPow 3 ((u : ℤ_[2]) ^ 2) = 1 := by
  rw [map_pow]
  have hu : IsUnit (PadicInt.toZModPow (p := 2) 3 (u : ℤ_[2])) := u.isUnit.map _
  revert hu
  generalize PadicInt.toZModPow (p := 2) 3 (u : ℤ_[2]) = r
  revert r
  decide

/-- **A `2`-adic integer squares into `{0, 1, 4}` modulo `8`.** -/
theorem mpcNorm_sq_mod_eight (y : ℤ_[2]) :
    PadicInt.toZModPow 3 (y ^ 2) = 0 ∨ PadicInt.toZModPow 3 (y ^ 2) = 1 ∨
      PadicInt.toZModPow 3 (y ^ 2) = 4 := by
  rw [map_pow]
  generalize PadicInt.toZModPow (p := 2) 3 y = r
  revert r
  decide

end ModEight

/-! ## §2 The value group of `ℚ₂(√a)` is generated by `√a`

Wave 80 §4.2 step 3: to turn `ν_ur(rec_K x)` into arithmetic one needs every `x : Kˣ` to be a
spectral unit times a power of `√a`.  `Fields.lean` §4 has the separation lemma this rests on
(`norm_add_mul_sqrtIn`) but not the statement, and `MarkedRecipBundle.exists_bot_decomp` is the
same statement one field down.  Here it is at a ramified quadratic field, with the exponent read
off the representation rather than from a valuation on `K`. -/

section ValueGroup

variable {a : ℚ_[2]}

/-- The coercion `ℚ₂(√a) → ℚ̄₂` commutes with integer powers.  Used throughout: `push_cast`
handles natural powers but not `zpow`, and every decomposition below is a `zpow`. -/
theorem mpcNorm_coe_zpow (y : ↥(quadField a)) (m : ℤ) :
    ((y ^ m : ↥(quadField a)) : ℚ̄₂) = ((y : ↥(quadField a)) : ℚ̄₂) ^ m :=
  map_zpow₀ (algebraMap (↥(quadField a)) ℚ̄₂) y m

/-- `‖√a‖` is positive: `√a ≠ 0` because `a ≠ 0`. -/
theorem mpcNorm_norm_sqrtIn_pos (hodd : Odd a.valuation) : 0 < ‖sqrtIn a‖ := by
  rw [norm_pos_iff]
  intro h
  have hsq := norm_sqrtIn_sq a
  rw [h, norm_zero] at hsq
  exact ne_zero_of_odd_valuation hodd (norm_eq_zero.1 (by simpa using hsq.symm))

/-- **A scalar has even `√a`-exponent.**  `‖c‖ = ‖√a‖^{2 v₂(c)}`, since `‖√a‖² = ‖a‖ = ‖2‖`. -/
theorem mpcNorm_norm_scalar (hna : ‖a‖ = ‖(2 : ℚ_[2])‖) {c : ℚ_[2]} (hc : c ≠ 0) :
    ‖(algebraMap ℚ_[2] ℚ̄₂ c)‖ = ‖sqrtIn a‖ ^ (2 * c.valuation) := by
  have hsq : ‖sqrtIn a‖ ^ (2 : ℤ) = ((2 : ℕ) : ℝ) ^ (-1 : ℤ) := by
    rw [show ((2 : ℤ)) = ((2 : ℕ) : ℤ) from rfl, zpow_natCast, norm_sqrtIn_sq, hna,
      show ((2 : ℚ_[2])) = ((2 : ℕ) : ℚ_[2]) by push_cast; ring, Padic.norm_p]
    rw [zpow_neg, zpow_one]
  rw [GQ2.Dyadic.Fields.norm_algebraMap, Padic.norm_eq_zpow_neg_valuation hc, zpow_mul, hsq,
    ← zpow_mul]
  congr 1
  ring

/-- **A `√a`-multiple has odd `√a`-exponent.** -/
theorem mpcNorm_norm_scalar_root (hna : ‖a‖ = ‖(2 : ℚ_[2])‖) {c : ℚ_[2]} (hc : c ≠ 0) :
    ‖(algebraMap ℚ_[2] ℚ̄₂ c) * sqrtIn a‖ = ‖sqrtIn a‖ ^ (2 * c.valuation + 1) := by
  rw [norm_mul, mpcNorm_norm_scalar hna hc, zpow_add₀ (by
    rw [← norm_sqrtIn_sq a] at hna
    intro h
    rw [h] at hna
    simp only [ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow] at hna
    exact (norm_ne_zero_iff.2 (two_ne_zero : (2 : ℚ_[2]) ≠ 0)) hna.symm), zpow_one]

/-- **Every nonzero element of `ℚ₂(√a)` has norm a power of `‖√a‖`**, for `v(a)` odd and
`‖a‖ = ‖2‖`: the value group of a ramified quadratic field is `‖√a‖^ℤ`. -/
theorem mpcNorm_exists_zpow_norm (ha : ¬ IsSquare a) (hodd : Odd a.valuation)
    (hna : ‖a‖ = ‖(2 : ℚ_[2])‖) (z : ↥(quadField a)) :
    ∃ n : ℤ, ‖(z : ℚ̄₂)‖ = ‖sqrtIn a‖ ^ n ∨ (z : ℚ̄₂) = 0 := by
  obtain ⟨t, s, hts⟩ := exists_repr ha z.2
  rcases eq_or_ne s 0 with rfl | hs
  · rcases eq_or_ne t 0 with rfl | ht
    · exact ⟨0, Or.inr (by rw [hts]; simp)⟩
    · refine ⟨2 * t.valuation, Or.inl ?_⟩
      rw [hts]
      simp only [map_zero, zero_mul, add_zero]
      exact mpcNorm_norm_scalar hna ht
  rcases eq_or_ne t 0 with rfl | ht
  · refine ⟨2 * s.valuation + 1, Or.inl ?_⟩
    rw [hts]
    simp only [map_zero, zero_add]
    exact mpcNorm_norm_scalar_root hna hs
  · rw [hts, norm_add_mul_sqrtIn hodd ht hs]
    rcases max_choice ‖(algebraMap ℚ_[2] ℚ̄₂ t)‖ ‖(algebraMap ℚ_[2] ℚ̄₂ s) * sqrtIn a‖ with h | h
    · exact ⟨2 * t.valuation, Or.inl (h.trans (mpcNorm_norm_scalar hna ht))⟩
    · exact ⟨2 * s.valuation + 1, Or.inl (h.trans (mpcNorm_norm_scalar_root hna hs))⟩

/-- **THE `Kˣ = U · ⟨√a⟩` DECOMPOSITION.**  Wave 80 §4.2 step 3, discharged: every unit of a
ramified quadratic field is a spectral unit times an integer power of `√a`.  This is what turns
`ν_ur(rec_K x)` into an exponent, and it is the same statement `exists_bot_decomp` provides at
`⊥` with `2` in place of `√a`. -/
theorem mpcNorm_exists_decomp (ha : ¬ IsSquare a) (hodd : Odd a.valuation)
    (hna : ‖a‖ = ‖(2 : ℚ_[2])‖) (x : (↥(quadField a))ˣ) :
    ∃ (u : (↥(quadField a))ˣ) (n : ℤ),
      x = u * (fieldUni_rootUnit ha) ^ n ∧
        ‖((u : ↥(quadField a)) : ℚ̄₂)‖ = 1 := by
  obtain ⟨n, hn⟩ := mpcNorm_exists_zpow_norm ha hodd hna (x : ↥(quadField a))
  have hx0 : ((x : ↥(quadField a)) : ℚ̄₂) ≠ 0 := by
    intro h
    exact x.ne_zero (Subtype.ext h)
  have hn' : ‖((x : ↥(quadField a)) : ℚ̄₂)‖ = ‖sqrtIn a‖ ^ n := by
    rcases hn with h | h
    · exact h
    · exact absurd h hx0
  refine ⟨x * (fieldUni_rootUnit ha) ^ (-n), n, by rw [mul_assoc, ← zpow_add, neg_add_cancel,
    zpow_zero, mul_one], ?_⟩
  have hroot : (0 : ℝ) < ‖sqrtIn a‖ := mpcNorm_norm_sqrtIn_pos hodd
  have hcoe : (((x * (fieldUni_rootUnit ha) ^ (-n) : (↥(quadField a))ˣ) :
      ↥(quadField a)) : ℚ̄₂)
      = ((x : ↥(quadField a)) : ℚ̄₂) * (sqrtIn a) ^ (-n) := by
    rw [Units.val_mul, Units.val_zpow_eq_zpow_val]
    push_cast
    rw [mpcNorm_coe_zpow, fieldUni_rootUnit_val]
  rw [hcoe, norm_mul, norm_zpow, hn', ← zpow_add₀ (ne_of_gt hroot), add_neg_cancel, zpow_zero]

end ValueGroup

/-! ## §3 The norm of a spectral unit, and its residue modulo eight

Wave 80 §4.2 step 4, the arithmetic step.  A spectral unit of `ℚ₂(√a)` is `t + s√a` with
`t : ℤ₂ˣ` and `s : ℤ₂` (the parity separation forbids `‖s√a‖ = 1`, so `‖t‖ = 1` and then `‖s‖ ≤ 1`
because the value group of `ℚ₂` is coarser than that of `K`).  Its norm is `t² − a s²`, whose
residue modulo `8` is therefore one of `1`, `1 − a`, `1 − 4a`.

**This replaces the Hilbert symbol.**  Together with §4's `N(√a) = −a` it determines the whole
norm group of the field, and the four values of wave 80 §4.1 are read off it directly. -/

section SpectralUnit

variable {a : ℚ_[2]}

/-- **The norm form.**  `N(t + s√a) = t² − a s²`, with **no** `s ≠ 0` side condition:
`evenPolish_norm_quadElt` at `s ≠ 0`, and `Algebra.norm_algebraMap` with `[K : ℚ₂] = 2` at
`s = 0`. -/
theorem mpcNorm_norm_quadElt (ha : ¬ IsSquare a) (t s : ℚ_[2]) :
    Algebra.norm ℚ_[2] (evenPolish_quadElt a t s) = t ^ 2 - a * s ^ 2 := by
  rcases eq_or_ne s 0 with rfl | hs
  · have hval : evenPolish_quadElt a t 0 = algebraMap ℚ_[2] (↥(quadField a)) t := by
      apply Subtype.ext
      rw [evenPolish_quadElt_val, map_zero, zero_mul, add_zero]
      rfl
    rw [hval, Algebra.norm_algebraMap, finrank_quadField ha]
    ring
  · rw [evenPolish_norm_quadElt ha hs]

/-- **A `√a`-multiple never has spectral norm `1`** when `v(a)` is odd: the parity separation, in
the form `normUnits_le_depthUnits` uses it internally. -/
theorem mpcNorm_root_mul_ne_one (hodd : Odd a.valuation) {y : ℚ_[2]} (hy : y ≠ 0) :
    ‖(algebraMap ℚ_[2] ℚ̄₂ y) * sqrtIn a‖ ≠ 1 := by
  intro hcon
  have ha0 := ne_zero_of_odd_valuation hodd
  rw [norm_mul, GQ2.Dyadic.Fields.norm_algebraMap] at hcon
  have hsq : ‖y ^ 2 * a‖ = ‖(1 : ℚ_[2])‖ := by
    rw [norm_mul, norm_pow, ← norm_sqrtIn_sq a, ← mul_pow, hcon, one_pow, norm_one]
  have hv := valuation_eq_of_norm_eq (mul_ne_zero (pow_ne_zero 2 hy) ha0) one_ne_zero hsq
  rw [Padic.valuation_mul (pow_ne_zero 2 hy) ha0, Padic.valuation_pow, Padic.valuation_one] at hv
  obtain ⟨k, hk⟩ := hodd
  omega

/-- **A spectral unit is `t + s√a` with `t` a `2`-adic unit and `s` a `2`-adic integer.**  The
integrality of `s` is the discreteness of `ℚ₂`'s value group against `K`'s
(`fieldUni_norm_le_one_of_mul_sqrtIn_lt_one`), not an assumption. -/
theorem mpcNorm_repr_of_norm_one (ha : ¬ IsSquare a) (hodd : Odd a.valuation)
    (hna : ‖a‖ = ‖(2 : ℚ_[2])‖) {z : ↥(quadField a)} (hz : ‖(z : ℚ̄₂)‖ = 1) :
    ∃ t s : ℚ_[2], z = evenPolish_quadElt a t s ∧ ‖t‖ = 1 ∧ ‖s‖ ≤ 1 := by
  obtain ⟨t, s, hts⟩ := exists_repr ha z.2
  have hzt : z = evenPolish_quadElt a t s := Subtype.ext (by rw [evenPolish_quadElt_val, ← hts])
  refine ⟨t, s, hzt, ?_, ?_⟩ <;> rcases eq_or_ne s 0 with rfl | hs
  · rw [hts] at hz
    simpa [GQ2.Dyadic.Fields.norm_algebraMap] using hz
  · rcases eq_or_ne t 0 with rfl | ht
    · rw [hts] at hz
      simp only [map_zero, zero_add] at hz
      exact absurd hz (mpcNorm_root_mul_ne_one hodd hs)
    · rw [hts, norm_add_mul_sqrtIn hodd ht hs] at hz
      rcases max_cases ‖(algebraMap ℚ_[2] ℚ̄₂ t)‖ ‖(algebraMap ℚ_[2] ℚ̄₂ s) * sqrtIn a‖ with
        ⟨he, -⟩ | ⟨he, -⟩
      · rw [he] at hz
        rwa [GQ2.Dyadic.Fields.norm_algebraMap] at hz
      · rw [he] at hz
        exact absurd hz (mpcNorm_root_mul_ne_one hodd hs)
  · rw [norm_zero]
    norm_num
  · rcases eq_or_ne t 0 with rfl | ht
    · rw [hts] at hz
      simp only [map_zero, zero_add] at hz
      exact absurd hz (mpcNorm_root_mul_ne_one hodd hs)
    · rw [hts, norm_add_mul_sqrtIn hodd ht hs] at hz
      have hle : ‖(algebraMap ℚ_[2] ℚ̄₂ s) * sqrtIn a‖ ≤ 1 := hz ▸ le_max_right _ _
      have hlt : ‖(algebraMap ℚ_[2] ℚ̄₂ s) * sqrtIn a‖ < 1 :=
        lt_of_le_of_ne hle (mpcNorm_root_mul_ne_one hodd hs)
      rw [norm_mul, GQ2.Dyadic.Fields.norm_algebraMap] at hlt
      exact fieldUni_norm_le_one_of_mul_sqrtIn_lt_one hna hlt

/-- **THE NORM OF A SPECTRAL UNIT, INTEGRALLY.**  `N(u) = t² − a s²` with `t : ℤ₂ˣ` and `s : ℤ₂`.
The residues `t² ≡ 1` and `s² ∈ {0, 1, 4}` modulo `8` then pin `N(u)` to three residues. -/
theorem mpcNorm_norm_spectral_unit (ha : ¬ IsSquare a) (hodd : Odd a.valuation)
    (hna : ‖a‖ = ‖(2 : ℚ_[2])‖) {az : ℤ_[2]} (haz : ((az : ℚ_[2])) = a)
    {z : ↥(quadField a)} (hz : ‖(z : ℚ̄₂)‖ = 1) :
    ∃ (t : ℤ_[2]ˣ) (s : ℤ_[2]),
      Algebra.norm ℚ_[2] z = ((((t : ℤ_[2]) ^ 2 - az * s ^ 2 : ℤ_[2]) : ℚ_[2])) := by
  obtain ⟨t, s, hzt, ht, hs⟩ := mpcNorm_repr_of_norm_one ha hodd hna hz
  obtain ⟨tz, htz⟩ : ∃ tz : ℤ_[2], ((tz : ℚ_[2])) = t := ⟨⟨t, le_of_eq ht⟩, rfl⟩
  obtain ⟨sz, hsz⟩ : ∃ sz : ℤ_[2], ((sz : ℚ_[2])) = s := ⟨⟨s, hs⟩, rfl⟩
  have htu : IsUnit tz := PadicInt.isUnit_iff.2 (by rw [PadicInt.norm_def, htz]; exact ht)
  refine ⟨htu.unit, sz, ?_⟩
  rw [hzt, mpcNorm_norm_quadElt ha, IsUnit.unit_spec]
  push_cast
  rw [haz, htz, hsz]

/-- `a` is `2` times a `2`-adic integer, integrally: `‖a‖ = ‖2‖` says the ramified scalar has
valuation one. -/
theorem mpcNorm_two_dvd (hna : ‖a‖ = ‖(2 : ℚ_[2])‖) {az : ℤ_[2]} (haz : ((az : ℚ_[2])) = a) :
    (2 : ℤ_[2]) ∣ az := by
  refine (PadicInt.norm_lt_one_iff_dvd az).1 ?_
  rw [PadicInt.norm_def, haz, hna]
  exact GQ2.Dyadic.Fields.norm_two_lt_one'

/-- `t² − a s²` is a `2`-adic **unit** whenever `t` is: `a` is even, so the norm form is odd. -/
theorem mpcNorm_isUnit_form (hna : ‖a‖ = ‖(2 : ℚ_[2])‖) {az : ℤ_[2]} (haz : ((az : ℚ_[2])) = a)
    (t : ℤ_[2]ˣ) (s : ℤ_[2]) : IsUnit ((t : ℤ_[2]) ^ 2 - az * s ^ 2) := by
  obtain ⟨k, hk⟩ := mpcNorm_two_dvd hna haz
  have hfac : (t : ℤ_[2]) ^ 2 - az * s ^ 2
      = (t : ℤ_[2]) ^ 2 * (1 + 2 * (-(k * s ^ 2) * ((t⁻¹ : ℤ_[2]ˣ) : ℤ_[2]) ^ 2)) := by
    have hinv : ((t : ℤ_[2])) * ((t⁻¹ : ℤ_[2]ˣ) : ℤ_[2]) = 1 := by
      rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
    rw [hk]
    linear_combination (2 * k * s ^ 2 * ((t : ℤ_[2]) * ((t⁻¹ : ℤ_[2]ˣ) : ℤ_[2]) + 1)) * hinv
  rw [hfac]
  exact (t.isUnit.pow 2).mul (GQ2.isUnit_one_add_two_mul _)

/-- **THE THREE RESIDUES.**  Modulo `8` the norm of a spectral unit is `1`, `1 − a` or `1 − 4a`.
This is the entire arithmetic input of the lane: no Hilbert symbol, no norm-residue axiom. -/
theorem mpcNorm_residue_spectral_unit (ha : ¬ IsSquare a) (hodd : Odd a.valuation)
    (hna : ‖a‖ = ‖(2 : ℚ_[2])‖) {az : ℤ_[2]} (haz : ((az : ℚ_[2])) = a)
    {z : ↥(quadField a)} (hz : ‖(z : ℚ̄₂)‖ = 1) :
    ∃ w : ℤ_[2]ˣ, Algebra.norm ℚ_[2] z = (((w : ℤ_[2]) : ℚ_[2])) ∧
      (PadicInt.toZModPow 3 (w : ℤ_[2]) = 1 ∨
        PadicInt.toZModPow 3 (w : ℤ_[2]) = 1 - PadicInt.toZModPow 3 az ∨
        PadicInt.toZModPow 3 (w : ℤ_[2]) = 1 - 4 * PadicInt.toZModPow 3 az) := by
  obtain ⟨t, s, hval⟩ := mpcNorm_norm_spectral_unit ha hodd hna haz hz
  refine ⟨(mpcNorm_isUnit_form hna haz t s).unit, ?_, ?_⟩
  · rw [hval, IsUnit.unit_spec]
  · rw [IsUnit.unit_spec, map_sub, map_mul, mpcNorm_unit_sq_mod_eight]
    rcases mpcNorm_sq_mod_eight s with h | h | h <;> rw [h]
    · exact Or.inl (by ring)
    · exact Or.inr (Or.inl (by ring))
    · exact Or.inr (Or.inr (by ring))

end SpectralUnit

/-! ## §4 The norm-group character on `Kˣ`

§2 and §3 combine into one statement about the reciprocity map: for every `x : Kˣ` there are a
`2`-adic unit `w` of known residue and an integer `n` with

    χ_K(rec_K x) = (w · w₀^n)⁻¹      and      ν_ur(rec_K x) = −n,

where `w₀` is the unit part of `−a = N(√a)`.  The parity of `ν_ur(rec_K x)` and the residue of
`χ_K(rec_K x)` modulo `8` are therefore locked together, and that lock is the whole content of
the four values. -/

section RecipValues

variable {K : IntermediateField ℚ_[2] ℚ̄₂} [FiniteDimensional ℚ_[2] K] {Rec : LocalReciprocity}

/-- **`fieldUni_chi_recip_of_norm` at an integer exponent.**  The `ℕ`-version cannot see the
negative powers of `√a` that `Kˣ` actually contains. -/
theorem mpcNorm_chi_recip_of_norm (B : MarkedRecip Rec K) (x : (↥K)ˣ) (u : ℤ_[2]ˣ) (n : ℤ)
    (hx : normUnitsK K x = unitEmbed u * uniformizer ^ n) :
    chiCycKAb K (B.recip x) = u⁻¹ := by
  rw [← chiCycAb_inclAbK, B.norm_compat, hx]
  simp only [map_mul, map_zpow, Rec.chiCyc_recip_unit, Rec.chiCyc_recip_uniformizer, one_zpow,
    mul_one]

end RecipValues

section QuadRecip

variable {a : ℚ_[2]} {Rec : LocalReciprocity}

/-- `N(√a) = −a`: the second half of the norm-group computation. -/
theorem mpcNorm_normUnits_rootUnit (ha : ¬ IsSquare a) :
    ((normUnitsK (quadField a) (fieldUni_rootUnit ha) : ℚ_[2]ˣ) : ℚ_[2]) = -a := by
  rw [normUnitsK_val]
  show Algebra.norm ℚ_[2] (evenPolish_quadElt a 0 1) = -a
  rw [mpcNorm_norm_quadElt ha]
  ring

/-- **THE MASTER IDENTITY.**  For every `x : Kˣ` at a ramified quadratic field, the cyclotomic
value and the unramified value of `rec_K x` are computed by a single integer `n` and a single
spectral-unit norm `w`: `χ = (w·w₀ⁿ)⁻¹` and `ν = −n`, with `w` one of three residues modulo `8`.
Every statement of §5 and §6 is a mod-`8` reading of this. -/
theorem mpcNorm_recip_values [FiniteDimensional ℚ_[2] (quadField a)] (ha : ¬ IsSquare a)
    (hodd : Odd a.valuation) (hna : ‖a‖ = ‖(2 : ℚ_[2])‖) {az : ℤ_[2]} (haz : ((az : ℚ_[2])) = a)
    {w₀ : ℤ_[2]ˣ} (hw₀ : ((w₀ : ℤ_[2]) : ℚ_[2]) * 2 = -a)
    (B : MarkedRecip Rec (quadField a)) (x : (↥(quadField a))ˣ) :
    ∃ (w : ℤ_[2]ˣ) (n : ℤ),
      chiCycKAb (quadField a) (B.recip x) = (w * w₀ ^ n)⁻¹ ∧
        toAdd (B.nu_ur (B.recip x)) = ((-n : ℤ) : ℤ_[2]) ∧
        (PadicInt.toZModPow 3 (w : ℤ_[2]) = 1 ∨
          PadicInt.toZModPow 3 (w : ℤ_[2]) = 1 - PadicInt.toZModPow 3 az ∨
          PadicInt.toZModPow 3 (w : ℤ_[2]) = 1 - 4 * PadicInt.toZModPow 3 az) := by
  obtain ⟨u, n, hxn, hu⟩ := mpcNorm_exists_decomp ha hodd hna x
  obtain ⟨w, hwval, hwres⟩ := mpcNorm_residue_spectral_unit ha hodd hna haz hu
  refine ⟨w, n, ?_, ?_, hwres⟩
  · refine mpcNorm_chi_recip_of_norm B x (w * w₀ ^ n) n ?_
    have hroot : normUnitsK (quadField a) (fieldUni_rootUnit ha) = unitEmbed w₀ * uniformizer := by
      apply Units.ext
      rw [Units.val_mul, unitEmbed_val, uniformizer_val, mpcNorm_normUnits_rootUnit ha, ← hw₀]
      rfl
    have hu' : normUnitsK (quadField a) u = unitEmbed w := by
      apply Units.ext
      rw [normUnitsK_val, unitEmbed_val, hwval]
      rfl
    rw [hxn, map_mul, map_zpow, hroot, hu', mul_zpow, ← map_zpow unitEmbed, map_mul unitEmbed,
      ← mul_assoc]
  · rw [B.nu_ur_recip_of_decomp x u (fieldUni_rootUnit ha) n hxn hu
      (fieldUni_rootUnit_lt_one ha hna) (fieldUni_rootUnit_max ha hodd hna), toAdd_ofAdd]

end QuadRecip

end

end GQ2.Dyadic.Instances.MpcNorm
