theorem mpcNorm_level_sqrtNegTen (B : MarkedRecip R KSqrtNegTen) : B.r = 1 :=
  le_antisymm (mpcRow_level_le_one_sqrtNegTen B)
    (Nat.one_le_iff_ne_zero.2 (mpcRow_level_ne_zero (mpcNorm_noUnitKerChi_sqrtNegTen B)))

