import GQ2.Dyadic.Instances.MpcBalancedNeutralityCokernel

/-!
# The neutral-C cokernel is generated by the relaxed C row

W212 separates ordinary relative coverage from the additional character-neutral condition
on the `C` correction.  This file removes the other three rows from the second obstruction:
the quotient of the relaxed span by the constrained span is generated by the ordinary
relative `C`-row map alone.

This is an algebraic reduction, not a vanishing theorem.  Its kernel is exactly the set of
ordinary relative `C` classes whose bracket shift already belongs to the constrained span.
-/

namespace GQ2.Dyadic.Instances.MpcBalancedNeutralitySpan

noncomputable section

open GQ2 GQ2.Dyadic Multiplicative
open GQ2.Dyadic.MarkedCore
open GQ2.Dyadic.Instances.MpcGeneralHandlePivotBoundary
open GQ2.Dyadic.Instances.MpcOneHandleBalancedLimit
open GQ2.Dyadic.Instances.MpcBalancedRelativeLift
open GQ2.Dyadic.Instances.MpcBalancedFiniteCore
open GQ2.Dyadic.Instances.MpcBalancedRelativeSpan
open GQ2.Dyadic.Instances.MpcBalancedCoordinateSpan
open GQ2.Dyadic.Instances.MpcBalancedNeutralityCokernel
open GQ2.Roe.Labute

open scoped IsMulCommutative

/-! ## The C-row quotient map -/

/-- Regard a relaxed `C` shift as an element of the full relaxed coordinate span. -/
noncomputable def oneHandleBalancedCoreRelaxedCToSpan
    (p : OneHandleBalancedPoint) (k : ℕ) (hk : 3 ≤ k) :
    oneHandleRelativeLambdaImage (k - 1) (k + 1) →*
      oneHandleBalancedCoreRelativeCoordinateSpan p k hk where
  toFun x := ⟨oneHandleBalancedCoreRelativeShiftCRelaxed p k hk x,
    (show (oneHandleBalancedCoreRelativeShiftCRelaxed p k hk).range ≤
        oneHandleBalancedCoreRelativeCoordinateSpan p k hk from
      le_trans le_sup_left le_sup_right) ⟨x, rfl⟩⟩
  map_one' := by
    apply Subtype.ext
    exact map_one (oneHandleBalancedCoreRelativeShiftCRelaxed p k hk)
  map_mul' x y := by
    apply Subtype.ext
    exact map_mul (oneHandleBalancedCoreRelativeShiftCRelaxed p k hk) x y

/-- The ordinary relative `C` row, reduced modulo the constrained coordinate span. -/
noncomputable def oneHandleBalancedCoreNeutralityClassHom
    (p : OneHandleBalancedPoint) (k : ℕ) (hk : 3 ≤ k) :
    oneHandleRelativeLambdaImage (k - 1) (k + 1) →*
      OneHandleBalancedCoreNeutralityCokernel p k hk :=
  (QuotientGroup.mk' (oneHandleBalancedCoreNeutralitySubgroup p k hk)).comp
    (oneHandleBalancedCoreRelaxedCToSpan p k hk)

/-- A relaxed `C` class maps to one exactly when its bracket shift is already in the
constrained four-coordinate span. -/
theorem oneHandleBalancedCoreNeutralityClassHom_eq_one_iff
    (p : OneHandleBalancedPoint) (k : ℕ) (hk : 3 ≤ k)
    (x : oneHandleRelativeLambdaImage (k - 1) (k + 1)) :
    oneHandleBalancedCoreNeutralityClassHom p k hk x = 1 ↔
      oneHandleBalancedCoreRelativeShiftCRelaxed p k hk x ∈
        oneHandleBalancedCoreCoordinateSpan p k hk := by
  change QuotientGroup.mk' (oneHandleBalancedCoreNeutralitySubgroup p k hk)
      (oneHandleBalancedCoreRelaxedCToSpan p k hk x) = 1 ↔ _
  constructor
  · intro h
    have hm := (QuotientGroup.eq_one_iff
      (oneHandleBalancedCoreRelaxedCToSpan p k hk x)).mp h
    exact hm
  · intro h
    apply (QuotientGroup.eq_one_iff
      (oneHandleBalancedCoreRelaxedCToSpan p k hk x)).mpr
    exact h

/-! ## Surjectivity onto the neutrality cokernel -/

/-- The relaxed `C` row generates the entire neutral-`C` cokernel.  The `A`, `B`, and `D`
pieces of any relaxed-span representative already lie in the constrained span and therefore
vanish in the quotient. -/
theorem oneHandleBalancedCoreNeutralityClassHom_surjective
    (p : OneHandleBalancedPoint) (k : ℕ) (hk : 3 ≤ k) :
    Function.Surjective (oneHandleBalancedCoreNeutralityClassHom p k hk) := by
  intro q
  obtain ⟨z, rfl⟩ := QuotientGroup.mk'_surjective
    (oneHandleBalancedCoreNeutralitySubgroup p k hk) q
  change ∃ x, QuotientGroup.mk' (oneHandleBalancedCoreNeutralitySubgroup p k hk)
      (oneHandleBalancedCoreRelaxedCToSpan p k hk x) =
        QuotientGroup.mk' (oneHandleBalancedCoreNeutralitySubgroup p k hk) z
  obtain ⟨ab, hab, cd, hcd, habcd⟩ := Subgroup.mem_sup.mp z.2
  obtain ⟨c, hc, d, hd, hcd'⟩ := Subgroup.mem_sup.mp hcd
  have hcRange := hc
  obtain ⟨x, hxc⟩ := hc
  let zab : oneHandleBalancedCoreRelativeCoordinateSpan p k hk :=
    ⟨ab, Subgroup.mem_sup_left hab⟩
  let zc : oneHandleBalancedCoreRelativeCoordinateSpan p k hk :=
    ⟨c, Subgroup.mem_sup_right (Subgroup.mem_sup_left hcRange)⟩
  let zd : oneHandleBalancedCoreRelativeCoordinateSpan p k hk :=
    ⟨d, Subgroup.mem_sup_right (Subgroup.mem_sup_right hd)⟩
  have hz : zab * (zc * zd) = z := by
    apply Subtype.ext
    change ab * (c * d) = z.1
    rw [← hcd'] at habcd
    exact habcd
  have habConstrained : ab ∈ oneHandleBalancedCoreCoordinateSpan p k hk :=
    Subgroup.mem_sup_left hab
  have hdConstrained : d ∈ oneHandleBalancedCoreCoordinateSpan p k hk :=
    Subgroup.mem_sup_right (Subgroup.mem_sup_right hd)
  have hzab : QuotientGroup.mk' (oneHandleBalancedCoreNeutralitySubgroup p k hk) zab = 1 :=
    (QuotientGroup.eq_one_iff zab).mpr habConstrained
  have hzd : QuotientGroup.mk' (oneHandleBalancedCoreNeutralitySubgroup p k hk) zd = 1 :=
    (QuotientGroup.eq_one_iff zd).mpr hdConstrained
  refine ⟨x, ?_⟩
  have hcx : oneHandleBalancedCoreRelaxedCToSpan p k hk x = zc := by
    apply Subtype.ext
    exact hxc
  rw [hcx, ← hz, map_mul, map_mul, hzab, hzd, one_mul, mul_one]

/-- Equivalently, the quotient map's range is the whole neutrality cokernel. -/
theorem oneHandleBalancedCoreNeutralityClassHom_range_eq_top
    (p : OneHandleBalancedPoint) (k : ℕ) (hk : 3 ≤ k) :
    (oneHandleBalancedCoreNeutralityClassHom p k hk).range = ⊤ :=
  MonoidHom.range_eq_top.mpr
    (oneHandleBalancedCoreNeutralityClassHom_surjective p k hk)

/-- Every target neutrality obstruction has a representative coming from a single ordinary
relative `C` correction class. -/
theorem exists_relativeC_class_eq_neutralityObstruction
    {Psi0 : ContinuousMulEquiv (DM 2 0) (DM 2 0)}
    (p : OneHandleBalancedPoint) {k : ℕ} (hk : 3 ≤ k)
    (hp : p ∈ oneHandleBalancedSet Psi0 k)
    (hrel : oneHandleBalancedCoreRelativeTarget p hp ∈
      oneHandleBalancedCoreRelativeCoordinateSpan p k hk) :
    ∃ x : oneHandleRelativeLambdaImage (k - 1) (k + 1),
      oneHandleBalancedCoreNeutralityClassHom p k hk x =
        oneHandleBalancedCoreNeutralityObstruction p hk hp hrel :=
  oneHandleBalancedCoreNeutralityClassHom_surjective p k hk _

/-! ## A target-specific one-row formulation -/

/-- The second obstruction vanishes exactly when one (equivalently every) single-`C`
representative of it belongs to the kernel of the `C`-class map. -/
theorem neutralityObstruction_eq_one_iff_exists_relativeC_kernel
    {Psi0 : ContinuousMulEquiv (DM 2 0) (DM 2 0)}
    (p : OneHandleBalancedPoint) {k : ℕ} (hk : 3 ≤ k)
    (hp : p ∈ oneHandleBalancedSet Psi0 k)
    (hrel : oneHandleBalancedCoreRelativeTarget p hp ∈
      oneHandleBalancedCoreRelativeCoordinateSpan p k hk) :
    oneHandleBalancedCoreNeutralityObstruction p hk hp hrel = 1 ↔
      ∃ x : oneHandleRelativeLambdaImage (k - 1) (k + 1),
        oneHandleBalancedCoreNeutralityClassHom p k hk x =
          oneHandleBalancedCoreNeutralityObstruction p hk hp hrel ∧
        oneHandleBalancedCoreRelativeShiftCRelaxed p k hk x ∈
          oneHandleBalancedCoreCoordinateSpan p k hk := by
  constructor
  · intro hobs
    obtain ⟨x, hx⟩ := exists_relativeC_class_eq_neutralityObstruction
      p hk hp hrel
    refine ⟨x, hx, ?_⟩
    exact (oneHandleBalancedCoreNeutralityClassHom_eq_one_iff p k hk x).mp
      (hx.trans hobs)
  · rintro ⟨x, hx, hmem⟩
    have hone := (oneHandleBalancedCoreNeutralityClassHom_eq_one_iff
      p k hk x).mpr hmem
    exact hx ▸ hone

#print axioms oneHandleBalancedCoreRelaxedCToSpan
#print axioms oneHandleBalancedCoreNeutralityClassHom
#print axioms oneHandleBalancedCoreNeutralityClassHom_eq_one_iff
#print axioms oneHandleBalancedCoreNeutralityClassHom_surjective
#print axioms oneHandleBalancedCoreNeutralityClassHom_range_eq_top
#print axioms exists_relativeC_class_eq_neutralityObstruction
#print axioms neutralityObstruction_eq_one_iff_exists_relativeC_kernel

end
end GQ2.Dyadic.Instances.MpcBalancedNeutralitySpan
