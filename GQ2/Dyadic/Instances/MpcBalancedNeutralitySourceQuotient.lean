open GQ2.Dyadic.Instances.MpcBalancedCoordinateSpan
open GQ2.Dyadic.Instances.MpcBalancedNeutralityCokernel
open GQ2.Dyadic.Instances.MpcBalancedNeutralitySpan
open GQ2.Roe.Labute

open scoped IsMulCommutative

/-! ## Neutral classes inside the ordinary relative C source -/

/-- Include an exact character-neutral relative class into the ordinary relative layer. -/
noncomputable def oneHandleNeutralRelativeInclusion
    (j n : ℕ) (hjn : j ≤ n) :
    oneHandleNeutralRelativeLambdaImage j n →*
      oneHandleRelativeLambdaImage j n where
  toFun x := ⟨x.1, oneHandleNeutralRelativeLambdaImage_le_relative j n hjn x.2⟩
  map_one' := by
    apply Subtype.ext
    rfl
  map_mul' x y := by
    apply Subtype.ext
    rfl

/-- On a neutral source class, the relaxed and constrained `C` shifts agree. -/
theorem oneHandleBalancedCoreRelativeShiftCRelaxed_inclusion
    (p : OneHandleBalancedPoint) (k : ℕ) (hk : 3 ≤ k)
    (x : oneHandleNeutralRelativeLambdaImage (k - 1) (k + 1)) :
    oneHandleBalancedCoreRelativeShiftCRelaxed p k hk
        (oneHandleNeutralRelativeInclusion (k - 1) (k + 1) (by omega) x) =
      oneHandleBalancedCoreRelativeShiftC p k hk x := by
  apply Subtype.ext
  rw [oneHandleBalancedCoreRelativeShiftCRelaxed_apply,
    oneHandleBalancedCoreRelativeShiftC_apply]
  rfl

/-- Genuinely neutral source classes vanish in the W213 quotient map. -/
theorem oneHandleNeutralRelativeInclusion_range_le_neutralityClassHom_ker
    (p : OneHandleBalancedPoint) (k : ℕ) (hk : 3 ≤ k) :
    (oneHandleNeutralRelativeInclusion (k - 1) (k + 1) (by omega)).range ≤
      (oneHandleBalancedCoreNeutralityClassHom p k hk).ker := by
  rintro y ⟨x, rfl⟩
  rw [MonoidHom.mem_ker]
  apply (oneHandleBalancedCoreNeutralityClassHom_eq_one_iff p k hk _).mpr
  rw [oneHandleBalancedCoreRelativeShiftCRelaxed_inclusion p k hk x]
  exact (show (oneHandleBalancedCoreRelativeShiftC p k hk).range ≤
      oneHandleBalancedCoreCoordinateSpan p k hk from
    le_trans le_sup_left le_sup_right) ⟨x, rfl⟩

/-! ## The relative-C-mod-neutral source -/

/-- For `k ≥ 3`, the ordinary relative source layer is commutative in `Q_(k+1)`. -/
@[reducible] noncomputable def oneHandleRelativeLambdaImageIsMulCommutative
    (k : ℕ) (hk : 3 ≤ k) :
    IsMulCommutative (oneHandleRelativeLambdaImage (k - 1) (k + 1)) where
  is_comm := ⟨fun x y ↦ Subtype.ext
    (mul_comm_lambdaImage k hk x.2.1 y.2.1)⟩

/-- Ordinary relative `C` classes modulo the exact character-neutral classes. -/
abbrev OneHandleRelativeCModuloNeutral (k : ℕ) (hk : 3 ≤ k) :=
  oneHandleRelativeLambdaImage (k - 1) (k + 1) ⧸
    (oneHandleNeutralRelativeInclusion (k - 1) (k + 1) (by omega)).range

noncomputable instance oneHandleRelativeCModuloNeutral_group (k : ℕ) (hk : 3 ≤ k) :
    Group (OneHandleRelativeCModuloNeutral k hk) := by
  letI := oneHandleRelativeLambdaImageIsMulCommutative k hk
  dsimp [OneHandleRelativeCModuloNeutral]
  infer_instance

noncomputable instance oneHandleRelativeCModuloNeutral_finite (k : ℕ) (hk : 3 ≤ k) :
    Finite (OneHandleRelativeCModuloNeutral k hk) := by
  letI : Finite (levelQuot (DM 2 1) (k + 1)) :=
    finite_levelQuot (DM 2 1) (dmFinsetTopGen 2 1) (isProP_DM 2 1) (k + 1)
  dsimp [OneHandleRelativeCModuloNeutral]
  infer_instance

/-- The canonical projection from ordinary relative `C` classes to classes modulo neutral
representatives. -/
noncomputable def oneHandleRelativeCModuloNeutralMk (k : ℕ) (hk : 3 ≤ k) :
    oneHandleRelativeLambdaImage (k - 1) (k + 1) →*
      OneHandleRelativeCModuloNeutral k hk :=
  letI := oneHandleRelativeLambdaImageIsMulCommutative k hk
  QuotientGroup.mk'
    (oneHandleNeutralRelativeInclusion (k - 1) (k + 1) (by omega)).range

theorem oneHandleRelativeCModuloNeutralMk_surjective (k : ℕ) (hk : 3 ≤ k) :
    Function.Surjective (oneHandleRelativeCModuloNeutralMk k hk) := by
  letI := oneHandleRelativeLambdaImageIsMulCommutative k hk
  exact QuotientGroup.mk'_surjective
    (oneHandleNeutralRelativeInclusion (k - 1) (k + 1) (by omega)).range

/-- The W213 class map descended through genuinely neutral source classes. -/
noncomputable def oneHandleBalancedCoreNeutralitySourceFactor
    (p : OneHandleBalancedPoint) (k : ℕ) (hk : 3 ≤ k) :
    OneHandleRelativeCModuloNeutral k hk →*
      OneHandleBalancedCoreNeutralityCokernel p k hk :=
  letI := oneHandleRelativeLambdaImageIsMulCommutative k hk
  QuotientGroup.lift
      (oneHandleNeutralRelativeInclusion (k - 1) (k + 1) (by omega)).range
      (oneHandleBalancedCoreNeutralityClassHom p k hk)
      (oneHandleNeutralRelativeInclusion_range_le_neutralityClassHom_ker p k hk)

@[simp] theorem oneHandleBalancedCoreNeutralitySourceFactor_mk
    (p : OneHandleBalancedPoint) (k : ℕ) (hk : 3 ≤ k)
    (x : oneHandleRelativeLambdaImage (k - 1) (k + 1)) :
    oneHandleBalancedCoreNeutralitySourceFactor p k hk
        (oneHandleRelativeCModuloNeutralMk k hk x) =
      oneHandleBalancedCoreNeutralityClassHom p k hk x :=
  rfl

/-- Passing to relative `C` classes modulo neutral representatives loses no target class. -/
theorem oneHandleBalancedCoreNeutralitySourceFactor_surjective
    (p : OneHandleBalancedPoint) (k : ℕ) (hk : 3 ≤ k) :
    Function.Surjective (oneHandleBalancedCoreNeutralitySourceFactor p k hk) := by
  intro q
  obtain ⟨x, hx⟩ := oneHandleBalancedCoreNeutralityClassHom_surjective p k hk q
  refine ⟨oneHandleRelativeCModuloNeutralMk k hk x, ?_⟩
  simpa using hx

/-- A source quotient class dies exactly when one of its ordinary relative representatives
has relaxed `C` shift in the constrained four-coordinate span. -/
theorem oneHandleBalancedCoreNeutralitySourceFactor_eq_one_iff
    (p : OneHandleBalancedPoint) (k : ℕ) (hk : 3 ≤ k)
    (q : OneHandleRelativeCModuloNeutral k hk) :
    oneHandleBalancedCoreNeutralitySourceFactor p k hk q = 1 ↔
      ∃ x : oneHandleRelativeLambdaImage (k - 1) (k + 1),
        oneHandleRelativeCModuloNeutralMk k hk x = q ∧
          oneHandleBalancedCoreRelativeShiftCRelaxed p k hk x ∈
            oneHandleBalancedCoreCoordinateSpan p k hk := by
  obtain ⟨x, rfl⟩ := oneHandleRelativeCModuloNeutralMk_surjective k hk q
  rw [oneHandleBalancedCoreNeutralitySourceFactor_mk,
    oneHandleBalancedCoreNeutralityClassHom_eq_one_iff]
  constructor
  · intro h
    exact ⟨x, rfl, h⟩
  · rintro ⟨y, hy, hmem⟩
    have hclass :
        oneHandleBalancedCoreNeutralityClassHom p k hk y =
          oneHandleBalancedCoreNeutralityClassHom p k hk x := by
      rw [← oneHandleBalancedCoreNeutralitySourceFactor_mk,
        ← oneHandleBalancedCoreNeutralitySourceFactor_mk, hy]
    apply (oneHandleBalancedCoreNeutralityClassHom_eq_one_iff p k hk x).mp
    exact hclass.symm.trans
      ((oneHandleBalancedCoreNeutralityClassHom_eq_one_iff p k hk y).mpr hmem)

/-! ## Exact residual interaction quotient -/

/-- The remaining relations among ordinary `C` classes after neutral representatives have
already been removed. -/
def oneHandleBalancedCoreNeutralityInteraction
    (p : OneHandleBalancedPoint) (k : ℕ) (hk : 3 ≤ k) :
    Subgroup (OneHandleRelativeCModuloNeutral k hk) :=
  (oneHandleBalancedCoreNeutralitySourceFactor p k hk).ker

noncomputable instance oneHandleBalancedCoreNeutralityInteraction_normal
    (p : OneHandleBalancedPoint) (k : ℕ) (hk : 3 ≤ k) :
    (oneHandleBalancedCoreNeutralityInteraction p k hk).Normal := by
  dsimp [oneHandleBalancedCoreNeutralityInteraction]
  infer_instance

/-- The W212 neutrality cokernel is exactly the relative-`C`-mod-neutral source modulo the
remaining coordinate-interaction kernel. -/
noncomputable def oneHandleBalancedCoreNeutralityCokernelEquiv
    (p : OneHandleBalancedPoint) (k : ℕ) (hk : 3 ≤ k) :
    (OneHandleRelativeCModuloNeutral k hk ⧸
        oneHandleBalancedCoreNeutralityInteraction p k hk) ≃*
      OneHandleBalancedCoreNeutralityCokernel p k hk :=
  QuotientGroup.quotientKerEquivOfSurjective
    (oneHandleBalancedCoreNeutralitySourceFactor p k hk)
    (oneHandleBalancedCoreNeutralitySourceFactor_surjective p k hk)

