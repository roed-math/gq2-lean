local notation "ℚ̄₂" => AlgebraicClosure ℚ_[2]

/-! ## §1 The abelianization frame of `D_sq h`

The `NFrameExists.lean` construction, adapted to the square relator.  Coordinates on
`D_sq(h)^{ab}`, written against the generator basis `σ̄ = ḡ₀, x̄₀ = ḡ₁, x̄₁ = ḡ₂, handles`:

* the free `σ̄`-coordinate (`oddSeamSHom`): `σ̄ ↦ 1`, all else `0`;
* the free `x̄₀`-coordinate (`oddSeamXHom`): `x̄₀ ↦ 1`, `x̄₁ ↦ 2`, all else `0` — the two-slot
  functional dual to `x̄₀` in the Smith basis `(σ̄, x̄₀, t = x̄₁ − 2x̄₀)`;
* the torsion coordinate (`oddSeamTHom`): `x̄₁ ↦ 1` into `ℤ/2`, all else `0`;
* the `2h` handle coordinates (`oddSeamHHom`).

Each is a well-defined character because it kills the relation vector `−4x̄₀ + 2x̄₁`:
`−4·1 + 2·2 = 0` for the `x̄₀`-row, `2·1 = 0` in `ℤ/2` for the torsion row, `0` for the rest. -/

section AbFrame

/-- **`D_sq^{ab}` is pro-2**, the continuous surjective image of the pro-2 group `D_sq h`. -/
theorem oddSeam_isProP_topAb (h : ℕ) : IsProP 2 (topAbelianization (DSq h : Type)) :=
  isProP_of_surjective abMk continuous_abMk abMk_surjective (isProP_DSq h)

/-- **The abelianized relation**: `x̄₀⁻⁴ · x̄₁² = 1` in `D_sq(h)^{ab}` — the relator's abelian
collapse `ρ_sq = −4x̄₀ + 2x̄₁` (`sqRelWord_comm`), with the handles contributing nothing. -/
theorem oddSeam_abRel (h : ℕ) :
    ((abMk (dsqX0 h) : topAbelianization (DSq h : Type)) ^ 4)⁻¹ * abMk (dsqX1 h) ^ 2 = 1 := by
  have hrel : abMk (sqRelWord (sqGen h)) = (1 : topAbelianization (DSq h : Type)) := by
    rw [dsq_relation, map_one]
  rw [map_sqRelWord] at hrel
  rw [sqRelWord_comm] at hrel
  exact hrel

/-- **The torsion generator** `t = x̄₁ − 2x̄₀` of `D_sq(h)^{ab}` (written multiplicatively:
`x̄₀⁻² x̄₁`), the second vector of the Smith basis. -/
def oddSeamT (h : ℕ) : topAbelianization (DSq h : Type) :=
  ((abMk (sqGen h 1) : topAbelianization (DSq h : Type)) ^ 2)⁻¹ * abMk (sqGen h 2)

/-- `t² = 1`: the square of the torsion generator is the abelianized relation. -/
theorem oddSeamT_sq (h : ℕ) : oddSeamT h ^ 2 = 1 := by
  calc oddSeamT h ^ 2
      = (((abMk (sqGen h 1) : topAbelianization (DSq h : Type)) ^ 2)⁻¹) ^ 2
          * abMk (sqGen h 2) ^ 2 := mul_pow _ _ 2
    _ = ((abMk (sqGen h 1) : topAbelianization (DSq h : Type)) ^ 4)⁻¹
          * abMk (sqGen h 2) ^ 2 := by rw [inv_pow, ← pow_mul]
    _ = 1 := oddSeam_abRel h

/-! ### Index bookkeeping: the flat handle index `3 + k` -/

/-- The flat handle index: the `k`-th handle letter sits at `3 + k` (so `u_j` is `k = 2j` and
`v_j` is `k = 2j + 1`). -/
def oddSeamHandleIdx {h : ℕ} (k : Fin (2 * h)) : Fin (sqRank h) :=
  ⟨3 + k, by have := k.isLt; simp only [sqRank]; omega⟩

theorem oddSeamHandleIdx_val {h : ℕ} (k : Fin (2 * h)) :
    ((oddSeamHandleIdx k : Fin (sqRank h)) : ℕ) = 3 + k := rfl

/-- The index split of `Fin (sqRank h)`: three core letters and `2h` flat handle slots. -/
theorem oddSeamIdx_cases {h : ℕ} (i : Fin (sqRank h)) :
    i = 0 ∨ i = 1 ∨ i = 2 ∨ ∃ k : Fin (2 * h), i = oddSeamHandleIdx k := by
  have hlt : (i : ℕ) < 3 + 2 * h := i.isLt
  by_cases h0 : (i : ℕ) = 0
  · exact Or.inl (Fin.val_injective (h0.trans (sqVal_zero h).symm))
  by_cases h1 : (i : ℕ) = 1
  · exact Or.inr (Or.inl (Fin.val_injective (h1.trans (sqVal_one h).symm)))
  by_cases h2 : (i : ℕ) = 2
  · exact Or.inr (Or.inr (Or.inl (Fin.val_injective (h2.trans (sqVal_two h).symm))))
  refine Or.inr (Or.inr (Or.inr ⟨⟨(i : ℕ) - 3, by omega⟩, Fin.val_injective ?_⟩))
  rw [oddSeamHandleIdx_val]
  show (i : ℕ) = 3 + ((i : ℕ) - 3)
  omega

theorem oddSeamOne_ne_handleIdx {h : ℕ} (k : Fin (2 * h)) :
    (1 : Fin (sqRank h)) ≠ oddSeamHandleIdx k := fun e => by
  have hv := congrArg Fin.val e
  rw [sqVal_one, oddSeamHandleIdx_val] at hv
  omega

theorem oddSeamTwo_ne_handleIdx {h : ℕ} (k : Fin (2 * h)) :
    (2 : Fin (sqRank h)) ≠ oddSeamHandleIdx k := fun e => by
  have hv := congrArg Fin.val e
  rw [sqVal_two, oddSeamHandleIdx_val] at hv
  omega

/-! ### The two marking shapes -/

section Marks

variable {G : Type*} [Group G] {h : ℕ}

/-- A marking supported at the three core slots: `a` at `σ`, `b` at `x₀`, `c` at `x₁`, `1` on
every handle. -/
def oddSeamCoreMark (a b c : G) : Fin (sqRank h) → G := fun i =>
  if (i : ℕ) = 0 then a else if (i : ℕ) = 1 then b else if (i : ℕ) = 2 then c else 1

@[simp] theorem oddSeamCoreMark_zero (a b c : G) :
    oddSeamCoreMark a b c (0 : Fin (sqRank h)) = a := by
  rw [oddSeamCoreMark, if_pos (sqVal_zero h)]

@[simp] theorem oddSeamCoreMark_one (a b c : G) :
    oddSeamCoreMark a b c (1 : Fin (sqRank h)) = b := by
  rw [oddSeamCoreMark, if_neg (by rw [sqVal_one]; omega), if_pos (sqVal_one h)]

@[simp] theorem oddSeamCoreMark_two (a b c : G) :
    oddSeamCoreMark a b c (2 : Fin (sqRank h)) = c := by
  rw [oddSeamCoreMark, if_neg (by rw [sqVal_two]; omega), if_neg (by rw [sqVal_two]; omega),
    if_pos (sqVal_two h)]

/-- The slotwise vanishing criterion for a core marking. -/
theorem oddSeamCoreMark_eq_one {a b c : G} (i : Fin (sqRank h))
    (ha : (i : ℕ) = 0 → a = 1) (hb : (i : ℕ) = 1 → b = 1) (hc : (i : ℕ) = 2 → c = 1) :
    oddSeamCoreMark a b c i = 1 := by
  rw [oddSeamCoreMark]
  split_ifs with h0 h1 h2
  exacts [ha h0, hb h1, hc h2, rfl]

/-- A marking supported at one flat handle slot. -/
def oddSeamHandleMark (k : Fin (2 * h)) (x : G) : Fin (sqRank h) → G := fun i =>
  if i = oddSeamHandleIdx k then x else 1

@[simp] theorem oddSeamHandleMark_self (k : Fin (2 * h)) (x : G) :
    oddSeamHandleMark k x (oddSeamHandleIdx k) = x := if_pos rfl

theorem oddSeamHandleMark_of_ne (k : Fin (2 * h)) (x : G) {i : Fin (sqRank h)}
    (hi : i ≠ oddSeamHandleIdx k) : oddSeamHandleMark k x i = 1 := if_neg hi

end Marks

/-! ### The coordinate hom builder, and the four coordinate families -/

section CoordHoms

variable {H : Type} [CommGroup H] [TopologicalSpace H] [IsTopologicalGroup H] [CompactSpace H]
  [T2Space H] [TotallyDisconnectedSpace H]

/-- **The square-side coordinate hom builder**: a marking of a commutative pro-2 group killing
the abelianized relation vector `−4·(m 1) + 2·(m 2)` classifies a continuous hom
`D_sq^{ab} → H`, by `sqLiftHom` then `abLiftG`.  The square twin of `nCoordHom`. -/
def oddSeamCoordHom (h : ℕ) (hH : IsProP 2 H) (m : Fin (sqRank h) → H)
    (hrel : (m 1 ^ 4)⁻¹ * m 2 ^ 2 = 1) :
    ContinuousMonoidHom (topAbelianization (DSq h : Type)) H :=
  abLiftG (sqLiftHom h hH m (by rw [sqRelWord_comm]; exact hrel))

@[simp] theorem oddSeamCoordHom_gen (h : ℕ) (hH : IsProP 2 H) (m : Fin (sqRank h) → H)
    (hrel : (m 1 ^ 4)⁻¹ * m 2 ^ 2 = 1) (i : Fin (sqRank h)) :
    oddSeamCoordHom h hH m hrel (abMk (sqGen h i)) = m i := by
  rw [oddSeamCoordHom, abLiftG_abMk, sqLiftHom_gen]

end CoordHoms

/-- **The torsion coordinate** `x̄₁ ↦ 1` into `ℤ/2`, everything else `↦ 0`.  Relator check:
`2·1 = 0` in `ℤ/2`. -/
def oddSeamTHom (h : ℕ) :
    ContinuousMonoidHom (topAbelianization (DSq h : Type)) (Multiplicative (ZMod 2)) :=
  oddSeamCoordHom h isProP_two_multZMod2 (oddSeamCoreMark 1 1 (ofAdd (1 : ZMod 2))) (by
    rw [oddSeamCoreMark_one, oddSeamCoreMark_two]
    decide)

/-- The free `σ̄`-coordinate: `σ̄ ↦ 1`, everything else `↦ 0`.  Relator check: `0 = 0`. -/
def oddSeamSHom (h : ℕ) :
    ContinuousMonoidHom (topAbelianization (DSq h : Type)) (Multiplicative ℤ_[2]) :=
  oddSeamCoordHom h PropOneOne.isProP_two_multPadicInt
    (oddSeamCoreMark (ofAdd (1 : ℤ_[2])) 1 1) (by
      rw [oddSeamCoreMark_one, oddSeamCoreMark_two, one_pow, one_pow, inv_one, one_mul])

/-- **The free `x̄₀`-coordinate**, the two-slot functional `x̄₀ ↦ 1, x̄₁ ↦ 2`: the dual of
`x̄₀` in the Smith basis `(σ̄, x̄₀, t)`.  Relator check: `−4·1 + 2·2 = 0` — this is the one
coordinate that sees the relation vector pair the two wild letters. -/
def oddSeamXHom (h : ℕ) :
    ContinuousMonoidHom (topAbelianization (DSq h : Type)) (Multiplicative ℤ_[2]) :=
  oddSeamCoordHom h PropOneOne.isProP_two_multPadicInt
    (oddSeamCoreMark 1 (ofAdd (1 : ℤ_[2])) (ofAdd (2 : ℤ_[2]))) (by
      rw [oddSeamCoreMark_one, oddSeamCoreMark_two, ← ofAdd_nsmul, ← ofAdd_nsmul, ← ofAdd_neg,
        ← ofAdd_add, ← ofAdd_zero]
      congr 1
      rw [nsmul_eq_mul, nsmul_eq_mul]
      norm_num)

/-- The `2h` handle coordinates.  The relator check is vacuous: handles never meet the
relation vector. -/
def oddSeamHHom (h : ℕ) (k : Fin (2 * h)) :
    ContinuousMonoidHom (topAbelianization (DSq h : Type)) (Multiplicative ℤ_[2]) :=
  oddSeamCoordHom h PropOneOne.isProP_two_multPadicInt
    (oddSeamHandleMark k (ofAdd (1 : ℤ_[2]))) (by
      rw [oddSeamHandleMark_of_ne k _ (oddSeamOne_ne_handleIdx k),
        oddSeamHandleMark_of_ne k _ (oddSeamTwo_ne_handleIdx k), one_pow, one_pow, inv_one,
        one_mul])

/-! ### Coordinate surjectivity of `D_sq^{ab}` -/

section Coord

variable (h : ℕ)

/-- The `ℤ₂`-power word `∏ᵢ ḡᵢ^{cᵢ}` in the marked generators of `D_sq^{ab}`. -/
def oddSeamAbWord (c : Fin (sqRank h) → ℤ_[2]) : topAbelianization (DSq h : Type) :=
  ∏ i, zpowZtwo (oddSeam_isProP_topAb h) (abMk (sqGen h i)) (c i)

/-- `oddSeamAbWord` as a monoid hom out of `ℤ₂^{3+2h}`. -/
def oddSeamAbWordHom :
    Multiplicative (Fin (sqRank h) → ℤ_[2]) →* topAbelianization (DSq h : Type) where
  toFun c := oddSeamAbWord h c.toAdd
  map_one' := by
    refine Finset.prod_eq_one fun i _ => ?_
    show zpowZtwo (oddSeam_isProP_topAb h) (abMk (sqGen h i)) 0 = 1
    exact zpowZtwo_zero _ _
  map_mul' c d := by
    show ∏ i, zpowZtwo (oddSeam_isProP_topAb h) (abMk (sqGen h i)) (c.toAdd i + d.toAdd i)
      = (∏ i, zpowZtwo (oddSeam_isProP_topAb h) (abMk (sqGen h i)) (c.toAdd i))
        * ∏ i, zpowZtwo (oddSeam_isProP_topAb h) (abMk (sqGen h i)) (d.toAdd i)
    rw [← Finset.prod_mul_distrib]
    exact Finset.prod_congr rfl fun i _ => zpowZtwo_add _ _ _ _

theorem oddSeam_continuous_abWordHom : Continuous (oddSeamAbWordHom h) := by
  show Continuous fun c : Multiplicative (Fin (sqRank h) → ℤ_[2]) =>
    ∏ i, zpowZtwo (oddSeam_isProP_topAb h) (abMk (sqGen h i)) (c.toAdd i)
  exact continuous_finsetProd _ fun i _ =>
    (continuous_zpowZtwo _ _).comp ((continuous_apply i).comp continuous_toAdd)

theorem oddSeamAbWordHom_single (i : Fin (sqRank h)) :
    oddSeamAbWordHom h (ofAdd (Pi.single i (1 : ℤ_[2]))) = abMk (sqGen h i) := by
  show ∏ j, zpowZtwo (oddSeam_isProP_topAb h) (abMk (sqGen h j))
    ((Pi.single i (1 : ℤ_[2]) : Fin (sqRank h) → ℤ_[2]) j) = _
  rw [Finset.prod_eq_single i (fun j _ hj => by
    rw [Pi.single_eq_of_ne hj, zpowZtwo_zero]) (fun hi => absurd (Finset.mem_univ i) hi)]
  rw [Pi.single_eq_same, zpowZtwo_one_exp]

/-- **Coordinate surjectivity of `D_sq^{ab}`**: every element is a `ℤ₂`-power word
`σ̄^{c₀}·x̄₀^{c₁}·x̄₁^{c₂}·∏ₖ …` in the marked generators. -/
theorem oddSeam_topAb_coord (z : topAbelianization (DSq h : Type)) :
    ∃ c : Fin (sqRank h) → ℤ_[2], z = oddSeamAbWord h c := by
  have hgen : (Subgroup.closure (⇑abMk '' Set.range (sqGen h))).topologicalClosure = ⊤ := by
    have := abMk_surjective.denseRange.topologicalClosure_map_subgroup
      (continuous_abMk (G := (DSq h : Type))) (dsq_topGen h)
    rwa [MonoidHom.map_closure] at this
  have hclosed : IsClosed ((oddSeamAbWordHom h).range :
      Set (topAbelianization (DSq h : Type))) := by
    rw [MonoidHom.coe_range]
    exact (isCompact_range (oddSeam_continuous_abWordHom h)).isClosed
  have hsub : Subgroup.closure (⇑abMk '' Set.range (sqGen h)) ≤ (oddSeamAbWordHom h).range := by
    rw [Subgroup.closure_le]
    rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
    exact ⟨ofAdd (Pi.single i 1), oddSeamAbWordHom_single h i⟩
  have htop : (oddSeamAbWordHom h).range = ⊤ :=
    eq_top_iff.mpr (hgen ▸ Subgroup.topologicalClosure_minimal _ hsub hclosed)
  have hz : z ∈ (oddSeamAbWordHom h).range := by rw [htop]; exact Subgroup.mem_top z
  obtain ⟨p, hp⟩ := MonoidHom.mem_range.mp hz
  exact ⟨p.toAdd, hp.symm⟩

end Coord

/-! ### Reading a coordinate hom off a word -/

section Words

variable {H : Type} [CommGroup H] [TopologicalSpace H] [IsTopologicalGroup H] [CompactSpace H]
  [T2Space H] [TotallyDisconnectedSpace H]

/-- A marking supported at one slot pairs with a word through that slot only. -/
theorem oddSeamProd_single {h : ℕ} (hH : IsProP 2 H) (m : Fin (sqRank h) → H)
    (c : Fin (sqRank h) → ℤ_[2]) (i₀ : Fin (sqRank h)) (hm : ∀ i, i ≠ i₀ → m i = 1) :
    ∏ i, zpowZtwo hH (m i) (c i) = zpowZtwo hH (m i₀) (c i₀) :=
  Finset.prod_eq_single i₀ (fun j _ hj => by rw [hm j hj, zpowZtwo_one_base])
    (fun hi => absurd (Finset.mem_univ i₀) hi)

/-- A marking supported at two slots pairs with a word through those two slots only. -/
theorem oddSeamProd_pair {h : ℕ} (hH : IsProP 2 H) (m : Fin (sqRank h) → H)
    (c : Fin (sqRank h) → ℤ_[2]) {i₀ i₁ : Fin (sqRank h)} (hne : i₀ ≠ i₁)
    (hm : ∀ i, i ≠ i₀ → i ≠ i₁ → m i = 1) :
    ∏ i, zpowZtwo hH (m i) (c i)
      = zpowZtwo hH (m i₀) (c i₀) * zpowZtwo hH (m i₁) (c i₁) := by
  rw [← Finset.prod_pair (f := fun i => zpowZtwo hH (m i) (c i)) hne]
  refine (Finset.prod_subset (Finset.subset_univ _) ?_).symm
  intro i _ hi
  simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hi
  rw [hm i hi.1 hi.2, zpowZtwo_one_base]

/-- A coordinate hom on a `ℤ₂`-power word: apply the marking slotwise. -/
theorem oddSeamCoordHom_word {h : ℕ} (hH : IsProP 2 H) (m : Fin (sqRank h) → H)
    (hrel : (m 1 ^ 4)⁻¹ * m 2 ^ 2 = 1) (c : Fin (sqRank h) → ℤ_[2]) :
    oddSeamCoordHom h hH m hrel (oddSeamAbWord h c) = ∏ i, zpowZtwo hH (m i) (c i) := by
  rw [oddSeamAbWord, map_prod]
  exact Finset.prod_congr rfl fun i _ => by
    rw [map_zpowZtwo (oddSeam_isProP_topAb h) hH, oddSeamCoordHom_gen]

end Words

section WordFormulas

variable (h : ℕ) (c : Fin (sqRank h) → ℤ_[2])

/-- The `σ̄`-coordinate of a word is its `σ̄`-exponent. -/
theorem oddSeamSHom_word : oddSeamSHom h (oddSeamAbWord h c) = ofAdd (c 0) := by
  rw [oddSeamSHom, oddSeamCoordHom_word, oddSeamProd_single _ _ _ 0 (fun i hi =>
    oddSeamCoreMark_eq_one i
      (fun h0 => absurd (Fin.val_injective (h0.trans (sqVal_zero h).symm)) hi)
      (fun _ => rfl) (fun _ => rfl)), oddSeamCoreMark_zero, zpowZtwo_ofAdd, one_mul]

/-- The `x̄₀`-coordinate of a word: the two-slot functional reads `c₁ + 2c₂`. -/
theorem oddSeamXHom_word : oddSeamXHom h (oddSeamAbWord h c) = ofAdd (c 1 + 2 * c 2) := by
  rw [oddSeamXHom, oddSeamCoordHom_word, oddSeamProd_pair _ _ _ (sqOne_ne_two h) (fun i hi1 hi2 =>
    oddSeamCoreMark_eq_one i (fun _ => rfl)
      (fun h1 => absurd (Fin.val_injective (h1.trans (sqVal_one h).symm)) hi1)
      (fun h2 => absurd (Fin.val_injective (h2.trans (sqVal_two h).symm)) hi2)),
    oddSeamCoreMark_one, oddSeamCoreMark_two, zpowZtwo_ofAdd, zpowZtwo_ofAdd, ← ofAdd_add,
    one_mul]

/-- The torsion coordinate of a word: only the `x̄₁`-exponent contributes, through `ℤ/2`. -/
theorem oddSeamTHom_word : oddSeamTHom h (oddSeamAbWord h c)
    = zpowZtwo isProP_two_multZMod2 (ofAdd (1 : ZMod 2)) (c 2) := by
  rw [oddSeamTHom, oddSeamCoordHom_word, oddSeamProd_single _ _ _ 2 (fun i hi =>
    oddSeamCoreMark_eq_one i (fun _ => rfl) (fun _ => rfl)
      (fun h2 => absurd (Fin.val_injective (h2.trans (sqVal_two h).symm)) hi)),
    oddSeamCoreMark_two]

/-- The `k`-th handle coordinate of a word is its `k`-th handle exponent. -/
theorem oddSeamHHom_word (k : Fin (2 * h)) :
    oddSeamHHom h k (oddSeamAbWord h c) = ofAdd (c (oddSeamHandleIdx k)) := by
  rw [oddSeamHHom, oddSeamCoordHom_word, oddSeamProd_single _ _ _ (oddSeamHandleIdx k)
    (fun i hi => oddSeamHandleMark_of_ne k _ hi), oddSeamHandleMark_self, zpowZtwo_ofAdd,
    one_mul]

end WordFormulas

/-! ### The model, and its torsion -/

/-- **The abelianization model of the square family**: `ℤ/2 × ℤ₂² × ℤ₂^{2h}`, coordinates
`(t, σ̄, x̄₀, handles)`.  Rank `2 + 2h` free part — one less than `NFrameModel h`, because the
square relation vector consumes one generator where the `N` vector consumes none. -/
abbrev OddSeamModel (h : ℕ) : Type :=
  Multiplicative (ZMod 2 × ℤ_[2] × ℤ_[2] × (Fin (2 * h) → ℤ_[2]))

section ModelTorsion

/-- A `ℤ₂` killed by a positive natural number is zero. -/
private lemma oddSeam_nsmul_eq_zero {n : ℕ} (hn : 0 < n) {b : ℤ_[2]} (hb : n • b = 0) :
    b = 0 := by
  rw [nsmul_eq_mul] at hb
  rcases mul_eq_zero.mp hb with h1 | h1
  · exact absurd h1 (Nat.cast_ne_zero.mpr hn.ne')
  · exact h1

/-- A finite-order element of the model has zero `ℤ₂`-components. -/
private lemma oddSeamFinOrder_model {h : ℕ} {a : ZMod 2} {b c : ℤ_[2]}
    {f : Fin (2 * h) → ℤ_[2]} (hfin : IsOfFinOrder (ofAdd (a, b, c, f) : OddSeamModel h)) :
    b = 0 ∧ c = 0 ∧ f = 0 := by
  rw [isOfFinOrder_iff_pow_eq_one] at hfin
  obtain ⟨n, hn, hpow⟩ := hfin
  rw [← ofAdd_nsmul, ← ofAdd_zero] at hpow
  have hz := Multiplicative.ofAdd.injective hpow
  have hb : n • b = 0 := congrArg (fun p => p.2.1) hz
  have hc : n • c = 0 := congrArg (fun p => p.2.2.1) hz
  have hf : n • f = 0 := congrArg (fun p => p.2.2.2) hz
  refine ⟨oddSeam_nsmul_eq_zero hn hb, oddSeam_nsmul_eq_zero hn hc, funext fun i => ?_⟩
  have hfi : n • f i = 0 := by
    have hfi' := congrFun hf i
    rwa [Pi.smul_apply] at hfi'
  exact oddSeam_nsmul_eq_zero hn hfi

/-- **Torsion of the model**: the finite-order subtype of `ℤ/2 × ℤ₂^{2+2h}` is `ℤ/2`, at every
handle count. -/
def oddSeamTorsionEquiv (h : ℕ) : {z : OddSeamModel h // IsOfFinOrder z} ≃ ZMod 2 where
  toFun z := z.1.toAdd.1
  invFun a := ⟨ofAdd (a, 0, 0, 0), by
    rw [isOfFinOrder_iff_pow_eq_one]
    refine ⟨2, by norm_num, ?_⟩
    rw [← ofAdd_nsmul, ← ofAdd_zero]
    congr 1
    refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_))
    · show (2 : ℕ) • a = 0
      exact (by decide : ∀ b : ZMod 2, (2 : ℕ) • b = 0) a
    all_goals simp⟩
  left_inv := by
    rintro ⟨z, hz⟩
    apply Subtype.ext
    have hz' : IsOfFinOrder (ofAdd
        (z.toAdd.1, z.toAdd.2.1, z.toAdd.2.2.1, z.toAdd.2.2.2) : OddSeamModel h) := by
      rw [show (z.toAdd.1, z.toAdd.2.1, z.toAdd.2.2.1, z.toAdd.2.2.2) = z.toAdd from rfl,
        ofAdd_toAdd]
      exact hz
    obtain ⟨hb, hc, hf⟩ := oddSeamFinOrder_model hz'
    show (ofAdd (z.toAdd.1, (0 : ℤ_[2]), (0 : ℤ_[2]), (0 : Fin (2 * h) → ℤ_[2]))
      : OddSeamModel h) = z
    conv_rhs => rw [← ofAdd_toAdd z]
    exact congrArg ofAdd (Prod.ext rfl (Prod.ext hb.symm (Prod.ext hc.symm hf.symm)))
  right_inv a := rfl

end ModelTorsion

/-! ### The combined coordinate hom, and its bijectivity -/

section Phi

variable (h : ℕ)

/-- **The combined coordinate hom** `φ_sq : D_sq^{ab} → ℤ/2 ⊕ ℤ₂² ⊕ ℤ₂^{2h}`. -/
def oddSeamPhiHom : topAbelianization (DSq h : Type) →* OddSeamModel h where
  toFun z := ofAdd ((oddSeamTHom h z).toAdd, (oddSeamSHom h z).toAdd, (oddSeamXHom h z).toAdd,
    fun k => (oddSeamHHom h k z).toAdd)
  map_one' := by
    simp only [map_one, toAdd_one]
    rfl
  map_mul' x y := by
    simp only [map_mul, toAdd_mul]
    rw [← ofAdd_add]
    rfl

/-- `φ_sq` on a `ℤ₂`-power word, all four coordinate families at once. -/
theorem oddSeamPhiHom_word (c : Fin (sqRank h) → ℤ_[2]) :
    oddSeamPhiHom h (oddSeamAbWord h c)
      = ofAdd ((zpowZtwo isProP_two_multZMod2 (ofAdd (1 : ZMod 2)) (c 2)).toAdd, c 0,
          c 1 + 2 * c 2, fun k => c (oddSeamHandleIdx k)) := by
  show ofAdd (_, _, _, _) = _
  rw [oddSeamTHom_word, oddSeamSHom_word, oddSeamXHom_word]
  simp only [toAdd_ofAdd]
  congr 1
  exact congrArg _ (congrArg _ (congrArg _
    (funext fun k => by rw [oddSeamHHom_word, toAdd_ofAdd])))

/-- A word whose exponents vanish off the two wild slots is the two-slot product. -/
theorem oddSeamAbWord_pair (c : Fin (sqRank h) → ℤ_[2])
    (hc : ∀ i, i ≠ 1 → i ≠ 2 → c i = 0) :
    oddSeamAbWord h c
      = zpowZtwo (oddSeam_isProP_topAb h) (abMk (sqGen h 1)) (c 1)
        * zpowZtwo (oddSeam_isProP_topAb h) (abMk (sqGen h 2)) (c 2) := by
  rw [oddSeamAbWord, ← Finset.prod_pair
    (f := fun i => zpowZtwo (oddSeam_isProP_topAb h) (abMk (sqGen h i)) (c i)) (sqOne_ne_two h)]
  refine (Finset.prod_subset (Finset.subset_univ _) ?_).symm
  intro i _ hi
  simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hi
  rw [hc i hi.1 hi.2, zpowZtwo_zero]

/-- **Injectivity of `φ_sq`.**  Killing the free coordinates leaves a word supported at the two
wild slots with `c₁ = −2c₂`, i.e. a `ℤ₂`-power of the torsion generator `t`; the torsion
coordinate then says the exponent is even, and `t² = 1` finishes. -/
theorem oddSeamPhiHom_injective : Function.Injective (oddSeamPhiHom h) := by
  rw [injective_iff_map_eq_one]
  intro z hz
  obtain ⟨c, rfl⟩ := oddSeam_topAb_coord h z
  rw [oddSeamPhiHom_word] at hz
  have hv := Multiplicative.ofAdd.injective (hz.trans
    (show (1 : OddSeamModel h) = ofAdd ((0 : ZMod 2), (0 : ℤ_[2]), (0 : ℤ_[2]),
      (0 : Fin (2 * h) → ℤ_[2])) from rfl))
  rw [Prod.mk.injEq, Prod.mk.injEq, Prod.mk.injEq] at hv
  obtain ⟨hvt, hv0, hvx, hvh⟩ := hv
  -- every exponent off the two wild slots vanishes
  have hc0 : ∀ i, i ≠ 1 → i ≠ 2 → c i = 0 := by
    intro i hi1 hi2
    rcases oddSeamIdx_cases i with rfl | rfl | rfl | ⟨k, rfl⟩
    · exact hv0
    · exact absurd rfl hi1
    · exact absurd rfl hi2
    · exact congrFun hvh k
  -- the torsion coordinate says the `x̄₁`-exponent is even
  have hval2 : (PadicInt.toZModPow 1 (c 2)).val = 0 := by
    rw [zpowZtwo_of_sq_eq_one isProP_two_multZMod2 (ofAdd (1 : ZMod 2)) (by decide) (c 2)]
      at hvt
    have hlt : (PadicInt.toZModPow (p := 2) 1 (c 2)).val < 2 := by
      have := ZMod.val_lt (PadicInt.toZModPow (p := 2) 1 (c 2))
      simpa using this
    rcases (by omega : (PadicInt.toZModPow 1 (c 2)).val = 0
        ∨ (PadicInt.toZModPow 1 (c 2)).val = 1) with h0 | h1
    · exact h0
    · rw [h1, pow_one, toAdd_ofAdd] at hvt
      exact absurd hvt (by decide)
  have hc1 : c 1 = -(2 * c 2) := eq_neg_of_add_eq_zero_left hvx
  rw [oddSeamAbWord_pair h c hc0, hc1]
  have hneg : ∀ (x : topAbelianization (DSq h : Type)) (a : ℤ_[2]),
      zpowZtwo (oddSeam_isProP_topAb h) x (-a)
        = (zpowZtwo (oddSeam_isProP_topAb h) x a)⁻¹ := fun x a =>
    eq_inv_of_mul_eq_one_left (by rw [← zpowZtwo_add, neg_add_cancel, zpowZtwo_zero])
  have hinv : ∀ (x : topAbelianization (DSq h : Type)) (a : ℤ_[2]),
      zpowZtwo (oddSeam_isProP_topAb h) x⁻¹ a
        = (zpowZtwo (oddSeam_isProP_topAb h) x a)⁻¹ := fun x a =>
    eq_inv_of_mul_eq_one_left (by rw [← zpowZtwo_mul_base, inv_mul_cancel, zpowZtwo_one_base])
  have htwo : zpowZtwo (oddSeam_isProP_topAb h) (abMk (sqGen h 1)) (2 * c 2)
      = zpowZtwo (oddSeam_isProP_topAb h) ((abMk (sqGen h 1)
          : topAbelianization (DSq h : Type)) ^ 2) (c 2) := by
    rw [← zpowZtwo_zpowZtwo]
    congr 1
    rw [show ((2 : ℤ_[2])) = ((2 : ℕ) : ℤ_[2]) by norm_num, zpowZtwo_natCast]
  rw [hneg, htwo, ← hinv, ← zpowZtwo_mul_base]
  rw [show (((abMk (sqGen h 1) : topAbelianization (DSq h : Type)) ^ 2)⁻¹ * abMk (sqGen h 2))
    = oddSeamT h from rfl]
  rw [zpowZtwo_of_sq_eq_one (oddSeam_isProP_topAb h) _ (oddSeamT_sq h) (c 2), hval2, pow_zero]

/-- The exponent vector realizing a prescribed coordinate tuple: the `x̄₀`-slot compensates the
torsion representative by `−2·a`. -/
def oddSeamSurjVec {h : ℕ} (a : ZMod 2) (s x : ℤ_[2]) (f : Fin (2 * h) → ℤ_[2]) :
    Fin (sqRank h) → ℤ_[2] := fun i =>
  if (i : ℕ) = 0 then s else
  if (i : ℕ) = 1 then x - 2 * ((a.val : ℤ_[2])) else
  if (i : ℕ) = 2 then ((a.val : ℤ_[2])) else
  if hk : (i : ℕ) - 3 < 2 * h then f ⟨(i : ℕ) - 3, hk⟩ else 0

section SurjVec

variable {h : ℕ} (a : ZMod 2) (s x : ℤ_[2]) (f : Fin (2 * h) → ℤ_[2])

@[simp] theorem oddSeamSurjVec_zero : oddSeamSurjVec a s x f 0 = s := by
  rw [oddSeamSurjVec, if_pos (sqVal_zero h)]

@[simp] theorem oddSeamSurjVec_one :
    oddSeamSurjVec a s x f 1 = x - 2 * ((a.val : ℤ_[2])) := by
  rw [oddSeamSurjVec, if_neg (by rw [sqVal_one]; omega), if_pos (sqVal_one h)]

@[simp] theorem oddSeamSurjVec_two : oddSeamSurjVec a s x f 2 = ((a.val : ℤ_[2])) := by
  rw [oddSeamSurjVec, if_neg (by rw [sqVal_two]; omega), if_neg (by rw [sqVal_two]; omega),
    if_pos (sqVal_two h)]

@[simp] theorem oddSeamSurjVec_handle (k : Fin (2 * h)) :
    oddSeamSurjVec a s x f (oddSeamHandleIdx k) = f k := by
  rw [oddSeamSurjVec, if_neg (by rw [oddSeamHandleIdx_val]; omega),
    if_neg (by rw [oddSeamHandleIdx_val]; omega),
    if_neg (by rw [oddSeamHandleIdx_val]; omega),
    dif_pos (by rw [oddSeamHandleIdx_val]; have := k.isLt; omega)]
  exact congrArg f (Fin.ext (by simp only [oddSeamHandleIdx_val]; omega))

end SurjVec

/-- **Surjectivity of `φ_sq`.** -/
theorem oddSeamPhiHom_surjective : Function.Surjective (oddSeamPhiHom h) := by
  intro w
  rw [← ofAdd_toAdd w]
  obtain ⟨a, s, x, f⟩ := w.toAdd
  refine ⟨oddSeamAbWord h (oddSeamSurjVec a s x f), ?_⟩
  rw [oddSeamPhiHom_word, oddSeamSurjVec_zero, oddSeamSurjVec_one, oddSeamSurjVec_two]
  congr 1
  refine Prod.ext ?_ (Prod.ext rfl (Prod.ext ?_ (funext fun k => ?_)))
  · show (zpowZtwo isProP_two_multZMod2 (ofAdd (1 : ZMod 2)) ((a.val : ℤ_[2]))).toAdd = a
    rw [zpowZtwo_ofAdd_one_zmod2, toAdd_ofAdd]
  · show x - 2 * ((a.val : ℤ_[2])) + 2 * ((a.val : ℤ_[2])) = x
    ring
  · exact oddSeamSurjVec_handle a s x f k

/-- **The abelianization frame of the square family**: `D_sq(h)^{ab} ≅ ℤ/2 ⊕ ℤ₂^{2+2h}` as
groups.  The bare `MulEquiv` is all the `q`-count consumes; the committed generic counting
lemma takes it as-is. -/
def oddSeamAbEquiv : topAbelianization (DSq h : Type) ≃* OddSeamModel h :=
  MulEquiv.ofBijective (oddSeamPhiHom h)
    ⟨oddSeamPhiHom_injective h, oddSeamPhiHom_surjective h⟩

end Phi

end AbFrame

/-! ## §2 `demushkinQ (D_sq h) = 2`, and the arithmetic discharge

The absence recorded by `SqCore/DsqDemushkin.lean` ("`demushkinQ (D_sq h) = 2` is **not**
proved, here or anywhere in the tree") is discharged by §1's frame through the generic count.
Wave 81's relocation then turns the one model value into the per-field torsion premise at
every odd-degree field at once, and the odd invariant triple closes. -/

section QInvariant

/-- **T1: the `q`-invariant of the square-commutator core is `2`, at every handle count.**
The third Demushkin invariant of the odd row, previously absent from the tree. -/
theorem oddSeam_demushkinQ_DSq (h : ℕ) : demushkinQ (DSq h : Type) = 2 :=
  demushkinQ_of_torsionEquivZMod (oddSeamAbEquiv h) (oddSeamTorsionEquiv h)

variable {Rec : LocalReciprocity} {K : IntermediateField ℚ_[2] ℚ̄₂} [FiniteDimensional ℚ_[2] K]
  [CompactSpace (GalK K)] [T2Space (GalK K)] [TotallyDisconnectedSpace (GalK K)]

/-- **The arithmetic torsion premise, discharged at every odd-degree field.**
`MaxProTwoAbTorsionGeneratedByFieldRoots B` — the per-field local-CFT premise of
`DemushkinQRamifiedI.lean` — holds at every odd-degree `K` over the bundle alone, through wave
81's relocation `oddId_torsionPremise_iff_model` and T1's model value. -/
theorem oddSeam_torsionPremise (B : MarkedRecip Rec K) {h : ℕ}
    (hdeg : Module.finrank ℚ_[2] K = 2 * h + 1) :
    MaxProTwoAbTorsionGeneratedByFieldRoots B :=
  (oddId_torsionPremise_iff_model B hdeg).mpr (oddSeam_demushkinQ_DSq h)

/-- **`q = 2` at the field**: the `q`-invariant of `G_K(2)` is `2` at every odd-degree `K`.
With `oddId_chiCycKTwo_surjective` and `oddId_demushkinRank` this completes the odd invariant
triple `(im χ, rank, q) = (ℤ₂ˣ, [K : ℚ₂] + 2, 2)`. -/
theorem oddSeam_demushkinQ_galK (B : MarkedRecip Rec K) {h : ℕ}
    (hdeg : Module.finrank ℚ_[2] K = 2 * h + 1) :
    demushkinQ (maxProPQuotient 2 (GalK K)) = 2 :=
  (oddId_demushkinQ_eq_model B hdeg).trans (oddSeam_demushkinQ_DSq h)

end QInvariant

