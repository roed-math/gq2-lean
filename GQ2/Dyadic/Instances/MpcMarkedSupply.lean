import GQ2.Dyadic.Instances.MpcSix

/-!
# Full marked moves for the `M6` ladder

`MpcSix.lean` isolates a useful two-slot producer, `mpcSx_shift_of_marked_supply`: at each
class it changes only the `B̄`- and `D̄`-corrections, so the increment is
`[Ā,u] [C̄₀,v]`.  The exact ladder engine `mpcBldIncr` has two further slots, and the
first climbed rung used one of them: the class-four witness changes the head correction by
`[D̄,B̄]`.  This module therefore records the full marked move space rather than assuming
that the two bracket slots suffice uniformly.

Three free slots use `mpcSxKill j`, the marked carrier generated by `B̄²` and all
commutators, intersected with `λ_j`.  The pivot slot is stricter: `mpcWordCorrC` requires
invisibility to every continuous `ℤ₂`-character, so its marked carrier is the subgroup
generated by commutators alone.  Sections 1 and 2 prove these four carriers legal, package
their exact `mpcBldIncr` as `MpcMkFullSupply`, and feed the result to the existing ladder iff.
The class-five rung is already an instance of this full marked supply.

## Exact remaining theorem

This API does not assert the missing mathematics.  To finish `MpcPivShift 2` through it one
must prove, for every `j ≥ 4`, that some class-`(j+1)` solution has its top-layer defect in
the image of the full marked cost map.  Equivalently, one needs the graded/Fox exactness
statement that the four marked correction slots cover the relevant chi-twisted Fox kernel,
and that the `M6` defect lies in that kernel.  The tree contains the exact increment map and
the generic layer calculus, but no such cost-image theorem for `D_M 2 0`; the Fox-ideal
calculation in `docs/dyadic/w84-word-note.md` is off-tree prose.  The conditional endpoint
below names this gap without turning it into an axiom or a hypothesis attached to the public
classification theorem.

Declaration prefix `mpcMk` (namespace `GQ2.Dyadic.Instances.MpcMk`).  No `sorry`, no new
axiom, no `native_decide`, and no heartbeat or recursion override.
-/

namespace GQ2.Dyadic.Instances.MpcMk

open GQ2 GQ2.Dyadic GQ2.Dyadic.MarkedCore Multiplicative
open GQ2.Dyadic.Instances.MpcPiv GQ2.Dyadic.Instances.MpcOrb
open GQ2.Dyadic.Instances.MpcWord GQ2.Dyadic.Instances.MpcBld
open GQ2.Dyadic.Instances.MpcLad GQ2.Dyadic.Instances.MpcFv
open GQ2.Dyadic.Instances.MpcSx GQ2.Roe.Labute GQ2.Dyadic.SqCore

noncomputable section

/-! ## 1. The row-invisible marked pivot carrier -/

/-- The subgroup generated by all commutators.  Unlike `mpcSxMarked`, it omits `B̄²`,
because a continuous `ℤ₂`-character need not kill that square. -/
def mpcMkDerived : Subgroup (DM 2 0 : Type) :=
  Subgroup.closure {x | ∃ a b : (DM 2 0 : Type), x = commP a b}

/-- Every element of the commutator-generated carrier is chi-trivial. -/
theorem mpcMk_derived_chi {x : (DM 2 0 : Type)} (hx : x ∈ mpcMkDerived) :
    chiM 2 0 x = 1 := by
  have hle : mpcMkDerived ≤ (chiM 2 0).toMonoidHom.ker := by
    refine (Subgroup.closure_le _).2 ?_
    rintro y ⟨a, b, rfl⟩
    exact MonoidHom.mem_ker.2 (mpcBld_chi_commP a b)
  exact MonoidHom.mem_ker.1 (hle hx)

/-- Every element of the commutator-generated carrier is invisible to every continuous
`Multiplicative ℤ₂`-character. -/
theorem mpcMk_derived_rowKer {x : (DM 2 0 : Type)} (hx : x ∈ mpcMkDerived) :
    x ∈ mpcWordRowKer := by
  rw [mpcWord_mem_rowKer]
  intro f
  have hle : mpcMkDerived ≤ f.toMonoidHom.ker := by
    refine (Subgroup.closure_le _).2 ?_
    rintro y ⟨a, b, rfl⟩
    refine MonoidHom.mem_ker.2 ?_
    simp only [commP, map_mul, map_inv]
    rw [mul_comm ((f.toMonoidHom a)⁻¹) ((f.toMonoidHom b)⁻¹)]
    group
  exact MonoidHom.mem_ker.1 (hle hx)

/-- The full marked carrier in the pivot slot: commutator-generated and `j` layers deep. -/
def mpcMkPivotKill (j : ℕ) : Subgroup (DM 2 0 : Type) :=
  mpcMkDerived ⊓ twoCentralSeries (DM 2 0 : Type) j

/-- Every marked pivot move at depth at least two is a legal pivot correction. -/
theorem mpcMk_pivotKill_le_corrC {j : ℕ} (hj : 2 ≤ j) :
    mpcMkPivotKill j ≤ mpcWordCorrC := by
  intro x hx
  exact ⟨⟨twoCentralSeries_antitone (G := (DM 2 0 : Type)) hj hx.2,
    mpcMk_derived_chi hx.1⟩, mpcMk_derived_rowKer hx.1⟩

/-! ## 2. Full marked moves and supply -/

/-- A full four-slot marked move at depth `j`.  The head, `B̄`, and `D̄` slots use
`mpcSxKill`; the row-sensitive pivot slot uses `mpcMkPivotKill`. -/
def MpcMkFullMove (j : ℕ) (us ut um un : (DM 2 0 : Type)) : Prop :=
  us ∈ mpcSxKill j ∧ ut ∈ mpcSxKill j ∧ um ∈ mpcMkPivotKill j ∧
    un ∈ mpcSxKill j

/-- A full marked move is a reachable move of the exact ladder engine. -/
theorem mpcMk_fullMove_ladMove {j : ℕ} (hj : 2 ≤ j)
    {us ut um un : (DM 2 0 : Type)} (h : MpcMkFullMove j us ut um un) :
    MpcLadMove j us ut um un := by
  exact ⟨⟨mpcSx_kill_le_corr hj h.1, h.1.2⟩,
    ⟨mpcSx_kill_le_corr hj h.2.1, h.2.1.2⟩,
    ⟨mpcMk_pivotKill_le_corrC hj h.2.2.1, h.2.2.1.2⟩,
    ⟨mpcSx_kill_le_corr hj h.2.2.2, h.2.2.2.2⟩⟩

/-- Full marked one-step supply at a correction quadruple. -/
def MpcMkFullSupply (j : ℕ)
    (p : (DM 2 0 : Type) × (DM 2 0 : Type) × (DM 2 0 : Type) ×
      (DM 2 0 : Type)) : Prop :=
  ∃ us ut um un, MpcMkFullMove j us ut um un ∧
    mpcLadDefect p * mpcBldIncr p.2.1 p.2.2.2 us ut um un
      ∈ twoCentralSeries (DM 2 0 : Type) (j + 2)

/-- Full marked supply is ordinary one-step supply, with no loss in the increment formula. -/
theorem mpcMk_supply_of_fullSupply {j : ℕ} (hj : 2 ≤ j)
    {p : (DM 2 0 : Type) × (DM 2 0 : Type) × (DM 2 0 : Type) ×
      (DM 2 0 : Type)}
    (h : MpcMkFullSupply j p) : MpcLadSupply j p := by
  obtain ⟨us, ut, um, un, hm, hkill⟩ := h
  exact ⟨us, ut, um, un, mpcMk_fullMove_ladMove hj hm, hkill⟩

/-- If one class-`(j+1)` solution has full marked supply at every `j ≥ 3`, then the existing
ladder endpoint gives `MpcPivShift 2`.  The unproved content is exactly the hypothesis. -/
theorem mpcMk_shift_of_fullSupply
    (H : ∀ j, 3 ≤ j → ∃ p ∈ mpcWordSet (j + 1), MpcMkFullSupply j p) :
    MpcPivShift 2 := by
  refine mpcLad_shift_of_exists_supply fun j hj ↦ ?_
  obtain ⟨p, hp, hs⟩ := H j hj
  exact ⟨p, hp, mpcMk_supply_of_fullSupply (by omega) hs⟩

/-! ## 3. The first required class -/

/-- The already-proved class-five move is a full marked supply: identities in the head and
pivot slots, and the marked `B̄⁴` / `B̄⁴[B̄²,D̄]` moves in the other two slots. -/
theorem mpcMk_fullSupply_three : MpcMkFullSupply 3 mpcLadW4 := by
  refine ⟨1, mpcFvUt, 1, mpcFvUn, ?_, mpcFv_supply_kill⟩
  exact ⟨one_mem _, mpcSx_ut_marked, one_mem _, mpcSx_un_marked⟩

/-- The `j = 3` instance in exactly the quantifier shape of
`mpcMk_shift_of_fullSupply`. -/
theorem mpcMk_exists_fullSupply_three :
    ∃ p ∈ mpcWordSet 4, MpcMkFullSupply 3 p :=
  ⟨mpcLadW4, mpcLad_w4_mem, mpcMk_fullSupply_three⟩

