import GQ2.Dyadic.Instances.MpcGeneralHandlePivotBoundary

/-!
# The exact general-h M6 construction boundary

The compact theorem `MpcMk.mpcMk_pivShift` provides elements of `DM 2 0`; there is no section,
word-evaluation map, or stabilization equivalence transporting those elements to `DM 2 h`.
Fixing the new handle generators does not repair the type mismatch: the rank-four core relator
is trivial in `DM 2 0`, whereas in `DM 2 h` it is the inverse of the handle commutator block.

This module makes the resulting boundary exact.

* Every automorphism in `dmClearAutsWide` fixes `C` literally.  This includes all existing
  handle transvections, handle/core mixing, and the constructed M5 family.
* The general `B`-coordinate character then proves that no element of this correction monoid
  can have the odd `C + 2 B` row.  Any witness of `MpcPivShiftH` necessarily lies outside it.
  Canonical scaling is no escape: `exactPivot_comp_iff_of_unit_C` records that its unit `C`
  row preserves the pivot condition rather than creating the missing digit.
* A general-h analogue of `mpcOrb_shift_iff_marking` reduces the desired construction exactly
  to a full `(4 + 2h)`-letter marking which kills `mRelWord`, generates topologically, preserves
  chi on every marked generator, and has the odd `C` row.

Thus the existing Eichler and presentation-automorphism APIs cannot construct the shift, and
the honest next input is a new full general-h relator marking, not another handle correction.
-/

namespace GQ2.Dyadic.Instances.MpcGeneralHandleShiftRecipe

noncomputable section

open GQ2 GQ2.Dyadic Multiplicative
open GQ2.Dyadic.MarkedCore
open GQ2.Dyadic.Instances.MpcGeneralHandlePivotBoundary

/-- Every automorphism generated by the existing handle corrections and M5 core mixing fixes
the pivot letter literally. -/
theorem dmClearAutsWide_fixes_C {alpha h : ℕ} {F : Function.End (DM alpha h : Type)}
    (hF : F ∈ Submonoid.closure (dmClearAutsWide alpha h)) :
    F (dmC alpha h) = dmC alpha h := by
  have htwo : dmC alpha h = dmGen alpha h 2 := rfl
  rw [htwo]
  induction hF using Submonoid.closure_induction with
  | mem F hgen =>
    rcases hgen with hgen | ⟨k, rfl⟩
    · simp only [dmClearAuts, Set.mem_union, Set.mem_iUnion, Set.mem_range] at hgen
      rcases hgen with ((⟨j, k, rfl⟩ | ⟨j, k, rfl⟩) | ⟨k, rfl⟩) | ⟨j, rfl⟩
      · rw [autEnd_apply, dmTauUEquiv_gen,
          tauUMark_of_ne _ _ _ _ (handleIdxU_ne_of_val_lt j coreVal_two_lt).symm]
      · rw [autEnd_apply, dmTauVEquiv_gen,
          tauVMark_of_ne _ _ _ _ (handleIdxV_ne_of_val_lt j coreVal_two_lt).symm]
      · rw [autEnd_apply, dmTauDEquiv_gen, tauDMark_two]
      · rw [autEnd_apply, dmMixEquiv_gen, handleMixMark_two]
    · change dmCoreMixEquiv alpha h k (dmGen alpha h 2) = dmGen alpha h 2
      rw [show dmGen alpha h 2 = dmC alpha h from rfl, dmCoreMixEquiv_dmC]
  | one => rfl
  | mul a b _ _ ha hb =>
    show a (b (dmGen alpha h 2)) = dmGen alpha h 2
    rw [hb]
    exact ha

/-- No element of the existing widened correction monoid has the odd `2 B` pivot row. -/
theorem not_shiftRow_of_mem_dmClearAutsWide {alpha h : ℕ}
    (Psi : ContinuousMulEquiv (DM alpha h : Type) (DM alpha h : Type))
    (hmem : autEnd Psi ∈ Submonoid.closure (dmClearAutsWide alpha h)) :
    ¬ ∀ f : ContinuousMonoidHom (DM alpha h : Type) (Multiplicative ℤ_[2]),
      toAdd (f (Psi (dmC alpha h))) =
        toAdd (f (dmC alpha h)) + 2 * toAdd (f (dmB alpha h)) := by
  intro hrow
  let fB : ContinuousMonoidHom (DM alpha h : Type) (Multiplicative ℤ_[2]) :=
    (mBHom alpha h).comp (mAbMkHom alpha h)
  have hfix : Psi (dmC alpha h) = dmC alpha h :=
    dmClearAutsWide_fixes_C hmem
  have hBC : fB (dmC alpha h) = 1 := by
    change mBHom alpha h (GQ2.SectionThree.abMk (dmGen alpha h 2)) = 1
    rw [mBHom, mCoordHom_gen, coreMark_two]
  have hBB : fB (dmB alpha h) = ofAdd (1 : ℤ_[2]) := by
    change mBHom alpha h (GQ2.SectionThree.abMk (dmGen alpha h 1)) =
      ofAdd (1 : ℤ_[2])
    rw [mBHom, mCoordHom_gen, coreMark_one]
  have bad := hrow fB
  rw [hfix, hBC, hBB, toAdd_one, toAdd_ofAdd] at bad
  norm_num at bad

/-- Any general-h pivot shift necessarily lies outside the full monoid generated by the
repository's handle-clearing and M5 automorphisms. -/
theorem MpcPivShiftH.exists_outside_clearWide {alpha h : ℕ}
    (hshift : MpcPivShiftH alpha h) :
    ∃ Psi : ContinuousMulEquiv (DM alpha h : Type) (DM alpha h : Type),
      (∀ x, chiM alpha h (Psi x) = chiM alpha h x) ∧
        (∀ f : ContinuousMonoidHom (DM alpha h : Type) (Multiplicative ℤ_[2]),
          toAdd (f (Psi (dmC alpha h))) =
            toAdd (f (dmC alpha h)) + 2 * toAdd (f (dmB alpha h))) ∧
          autEnd Psi ∉ Submonoid.closure (dmClearAutsWide alpha h) := by
  obtain ⟨Psi, hchi, hrow⟩ := hshift
  refine ⟨Psi, hchi, hrow, ?_⟩
  intro hmem
  exact not_shiftRow_of_mem_dmClearAutsWide Psi hmem hrow

/-- A relator-respecting, generating, oriented marking with the M6 `C` row constructs the
general-h shift. -/
theorem mpcPivShiftH_of_marking {alpha h : ℕ}
    (m : Fin (coreRank h) → (DM alpha h : Type))
    (hrel : mRelWord alpha m = 1)
    (hgen : (Subgroup.closure (Set.range m)).topologicalClosure = ⊤)
    (hchi : ∀ i, chiM alpha h (m i) = chiM alpha h (dmGen alpha h i))
    (hrow : ∀ f : ContinuousMonoidHom (DM alpha h : Type) (Multiplicative ℤ_[2]),
      toAdd (f (m 2)) =
        toAdd (f (dmC alpha h)) + 2 * toAdd (f (dmB alpha h))) :
    MpcPivShiftH alpha h := by
  classical
  let Phi := mLiftHom alpha h (isProP_DM alpha h) m hrel
  have hPhi (i : Fin (coreRank h)) : Phi (dmGen alpha h i) = m i := by
    exact mLiftHom_gen _ _ _ _ _ _
  have hsurj : Function.Surjective Phi := by
    have hclosed : IsClosed ((Phi.toMonoidHom.range : Subgroup (DM alpha h : Type)) :
        Set (DM alpha h : Type)) := by
      rw [MonoidHom.coe_range Phi.toMonoidHom]
      exact (isCompact_range Phi.continuous_toFun).isClosed
    have hsub : Subgroup.closure (Set.range m) ≤ Phi.toMonoidHom.range := by
      rw [Subgroup.closure_le]
      rintro _ ⟨i, rfl⟩
      exact ⟨dmGen alpha h i, hPhi i⟩
    have hle := Subgroup.topologicalClosure_minimal _ hsub hclosed
    rw [hgen, top_le_iff] at hle
    intro y
    have : y ∈ Phi.toMonoidHom.range := by rw [hle]; trivial
    exact this
  have hbij : Function.Bijective Phi :=
    ⟨profinite_hopfian (dm_topologicallyFinGen alpha h) Phi hsurj, hsurj⟩
  refine ⟨continuousMulEquivOfBijective Phi hbij, ?_, ?_⟩
  · have hcomp : (chiM alpha h).comp Phi = chiM alpha h := by
      refine dm_hom_ext _ _ fun i => ?_
      change chiM alpha h (Phi (dmGen alpha h i)) = chiM alpha h (dmGen alpha h i)
      rw [hPhi, hchi]
    intro x
    exact congrArg (fun F : ContinuousMonoidHom (DM alpha h : Type) ℤ_[2]ˣ => F x) hcomp
  · intro f
    show toAdd (f (Phi (dmC alpha h))) = _
    rw [show dmC alpha h = dmGen alpha h 2 from rfl, hPhi]
    exact hrow f

/-- A general-h shift transports the marked generators to a marking satisfying the full
general-h presentation problem. -/
theorem marking_of_mpcPivShiftH {alpha h : ℕ} (hshift : MpcPivShiftH alpha h) :
    ∃ m : Fin (coreRank h) → (DM alpha h : Type),
      mRelWord alpha m = 1 ∧
        (Subgroup.closure (Set.range m)).topologicalClosure = ⊤ ∧
        (∀ i, chiM alpha h (m i) = chiM alpha h (dmGen alpha h i)) ∧
        ∀ f : ContinuousMonoidHom (DM alpha h : Type) (Multiplicative ℤ_[2]),
          toAdd (f (m 2)) =
            toAdd (f (dmC alpha h)) + 2 * toAdd (f (dmB alpha h)) := by
  classical
  obtain ⟨Psi, hchi, hrow⟩ := hshift
  let m : Fin (coreRank h) → (DM alpha h : Type) := fun i => Psi (dmGen alpha h i)
  refine ⟨m, ?_, ?_, ?_, ?_⟩
  · rw [show mRelWord alpha m = Psi (mRelWord alpha (dmGen alpha h)) by
      exact (map_mRelWord Psi alpha (dmGen alpha h)).symm,
      dm_relation, map_one]
  · set H := (Subgroup.closure (Set.range m)).topologicalClosure with hH
    have hmem : ∀ i, Psi (dmGen alpha h i) ∈ H := by
      intro i
      exact Subgroup.le_topologicalClosure _ (Subgroup.subset_closure ⟨i, rfl⟩)
    have hKclosed : IsClosed ((Subgroup.comap Psi.toMonoidHom H :
        Subgroup (DM alpha h : Type)) : Set (DM alpha h : Type)) :=
      (Subgroup.isClosed_topologicalClosure _).preimage Psi.continuous_toFun
    have hsub : Subgroup.closure (Set.range (dmGen alpha h)) ≤
        Subgroup.comap Psi.toMonoidHom H := by
      rw [Subgroup.closure_le]
      rintro _ ⟨i, rfl⟩
      exact hmem i
    have hall := Subgroup.topologicalClosure_minimal _ hsub hKclosed
    rw [dm_topGen, top_le_iff] at hall
    refine eq_top_iff.mpr fun y _ => ?_
    obtain ⟨x, rfl⟩ := Psi.surjective y
    have hx : x ∈ Subgroup.comap Psi.toMonoidHom H := by rw [hall]; trivial
    exact hx
  · intro i
    exact hchi _
  · intro f
    exact hrow f

/-- The actual general-h M6 construction is exactly a full `(4 + 2h)`-letter presentation
marking problem. -/
theorem mpcPivShiftH_iff_marking {alpha h : ℕ} :
    MpcPivShiftH alpha h ↔
      ∃ m : Fin (coreRank h) → (DM alpha h : Type),
        mRelWord alpha m = 1 ∧
          (Subgroup.closure (Set.range m)).topologicalClosure = ⊤ ∧
          (∀ i, chiM alpha h (m i) = chiM alpha h (dmGen alpha h i)) ∧
          ∀ f : ContinuousMonoidHom (DM alpha h : Type) (Multiplicative ℤ_[2]),
            toAdd (f (m 2)) =
              toAdd (f (dmC alpha h)) + 2 * toAdd (f (dmB alpha h)) := by
  constructor
  · exact marking_of_mpcPivShiftH
  · rintro ⟨m, hrel, hgen, hchi, hrow⟩
    exact mpcPivShiftH_of_marking m hrel hgen hchi hrow

#print axioms dmClearAutsWide_fixes_C
#print axioms not_shiftRow_of_mem_dmClearAutsWide
#print axioms MpcPivShiftH.exists_outside_clearWide
#print axioms mpcPivShiftH_of_marking
#print axioms marking_of_mpcPivShiftH
#print axioms mpcPivShiftH_iff_marking

end
end GQ2.Dyadic.Instances.MpcGeneralHandleShiftRecipe
