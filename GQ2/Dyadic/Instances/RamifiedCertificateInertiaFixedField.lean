import GQ2.Dyadic.Instances.RamifiedCertificateAbsoluteResidueZhat
import Mathlib.RingTheory.RootsOfUnity.AlgebraicallyClosed

/-!
# Actual inertia and finite odd cyclotomic containment

The canonical residue inertia subgroup fixes exactly the field generated by odd roots of unity.
The proof uses the previously proved equivalence between fixing odd roots and trivial residue
action, followed by the infinite Galois correspondence. Over any intermediate base K its fixed
field is the compositum of K with that odd cyclotomic field.

Every element of this compositum already belongs to K joined with a single primitive odd root
of unity. This finite-containment result is independent of reciprocity and makes relative odd
cyclotomic unramifiedness sufficient for the anchored norm-value argument.
-/

namespace GQ2.Dyadic
noncomputable section
open GQ2
local notation "ℚ̄₂" => AlgebraicClosure ℚ_[2]

/-- All algebraic roots of unity of odd order. -/
def oddRootSet : Set ℚ̄₂ := {z | ∃ m : ℕ, Odd m ∧ z ^ m = 1}

/-- The compositum of all odd cyclotomic extensions of the dyadic base field. -/
def oddCyclotomicCompositum : IntermediateField ℚ_[2] ℚ̄₂ :=
  IntermediateField.adjoin ℚ_[2] oddRootSet

theorem fixingSubgroup_oddCyclotomicCompositum :
    oddCyclotomicCompositum.fixingSubgroup = absoluteInertiaSubgroup := by
  ext g
  rw [mem_absoluteInertiaSubgroup_iff_isResidueTrivial_bot,
    ← fixesOddRootsOfUnity_iff_isResidueTrivial_bot]
  constructor
  · intro hg m z hm hz
    exact (IntermediateField.mem_fixingSubgroup_iff _ g).mp hg z
      (IntermediateField.subset_adjoin ℚ_[2] oddRootSet ⟨m, hm, hz⟩)
  · intro hg
    rw [← Subgroup.zpowers_le, ← IntermediateField.le_iff_le]
    apply IntermediateField.adjoin_le_iff.mpr
    intro z hz
    obtain ⟨m, hm, hz⟩ := hz
    change z ∈ IntermediateField.fixedField (Subgroup.zpowers g)
    rw [IntermediateField.mem_fixedField_iff]
    intro a ha
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp ha
    have hfix : g • z = z := hg m z hm hz
    have hmem : g ∈ MulAction.stabilizer (Kummer.GaloisGroup ℚ_[2]) z := hfix
    exact (MulAction.stabilizer (Kummer.GaloisGroup ℚ_[2]) z).zpow_mem hmem k

theorem fixedField_absoluteInertia_eq_oddCyclotomicCompositum :
    IntermediateField.fixedField absoluteInertiaSubgroup = oddCyclotomicCompositum := by
  rw [← fixingSubgroup_oddCyclotomicCompositum]
  exact InfiniteGalois.fixedField_fixingSubgroup _

theorem fixedField_absoluteInertia_inf_fixingSubgroup
    (K : IntermediateField ℚ_[2] ℚ̄₂) :
    IntermediateField.fixedField (absoluteInertiaSubgroup ⊓ K.fixingSubgroup) =
      K ⊔ oddCyclotomicCompositum := by
  rw [inf_comm, ← fixingSubgroup_oddCyclotomicCompositum,
    ← IntermediateField.fixingSubgroup_sup]
  exact InfiniteGalois.fixedField_fixingSubgroup _

private theorem finite_set_odd_exponent
    (K : IntermediateField ℚ_[2] ℚ̄₂) (T : Finset ℚ̄₂)
    (hT : (T : Set ℚ̄₂) ⊆ (K : Set ℚ̄₂) ∪ oddRootSet) :
    ∃ m : ℕ, Odd m ∧ ∀ z ∈ T, z ∈ K ∨ z ^ m = 1 := by
  classical
  induction T using Finset.induction_on with
  | empty => exact ⟨1, odd_one, by simp⟩
  | @insert z T hz ih =>
    obtain ⟨m, hm, hpow⟩ := ih (fun y hy ↦ hT (Finset.mem_insert_of_mem hy))
    rcases hT (Finset.mem_insert_self z T) with hzK | hzroot
    · exact ⟨m, hm, by
        intro y hy
        rcases Finset.mem_insert.mp hy with rfl | hy
        · exact Or.inl hzK
        · exact hpow y hy⟩
    · obtain ⟨n, hn, hzn⟩ := hzroot
      refine ⟨n * m, hn.mul hm, ?_⟩
      intro y hy
      rcases Finset.mem_insert.mp hy with rfl | hy
      · exact Or.inr (by rw [pow_mul, hzn, one_pow])
      · rcases hpow y hy with hyK | hym
        · exact Or.inl hyK
        · exact Or.inr (by rw [Nat.mul_comm n m, pow_mul, hym, one_pow])

/-- Every element of the relative odd cyclotomic compositum lies in a single finite odd
cyclotomic compositum. The root can be chosen primitive. -/
theorem exists_odd_primitive_root_mem_compositum
    (K : IntermediateField ℚ_[2] ℚ̄₂) {x : ℚ̄₂}
    (hx : x ∈ K ⊔ oddCyclotomicCompositum) :
    ∃ (m : ℕ) (ζ : ℚ̄₂), Odd m ∧ IsPrimitiveRoot ζ m ∧
      x ∈ K ⊔ IntermediateField.adjoin ℚ_[2] {ζ} := by
  have hx' : x ∈ IntermediateField.adjoin ℚ_[2] ((K : Set ℚ̄₂) ∪ oddRootSet) := by
    rw [IntermediateField.adjoin_union, IntermediateField.adjoin_self]
    exact hx
  obtain ⟨T, hT, hxT⟩ := IntermediateField.exists_finset_of_mem_adjoin hx'
  obtain ⟨m, hm, hpow⟩ := finite_set_odd_exponent K T hT
  letI : NeZero m := ⟨Nat.ne_of_gt hm.pos⟩
  letI : NeZero (m : ℚ_[2]) := ⟨Nat.cast_ne_zero.mpr (NeZero.ne m)⟩
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot ℚ̄₂ m
  refine ⟨m, ζ, hm, hζ, ?_⟩
  apply (show IntermediateField.adjoin ℚ_[2] (T : Set ℚ̄₂) ≤
    K ⊔ IntermediateField.adjoin ℚ_[2] {ζ} from ?_) hxT
  apply IntermediateField.adjoin_le_iff.mpr
  intro z hz
  rcases hpow z hz with hzK | hzm
  · exact (show K ≤ K ⊔ IntermediateField.adjoin ℚ_[2] {ζ} from le_sup_left) hzK
  · obtain ⟨i, _, rfl⟩ := hζ.eq_pow_of_pow_eq_one hzm
    exact (show IntermediateField.adjoin ℚ_[2] {ζ} ≤
      K ⊔ IntermediateField.adjoin ℚ_[2] {ζ} from le_sup_right)
      (pow_mem (IntermediateField.mem_adjoin_simple_self ℚ_[2] ζ) i)

/-- A relative inertia-fixed element is contained in an odd cyclotomic base change. -/
theorem exists_odd_primitive_root_of_inertia_fixed
    (K : IntermediateField ℚ_[2] ℚ̄₂) {x : ℚ̄₂}
    (hx : x ∈ IntermediateField.fixedField
      (absoluteInertiaSubgroup ⊓ K.fixingSubgroup)) :
    ∃ (m : ℕ) (ζ : ℚ̄₂), Odd m ∧ IsPrimitiveRoot ζ m ∧
      x ∈ K ⊔ IntermediateField.adjoin ℚ_[2] {ζ} := by
  rw [fixedField_absoluteInertia_inf_fixingSubgroup] at hx
  exact exists_odd_primitive_root_mem_compositum K hx

#print axioms oddRootSet
#print axioms oddCyclotomicCompositum
#print axioms fixingSubgroup_oddCyclotomicCompositum
#print axioms fixedField_absoluteInertia_eq_oddCyclotomicCompositum
#print axioms fixedField_absoluteInertia_inf_fixingSubgroup
#print axioms exists_odd_primitive_root_mem_compositum
#print axioms exists_odd_primitive_root_of_inertia_fixed
end
end GQ2.Dyadic

