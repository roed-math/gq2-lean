private noncomputable def baseIncr
    (us ut um un : (DM 2 0 : Type)) : (DM 2 0 : Type) :=
  us ^ 2 * commP us (dmA 2 0) * commP us (dmB 2 0) *
    commP um (dmD 2 0) * commP (dmA 2 0) ut * commP (dmC 2 0) un

theorem level_utC2 :
    levelMk (DM 2 0 : Type) 4
        (mpcBldIncr 1 1 1 (dmC 2 0 ^ 2) 1 1) =
      levelMk (DM 2 0 : Type) 4
        (mpcBldIncr 1 1
          (commP (dmA 2 0) (dmC 2 0))
          (commP (dmA 2 0) (dmC 2 0) * commP (dmB 2 0) (dmC 2 0))
          1
          (commP (dmA 2 0) (dmB 2 0) * commP (dmA 2 0) (dmC 2 0))) := by
  have hl : eval dmVal4 utC2Lhs =
      baseIncr 1 (dmC 2 0 ^ 2) 1 1 := by rfl
  have hr : eval dmVal4 utC2Rhs =
      baseIncr
        (commP (dmA 2 0) (dmC 2 0))
        (commP (dmA 2 0) (dmC 2 0) * commP (dmB 2 0) (dmC 2 0))
        1
        (commP (dmA 2 0) (dmB 2 0) * commP (dmA 2 0) (dmC 2 0)) := by rfl
  have h := eval_utC2
  rw [eval_dmModel4, eval_dmModel4] at h
  rw [hl, hr] at h
  simpa only [baseIncr, mpcBldIncr, mpcWordLetB, mpcWordLetD, mul_one] using h

