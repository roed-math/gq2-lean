    relationOccurrences.Perm (endpointSupport ++ pairs relationPairBases) :=
  relationPermThrough32

private theorem eval_relationOccurrences_eq_support :
    evalList dmModel relationOccurrences = evalList dmModel endpointSupport := by
  calc
    _ = evalList dmModel (endpointSupport ++ pairs relationPairBases) :=
      evalList_perm dmModel
        (depth_of_all relationOccurrences relationOccurrences_all_depth_ge_five)
        relation_perm
    _ = evalList dmModel endpointSupport * evalList dmModel (pairs relationPairBases) :=
      evalList_append dmModel endpointSupport (pairs relationPairBases)
    _ = evalList dmModel endpointSupport * 1 := by
      rw [evalList_pairs dmModel relationPairBases
        (depth_of_all relationPairBases relationPairBases_all_depth_five)]
    _ = evalList dmModel endpointSupport := mul_one _

theorem eval_endpointSupport_eq_one : evalList dmModel endpointSupport = 1 := by
  rw [← eval_relationOccurrences_eq_support]
  exact eval_relationOccurrences_eq_one

theorem eval_endpoint_eq_one :
    eval dmModel.val MpcC6WeightedRelationSupport.endpoint = 1 :=
  eval_endpoint_eq_canonical.trans
    (eval_canonicalEndpointFactors_eq_support.trans eval_endpointSupport_eq_one)

theorem eval_certificateWord_eq_one :
    eval dmModel.val MpcC6WeightedCertificate.Bridge.certificateWord = 1 :=
  MpcC6WeightedRelationSupport.eval_certificateWord_eq_endpoint.trans
    eval_endpoint_eq_one

theorem mpcMkC6_certificateKill : MpcMkC6CertificateKill :=
  MpcC6WeightedCertificate.Bridge.certificateKill_iff_checkedWord.mpr
    eval_certificateWord_eq_one

theorem mpcMkC6_fullSupply :
    MpcMkFullSupply 4 GQ2.Dyadic.Instances.MpcFv.mpcFvW5 :=
  mpcMkC6_fullSupply_of_certificateKill mpcMkC6_certificateKill

