    eval dmModel.val endpointTrace.lhs = eval dmModel.val endpointTrace.rhs :=
  Deriv.sound dmModel endpointTrace endpointTrace_checked

private theorem endpointTrace_lhs :
    endpointTrace.lhs = MpcC6WeightedRelationSupport.endpoint := by decide

private theorem endpointTrace_rhs :
    endpointTrace.rhs =
      MpcC6WeightedTracePrefix.rightProduct canonicalEndpointFactors := by decide

theorem canonicalEndpointFactors_length : canonicalEndpointFactors.length = 65 := by decide

theorem canonicalEndpointFactors_all_depth_five :
    canonicalEndpointFactors.all (fun w => decide (w.depth = 5)) = true := by decide

private theorem canonicalEndpointFactors_all_depth_ge_five :
    canonicalEndpointFactors.all (fun w => decide (5 ≤ w.depth)) = true := by decide

theorem endpointSupport_length : endpointSupport.length = 59 := by decide

theorem endpointSupport_all_depth_five :
    endpointSupport.all (fun w => decide (w.depth = 5)) = true := by decide

private theorem endpointPairBases_all_depth_five :
    endpointPairBases.all (fun w => decide (5 ≤ w.depth)) = true := by decide

private theorem endpoint_perm :
    canonicalEndpointFactors.Perm (endpointSupport ++ pairs endpointPairBases) := by decide

private theorem eval_endpoint_eq_canonical :
    eval dmModel.val MpcC6WeightedRelationSupport.endpoint =
      evalList dmModel canonicalEndpointFactors := by
  calc
    _ = eval dmModel.val endpointTrace.lhs := by rw [endpointTrace_lhs]
    _ = eval dmModel.val endpointTrace.rhs := endpointTrace_sound
    _ = eval dmModel.val
        (MpcC6WeightedTracePrefix.rightProduct canonicalEndpointFactors) := by
      rw [endpointTrace_rhs]
    _ = evalList dmModel canonicalEndpointFactors :=
      eval_rightProduct dmModel canonicalEndpointFactors

private theorem eval_canonicalEndpointFactors_eq_support :
    evalList dmModel canonicalEndpointFactors = evalList dmModel endpointSupport := by
  calc
    _ = evalList dmModel (endpointSupport ++ pairs endpointPairBases) :=
      evalList_perm dmModel
        (depth_of_all canonicalEndpointFactors
          canonicalEndpointFactors_all_depth_ge_five) endpoint_perm
    _ = evalList dmModel endpointSupport * evalList dmModel (pairs endpointPairBases) :=
      evalList_append dmModel endpointSupport (pairs endpointPairBases)
    _ = evalList dmModel endpointSupport * 1 := by
      rw [evalList_pairs dmModel endpointPairBases
        (depth_of_all endpointPairBases endpointPairBases_all_depth_five)]
    _ = evalList dmModel endpointSupport := mul_one _

