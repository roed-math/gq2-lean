import GQ2.Dyadic.Instances.MpcWord
import GQ2.Dyadic.SqCore.GradedClassFour

/-!
# W85-M6BUILD: the `M6` ansatz at class four, and the widened shape

Wave 84 (`GQ2/Dyadic/Instances/MpcWord.lean`) reduced `MpcPivShift 2` - the whole residue of the
`ℚ₂(√−10)` row - to one word identity, showed it is decided at a finite class, and proved classes
at most three free.  It left two things: the class-four rung, whose kill was a hand computation
in the Magnus model, and the widened shape, in which the `B̄` and `D̄` letters carry χ-legal `Ā`
and `C̄₀` factors.  This module lands both.

## What lands

1. **The class-four defect in closed form** (§1, §2).  For arbitrary `λ₂`-corrections the `M6`
   core word is, modulo `λ₄`, the marked relator times an explicit product of eight brackets
   (`mpcBld_mWord_four`, `mpcBld_defect_four`).  Every factor of the defect lies in the central
   involutive layer `Z = λ₃/λ₄`, so the class-four rung is an equation in an elementary abelian
   2-group: exact linear algebra, not a search.

2. **The class-four rung is climbed** (§3).  The wave-84 witness `s = t = ⁅D̄, B̄⁆`, `m = n = 1`
   kills the defect (`mpcBld_mem_four_witness`), so `(mpcWordSet 4).Nonempty`
   (`mpcBld_nonempty_four`) and the residue starts at **class five**
   (`mpcBld_shift_of_forall_class_five`).  This turns wave 84 §4.2 from a checked hand
   computation into a theorem.

3. **The widened shape** (§4).  The `B̄`- and `D̄`-corrections may range over the closed subgroup
   generated by `Ā`, `C̄₀` and the Frattini subgroup (`mpcBldWide`): generation still holds
   (`mpcBld_gen`), so the word identity still gives `MpcPivShift 2`
   (`mpcBld_shift_of_word`), and the per-class criterion transfers verbatim
   (`mpcBld_shift_of_forall_class`, `mpcBld_shift_of_forall_class_five`).  The widened rungs
   below five are free for the same reason the narrow ones are (`mpcBld_wide_nonempty_four`).

## What does not land

**The decision.**  `MpcPivShift 2` is still neither proved nor refuted.  What moved is the
starting line: wave 84 left the residue at class four with an unformalized witness, and this lane
leaves it at **class five**, with the class-four defect computed exactly rather than sampled.  No
class-five claim is made in either direction; wave 84 §5's control (the greedy ladder kills `M5`,
which is a theorem) still forbids reading any stall as evidence.

Declaration prefix `mpcBld` (namespace `GQ2.Dyadic.Instances.MpcBld`).  No `sorry`, no new
axiom, no `native_decide`, no `maxHeartbeats`, no `maxRecDepth`.
-/

namespace GQ2.Dyadic.Instances.MpcBld

open GQ2 GQ2.Dyadic GQ2.Dyadic.MarkedCore Multiplicative
open GQ2.Dyadic.Instances.MpcPiv GQ2.Dyadic.Instances.MpcOrb GQ2.Dyadic.Instances.MpcWord
open GQ2.Roe.Labute GQ2.Dyadic.SqCore

noncomputable section

/-! ## §1 The class-four calculus for the `M6` letters

Everything here is read in `Q₄ = G/λ₄` for an arbitrary topological group `G`, with
`Y = λ₂/λ₄` (`lambdaImage G 2 4`) and the central involutive layer `Z = λ₃/λ₄`
(`zLayer G 3`).  The committed class-four calculus (`cfour_*`) supplies every step; the four
lemmas below are the four factors of `mWord`. -/

section ClassFour

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- Moving a central factor one place to the right. -/
private theorem mpcBld_cmove {Q : Type*} [Group Q] {z : Q} (hz : ∀ x : Q, z * x = x * z)
    (x y : Q) : x * z * y = x * y * z := by
  rw [mul_assoc, hz, ← mul_assoc]

/-- A `Z`-element commutes with everything in `Q₄`. -/
private theorem mpcBld_zcomm {z : levelQuot G 4} (hz : z ∈ zLayer G 3) (x : levelQuot G 4) :
    z * x = x * z := (zLayer_commute hz x).eq

/-- The bracket swap, in any group. -/
private theorem mpcBld_commP_swap {Q : Type*} [Group Q] (x y : Q) :
    commP x y = (commP y x)⁻¹ := by
  simp only [commP]; group

/-- Naturality of the bracket, as a rewrite rule. -/
theorem mpcBld_map_commP {H K : Type*} [Group H] [Group K] (f : H →* K) (x y : H) :
    f (commP x y) = commP (f x) (f y) := by
  simp only [commP, map_mul, map_inv]

/-- **The near slot of a bracket is a homomorphism on `Y`.**  The correction term of
`cfour_commP_mul_left` is a bracket against a `Z`-element. -/
theorem mpcBld_commP_hom_left {y : levelQuot G 4} (hy : y ∈ lambdaImage G 2 4)
    (y' r : levelQuot G 4) : commP (y * y') r = commP y r * commP y' r := by
  rw [cfour_commP_mul_left, cfour_commP_zLayer_left (cfour_commP_mem_zLayer_left hy r) y', mul_one]

/-- The near slot of a bracket inverts on `Y`. -/
theorem mpcBld_commP_inv_left {y : levelQuot G 4} (hy : y ∈ lambdaImage G 2 4)
    (r : levelQuot G 4) : commP y⁻¹ r = (commP y r)⁻¹ := by
  have h : commP (y⁻¹ * y) r = commP y⁻¹ r * commP y r :=
    mpcBld_commP_hom_left (Subgroup.inv_mem _ hy) y r
  rw [inv_mul_cancel, cfour_one_comm] at h
  exact mul_eq_one_iff_eq_inv.mp h.symm

/-- **The `Ā`-letter's square**: `(p·z·σ)² = p²·(σ²·⁅σ,p⁆)` for `z` central of the top layer
(the letter's `B̄⁻⁴` factor) and `σ` a `Y`-correction. -/
theorem mpcBld_sq_letA {p σ z : levelQuot G 4} (hσ : σ ∈ lambdaImage G 2 4)
    (hz : z ∈ zLayer G 3) : (p * z * σ) ^ 2 = p ^ 2 * (σ ^ 2 * commP σ p) := by
  rw [mpcBld_cmove (mpcBld_zcomm hz) p σ]
  rw [cfour_sq_mul (p * σ) z, zLayer_sq G hz, cfour_commP_zLayer_left hz (p * σ),
    cfour_one_comm, mul_one, mul_one, mul_one]
  rw [cfour_sq_mul p σ, cfour_commP_zLayer_left (cfour_commP_mem_zLayer_left hσ p) σ, mul_one,
    mul_assoc]

/-- **The `Ā`/`B̄` bracket**: `⁅p·z·σ, q·τ⁆ = ⁅p,q⁆·(⁅p,τ⁆·⁅σ,q⁆)`.  Only the two first-order
terms survive; every correction of a correction dies at class four. -/
theorem mpcBld_comm_letAB {p q σ τ z : levelQuot G 4} (hσ : σ ∈ lambdaImage G 2 4)
    (hτ : τ ∈ lambdaImage G 2 4) (hz : z ∈ zLayer G 3) :
    commP (p * z * σ) (q * τ) = commP p q * (commP p τ * commP σ q) := by
  have h1 : commP (p * z * σ) (q * τ) = commP (p * z * σ) τ * commP (p * z * σ) q := by
    rw [cfour_commP_mul_right,
      cfour_commP_lambdaTwo (cfour_commP_mem_lambdaTwo (p * z * σ) q) hτ, mul_one]
  have h2 : commP (p * z * σ) τ = commP p τ := by
    rw [cfour_commP_left_hom (p * z) σ hτ, cfour_commP_lambdaTwo hσ hτ, mul_one,
      cfour_commP_left_hom p z hτ, cfour_commP_zLayer_left hz τ, mul_one]
  have h3 : commP (p * z * σ) q = commP p q * commP σ q := by
    rw [cfour_commP_mul_left (p * z) σ q,
      cfour_commP_lambdaTwo (cfour_commP_mem_lambdaTwo (p * z) q) hσ, mul_one,
      cfour_commP_mul_left p z q, cfour_commP_zLayer_right hz (commP p q),
      cfour_commP_zLayer_left hz q, mul_one, mul_one]
  rw [h1, h2, h3, ← mul_assoc,
    mpcBld_zcomm (cfour_commP_mem_zLayer_right p hτ) (commP p q), mul_assoc]

/-- **The `C̄₀`-letter's fourth power is blind to the whole shift**: `(q²·r·μ)⁴ = r⁴`.  Both the
`B̄²` prefix and the `Y`-correction contribute only `Z`-squares, and `Z` has exponent two. -/
theorem mpcBld_pow_letC (q r : levelQuot G 4) {μ : levelQuot G 4}
    (hμ : μ ∈ lambdaImage G 2 4) : (q ^ 2 * r * μ) ^ 4 = r ^ 4 := by
  have hq2 : q ^ 2 ∈ lambdaImage G 2 4 := cfour_sq_mem_lambdaTwo q
  have hμ4 : μ ^ 4 = 1 := by
    rw [pow_mul μ 2 2]
    exact zLayer_sq G (cfour_sq_mem_zLayer hμ)
  have hq24 : (q ^ 2) ^ 4 = 1 := by
    rw [pow_mul (q ^ 2) 2 2]
    exact zLayer_sq G (cfour_sq_mem_zLayer hq2)
  rw [cfour_pow_four_mul (q ^ 2 * r) μ, hμ4, mul_one,
    zLayer_sq G (cfour_commP_mem_zLayer_left hμ (q ^ 2 * r)), mul_one,
    cfour_pow_four_mul (q ^ 2) r, hq24, one_mul,
    zLayer_sq G (cfour_commP_mem_zLayer_right r hq2), mul_one]

/-- **The `C̄₀`/`D̄` bracket, with the class-four obstruction visible**:

    ⁅q²·r·μ, w·ν⁆ = ⁅r,w⁆ · (⁅q,w⁆²·⁅⁅q,w⁆,q⁆·⁅r,ν⁆·⁅μ,w⁆).

The two terms `⁅q,w⁆²·⁅⁅q,w⁆,q⁆` are the `B̄²` prefix's own cost - the Hall-Petrescu expansion of
`⁅q², w⁆` - and they are the whole class-four obstruction of the bare ansatz. -/
theorem mpcBld_comm_letCD {q r w μ ν : levelQuot G 4} (hμ : μ ∈ lambdaImage G 2 4)
    (hν : ν ∈ lambdaImage G 2 4) :
    commP (q ^ 2 * r * μ) (w * ν)
      = commP r w * (commP q w ^ 2 * commP (commP q w) q * commP r ν * commP μ w) := by
  have hq2 : q ^ 2 ∈ lambdaImage G 2 4 := cfour_sq_mem_lambdaTwo q
  have hβ : commP q w ∈ lambdaImage G 2 4 := cfour_commP_mem_lambdaTwo q w
  have hκ : commP (commP q w) q ∈ zLayer G 3 := cfour_commP_mem_zLayer_left hβ q
  have hβ2 : commP q w ^ 2 ∈ zLayer G 3 := cfour_sq_mem_zLayer hβ
  have hγ : commP r ν ∈ zLayer G 3 := cfour_commP_mem_zLayer_right r hν
  have hδ : commP μ w ∈ zLayer G 3 := cfour_commP_mem_zLayer_left hμ w
  have h1 : commP (q ^ 2 * r * μ) (w * ν)
      = commP (q ^ 2 * r * μ) ν * commP (q ^ 2 * r * μ) w := by
    rw [cfour_commP_mul_right,
      cfour_commP_lambdaTwo (cfour_commP_mem_lambdaTwo (q ^ 2 * r * μ) w) hν, mul_one]
  have h2 : commP (q ^ 2 * r * μ) ν = commP r ν := by
    rw [cfour_commP_left_hom (q ^ 2 * r) μ hν, cfour_commP_lambdaTwo hμ hν, mul_one,
      cfour_commP_left_hom (q ^ 2) r hν, cfour_commP_sq_left q hν, one_mul]
  have h4 : commP (q ^ 2) w = commP q w ^ 2 * commP (commP q w) q := by
    rw [pow_two q, cfour_commP_mul_left q q w, mpcBld_cmove (mpcBld_zcomm hκ), ← pow_two]
  have h3 : commP (q ^ 2 * r * μ) w
      = commP q w ^ 2 * commP (commP q w) q * commP r w * commP μ w := by
    rw [cfour_commP_mul_left (q ^ 2 * r) μ w,
      cfour_commP_lambdaTwo (cfour_commP_mem_lambdaTwo (q ^ 2 * r) w) hμ, mul_one,
      cfour_commP_mul_left (q ^ 2) r w,
      cfour_commP_zLayer_left (cfour_commP_mem_zLayer_left hq2 w) r, mul_one, h4]
  rw [h1, h2, h3]
  simp only [← mul_assoc]
  rw [mpcBld_zcomm hγ (commP q w ^ 2), mpcBld_cmove (mpcBld_zcomm hγ) (commP q w ^ 2),
    mpcBld_cmove (mpcBld_zcomm hγ) (commP q w ^ 2 * commP (commP q w) q),
    mpcBld_cmove (mpcBld_zcomm hκ) (commP q w ^ 2),
    mpcBld_zcomm hβ2 (commP r w)]

/-- The four-fold central shuffle used to assemble the core word. -/
private theorem mpcBld_shuffle4 {Q : Type*} [Group Q] {z₁ z₂ z₄ : Q}
    (h₁ : ∀ x : Q, z₁ * x = x * z₁) (h₂ : ∀ x : Q, z₂ * x = x * z₂) (x₁ x₂ x₃ x₄ : Q) :
    x₁ * z₁ * (x₂ * z₂) * x₃ * (x₄ * z₄) = x₁ * x₂ * x₃ * x₄ * (z₁ * z₂ * z₄) := by
  have e₁ := mpcBld_cmove h₁
  have e₂ := mpcBld_cmove h₂
  calc x₁ * z₁ * (x₂ * z₂) * x₃ * (x₄ * z₄)
      = x₁ * z₁ * x₂ * z₂ * x₃ * x₄ * z₄ := by group
    _ = x₁ * x₂ * z₁ * z₂ * x₃ * x₄ * z₄ := by rw [e₁ x₁ x₂]
    _ = x₁ * x₂ * z₁ * x₃ * z₂ * x₄ * z₄ := by rw [e₂ (x₁ * x₂ * z₁) x₃]
    _ = x₁ * x₂ * x₃ * z₁ * z₂ * x₄ * z₄ := by rw [e₁ (x₁ * x₂) x₃]
    _ = x₁ * x₂ * x₃ * z₁ * x₄ * z₂ * z₄ := by rw [e₂ (x₁ * x₂ * x₃ * z₁) x₄]
    _ = x₁ * x₂ * x₃ * x₄ * z₁ * z₂ * z₄ := by rw [e₁ (x₁ * x₂ * x₃) x₄]
    _ = x₁ * x₂ * x₃ * x₄ * (z₁ * z₂ * z₄) := by group

/-- ⭐⭐ **THE CLASS-FOUR DEFECT OF THE `M6` ANSATZ, IN CLOSED FORM.**  In `Q₄`, for any four
`Y`-corrections,

    mWord 2 (p·z·σ) (q·τ) (q²·r·μ) (w·ν)
      = mWord 2 p q r w · (σ²·⁅σ,p⁆ · ⁅p,τ⁆·⁅σ,q⁆ · ⁅q,w⁆²·⁅⁅q,w⁆,q⁆·⁅r,ν⁆·⁅μ,w⁆)

with `z` any element of the top layer (the ansatz uses `z = (q⁴)⁻¹`).  Every factor of the
defect lies in `Z`, which is central of exponent two, so **the class-four rung is a linear
equation over `𝔽₂`**: this is the exact per-class statement the greedy ladder can only sample. -/
theorem mpcBld_mWord_four {p q r w σ τ μ ν z : levelQuot G 4}
    (hσ : σ ∈ lambdaImage G 2 4) (hτ : τ ∈ lambdaImage G 2 4)
    (hμ : μ ∈ lambdaImage G 2 4) (hν : ν ∈ lambdaImage G 2 4) (hz : z ∈ zLayer G 3) :
    mWord 2 (p * z * σ) (q * τ) (q ^ 2 * r * μ) (w * ν)
      = mWord 2 p q r w * (σ ^ 2 * commP σ p * (commP p τ * commP σ q) *
          (commP q w ^ 2 * commP (commP q w) q * commP r ν * commP μ w)) := by
  have hE₁ : σ ^ 2 * commP σ p ∈ zLayer G 3 :=
    Subgroup.mul_mem _ (cfour_sq_mem_zLayer hσ) (cfour_commP_mem_zLayer_left hσ p)
  have hE₂ : commP p τ * commP σ q ∈ zLayer G 3 :=
    Subgroup.mul_mem _ (cfour_commP_mem_zLayer_right p hτ) (cfour_commP_mem_zLayer_left hσ q)
  simp only [mWord, show (2 : ℕ) ^ 2 = 4 from rfl]
  rw [mpcBld_sq_letA hσ hz, mpcBld_comm_letAB hσ hτ hz, mpcBld_pow_letC q r hμ,
    mpcBld_comm_letCD hμ hν]
  exact mpcBld_shuffle4 (z₄ := _) (mpcBld_zcomm hE₁) (mpcBld_zcomm hE₂) _ _ _ _

end ClassFour

/-! ## §2 The defect downstairs, on `D_M 2 0`

Transporting §1 through `levelMk` and killing the marked relator with `mpcOrb_relation`: the
whole class-four content of the `M6` ansatz is that one eight-term product dies. -/

section Defect

/-- The `M6` ansatz's core word, modulo `λ₄`, is exactly the defect. -/
theorem mpcBld_defect_four (s t m n : (DM 2 0 : Type))
    (hs : s ∈ twoCentralSeries (DM 2 0 : Type) 2)
    (ht : t ∈ twoCentralSeries (DM 2 0 : Type) 2)
    (hm : m ∈ twoCentralSeries (DM 2 0 : Type) 2)
    (hn : n ∈ twoCentralSeries (DM 2 0 : Type) 2) :
    levelMk (DM 2 0 : Type) 4
        (mWord 2 (mpcWordLetA s) (mpcWordLetB t) (mpcWordLetC m) (mpcWordLetD n))
      = levelMk (DM 2 0 : Type) 4
        (s ^ 2 * commP s (dmA 2 0) * (commP (dmA 2 0) t * commP s (dmB 2 0)) *
          (commP (dmB 2 0) (dmD 2 0) ^ 2 * commP (commP (dmB 2 0) (dmD 2 0)) (dmB 2 0) *
            commP (dmC 2 0) n * commP m (dmD 2 0))) := by
  have hrel : mWord 2 (levelMk (DM 2 0 : Type) 4 (dmA 2 0)) (levelMk (DM 2 0 : Type) 4 (dmB 2 0))
      (levelMk (DM 2 0 : Type) 4 (dmC 2 0)) (levelMk (DM 2 0 : Type) 4 (dmD 2 0)) = 1 := by
    rw [← map_mWord, mpcOrb_relation, map_one]
  have hz : (levelMk (DM 2 0 : Type) 4 (dmB 2 0) ^ 4)⁻¹ ∈ zLayer (DM 2 0 : Type) 3 :=
    Subgroup.inv_mem _ (cfour_pow_four_mem_zLayer _)
  have hA : levelMk (DM 2 0 : Type) 4 (mpcWordLetA s)
      = levelMk (DM 2 0 : Type) 4 (dmA 2 0) * (levelMk (DM 2 0 : Type) 4 (dmB 2 0) ^ 4)⁻¹ *
        levelMk (DM 2 0 : Type) 4 s := by
    rw [mpcWordLetA, map_mul, map_mul, map_inv, map_pow]
  have hB : levelMk (DM 2 0 : Type) 4 (mpcWordLetB t)
      = levelMk (DM 2 0 : Type) 4 (dmB 2 0) * levelMk (DM 2 0 : Type) 4 t := by
    rw [mpcWordLetB, map_mul]
  have hC : levelMk (DM 2 0 : Type) 4 (mpcWordLetC m)
      = levelMk (DM 2 0 : Type) 4 (dmB 2 0) ^ 2 * levelMk (DM 2 0 : Type) 4 (dmC 2 0) *
        levelMk (DM 2 0 : Type) 4 m := by
    rw [mpcWordLetC, map_mul, map_mul, map_pow]
  have hD : levelMk (DM 2 0 : Type) 4 (mpcWordLetD n)
      = levelMk (DM 2 0 : Type) 4 (dmD 2 0) * levelMk (DM 2 0 : Type) 4 n := by
    rw [mpcWordLetD, map_mul]
  rw [map_mWord, hA, hB, hC, hD,
    mpcBld_mWord_four (G := (DM 2 0 : Type)) ⟨s, hs, rfl⟩ ⟨t, ht, rfl⟩ ⟨m, hm, rfl⟩ ⟨n, hn, rfl⟩
      hz, hrel, one_mul]
  simp only [map_mul, map_pow, commP, map_inv]

end Defect

/-! ## §3 The class-four rung, climbed

Wave 84 §4.2's witness `s = t = ⁅D̄, B̄⁆`, `m = n = 1` kills the defect: the `⁅D̄,B̄⁆`-square
cancels `⁅B̄,D̄⁆²`, the two `Ā`-brackets cancel each other, and `⁅⁅D̄,B̄⁆,B̄⁆` cancels the triple
bracket `⁅⁅B̄,D̄⁆,B̄⁆`.  All six live in the exponent-two layer `Z`, so the cancellation is the
elementary abelian one, and the hand computation becomes a theorem. -/

section Witness

/-- Six central involutions in the pattern the witness produces multiply to `1`. -/
private theorem mpcBld_kill6 {Q : Type*} [Group Q] {z₁ z₂ z₃ : Q}
    (h₁ : ∀ x : Q, z₁ * x = x * z₁) (e₁ : z₁ ^ 2 = 1) (e₂ : z₂ ^ 2 = 1) (e₃ : z₃ ^ 2 = 1) :
    z₁ * z₂ * (z₂ * z₃) * (z₁ * z₃) = 1 := by
  calc z₁ * z₂ * (z₂ * z₃) * (z₁ * z₃)
      = z₁ * z₂ * (z₂ * z₃) * z₁ * z₃ := by group
    _ = z₁ * (z₁ * z₂ * (z₂ * z₃)) * z₃ := by rw [← h₁ (z₁ * z₂ * (z₂ * z₃))]
    _ = z₁ ^ 2 * z₂ ^ 2 * z₃ ^ 2 := by rw [pow_two, pow_two, pow_two]; group
    _ = 1 := by rw [e₁, e₂, e₃, one_mul, one_mul]

/-- The `M6` witness correction: `⁅D̄, B̄⁆`. -/
def mpcBldW : (DM 2 0 : Type) := commP (dmD 2 0) (dmB 2 0)

theorem mpcBld_w_mem : mpcBldW ∈ twoCentralSeries (DM 2 0 : Type) 2 :=
  cfour_commP_mem_two _ _

/-- Every bracket is χ-trivial: `χ_M` lands in the commutative group `ℤ₂ˣ`. -/
theorem mpcBld_chi_commP (x y : (DM 2 0 : Type)) : chiM 2 0 (commP x y) = 1 := by
  have h : chiM 2 0 (commP x y)
      = (chiM 2 0 x)⁻¹ * (chiM 2 0 y)⁻¹ * chiM 2 0 x * chiM 2 0 y := by
    simp only [commP, map_mul, map_inv]
  rw [h, mul_comm ((chiM 2 0 x)⁻¹) ((chiM 2 0 y)⁻¹)]
  group

/-- ⭐⭐ **THE CLASS-FOUR RUNG IS CLIMBED.**  The wave-84 witness `s = t = ⁅D̄, B̄⁆`, `m = n = 1`
solves the `M6` identity to class four.  Formalizes wave 84 §4.2, whose kill was a hand
computation in the Magnus model. -/
theorem mpcBld_mem_four_witness :
    mWord 2 (mpcWordLetA mpcBldW) (mpcWordLetB mpcBldW) (mpcWordLetC 1) (mpcWordLetD 1)
      ∈ twoCentralSeries (DM 2 0 : Type) 4 := by
  rw [mpcWord_mem_iff_levelMk,
    mpcBld_defect_four mpcBldW mpcBldW 1 1 mpcBld_w_mem mpcBld_w_mem (one_mem _) (one_mem _)]
  simp only [mpcBldW, map_mul, map_pow, mpcBld_map_commP, cfour_comm_one,
    cfour_one_comm, mul_one]
  set p := levelMk (DM 2 0 : Type) 4 (dmA 2 0) with hp
  set q := levelMk (DM 2 0 : Type) 4 (dmB 2 0) with hq
  set r := levelMk (DM 2 0 : Type) 4 (dmC 2 0) with hr
  set w := levelMk (DM 2 0 : Type) 4 (dmD 2 0) with hw
  have hβ : commP q w ∈ lambdaImage (DM 2 0 : Type) 2 4 := cfour_commP_mem_lambdaTwo q w
  have hβinv : commP w q ∈ lambdaImage (DM 2 0 : Type) 2 4 := cfour_commP_mem_lambdaTwo w q
  have hβ2 : commP q w ^ 2 ∈ zLayer (DM 2 0 : Type) 3 := cfour_sq_mem_zLayer hβ
  have hκ : commP (commP q w) q ∈ zLayer (DM 2 0 : Type) 3 :=
    cfour_commP_mem_zLayer_left hβ q
  have hP : commP (commP w q) p ∈ zLayer (DM 2 0 : Type) 3 :=
    cfour_commP_mem_zLayer_left hβinv p
  -- the three cancellations
  have hsq : commP w q ^ 2 = commP q w ^ 2 := by
    rw [mpcBld_commP_swap w q, inv_pow]
    exact zLayer_inv_self hβ2
  have hswapA : commP p (commP w q) = commP (commP w q) p := by
    rw [mpcBld_commP_swap p (commP w q)]
    exact zLayer_inv_self hP
  have hswapB : commP (commP w q) q = commP (commP q w) q := by
    rw [mpcBld_commP_swap w q, mpcBld_commP_inv_left hβ q]
    exact zLayer_inv_self hκ
  rw [hsq, hswapA, hswapB]
  exact mpcBld_kill6 (mpcBld_zcomm hβ2) (zLayer_sq _ hβ2)
    (zLayer_sq _ hP) (zLayer_sq _ hκ)

/-- The class-four solution set of the `M6` ansatz is nonempty. -/
theorem mpcBld_nonempty_four : (mpcWordSet 4).Nonempty := by
  refine ⟨(mpcBldW, mpcBldW, 1, 1), ⟨mpcBld_w_mem, ?_⟩, ⟨mpcBld_w_mem, ?_⟩, one_mem _,
    one_mem _, mpcBld_mem_four_witness⟩ <;>
  exact mpcBld_chi_commP _ _

/-- ⭐ **THE RESIDUE STARTS AT CLASS FIVE.**  Wave 84's `mpcWord_shift_of_forall_class_four` with
its first rung discharged: `MpcPivShift 2` follows from class-`k` solvability for `k ≥ 5` alone. -/
theorem mpcBld_shift_of_forall_class_five
    (H : ∀ k, 5 ≤ k → (mpcWordSet k).Nonempty) : MpcPivShift 2 := by
  refine mpcWord_shift_of_forall_class_four fun k hk => ?_
  rcases eq_or_lt_of_le hk with h | h
  · exact h ▸ mpcBld_nonempty_four
  · exact H k (by omega)

end Witness

