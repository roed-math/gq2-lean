import GQ2.Dyadic.Instances.AnchoredTameInertiaRelativeIndex

/-!
# The prescribed tame-inertia field is group-theoretically unramified

The field `anchoredTameInertiaField` is fixed by the preimage of the cyclic subgroup generated by
the finite image of `tqTau`.  This module proves the strongest available group-theoretic version
of its expected unramifiedness: every finite image of `inertiaPartQ` lies in that cyclic subgroup.
Consequently the quotient cutting out the prescribed field factors through `QurQ`, the tame
quotient with its full closed inertia subgroup removed.

The remaining gap is an exact semantic bridge.  No current theorem says that a finite field cut
out by a quotient of `QurQ` has relative ramification index one.  The AX4 unit clause is also
strictly weaker than the needed full-inertia statement: it kills reciprocity units under `nuTq`,
the pro-`2` unramified coordinate, while `qMkQ` retains the prime-to-`2` unramified coordinates.
`TameUnitInertiaRefinement` names the precise missing strengthening and identifies it with
`qMkQ (tameFK g) = 1` on reciprocity units.  Even after that group membership is known, the
present `MarkedRecip` API has no relative norm-reciprocity/unit-index theorem for this prescribed
field.

On the field side, `relE(F₀/K) = 1` is proved equivalent to the repository's exact spectral
unramifiedness statement: every nonzero value in `F₀` is represented by a nonzero value in `K`.
The compatible-use forms preserve the determinant consumer's custom action and feed the W171
relative-oddness producer.
-/

namespace GQ2.Dyadic

noncomputable section

open GQ2

local notation "ℚ̄₂" => AlgebraicClosure ℚ_[2]

/-- Every finite image of the closed tame-inertia subgroup lies in the cyclic subgroup generated
by the image of `tqTau`. -/
theorem inertiaPartQ_le_comap_zpowers_tqTau
    (q : ℕ) {D : Type} [Group D] [TopologicalSpace D] [DiscreteTopology D] [Finite D]
    (c : ContinuousMonoidHom (Tq q) D) :
    inertiaPartQ q ≤
      (Subgroup.zpowers (c (tqTau q))).comap c.toMonoidHom := by
  let cR : ContinuousMonoidHom (Tq q) ↑c.toMonoidHom.range :=
    { toFun := c.toMonoidHom.rangeRestrict
      map_one' := Subtype.ext (map_one c)
      map_mul' := fun x y => Subtype.ext (map_mul c x y)
      continuous_toFun := c.continuous_toFun.subtype_mk _ }
  have hgen : Subgroup.closure {cR (tqSigma q), cR (tqTau q)} = ⊤ :=
    gen_tq_quotient cR.toMonoidHom cR.continuous_toFun c.toMonoidHom.rangeRestrict_surjective
  have hrel : (cR (tqSigma q))⁻¹ * cR (tqTau q) * cR (tqSigma q) =
      (cR (tqTau q)) ^ q := tame_rel_map_q cR.toMonoidHom
  letI : (Subgroup.zpowers (cR (tqTau q))).Normal :=
    TameQ.zpowers_normal hgen hrel
  have hclosed : IsClosed
      ((((Subgroup.zpowers (cR (tqTau q))).comap cR.toMonoidHom) :
        Subgroup (Tq q)) : Set (Tq q)) := by
    change IsClosed (cR ⁻¹' ((Subgroup.zpowers (cR (tqTau q))) :
      Set ↑c.toMonoidHom.range))
    exact (isClosed_discrete _).preimage cR.continuous_toFun
  have hle : inertiaPartQ q ≤
      (Subgroup.zpowers (cR (tqTau q))).comap cR.toMonoidHom := by
    refine Subgroup.topologicalClosure_minimal _ ?_ hclosed
    refine Subgroup.normalClosure_le_normal ?_
    intro x hx
    rcases Set.mem_singleton_iff.mp hx with rfl
    exact Subgroup.mem_comap.mpr (Subgroup.mem_zpowers _)
  intro x hx
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp (Subgroup.mem_comap.mp (hle hx))
  exact Subgroup.mem_zpowers_iff.mpr ⟨n, congrArg Subtype.val hn⟩

/-- For a compatible marking, the subgroup defining the prescribed anchored tame-inertia field
contains the pullback of `inertiaPartQ`. -/
theorem tameInertia_preimage_le_anchoredTameInertia_preimage
    (P : FieldParameters) (K : IntermediateField ℚ_[2] ℚ̄₂)
    {D : Type} [Group D] [TopologicalSpace D] [DiscreteTopology D] [Finite D]
    (tame : ContinuousMonoidHom ↑(GalKsub K) (Tq P.qK))
    (c : ContinuousMonoidHom (Tq P.qK) D)
    (rho : ContinuousMonoidHom ↑(GalKsub K) D)
    (hfac : ∀ g : ↑(GalKsub K), rho g = c (tame g)) :
    (inertiaPartQ P.qK).comap tame.toMonoidHom ≤
      (Subgroup.zpowers (c (tqTau P.qK))).comap rho.toMonoidHom := by
  intro g hg
  change rho g ∈ Subgroup.zpowers (c (tqTau P.qK))
  rw [hfac]
  exact inertiaPartQ_le_comap_zpowers_tqTau P.qK c hg

/-- The missing refinement of AX4's unit orientation: reciprocity units land in the full closed
tame-inertia subgroup, not merely in the kernel of the pro-`2` coordinate `nuTq`. -/
def TameUnitInertiaRefinement
    {R : LocalReciprocity} {K : IntermediateField ℚ_[2] ℚ̄₂}
    [FiniteDimensional ℚ_[2] K] (B : MarkedRecip R K) (FK : DyadicUnitFiltration K)
    (T : OrientedTameQuotientK B FK) : Prop :=
  ∀ (u : (↥K)ˣ) (g : GalK K), ‖((u : ↥K) : ℚ̄₂)‖ = 1 →
    toAbK K g = B.recip u → T.tameFK g ∈ inertiaPartQ (qOf K FK)

/-- Equivalently, the genuinely unramified quotient `qMkQ` kills every reciprocity unit. -/
theorem tameUnitInertiaRefinement_iff_qMkQ_recip_unit
    {R : LocalReciprocity} {K : IntermediateField ℚ_[2] ℚ̄₂}
    [FiniteDimensional ℚ_[2] K] (B : MarkedRecip R K) (FK : DyadicUnitFiltration K)
    (T : OrientedTameQuotientK B FK) :
    TameUnitInertiaRefinement B FK T ↔
      ∀ (u : (↥K)ˣ) (g : GalK K), ‖((u : ↥K) : ℚ̄₂)‖ = 1 →
        toAbK K g = B.recip u → qMkQ (qOf K FK) (T.tameFK g) = 1 := by
  refine forall_congr' fun u => forall_congr' fun g => forall_congr' fun hu =>
    forall_congr' fun hg => ?_
  exact (quotientMk_eq_one_iff (N := inertiaPartQ (qOf K FK))).symm

/-- The refined unit statement places every reciprocity unit in the subgroup defining each
finite prescribed tame-inertia field. -/
theorem recipUnit_mem_anchoredTameInertia_preimage_of_refinement
    {R : LocalReciprocity} {K : IntermediateField ℚ_[2] ℚ̄₂}
    [FiniteDimensional ℚ_[2] K] (B : MarkedRecip R K) (FK : DyadicUnitFiltration K)
    (T : OrientedTameQuotientK B FK) (Hunit : TameUnitInertiaRefinement B FK T)
    {D : Type} [Group D] [TopologicalSpace D] [DiscreteTopology D] [Finite D]
    (c : ContinuousMonoidHom (Tq (qOf K FK)) D)
    (rho : ContinuousMonoidHom ↑(GalKsub K) D)
    (hfac : ∀ g : ↑(GalKsub K), rho g = c (T.tameFK g))
    (u : (↥K)ˣ) (g : GalK K) (hu : ‖((u : ↥K) : ℚ̄₂)‖ = 1)
    (hg : toAbK K g = B.recip u) :
    g ∈ (Subgroup.zpowers (c (tqTau (qOf K FK)))).comap rho.toMonoidHom := by
  change rho g ∈ Subgroup.zpowers (c (tqTau (qOf K FK)))
  rw [hfac]
  exact inertiaPartQ_le_comap_zpowers_tqTau (qOf K FK) c (Hunit u g hu hg)

/-- For the prescribed anchored field, relative index one is equivalent to equality of spectral
value groups with the base field. -/
theorem anchoredTameInertiaField_relE_eq_one_iff_equalNormValues
    (K : IntermediateField ℚ_[2] ℚ̄₂) [FiniteDimensional ℚ_[2] K]
    (FK : DyadicUnitFiltration K)
    {D : Type} [Group D] [TopologicalSpace D] [DiscreteTopology D]
    (rho : ContinuousMonoidHom ↑(GalKsub K) D) (t : D)
    (F₀F : DyadicUnitFiltration (anchoredTameInertiaField (GalKsub K) rho t)) :
    GaloisCosetNorm.relE FK F₀F
        (baseField_le_anchoredTameInertiaField K rho t) = 1 ↔
      ∀ x : ℚ̄₂, x ≠ 0 → x ∈ anchoredTameInertiaField (GalKsub K) rho t →
        ∃ y : ℚ̄₂, y ≠ 0 ∧ y ∈ K ∧ ‖x‖ = ‖y‖ := by
  let hKF₀ := baseField_le_anchoredTameInertiaField K rho t
  constructor
  · intro hrel
    have hπ := GaloisCosetNorm.relE_spec FK F₀F hKF₀
    rw [hrel, zpow_one] at hπ
    exact UnramifiedNorm.hunram_of_uniformizer_norm_eq FK F₀F hπ.symm
  · intro hnorm
    have hdiv : GaloisCosetNorm.relE FK F₀F hKF₀ ∣ (1 : ℤ) :=
      GaloisCosetNorm.relE_dvd FK F₀F hKF₀ (n := 1) (fun x hx0 hxF₀ => by
        obtain ⟨y, hy0, hyK, hxy⟩ := hnorm x hx0 hxF₀
        exact ⟨y, hy0, hyK, by simpa using hxy⟩)
    have hunit : IsUnit (GaloisCosetNorm.relE FK F₀F hKF₀) := isUnit_of_dvd_one hdiv
    rw [Int.isUnit_iff] at hunit
    rcases hunit with h | h
    · exact h
    · have hpos := GaloisCosetNorm.relE_pos FK F₀F hKF₀
      omega

/-- The exact prescribed-field unramified premise, with the determinant consumer's compatible
ramified-use quantification and custom action unchanged. -/
def AnchoredTameInertiaRelativeUnramifiedDataAt
    (P : FieldParameters) (K : IntermediateField ℚ_[2] ℚ̄₂)
    [FiniteDimensional ℚ_[2] K] (FK : DyadicUnitFiltration K)
    (tame : ContinuousMonoidHom ↑(GalKsub K) (Tq P.qK)) : Prop :=
  ∀ {D : Type} [Group D] [TopologicalSpace D] [DiscreteTopology D] [Finite D]
    (V : Type) [AddCommGroup V] [DistribMulAction D V]
    (c : ContinuousMonoidHom (Tq P.qK) D)
    (rho : ContinuousMonoidHom ↑(GalKsub K) D),
    (∀ g : ↑(GalKsub K), rho g = c (tame g)) →
      (∃ v : V, c (tqTau P.qK) • v ≠ v) →
        ∃ F₀F : DyadicUnitFiltration
            (anchoredTameInertiaField (GalKsub K) rho (c (tqTau P.qK))),
          GaloisCosetNorm.relE FK F₀F
            (baseField_le_anchoredTameInertiaField K rho (c (tqTau P.qK))) = 1

/-- The same prescribed-field statement in the repository's spectral value-group vocabulary. -/
def AnchoredTameInertiaEqualNormValuesAt
    (P : FieldParameters) (K : IntermediateField ℚ_[2] ℚ̄₂)
    (tame : ContinuousMonoidHom ↑(GalKsub K) (Tq P.qK)) : Prop :=
  ∀ {D : Type} [Group D] [TopologicalSpace D] [DiscreteTopology D] [Finite D]
    (V : Type) [AddCommGroup V] [DistribMulAction D V]
    (c : ContinuousMonoidHom (Tq P.qK) D)
    (rho : ContinuousMonoidHom ↑(GalKsub K) D),
    (∀ g : ↑(GalKsub K), rho g = c (tame g)) →
      (∃ v : V, c (tqTau P.qK) • v ≠ v) →
        ∀ x : ℚ̄₂, x ≠ 0 →
          x ∈ anchoredTameInertiaField (GalKsub K) rho (c (tqTau P.qK)) →
            ∃ y : ℚ̄₂, y ≠ 0 ∧ y ∈ K ∧ ‖x‖ = ‖y‖

/-- Relative index one and equal spectral value groups are equivalent at every compatible use. -/
theorem anchoredTameInertiaRelativeUnramifiedDataAt_iff_equalNormValues
    (P : FieldParameters) (K : IntermediateField ℚ_[2] ℚ̄₂)
    [FiniteDimensional ℚ_[2] K] (FK : DyadicUnitFiltration K)
    (tame : ContinuousMonoidHom ↑(GalKsub K) (Tq P.qK)) :
    AnchoredTameInertiaRelativeUnramifiedDataAt P K FK tame ↔
      AnchoredTameInertiaEqualNormValuesAt P K tame := by
  constructor
  · intro H D _ _ _ _ V _ _ c rho hfac hram
    obtain ⟨F₀F, hrel⟩ := H V c rho hfac hram
    exact (anchoredTameInertiaField_relE_eq_one_iff_equalNormValues K FK rho
      (c (tqTau P.qK)) F₀F).mp hrel
  · intro H D _ _ _ _ V _ _ c rho hfac hram
    let F₀ := anchoredTameInertiaField (GalKsub K) rho (c (tqTau P.qK))
    letI : FiniteDimensional ℚ_[2] F₀ :=
      anchoredTameInertiaField_finiteDimensional (GalKsub K)
        (isOpen_fixingSubgroup K) rho (c (tqTau P.qK))
    let F₀F : DyadicUnitFiltration F₀ := dyadicUnitFiltration F₀
    exact ⟨F₀F,
      (anchoredTameInertiaField_relE_eq_one_iff_equalNormValues K FK rho
        (c (tqTau P.qK)) F₀F).mpr (H V c rho hfac hram)⟩

/-- Prescribed-field unramifiedness supplies the relative oddness packet from W171. -/
theorem anchoredTameInertiaRelativeOddDataAt_of_relativeUnramified
    (P : FieldParameters) (K : IntermediateField ℚ_[2] ℚ̄₂)
    [FiniteDimensional ℚ_[2] K] (FK : DyadicUnitFiltration K)
    (tame : ContinuousMonoidHom ↑(GalKsub K) (Tq P.qK))
    (Hunram : AnchoredTameInertiaRelativeUnramifiedDataAt P K FK tame) :
    AnchoredTameInertiaRelativeOddDataAt P K FK tame := by
  intro D _ _ _ _ V _ _ c rho hfac hram
  obtain ⟨F₀F, hrel⟩ := Hunram V c rho hfac hram
  exact ⟨F₀F, hrel ▸ odd_one⟩

/-- The exact prescribed-field unramified statement closes the compatible involution norm
packet over an odd-degree base. -/
theorem anchoredInvolutionEqualNormValueGroupsAt_of_prescribedTameUnramified
    (P : FieldParameters) (K : IntermediateField ℚ_[2] ℚ̄₂)
    [FiniteDimensional ℚ_[2] K] (FK : DyadicUnitFiltration K)
    (tame : ContinuousMonoidHom ↑(GalKsub K) (Tq P.qK))
    (htame : Function.Surjective tame) (hodd : Odd (Module.finrank ℚ_[2] K))
    (Hunram : AnchoredTameInertiaRelativeUnramifiedDataAt P K FK tame) :
    AnchoredInvolutionEqualNormValueGroupsAt P (GalKsub K) tame :=
  anchoredInvolutionEqualNormValueGroupsAt_of_relativeOddTameInertia P K FK tame htame hodd
    (anchoredTameInertiaRelativeOddDataAt_of_relativeUnramified P K FK tame Hunram)

