noncomputable section

/-! ## §0 The class-six layer calculus

Everything is read in `Q₆ = G/λ₆`, with four layers in play instead of class five's three:

* `Y = λ₂/λ₆` (`lambdaImage G 2 6`), where every bracket lands;
* `L = λ₃/λ₆`, where `⁅Y, G⁆`, `Y²` and `p⁴` land;
* `M = λ₄/λ₆`, where `⁅L, G⁆`, `⁅Y, Y⁆`, `L²` and `p⁸` land;
* `Z = λ₅/λ₆` (`zLayer G 5`), central of exponent two, where `⁅M, G⁆`, `⁅L, Y⁆`, `M²` and `p¹⁶`
  land.

**What changes from class five.**  At class five the correction layer `L` was abelian and
commuted with `Y`, so the four factors of `mWord` assembled with nothing incurred (`MpcFive` §4).
At class six that argument is unavailable: `⁅L, Y⁆` is only known to land in `Z`, and `Z` is not
trivial in `Q₆`, so neither `L`-abelianness nor `⁅L, Y⁆ = 1` is on hand.  (Nothing below asserts
that `⁅L, Y⁆ ≠ 1`; what is committed is that the class-five proof delivers nothing there, the
scope wave 70's `GradedClassFive` header uses for the same kind of statement.)  What survives one
layer deeper is `⁅M, Y⁆ = 1` (`mpcSx_vanish_four`, the instance `k = 4` of
`cfive_commutator_lambdaTwo`), and that single fact is what every cancellation below reduces to,
together with the centrality of `Z`.

So the class-six discipline is: `M`-valued factors move freely through `Y`, `Z`-valued factors
move freely through everything, and an `L`-valued factor moves only by paying an explicit
`Z`-term, which the identities below carry rather than drop. -/

section Calculus

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- The bracket swap, in any group. -/
theorem mpcSx_swap {Q : Type*} [Group Q] (x y : Q) : commP x y = (commP y x)⁻¹ := by
  simp only [commP]; group

/-- Moving a central factor one place to the right. -/
private theorem mpcSx_cmove {Q : Type*} [Group Q] {z : Q} (hz : ∀ x : Q, z * x = x * z)
    (x y : Q) : x * z * y = x * y * z := by
  rw [mul_assoc, hz, ← mul_assoc]

/-- Moving a central factor one place to the left. -/
private theorem mpcSx_cmoveL {Q : Type*} [Group Q] {z : Q} (hz : ∀ x : Q, z * x = x * z)
    (x y : Q) : x * y * z = x * z * y := (mpcSx_cmove hz x y).symm

/-- Moving one factor one place to the right past another it commutes with. -/
private theorem mpcSx_mv {Q : Type*} [Group Q] {e x : Q} (h : e * x = x * e) (u v : Q) :
    u * e * x * v = u * x * e * v := by rw [mul_assoc u e x, h, ← mul_assoc]

/-- **The class-six collection step.**  One central factor `c₁` interleaved with a marked factor
`s`, and one factor `mz` that commutes with `s`: the three central factors come out at the right
and `mz` passes `s`.  This is the shape every reordering below takes. -/
private theorem mpcSx_collect3 {Q : Type*} [Group Q] {c₁ mz s : Q}
    (h₁ : ∀ x : Q, c₁ * x = x * c₁) (hms : mz * s = s * mz) (P c₂ c₃ : Q) :
    P * mz * (c₁ * s * c₂) * c₃ = P * s * mz * (c₁ * c₂ * c₃) := by
  calc P * mz * (c₁ * s * c₂) * c₃ = P * mz * c₁ * s * c₂ * c₃ := by group
    _ = P * mz * s * c₁ * c₂ * c₃ := by rw [mpcSx_cmove h₁ (P * mz) s]
    _ = P * mz * s * (c₁ * c₂ * c₃) := by group
    _ = P * s * mz * (c₁ * c₂ * c₃) := by rw [mul_assoc P mz s, hms]; group

/-- Pulling three central factors out of the pattern the two bracket blocks produce. -/
private theorem mpcSx_zpull3 {Q : Type*} [Group Q] {e₁ e₂ e₃ : Q}
    (h₁ : ∀ x : Q, e₁ * x = x * e₁) (h₂ : ∀ x : Q, e₂ * x = x * e₂) (A B C D : Q) :
    A * e₁ * (B * C * e₂) * (D * e₃) = A * B * C * D * (e₁ * e₂ * e₃) := by
  calc A * e₁ * (B * C * e₂) * (D * e₃) = A * e₁ * B * C * e₂ * D * e₃ := by group
    _ = A * B * e₁ * C * e₂ * D * e₃ := by rw [mpcSx_cmove h₁ A B]
    _ = A * B * C * e₁ * e₂ * D * e₃ := by rw [mpcSx_cmove h₁ (A * B) C]
    _ = A * B * C * e₁ * D * e₂ * e₃ := by rw [mpcSx_cmove h₂ (A * B * C * e₁) D]
    _ = A * B * C * D * e₁ * e₂ * e₃ := by rw [mpcSx_cmove h₁ (A * B * C) D]
    _ = A * B * C * D * (e₁ * e₂ * e₃) := by group

/-- Pushing three central factors past one non-central one. -/
private theorem mpcSx_zout3 {Q : Type*} [Group Q] {z₁ z₂ z₃ : Q}
    (h₁ : ∀ x : Q, z₁ * x = x * z₁) (h₂ : ∀ x : Q, z₂ * x = x * z₂)
    (h₃ : ∀ x : Q, z₃ * x = x * z₃) (a m : Q) :
    a * z₁ * z₂ * z₃ * m = a * m * (z₁ * z₂ * z₃) := by
  calc a * z₁ * z₂ * z₃ * m = a * z₁ * z₂ * m * z₃ := by rw [mpcSx_cmove h₃ (a * z₁ * z₂) m]
    _ = a * z₁ * m * z₂ * z₃ := by rw [mpcSx_cmove h₂ (a * z₁) m]
    _ = a * m * z₁ * z₂ * z₃ := by rw [mpcSx_cmove h₁ a m]
    _ = a * m * (z₁ * z₂ * z₃) := by group

/-- Moving an `L`-factor left past two `M`-factors and a central one. -/
private theorem mpcSx_lswap {Q : Type*} [Group Q] {m₁ m₂ l : Q}
    (h₁ : m₁ * l = l * m₁) (h₂ : m₂ * l = l * m₂) {z : Q} (hz : ∀ x : Q, z * x = x * z) (A : Q) :
    A * z * m₁ * m₂ * l = A * l * (m₁ * m₂ * z) := by
  calc A * z * m₁ * m₂ * l = A * m₁ * z * m₂ * l := by rw [mpcSx_cmove hz A m₁]
    _ = A * m₁ * m₂ * z * l := by rw [mpcSx_cmove hz (A * m₁) m₂]
    _ = A * m₁ * m₂ * l * z := by rw [mpcSx_cmove hz (A * m₁ * m₂) l]
    _ = A * m₁ * l * m₂ * z := by rw [mpcSx_mv h₂ (A * m₁) z]
    _ = A * l * m₁ * m₂ * z := by rw [mpcSx_mv h₁ A m₂]
    _ = A * l * (m₁ * m₂ * z) := by group

/-- The two-block collection: one block's correction passes the next block's marked part. -/
private theorem mpcSx_shuffleAB {Q : Type*} [Group Q] {x₁ x₂ e₁ e₂ e₃ : Q}
    (h₁₂ : e₁ * x₂ = x₂ * e₁) :
    x₁ * e₁ * (x₂ * e₂) * e₃ = x₁ * x₂ * (e₁ * e₂ * e₃) := by
  calc x₁ * e₁ * (x₂ * e₂) * e₃ = x₁ * e₁ * x₂ * e₂ * e₃ := by group
    _ = x₁ * x₂ * e₁ * e₂ * e₃ := by rw [mpcSx_mv h₁₂ x₁ e₂]
    _ = x₁ * x₂ * (e₁ * e₂ * e₃) := by group

/-- Pushing two central factors past three that commute with each other. -/
private theorem mpcSx_zout2 {Q : Type*} [Group Q] {z₃ z₄ : Q}
    (h₃ : ∀ x : Q, z₃ * x = x * z₃) (h₄ : ∀ x : Q, z₄ * x = x * z₄)
    (A m₁ m₂ m₃ z₁ z₂ : Q) :
    A * z₃ * z₄ * m₁ * m₂ * m₃ * z₁ * z₂ = A * m₁ * m₂ * m₃ * (z₃ * z₄ * z₁ * z₂) := by
  calc A * z₃ * z₄ * m₁ * m₂ * m₃ * z₁ * z₂
      = A * z₃ * m₁ * z₄ * m₂ * m₃ * z₁ * z₂ := by rw [mpcSx_cmove h₄ (A * z₃) m₁]
    _ = A * m₁ * z₃ * z₄ * m₂ * m₃ * z₁ * z₂ := by rw [mpcSx_cmove h₃ A m₁]
    _ = A * m₁ * z₃ * m₂ * z₄ * m₃ * z₁ * z₂ := by rw [mpcSx_cmove h₄ (A * m₁ * z₃) m₂]
    _ = A * m₁ * m₂ * z₃ * z₄ * m₃ * z₁ * z₂ := by rw [mpcSx_cmove h₃ (A * m₁) m₂]
    _ = A * m₁ * m₂ * z₃ * m₃ * z₄ * z₁ * z₂ := by rw [mpcSx_cmove h₄ (A * m₁ * m₂ * z₃) m₃]
    _ = A * m₁ * m₂ * m₃ * z₃ * z₄ * z₁ * z₂ := by rw [mpcSx_cmove h₃ (A * m₁ * m₂) m₃]
    _ = A * m₁ * m₂ * m₃ * (z₃ * z₄ * z₁ * z₂) := by group

/-- **The `C̄₀`/`D̄` collection at class six.**  Three `M`-factors move right through the two
`L`-factors and the marked bracket `y`; then `y` moves to the front past both `L`-factors, at the
cost of the two central brackets `z₃`, `z₄`. -/
private theorem mpcSx_shuffleCD {Q : Type*} [Group Q] {m₁ m₂ m₃ l₁ l₂ y z₁ z₂ z₃ z₄ : Q}
    (hz₁ : ∀ x : Q, z₁ * x = x * z₁) (hz₂ : ∀ x : Q, z₂ * x = x * z₂)
    (hz₃ : ∀ x : Q, z₃ * x = x * z₃) (hz₄ : ∀ x : Q, z₄ * x = x * z₄)
    (h₁₁ : m₁ * l₁ = l₁ * m₁) (h₁₂ : m₁ * l₂ = l₂ * m₁) (h₁y : m₁ * y = y * m₁)
    (h₂y : m₂ * y = y * m₂)
    (hs₁ : l₁ * y = y * l₁ * z₃) (hs₂ : l₂ * y = y * l₂ * z₄) :
    m₁ * z₁ * l₁ * (l₂ * m₂ * y) * (z₂ * m₃)
      = y * (l₁ * l₂) * (m₁ * m₂ * m₃) * (z₃ * z₄ * z₁ * z₂) := by
  have hy2 : l₁ * l₂ * y = y * l₁ * l₂ * z₃ * z₄ := by
    calc l₁ * l₂ * y = l₁ * (l₂ * y) := by group
      _ = l₁ * (y * l₂ * z₄) := by rw [hs₂]
      _ = l₁ * y * l₂ * z₄ := by group
      _ = y * l₁ * z₃ * l₂ * z₄ := by rw [hs₁]
      _ = y * l₁ * l₂ * z₃ * z₄ := by rw [mpcSx_cmove hz₃ (y * l₁) l₂]
  calc m₁ * z₁ * l₁ * (l₂ * m₂ * y) * (z₂ * m₃)
      = m₁ * z₁ * l₁ * l₂ * m₂ * y * z₂ * m₃ := by group
    _ = m₁ * z₁ * l₁ * l₂ * m₂ * y * m₃ * z₂ := by
        rw [mpcSx_cmove hz₂ (m₁ * z₁ * l₁ * l₂ * m₂ * y) m₃]
    _ = m₁ * l₁ * l₂ * m₂ * y * m₃ * z₁ * z₂ := by
        rw [mpcSx_cmove hz₁ m₁ l₁, mpcSx_cmove hz₁ (m₁ * l₁) l₂,
          mpcSx_cmove hz₁ (m₁ * l₁ * l₂) m₂, mpcSx_cmove hz₁ (m₁ * l₁ * l₂ * m₂) y,
          mpcSx_cmove hz₁ (m₁ * l₁ * l₂ * m₂ * y) m₃]
    _ = l₁ * l₂ * m₁ * m₂ * y * m₃ * z₁ * z₂ := by rw [h₁₁, mpcSx_mv h₁₂ l₁ m₂]
    _ = l₁ * l₂ * y * m₁ * m₂ * m₃ * z₁ * z₂ := by
        rw [mpcSx_mv h₂y (l₁ * l₂ * m₁) m₃, mpcSx_mv h₁y (l₁ * l₂) m₂]
    _ = y * l₁ * l₂ * z₃ * z₄ * m₁ * m₂ * m₃ * z₁ * z₂ := by rw [hy2]
    _ = y * (l₁ * l₂) * (m₁ * m₂ * m₃) * (z₃ * z₄ * z₁ * z₂) := by
        rw [show y * l₁ * l₂ * z₃ * z₄ * m₁ * m₂ * m₃ * z₁ * z₂
            = y * l₁ * l₂ * z₃ * z₄ * m₁ * m₂ * m₃ * z₁ * z₂ from rfl,
          mpcSx_zout2 hz₃ hz₄ (y * l₁ * l₂) m₁ m₂ m₃ z₁ z₂]
        group

/-- ⭐ **THE FOUR-LETTER SHUFFLE AT CLASS SIX.**  Each of `mWord`'s four factors splits as a
marked part times a correction.  At class five every correction commuted with every marked part
to its right and the four collected for free (`mpcFv_shuffle4`).  At class six only the third
does: the first two corrections are `L`-valued and the marked parts they have to pass are
`Y`-valued, so each pass costs one central bracket.  Two costs, not five, because a correction
passes the whole remaining marked block in one step. -/
private theorem mpcSx_shuffle4 {Q : Type*} [Group Q] {x₁ x₂ x₃ x₄ e₁ e₂ e₃ e₄ c₁ c₂ : Q}
    (h₁ : e₁ * (x₂ * x₃ * x₄) = x₂ * x₃ * x₄ * e₁ * c₁)
    (h₂ : e₂ * (x₃ * x₄) = x₃ * x₄ * e₂ * c₂) (h₃ : e₃ * x₄ = x₄ * e₃)
    (k₁ : ∀ x : Q, c₁ * x = x * c₁) (k₂ : ∀ x : Q, c₂ * x = x * c₂) :
    x₁ * e₁ * (x₂ * e₂) * (x₃ * e₃) * (x₄ * e₄)
      = x₁ * x₂ * x₃ * x₄ * (e₁ * e₂ * e₃ * e₄ * (c₁ * c₂)) := by
  calc x₁ * e₁ * (x₂ * e₂) * (x₃ * e₃) * (x₄ * e₄)
      = x₁ * e₁ * x₂ * e₂ * x₃ * (e₃ * x₄) * e₄ := by group
    _ = x₁ * e₁ * x₂ * (e₂ * (x₃ * x₄)) * e₃ * e₄ := by rw [h₃]; group
    _ = x₁ * (e₁ * (x₂ * x₃ * x₄)) * e₂ * c₂ * e₃ * e₄ := by rw [h₂]; group
    _ = x₁ * x₂ * x₃ * x₄ * e₁ * c₁ * e₂ * c₂ * e₃ * e₄ := by rw [h₁]; group
    _ = x₁ * x₂ * x₃ * x₄ * e₁ * c₁ * e₂ * e₃ * c₂ * e₄ := by
        rw [mpcSx_cmove k₂ (x₁ * x₂ * x₃ * x₄ * e₁ * c₁ * e₂) e₃]
    _ = x₁ * x₂ * x₃ * x₄ * e₁ * c₁ * e₂ * e₃ * e₄ * c₂ := by
        rw [mpcSx_cmove k₂ (x₁ * x₂ * x₃ * x₄ * e₁ * c₁ * e₂ * e₃) e₄]
    _ = x₁ * x₂ * x₃ * x₄ * e₁ * e₂ * c₁ * e₃ * e₄ * c₂ := by
        rw [mpcSx_cmove k₁ (x₁ * x₂ * x₃ * x₄ * e₁) e₂]
    _ = x₁ * x₂ * x₃ * x₄ * e₁ * e₂ * e₃ * c₁ * e₄ * c₂ := by
        rw [mpcSx_cmove k₁ (x₁ * x₂ * x₃ * x₄ * e₁ * e₂) e₃]
    _ = x₁ * x₂ * x₃ * x₄ * e₁ * e₂ * e₃ * e₄ * c₁ * c₂ := by
        rw [mpcSx_cmove k₁ (x₁ * x₂ * x₃ * x₄ * e₁ * e₂ * e₃) e₄]
    _ = x₁ * x₂ * x₃ * x₄ * (e₁ * e₂ * e₃ * e₄ * (c₁ * c₂)) := by group

/-- The head swap of §2: two `Y`-factors exchange at the cost of one central bracket. -/
private theorem mpcSx_headswap {Q : Type*} [Group Q] (a b c E : Q) {z : Q}
    (hz : ∀ x : Q, z * x = x * z) (hzdef : a * b = b * a * z) :
    a * (b * c) * E = b * (a * c) * (E * z) := by
  calc a * (b * c) * E = a * b * c * E := by group
    _ = b * a * z * c * E := by rw [hzdef]
    _ = b * a * c * z * E := by rw [mpcSx_cmove hz (b * a) c]
    _ = b * a * c * E * z := by rw [mpcSx_cmove hz (b * a * c) E]
    _ = b * (a * c) * (E * z) := by group

/-- The layers of `Q₆` are nested. -/
theorem mpcSx_lam_le {j k : ℕ} (h : k ≤ j) {y : levelQuot G 6} (hy : y ∈ lambdaImage G j 6) :
    y ∈ lambdaImage G k 6 := by
  obtain ⟨v, hv, rfl⟩ := hy
  exact ⟨v, twoCentralSeries_antitone (G := G) h hv, rfl⟩

/-- **`λ₆` is trivial in `Q₆`.**  Every class-six cancellation below is an instance of this. -/
theorem mpcSx_six_eq_one {y : levelQuot G 6} (hy : y ∈ lambdaImage G 6 6) : y = 1 := by
  obtain ⟨v, hv, rfl⟩ := hy
  exact (QuotientGroup.eq_one_iff v).mpr hv

/-- A bracket with a `λ_k`-slot on the left drops one layer. -/
theorem mpcSx_commP_step {k : ℕ} {y : levelQuot G 6} (hy : y ∈ lambdaImage G k 6)
    (x : levelQuot G 6) : commP y x ∈ lambdaImage G (k + 1) 6 := by
  obtain ⟨v, hv, rfl⟩ := hy
  obtain ⟨b, rfl⟩ := levelMk_surjective G 6 x
  exact ⟨commP v b, cfive_commP_mem_succ hv b, by simp only [commP, map_mul, map_inv]⟩

/-- A bracket with a `λ_k`-slot on the right drops one layer. -/
theorem mpcSx_commP_step' {k : ℕ} (x : levelQuot G 6) {y : levelQuot G 6}
    (hy : y ∈ lambdaImage G k 6) : commP x y ∈ lambdaImage G (k + 1) 6 := by
  rw [mpcSx_swap]
  exact Subgroup.inv_mem _ (mpcSx_commP_step hy x)

/-- ⭐ **A bracket of a `λ_k`-slot against a `Y`-slot drops TWO layers**: the instance of
`cfive_commutator_lambdaTwo` read in `Q₆`.  This is the engine of the whole section. -/
theorem mpcSx_commP_lam {k : ℕ} {v w : levelQuot G 6} (hv : v ∈ lambdaImage G k 6)
    (hw : w ∈ lambdaImage G 2 6) : commP v w ∈ lambdaImage G (k + 2) 6 := by
  obtain ⟨a, ha, rfl⟩ := hv
  obtain ⟨b, hb, rfl⟩ := hw
  exact ⟨commP a b, cfive_commutator_lambdaTwo ha hb, by simp only [commP, map_mul, map_inv]⟩

/-- The same with the slots exchanged. -/
theorem mpcSx_commP_lam' {k : ℕ} {v w : levelQuot G 6} (hv : v ∈ lambdaImage G k 6)
    (hw : w ∈ lambdaImage G 2 6) : commP w v ∈ lambdaImage G (k + 2) 6 := by
  rw [mpcSx_swap]
  exact Subgroup.inv_mem _ (mpcSx_commP_lam hv hw)

/-- The square of a `λ_k`-image is a `λ_{k+1}`-image. -/
theorem mpcSx_sq_step {k : ℕ} {y : levelQuot G 6} (hy : y ∈ lambdaImage G k 6) :
    y ^ 2 ∈ lambdaImage G (k + 1) 6 := by
  obtain ⟨v, hv, rfl⟩ := hy
  exact ⟨v ^ 2, sq_mem_twoCentralSeries_succ G hv, by rw [map_pow]⟩

/-- ⭐⭐ **`⁅M, Y⁆ = 1` in `Q₆`.**  The class-six replacement for class five's `⁅L, Y⁆ = 1`:
one layer deeper, and the only free commutation the class-six calculus has. -/
theorem mpcSx_vanish_four {m y : levelQuot G 6} (hm : m ∈ lambdaImage G 4 6)
    (hy : y ∈ lambdaImage G 2 6) : commP m y = 1 :=
  mpcSx_six_eq_one (mpcSx_commP_lam hm hy)

/-- `⁅Y, M⁆ = 1` in `Q₆`. -/
theorem mpcSx_vanish_four' {m y : levelQuot G 6} (hm : m ∈ lambdaImage G 4 6)
    (hy : y ∈ lambdaImage G 2 6) : commP y m = 1 :=
  mpcSx_six_eq_one (mpcSx_commP_lam' hm hy)

/-- An `M`-element commutes with every `Y`-element. -/
theorem mpcSx_mcomm {m y : levelQuot G 6} (hm : m ∈ lambdaImage G 4 6)
    (hy : y ∈ lambdaImage G 2 6) : m * y = y * m :=
  (cfour_commute_of_comm (mpcSx_vanish_four hm hy)).eq

/-- ⭐ **`M` is abelian in `Q₆`**, since `M ⊆ Y`. -/
theorem mpcSx_mcomm' {m m' : levelQuot G 6} (hm : m ∈ lambdaImage G 4 6)
    (hm' : m' ∈ lambdaImage G 4 6) : m * m' = m' * m :=
  mpcSx_mcomm hm (mpcSx_lam_le (by omega) hm')

/-- Every bracket of `Q₆` is a `Y`-element. -/
theorem mpcSx_commP_mem_two (x y : levelQuot G 6) : commP x y ∈ lambdaImage G 2 6 :=
  mpcLad_commP_mem_two (j := 4) x y

/-- Moving an `M`-factor one place to the right past a `Y`-factor. -/
private theorem mpcSx_mmove {m y : levelQuot G 6} (hm : m ∈ lambdaImage G 4 6)
    (hy : y ∈ lambdaImage G 2 6) (x : levelQuot G 6) : x * m * y = x * y * m := by
  rw [mul_assoc, mpcSx_mcomm hm hy, ← mul_assoc]

/-- A `Z`-element commutes with everything in `Q₆`. -/
theorem mpcSx_zcomm {z : levelQuot G 6} (hz : z ∈ zLayer G 5) (x : levelQuot G 6) :
    z * x = x * z := (zLayer_commute hz x).eq

/-- A `Z`-element kills a bracket from the left. -/
theorem mpcSx_commP_zLayer_left {z : levelQuot G 6} (hz : z ∈ zLayer G 5) (x : levelQuot G 6) :
    commP z x = 1 := bridge_comm_of_commute (zLayer_commute hz x).eq

/-- A `Z`-element kills a bracket from the right. -/
theorem mpcSx_commP_zLayer_right (x : levelQuot G 6) {z : levelQuot G 6} (hz : z ∈ zLayer G 5) :
    commP x z = 1 := by rw [mpcSx_swap, mpcSx_commP_zLayer_left hz x, inv_one]

/-- Squares in `Q₆`: `p²` is a `Y`-element. -/
theorem mpcSx_pow_two_mem (p : levelQuot G 6) : p ^ 2 ∈ lambdaImage G 2 6 := by
  obtain ⟨a, rfl⟩ := levelMk_surjective G 6 p
  exact ⟨a ^ 2, sq_mem_twoCentralSeries_succ G (Subgroup.mem_top a), by rw [map_pow]⟩

/-- Fourth powers are `L`-elements in `Q₆`. -/
theorem mpcSx_pow_four_mem (p : levelQuot G 6) : p ^ 4 ∈ lambdaImage G 3 6 := by
  obtain ⟨a, rfl⟩ := levelMk_surjective G 6 p
  refine ⟨a ^ 4, ?_, by rw [map_pow]⟩
  have h := pow_two_pow_mem_twoCentralSeries_succ (G := G) a 2
  rwa [show (2 : ℕ) ^ 2 = 4 from by norm_num] at h

/-- ⭐ **Eighth powers are `M`-elements at class six**, where at class five they were central.
This is one of the two hazards the wave-87 note named. -/
theorem mpcSx_pow_eight_mem (p : levelQuot G 6) : p ^ 8 ∈ lambdaImage G 4 6 := by
  obtain ⟨a, rfl⟩ := levelMk_surjective G 6 p
  refine ⟨a ^ 8, ?_, by rw [map_pow]⟩
  have h := pow_two_pow_mem_twoCentralSeries_succ (G := G) a 3
  rwa [show (2 : ℕ) ^ 3 = 8 from by norm_num] at h

/-- **Sixteenth powers are what is central at class six.** -/
theorem mpcSx_pow_sixteen_mem (p : levelQuot G 6) : p ^ 16 ∈ zLayer G 5 := by
  obtain ⟨a, rfl⟩ := levelMk_surjective G 6 p
  refine ⟨a ^ 16, ?_, by rw [map_pow]⟩
  have h := pow_two_pow_mem_twoCentralSeries_succ (G := G) a 4
  rwa [show (2 : ℕ) ^ 4 = 16 from by norm_num] at h

/-- **Left-slot additivity against an `L`-factor followed by a `Y`-factor**: the correction of
`cfour_commP_mul_left` is a bracket of an `M`-element against a `Y`-element. -/
theorem mpcSx_commP_add_left_three {a b : levelQuot G 6} (ha : a ∈ lambdaImage G 3 6)
    (hb : b ∈ lambdaImage G 2 6) (c : levelQuot G 6) :
    commP (a * b) c = commP a c * commP b c := by
  rw [cfour_commP_mul_left, mpcSx_vanish_four (mpcSx_commP_step ha c) hb, mul_one]

/-- **Left-slot additivity for three `Y`-elements**: the correction is a bracket of an
`M`-element against a `Y`-element.  This is the class-six form of
`cfive_commP_lambdaTwo_hom_left`. -/
theorem mpcSx_commP_add_left_two {a b c : levelQuot G 6} (ha : a ∈ lambdaImage G 2 6)
    (hb : b ∈ lambdaImage G 2 6) (hc : c ∈ lambdaImage G 2 6) :
    commP (a * b) c = commP a c * commP b c := by
  rw [cfour_commP_mul_left, mpcSx_vanish_four (mpcSx_commP_lam ha hc) hb, mul_one]

/-- **A trailing `M`-factor is invisible in the left slot against a `Y`-slot**, provided the head
is a `Y`-element: both corrections are `⁅M, Y⁆`-terms. -/
theorem mpcSx_commP_drop_left_tail_four {b c y : levelQuot G 6} (hb : b ∈ lambdaImage G 2 6)
    (hc : c ∈ lambdaImage G 4 6) (hy : y ∈ lambdaImage G 2 6) :
    commP (b * c) y = commP b y := by
  rw [cfour_commP_mul_left, mpcSx_vanish_four hc hy,
    mpcSx_vanish_four (mpcSx_commP_lam hb hy) (mpcSx_lam_le (by omega) hc), mul_one, mul_one]

/-- **Left-slot additivity against an `M`-factor**: the correction is a bracket of a
`Z`-element. -/
theorem mpcSx_commP_add_left_four {a : levelQuot G 6} (ha : a ∈ lambdaImage G 4 6)
    (b c : levelQuot G 6) : commP (a * b) c = commP a c * commP b c := by
  rw [cfour_commP_mul_left, mpcSx_commP_zLayer_left (mpcSx_commP_step ha c) b, mul_one]

/-- **A leading `Z`-factor is invisible in the left slot.** -/
theorem mpcSx_commP_drop_left {a : levelQuot G 6} (ha : a ∈ zLayer G 5) (b c : levelQuot G 6) :
    commP (a * b) c = commP b c := by
  rw [cfour_commP_mul_left, mpcSx_commP_zLayer_left ha c, cfour_one_comm, one_mul, one_mul]

/-- **A trailing `Z`-factor is invisible in the left slot.** -/
theorem mpcSx_commP_drop_left_tail {c : levelQuot G 6} (hc : c ∈ zLayer G 5)
    (b a : levelQuot G 6) : commP (b * c) a = commP b a := by
  rw [cfour_commP_mul_left, mpcSx_commP_zLayer_left hc a,
    mpcSx_commP_zLayer_right (commP b a) hc, mul_one, mul_one]

/-- **A trailing `Z`-factor is invisible in the right slot.** -/
theorem mpcSx_commP_drop_right (a b : levelQuot G 6) {c : levelQuot G 6} (hc : c ∈ zLayer G 5) :
    commP a (b * c) = commP a b := by
  rw [cfour_commP_mul_right, mpcSx_commP_zLayer_right a hc,
    mpcSx_commP_zLayer_right (commP a b) hc, one_mul, mul_one]

/-- **Right-slot additivity against an `L`-factor and a `Y`-factor**, in the reversed order
`cfour_commP_mul_right` produces. -/
theorem mpcSx_commP_add_right_three (a : levelQuot G 6) {b c : levelQuot G 6}
    (hb : b ∈ lambdaImage G 3 6) (hc : c ∈ lambdaImage G 2 6) :
    commP a (b * c) = commP a c * commP a b := by
  rw [cfour_commP_mul_right, mpcSx_vanish_four (mpcSx_commP_step' a hb) hc, mul_one]

end Calculus

/-! ## §1 The `Ā`-letter's square

`mpcFv_sq_letA` reads `(p·z·σ)² = p²·(σ²·⁅σ,p⁆)·(z²·⁅z,p⁆)` in `Q₅`, where the two extra factors
`z²` and `⁅z,p⁆` are central and the three terms `⁅σ,z⁆`, `⁅⁅σ,p⁆,z⁆` and `⁅⁅σ,p⁆,σ⁆` are all
`⁅Y, L⁆`- or `⁅L, Y⁆`-terms and therefore trivial.  At class six those three survive, central of
exponent two, and `z²`, `⁅z,p⁆` sink from `Z` to `M`. -/

section LetterA

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- ⭐ **THE `Ā`-LETTER'S SQUARE AT CLASS SIX.**

    (p·z·σ)² = p² · (σ²·⁅σ,p⁆) · (z²·⁅z,p⁆) · (⁅σ,z⁆·⁅⁅σ,p⁆,z⁆·⁅⁅σ,p⁆,σ⁆) ,

with `z` an `L`-element and `σ` a `Y`-correction.  The first three groups are `mpcFv_sq_letA`;
the fourth is central of exponent two and is `1` in `Q₅`, where each of its three factors is a
bracket of an `L`-element against a `Y`-element. -/
theorem mpcSx_sq_letA {p σ z : levelQuot G 6} (hσ : σ ∈ lambdaImage G 2 6)
    (hz : z ∈ lambdaImage G 3 6) :
    (p * z * σ) ^ 2
      = p ^ 2 * (σ ^ 2 * commP σ p) * (z ^ 2 * commP z p) *
        (commP σ z * commP (commP σ p) z * commP (commP σ p) σ) := by
  have hzY : z ∈ lambdaImage G 2 6 := mpcSx_lam_le (by omega) hz
  have hz2 : z ^ 2 ∈ lambdaImage G 4 6 := mpcSx_sq_step hz
  have hzp : commP z p ∈ lambdaImage G 4 6 := mpcSx_commP_step hz p
  have hσp : commP σ p ∈ lambdaImage G 3 6 := mpcSx_commP_step hσ p
  have hσz : commP σ z ∈ zLayer G 5 := mpcSx_commP_lam' hz hσ
  have hσpz : commP (commP σ p) z ∈ zLayer G 5 := mpcSx_commP_lam hσp hzY
  have hσpσ : commP (commP σ p) σ ∈ zLayer G 5 := mpcSx_commP_lam hσp hσ
  have hσ2 : σ ^ 2 ∈ lambdaImage G 2 6 := mpcSx_lam_le (by omega) (mpcSx_sq_step hσ)
  have hσpY : commP σ p ∈ lambdaImage G 2 6 := mpcSx_lam_le (by omega) hσp
  -- the square of the `z`-shifted head: the second-order term is an `⁅M, Y⁆`-term
  have h1 : (p * z) ^ 2 = p ^ 2 * (z ^ 2 * commP z p) := by
    rw [cfour_sq_mul, mpcSx_vanish_four hzp hzY, mul_one, mul_assoc]
  -- the correction against the shifted head
  have h2 : commP σ (p * z) = commP σ z * commP σ p * commP (commP σ p) z :=
    cfour_commP_mul_right _ _ _
  -- the second-order term sees only the marked head
  have h3 : commP (commP σ (p * z)) σ = commP (commP σ p) σ := by
    rw [h2, mpcSx_commP_drop_left_tail hσpz, mpcSx_commP_drop_left hσz]
  calc (p * z * σ) ^ 2
      = (p * z) ^ 2 * σ ^ 2 * commP σ (p * z) * commP (commP σ (p * z)) σ := cfour_sq_mul _ _
    _ = p ^ 2 * (z ^ 2 * commP z p) * σ ^ 2 *
          (commP σ z * commP σ p * commP (commP σ p) z) * commP (commP σ p) σ := by
        rw [h1, h3, h2]
    _ = p ^ 2 * σ ^ 2 * (z ^ 2 * commP z p) *
          (commP σ z * commP σ p * commP (commP σ p) z) * commP (commP σ p) σ := by
        rw [mpcSx_mmove (Subgroup.mul_mem _ hz2 hzp) hσ2 (p ^ 2)]
    _ = p ^ 2 * σ ^ 2 * commP σ p * (z ^ 2 * commP z p) *
          (commP σ z * commP (commP σ p) z * commP (commP σ p) σ) :=
        mpcSx_collect3 (mpcSx_zcomm hσz)
          (mpcSx_mcomm (Subgroup.mul_mem _ hz2 hzp) hσpY) _ _ _
    _ = p ^ 2 * (σ ^ 2 * commP σ p) * (z ^ 2 * commP z p) *
          (commP σ z * commP (commP σ p) z * commP (commP σ p) σ) := by group

end LetterA

/-! ## §2 The `Ā`/`B̄` bracket

`mpcFv_comm_letAB` reads

    ⁅p·z·σ, q·τ⁆ = ⁅p,q⁆ · (⁅p,τ⁆·⁅σ,q⁆) · (⁅σ,τ⁆·⁅z,q⁆·⁅⁅p,q⁆,σ⁆·⁅⁅p,q⁆,τ⁆)

in `Q₅`, where the third group is central.  At class six that group sinks to `M` and six further
terms survive in `Z`.  **Five of the six are new bracket terms; the sixth is a reordering
term**, `⁅⁅p,τ⁆, ⁅p,q⁆⁆`, carried when the marked bracket `⁅p,q⁆` is moved to the front past the
`L`-term `⁅p,τ⁆`.  Class five drops that move for free because `⁅L, Y⁆ = 1` there; here the move
is priced instead.  Whether the price is nontrivial in any particular group is not claimed. -/

section LetterAB

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- ⭐ **THE `Ā`/`B̄` BRACKET AT CLASS SIX.**

    ⁅p·z·σ, q·τ⁆ = ⁅p,q⁆ · (⁅p,τ⁆·⁅σ,q⁆) · (⁅σ,τ⁆·⁅z,q⁆·⁅⁅p,q⁆,σ⁆·⁅⁅p,q⁆,τ⁆)
                        · (⁅⁅p,τ⁆,z⁆·⁅z,τ⁆·⁅⁅p,τ⁆,σ⁆·⁅⁅p,q⁆,z⁆·⁅⁅σ,q⁆,τ⁆·⁅⁅p,τ⁆,⁅p,q⁆⁆) .

The first three groups are `mpcFv_comm_letAB`; the fourth is central of exponent two and is `1`
in `Q₅`, where every one of its six factors is a bracket of an `L`-element against a
`Y`-element. -/
theorem mpcSx_comm_letAB {p q σ τ z : levelQuot G 6} (hσ : σ ∈ lambdaImage G 2 6)
    (hτ : τ ∈ lambdaImage G 2 6) (hz : z ∈ lambdaImage G 3 6) :
    commP (p * z * σ) (q * τ)
      = commP p q * (commP p τ * commP σ q) *
        (commP σ τ * commP z q * commP (commP p q) σ * commP (commP p q) τ) *
        (commP (commP p τ) z * commP z τ * commP (commP p τ) σ * commP (commP p q) z *
          commP (commP σ q) τ * commP (commP p τ) (commP p q)) := by
  have hzY : z ∈ lambdaImage G 2 6 := mpcSx_lam_le (by omega) hz
  have hpq : commP p q ∈ lambdaImage G 2 6 := mpcSx_commP_mem_two p q
  have hpτ : commP p τ ∈ lambdaImage G 3 6 := mpcSx_commP_step' p hτ
  have hσq : commP σ q ∈ lambdaImage G 3 6 := mpcSx_commP_step hσ q
  have hσqY : commP σ q ∈ lambdaImage G 2 6 := mpcSx_lam_le (by omega) hσq
  have hστ : commP σ τ ∈ lambdaImage G 4 6 := mpcSx_commP_lam hσ hτ
  have hzq : commP z q ∈ lambdaImage G 4 6 := mpcSx_commP_step hz q
  have hpqσ : commP (commP p q) σ ∈ lambdaImage G 4 6 := mpcSx_commP_lam hpq hσ
  have hpqτ : commP (commP p q) τ ∈ lambdaImage G 4 6 := mpcSx_commP_lam hpq hτ
  have hpτz : commP (commP p τ) z ∈ zLayer G 5 := mpcSx_commP_lam hpτ hzY
  have hzτ : commP z τ ∈ zLayer G 5 := mpcSx_commP_lam hz hτ
  have hpτσ : commP (commP p τ) σ ∈ zLayer G 5 := mpcSx_commP_lam hpτ hσ
  have hpqz : commP (commP p q) z ∈ zLayer G 5 := mpcSx_commP_lam' hz hpq
  have hσqτ : commP (commP σ q) τ ∈ zLayer G 5 := mpcSx_commP_lam hσq hτ
  have hswap : commP (commP p τ) (commP p q) ∈ zLayer G 5 := mpcSx_commP_lam hpτ hpq
  -- the `Ā`-letter against the `B̄`-correction
  have e1 : commP (p * z) τ = commP p τ * commP (commP p τ) z * commP z τ :=
    cfour_commP_mul_left p z τ
  have e2 : commP (commP (p * z) τ) σ = commP (commP p τ) σ := by
    rw [e1, mpcSx_commP_drop_left_tail hzτ, mpcSx_commP_drop_left_tail hpτz]
  have h2 : commP (p * z * σ) τ
      = commP p τ * (commP σ τ *
          (commP (commP p τ) z * commP z τ * commP (commP p τ) σ)) := by
    calc commP (p * z * σ) τ
        = commP (p * z) τ * commP (commP (p * z) τ) σ * commP σ τ :=
          cfour_commP_mul_left _ _ _
      _ = commP p τ * commP (commP p τ) z * commP z τ * commP (commP p τ) σ * commP σ τ := by
          rw [e2, e1]
      _ = commP p τ * (commP σ τ *
            (commP (commP p τ) z * commP z τ * commP (commP p τ) σ)) := by
          rw [mpcSx_zout3 (mpcSx_zcomm hpτz) (mpcSx_zcomm hzτ) (mpcSx_zcomm hpτσ)]
          group
  -- the `Ā`-letter against the marked `B̄`
  have f1 : commP (p * z) q = commP p q * commP (commP p q) z * commP z q :=
    cfour_commP_mul_left p z q
  have f2 : commP (commP (p * z) q) σ = commP (commP p q) σ := by
    rw [f1, mpcSx_commP_drop_left_tail_four (Subgroup.mul_mem _ hpq
      (mpcSx_lam_le (by omega) hpqz)) hzq hσ, mpcSx_commP_drop_left_tail hpqz]
  have h4 : commP (p * z * σ) q
      = commP p q * commP σ q *
        (commP z q * commP (commP p q) σ * commP (commP p q) z) := by
    calc commP (p * z * σ) q
        = commP (p * z) q * commP (commP (p * z) q) σ * commP σ q :=
          cfour_commP_mul_left _ _ _
      _ = commP p q * commP (commP p q) z * commP z q * commP (commP p q) σ * commP σ q := by
          rw [f2, f1]
      _ = commP p q * commP σ q *
            (commP z q * commP (commP p q) σ * commP (commP p q) z) :=
          mpcSx_lswap (mpcSx_mcomm hzq hσqY) (mpcSx_mcomm hpqσ hσqY) (mpcSx_zcomm hpqz) _
  -- the second-order correction sees the marked bracket and the `σ`-bracket
  have h5 : commP (commP (p * z * σ) q) τ
      = commP (commP p q) τ * commP (commP σ q) τ := by
    rw [h4, mpcSx_commP_drop_left_tail_four (Subgroup.mul_mem _ hpq hσqY)
      (Subgroup.mul_mem _ (Subgroup.mul_mem _ hzq hpqσ) (mpcSx_lam_le (by omega) hpqz)) hτ,
      mpcSx_commP_add_left_two hpq hσqY hτ]
  calc commP (p * z * σ) (q * τ)
      = commP (p * z * σ) τ * commP (p * z * σ) q * commP (commP (p * z * σ) q) τ :=
        cfour_commP_mul_right _ _ _
    _ = commP p τ * (commP σ τ *
            (commP (commP p τ) z * commP z τ * commP (commP p τ) σ)) *
          (commP p q * commP σ q *
            (commP z q * commP (commP p q) σ * commP (commP p q) z)) *
          (commP (commP p q) τ * commP (commP σ q) τ) := by rw [h5, h4, h2]
    _ = commP p τ * (commP p q * commP σ q) *
          ((commP σ τ * (commP (commP p τ) z * commP z τ * commP (commP p τ) σ)) *
            (commP z q * commP (commP p q) σ * commP (commP p q) z) *
            (commP (commP p q) τ * commP (commP σ q) τ)) :=
        mpcSx_shuffleAB (mpcSx_mcomm (Subgroup.mul_mem _ hστ (mpcSx_lam_le (by omega)
          (Subgroup.mul_mem _ (Subgroup.mul_mem _ hpτz hzτ) hpτσ)))
          (Subgroup.mul_mem _ hpq hσqY))
    _ = commP p q * (commP p τ * commP σ q) *
          (((commP σ τ * (commP (commP p τ) z * commP z τ * commP (commP p τ) σ)) *
            (commP z q * commP (commP p q) σ * commP (commP p q) z) *
            (commP (commP p q) τ * commP (commP σ q) τ)) *
            commP (commP p τ) (commP p q)) :=
        mpcSx_headswap _ _ _ _ (mpcSx_zcomm hswap) (cfive_swap_free _ _)
    _ = commP p q * (commP p τ * commP σ q) *
          (commP σ τ * commP z q * commP (commP p q) σ * commP (commP p q) τ) *
          (commP (commP p τ) z * commP z τ * commP (commP p τ) σ * commP (commP p q) z *
            commP (commP σ q) τ * commP (commP p τ) (commP p q)) := by
        rw [mpcSx_zpull3
          (mpcSx_zcomm (Subgroup.mul_mem _ (Subgroup.mul_mem _ hpτz hzτ) hpτσ))
          (mpcSx_zcomm hpqz) (commP σ τ) (commP z q) (commP (commP p q) σ)
          (commP (commP p q) τ)]
        group

end LetterAB

/-! ## §3 The pivot letter's fourth power, and the `C̄₀`/`D̄` bracket

**Scope, carried by §3 AND §4 and repeated at §4's own head and in both theorem docstrings, so
that no site inherits it from a block it cannot see: the pivot correction is trivial.**
`mpcLad_pow_letC_five` and `mpcFv_comm_letCD` carry a general `μ ∈ Y`; §3 and §4 take `μ = 1`.
That is not a loss for the class-six rung, because **both climbed witnesses have a
trivial pivot correction**: `mpcLadW4 = (W, W, 1, 1)` and `mpcFvW5 = (W, W·B̄⁴, 1, B̄⁴·⁅B̄²,D̄⁆)`,
so the pivot slot has never been used by the ladder.  The general-`μ` class-six statement is
open, and nothing below is evidence about it either way.

`mpcLad_pow_letC_five` at `μ = 1` reads `(q²·r)⁴ = r⁴·(q⁸·⁅r,q²⁆²)` in `Q₅`.  At class six five
more terms survive: `q⁸` and `⁅r,q²⁆²` sink from `Z` to `M`, and four `Z`-terms appear, three of
them brackets against the `L`-element `⁅r,q²⁆` and one the square of the second-order term
`⁅⁅r,q²⁆,r⁆` that class five could drop outright. -/

section LetterC

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- ⭐ **THE PIVOT LETTER'S FOURTH POWER AT CLASS SIX**, at trivial pivot correction:

    (q²·r)⁴ = r⁴ · (q⁸·⁅r,q²⁆²) · (⁅r²,q⁴⁆·⁅⁅r,q²⁆,r²⁆·⁅⁅r,q²⁆,q⁴⁆·⁅⁅r,q²⁆,r⁆²) .

The first two groups are `mpcLad_pow_letC_five` at `μ = 1`; the third is central of exponent two
and vanishes at class five, where each factor is a bracket against an `L`-element or the square
of one. -/
theorem mpcSx_pow_letC (q r : levelQuot G 6) :
    (q ^ 2 * r) ^ 4
      = r ^ 4 * (q ^ 8 * commP r (q ^ 2) ^ 2) *
        (commP (r ^ 2) (q ^ 4) * commP (commP r (q ^ 2)) (r ^ 2) *
          commP (commP r (q ^ 2)) (q ^ 4) * commP (commP r (q ^ 2)) r ^ 2) := by
  have e4 : (q ^ 2) ^ 2 = q ^ 4 := by rw [← pow_mul]
  have e8 : (q ^ 4) ^ 2 = q ^ 8 := by rw [← pow_mul]
  have er4 : (r ^ 2) ^ 2 = r ^ 4 := by rw [← pow_mul]
  have hq2 : q ^ 2 ∈ lambdaImage G 2 6 := mpcSx_pow_two_mem q
  have hq4 : q ^ 4 ∈ lambdaImage G 3 6 := mpcSx_pow_four_mem q
  have hq4Y : q ^ 4 ∈ lambdaImage G 2 6 := mpcSx_lam_le (by omega) hq4
  have hq8 : q ^ 8 ∈ lambdaImage G 4 6 := mpcSx_pow_eight_mem q
  have hr2 : r ^ 2 ∈ lambdaImage G 2 6 := mpcSx_pow_two_mem r
  have hr4 : r ^ 4 ∈ lambdaImage G 3 6 := mpcSx_pow_four_mem r
  have hr4Y : r ^ 4 ∈ lambdaImage G 2 6 := mpcSx_lam_le (by omega) hr4
  have hT : commP r (q ^ 2) ∈ lambdaImage G 3 6 := mpcSx_commP_step' r hq2
  have hTY : commP r (q ^ 2) ∈ lambdaImage G 2 6 := mpcSx_lam_le (by omega) hT
  have hT2 : commP r (q ^ 2) ^ 2 ∈ lambdaImage G 4 6 := mpcSx_sq_step hT
  have hK : commP (commP r (q ^ 2)) r ∈ lambdaImage G 4 6 := mpcSx_commP_step hT r
  have hK2 : commP (commP r (q ^ 2)) r ^ 2 ∈ zLayer G 5 := mpcSx_sq_step hK
  have hZ1 : commP (r ^ 2) (q ^ 4) ∈ zLayer G 5 := mpcSx_commP_lam' hq4 hr2
  have hZ2 : commP (commP r (q ^ 2)) (r ^ 2) ∈ zLayer G 5 := mpcSx_commP_lam hT hr2
  have hZ3 : commP (commP r (q ^ 2)) (q ^ 4) ∈ zLayer G 5 := mpcSx_commP_lam hT hq4Y
  -- the square of the row-shifted pivot
  have hsq2 : (q ^ 2 * r) ^ 2
      = q ^ 4 * r ^ 2 * commP r (q ^ 2) * commP (commP r (q ^ 2)) r := by
    rw [cfour_sq_mul, e4]
  -- the second-order term is an `M`-element, so it separates from the square
  have hSK : ∀ S : levelQuot G 6, S ∈ lambdaImage G 2 6 →
      (S * commP (commP r (q ^ 2)) r) ^ 2 = S ^ 2 * commP (commP r (q ^ 2)) r ^ 2 := by
    intro S hS
    rw [cfour_sq_mul, mpcSx_vanish_four hK hS, cfour_one_comm, mul_one, mul_one]
  -- the square of the `Y`-part
  have hXY : (q ^ 4 * r ^ 2) ^ 2 = q ^ 8 * r ^ 4 * commP (r ^ 2) (q ^ 4) := by
    rw [cfour_sq_mul, mpcSx_commP_zLayer_left hZ1 (r ^ 2), mul_one, e8, er4]
  have hbr : commP (commP r (q ^ 2)) (q ^ 4 * r ^ 2)
      = commP (commP r (q ^ 2)) (r ^ 2) * commP (commP r (q ^ 2)) (q ^ 4) :=
    mpcSx_commP_add_right_three _ hq4 hr2
  have hS2 : (q ^ 4 * r ^ 2 * commP r (q ^ 2)) ^ 2
      = q ^ 8 * r ^ 4 * commP (r ^ 2) (q ^ 4) * commP r (q ^ 2) ^ 2 *
        (commP (commP r (q ^ 2)) (r ^ 2) * commP (commP r (q ^ 2)) (q ^ 4)) := by
    rw [cfour_sq_mul, mpcSx_commP_zLayer_left (mpcSx_commP_lam hT
      (Subgroup.mul_mem _ hq4Y hr2)) (commP r (q ^ 2)), mul_one, hXY, hbr]
  calc (q ^ 2 * r) ^ 4
      = ((q ^ 2 * r) ^ 2) ^ 2 := by rw [← pow_mul]
    _ = (q ^ 4 * r ^ 2 * commP r (q ^ 2)) ^ 2 * commP (commP r (q ^ 2)) r ^ 2 := by
        rw [hsq2, hSK _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ hq4Y hr2) hTY)]
    _ = q ^ 8 * r ^ 4 * commP (r ^ 2) (q ^ 4) * commP r (q ^ 2) ^ 2 *
          (commP (commP r (q ^ 2)) (r ^ 2) * commP (commP r (q ^ 2)) (q ^ 4)) *
          commP (commP r (q ^ 2)) r ^ 2 := by rw [hS2]
    _ = r ^ 4 * (q ^ 8 * commP r (q ^ 2) ^ 2) *
          (commP (r ^ 2) (q ^ 4) * commP (commP r (q ^ 2)) (r ^ 2) *
            commP (commP r (q ^ 2)) (q ^ 4) * commP (commP r (q ^ 2)) r ^ 2) := by
        rw [mpcSx_cmove (mpcSx_zcomm hZ1) (q ^ 8 * r ^ 4) (commP r (q ^ 2) ^ 2),
          show q ^ 8 * r ^ 4 = r ^ 4 * q ^ 8 from mpcSx_mcomm hq8 hr4Y]
        group

end LetterC

/-! ## §4 The `C̄₀`/`D̄` bracket at class six

**Scope, repeated from §3: the pivot correction is trivial** (`μ = 1`).  `mpcFv_comm_letCD`
carries a general `μ ∈ Y`; this section does not, and the general-`μ` class-six statement is
open. -/

section LetterCD

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- ⭐ **THE `C̄₀`/`D̄` BRACKET AT CLASS SIX**, at trivial pivot correction:

    ⁅q²·r, w·ν⁆ = ⁅r,w⁆ · (⁅r,ν⁆·⁅q²,w⁆) · (⁅q²,ν⁆·⁅⁅q²,w⁆,r⁆·⁅⁅r,w⁆,ν⁆)
                        · (⁅⁅r,ν⁆,⁅r,w⁆⁆·⁅⁅q²,w⁆,⁅r,w⁆⁆·⁅⁅q²,ν⁆,r⁆·⁅⁅q²,w⁆,ν⁆) .

The first three groups are `mpcFv_comm_letCD` at `μ = 1` (with the two `L`-terms in the opposite
order, an exchange class five performs for free and this identity prices); the fourth group is
central of exponent two and
vanishes at class five.  **Its first two factors are reordering terms**, carried when the marked
bracket `⁅r,w⁆` is moved to the front past the two `L`-terms; the other two are new bracket
terms.  Class five performs those two moves for free; this identity prices them, and does not
claim the price is nonzero. -/
theorem mpcSx_comm_letCD {q r w ν : levelQuot G 6} (hν : ν ∈ lambdaImage G 2 6) :
    commP (q ^ 2 * r) (w * ν)
      = commP r w * (commP r ν * commP (q ^ 2) w) *
        (commP (q ^ 2) ν * commP (commP (q ^ 2) w) r * commP (commP r w) ν) *
        (commP (commP r ν) (commP r w) * commP (commP (q ^ 2) w) (commP r w) *
          commP (commP (q ^ 2) ν) r * commP (commP (q ^ 2) w) ν) := by
  have hq2 : q ^ 2 ∈ lambdaImage G 2 6 := mpcSx_pow_two_mem q
  have hrw : commP r w ∈ lambdaImage G 2 6 := mpcSx_commP_mem_two r w
  have hrν : commP r ν ∈ lambdaImage G 3 6 := mpcSx_commP_step' r hν
  have hrνY : commP r ν ∈ lambdaImage G 2 6 := mpcSx_lam_le (by omega) hrν
  have hq2w : commP (q ^ 2) w ∈ lambdaImage G 3 6 := mpcSx_commP_step hq2 w
  have hq2wY : commP (q ^ 2) w ∈ lambdaImage G 2 6 := mpcSx_lam_le (by omega) hq2w
  have hq2ν : commP (q ^ 2) ν ∈ lambdaImage G 4 6 := mpcSx_commP_lam hq2 hν
  have hq2wr : commP (commP (q ^ 2) w) r ∈ lambdaImage G 4 6 := mpcSx_commP_step hq2w r
  have hrwν : commP (commP r w) ν ∈ lambdaImage G 4 6 := mpcSx_commP_lam hrw hν
  have hZ1 : commP (commP (q ^ 2) ν) r ∈ zLayer G 5 := mpcSx_commP_step hq2ν r
  have hZ2 : commP (commP (q ^ 2) w) ν ∈ zLayer G 5 := mpcSx_commP_lam hq2w hν
  have hZ3 : commP (commP r ν) (commP r w) ∈ zLayer G 5 := mpcSx_commP_lam hrν hrw
  have hZ4 : commP (commP (q ^ 2) w) (commP r w) ∈ zLayer G 5 := mpcSx_commP_lam hq2w hrw
  -- the pivot letter against the `D̄`-correction
  have ha : commP (q ^ 2 * r) ν
      = commP (q ^ 2) ν * commP (commP (q ^ 2) ν) r * commP r ν :=
    cfour_commP_mul_left _ _ _
  -- the pivot letter against the marked `D̄`
  have hb : commP (q ^ 2 * r) w
      = commP (q ^ 2) w * commP (commP (q ^ 2) w) r * commP r w :=
    cfour_commP_mul_left _ _ _
  -- the second-order correction sees the shift bracket and the marked bracket
  have hc : commP (commP (q ^ 2 * r) w) ν
      = commP (commP (q ^ 2) w) ν * commP (commP r w) ν := by
    rw [hb, cfour_commP_mul_left (commP (q ^ 2) w * commP (commP (q ^ 2) w) r) (commP r w) ν,
      mpcSx_commP_drop_left_tail_four hq2wY hq2wr hν,
      mpcSx_commP_zLayer_left hZ2 (commP r w), mul_one]
  calc commP (q ^ 2 * r) (w * ν)
      = commP (q ^ 2 * r) ν * commP (q ^ 2 * r) w * commP (commP (q ^ 2 * r) w) ν :=
        cfour_commP_mul_right _ _ _
    _ = commP (q ^ 2) ν * commP (commP (q ^ 2) ν) r * commP r ν *
          (commP (q ^ 2) w * commP (commP (q ^ 2) w) r * commP r w) *
          (commP (commP (q ^ 2) w) ν * commP (commP r w) ν) := by rw [hc, hb, ha]
    _ = commP r w * (commP r ν * commP (q ^ 2) w) *
          (commP (q ^ 2) ν * commP (commP (q ^ 2) w) r * commP (commP r w) ν) *
          (commP (commP r ν) (commP r w) * commP (commP (q ^ 2) w) (commP r w) *
            commP (commP (q ^ 2) ν) r * commP (commP (q ^ 2) w) ν) :=
        mpcSx_shuffleCD (mpcSx_zcomm hZ1) (mpcSx_zcomm hZ2) (mpcSx_zcomm hZ3)
          (mpcSx_zcomm hZ4) (mpcSx_mcomm hq2ν hrνY) (mpcSx_mcomm hq2ν hq2wY)
          (mpcSx_mcomm hq2ν hrw) (mpcSx_mcomm hq2wr hrw)
          (cfive_swap_free _ _) (cfive_swap_free _ _)

end LetterCD

/-! ## §5 The class-six defect of the `M6` ansatz, in closed form

`MpcFive` §4 records that at class five "the assembly costs nothing", and gives the reason: every
correction lies in `L`, `L` is abelian, and `L` commutes with `Y`.  **The reason is exactly
class-five**, resting on `⁅L, Y⁆ = 1`, so one class up it is unavailable and the assembly has to
be priced instead of dropped.

The three marked parts a correction has to pass are still `⁅p,q⁆ ∈ Y`, `r⁴ ∈ L` and `⁅r,w⁆ ∈ Y`.
The pivot correction `E₃` is `M`-valued and still passes free (`mpcSx_e3_mem` with
`mpcSx_vanish_four`).  The two `L`-valued corrections `E₁` and `E₂` are priced, at

    C₁ = ⁅E₁, ⁅p,q⁆·r⁴·⁅r,w⁆⁆   and   C₂ = ⁅E₂, r⁴·⁅r,w⁆⁆ ,

**which are terms of no letter**: a builder who computes the four factors of §1 to §4 and
multiplies them has not computed the defect.

**Scope.**  `C₁` and `C₂` are `⁅L, Y⁆`-terms and therefore land in `Z`.  Whether they are
nontrivial, in `D_M 2 0` or in any other group, is **not** decided here and is not needed: the
identity below is exact with them present, and it is the class-five *argument* for dropping them
that is gone, not (on any evidence collected here) their value. -/

section Assembly

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- The `Ā`-letter's class-six correction, as one element (`mpcSx_sq_letA`). -/
def mpcSxE1 (p σ z : levelQuot G 6) : levelQuot G 6 :=
  σ ^ 2 * commP σ p * (z ^ 2 * commP z p) *
    (commP σ z * commP (commP σ p) z * commP (commP σ p) σ)

/-- The `Ā`/`B̄` bracket's class-six correction (`mpcSx_comm_letAB`). -/
def mpcSxE2 (p q σ τ z : levelQuot G 6) : levelQuot G 6 :=
  commP p τ * commP σ q *
    (commP σ τ * commP z q * commP (commP p q) σ * commP (commP p q) τ) *
    (commP (commP p τ) z * commP z τ * commP (commP p τ) σ * commP (commP p q) z *
      commP (commP σ q) τ * commP (commP p τ) (commP p q))

/-- The pivot letter's class-six correction (`mpcSx_pow_letC`). -/
def mpcSxE3 (q r : levelQuot G 6) : levelQuot G 6 :=
  q ^ 8 * commP r (q ^ 2) ^ 2 *
    (commP (r ^ 2) (q ^ 4) * commP (commP r (q ^ 2)) (r ^ 2) *
      commP (commP r (q ^ 2)) (q ^ 4) * commP (commP r (q ^ 2)) r ^ 2)

/-- The `C̄₀`/`D̄` bracket's class-six correction (`mpcSx_comm_letCD`). -/
def mpcSxE4 (q r w ν : levelQuot G 6) : levelQuot G 6 :=
  commP r ν * commP (q ^ 2) w *
    (commP (q ^ 2) ν * commP (commP (q ^ 2) w) r * commP (commP r w) ν) *
    (commP (commP r ν) (commP r w) * commP (commP (q ^ 2) w) (commP r w) *
      commP (commP (q ^ 2) ν) r * commP (commP (q ^ 2) w) ν)

/-- `E₁` is an `L`-element: it is what has to be carried past the marked block. -/
theorem mpcSx_e1_mem {p σ z : levelQuot G 6} (hσ : σ ∈ lambdaImage G 2 6)
    (hz : z ∈ lambdaImage G 3 6) : mpcSxE1 p σ z ∈ lambdaImage G 3 6 := by
  have hzY : z ∈ lambdaImage G 2 6 := mpcSx_lam_le (by omega) hz
  have hσp : commP σ p ∈ lambdaImage G 3 6 := mpcSx_commP_step hσ p
  exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _
      (mpcSx_sq_step hσ) hσp)
      (mpcSx_lam_le (by omega) (Subgroup.mul_mem _ (mpcSx_sq_step hz)
        (mpcSx_commP_step hz p))))
    (mpcSx_lam_le (by omega) (Subgroup.mul_mem _ (Subgroup.mul_mem _
      (mpcSx_commP_lam' hz hσ) (mpcSx_commP_lam hσp hzY)) (mpcSx_commP_lam hσp hσ)))

/-- `E₂` is an `L`-element. -/
theorem mpcSx_e2_mem {p q σ τ z : levelQuot G 6} (hσ : σ ∈ lambdaImage G 2 6)
    (hτ : τ ∈ lambdaImage G 2 6) (hz : z ∈ lambdaImage G 3 6) :
    mpcSxE2 p q σ τ z ∈ lambdaImage G 3 6 := by
  have hzY : z ∈ lambdaImage G 2 6 := mpcSx_lam_le (by omega) hz
  have hpq : commP p q ∈ lambdaImage G 2 6 := mpcSx_commP_mem_two p q
  have hpτ : commP p τ ∈ lambdaImage G 3 6 := mpcSx_commP_step' p hτ
  have hσq : commP σ q ∈ lambdaImage G 3 6 := mpcSx_commP_step hσ q
  have hM : commP σ τ * commP z q * commP (commP p q) σ * commP (commP p q) τ
      ∈ lambdaImage G 4 6 :=
    Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _
      (mpcSx_commP_lam hσ hτ) (mpcSx_commP_step hz q)) (mpcSx_commP_lam hpq hσ))
      (mpcSx_commP_lam hpq hτ)
  have hZ : commP (commP p τ) z * commP z τ * commP (commP p τ) σ * commP (commP p q) z *
      commP (commP σ q) τ * commP (commP p τ) (commP p q) ∈ lambdaImage G 5 6 :=
    Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _
      (Subgroup.mul_mem _ (Subgroup.mul_mem _ (mpcSx_commP_lam hpτ hzY)
        (mpcSx_commP_lam hz hτ)) (mpcSx_commP_lam hpτ hσ))
      (mpcSx_commP_lam' hz hpq)) (mpcSx_commP_lam hσq hτ)) (mpcSx_commP_lam hpτ hpq)
  exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ hpτ hσq)
    (mpcSx_lam_le (by omega) hM)) (mpcSx_lam_le (by omega) hZ)

/-- `E₃` is an `M`-element, which is why the pivot correction still passes the marked block for
free. -/
theorem mpcSx_e3_mem (q r : levelQuot G 6) : mpcSxE3 q r ∈ lambdaImage G 4 6 := by
  have hq2 : q ^ 2 ∈ lambdaImage G 2 6 := mpcSx_pow_two_mem q
  have hq4 : q ^ 4 ∈ lambdaImage G 3 6 := mpcSx_pow_four_mem q
  have hr2 : r ^ 2 ∈ lambdaImage G 2 6 := mpcSx_pow_two_mem r
  have hT : commP r (q ^ 2) ∈ lambdaImage G 3 6 := mpcSx_commP_step' r hq2
  exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (mpcSx_pow_eight_mem q) (mpcSx_sq_step hT))
    (mpcSx_lam_le (by omega) (Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _
      (mpcSx_commP_lam' hq4 hr2) (mpcSx_commP_lam hT hr2))
      (mpcSx_commP_lam hT (mpcSx_lam_le (by omega) hq4)))
      (mpcSx_sq_step (mpcSx_commP_step hT r))))

/-- The `Ā`-letter's square, restated against `mpcSxE1`. -/
theorem mpcSx_sq_letA' {p σ z : levelQuot G 6} (hσ : σ ∈ lambdaImage G 2 6)
    (hz : z ∈ lambdaImage G 3 6) : (p * z * σ) ^ 2 = p ^ 2 * mpcSxE1 p σ z := by
  rw [mpcSx_sq_letA hσ hz]; simp only [mpcSxE1]; group

/-- The `Ā`/`B̄` bracket, restated against `mpcSxE2`. -/
theorem mpcSx_comm_letAB' {p q σ τ z : levelQuot G 6} (hσ : σ ∈ lambdaImage G 2 6)
    (hτ : τ ∈ lambdaImage G 2 6) (hz : z ∈ lambdaImage G 3 6) :
    commP (p * z * σ) (q * τ) = commP p q * mpcSxE2 p q σ τ z := by
  rw [mpcSx_comm_letAB hσ hτ hz]; simp only [mpcSxE2]; group

/-- The pivot letter's fourth power, restated against `mpcSxE3`. -/
theorem mpcSx_pow_letC' (q r : levelQuot G 6) :
    (q ^ 2 * r) ^ 4 = r ^ 4 * mpcSxE3 q r := by
  rw [mpcSx_pow_letC]; simp only [mpcSxE3]; group

/-- The `C̄₀`/`D̄` bracket, restated against `mpcSxE4`. -/
theorem mpcSx_comm_letCD' {q r w ν : levelQuot G 6} (hν : ν ∈ lambdaImage G 2 6) :
    commP (q ^ 2 * r) (w * ν) = commP r w * mpcSxE4 q r w ν := by
  rw [mpcSx_comm_letCD hν]; simp only [mpcSxE4]; group

/-- ⭐⭐⭐ **THE CLASS-SIX DEFECT OF THE `M6` ANSATZ, IN CLOSED FORM**, at trivial pivot
correction.  The analogue of `mpcFv_mWord_five` one class up:

    mWord 2 (p·z·σ) (q·τ) (q²·r) (w·ν) = mWord 2 p q r w · (E₁·E₂·E₃·E₄·(C₁·C₂))

with the four corrections `mpcSxE1` … `mpcSxE4` read off §1 to §4, and

    C₁ = ⁅E₁, ⁅p,q⁆·r⁴·⁅r,w⁆⁆ ,   C₂ = ⁅E₂, r⁴·⁅r,w⁆⁆

the two **collection terms**.  Setting `z ∈ M` and dropping every term that `⁅L, Y⁆ = 1` kills
recovers `mpcFv_mWord_five` at `μ = 1` exactly, and kills `C₁` and `C₂` with it.  They are terms
of **no letter**, so the four factors of §1 to §4 do not multiply to the defect.  Whether they
vanish in a given group is not decided here; `MpcFive` §4's reason for their absence is a
class-five fact and is what has gone, not necessarily their value.

`C₁` and `C₂` are central and expand additively in either slot (`mpcSx_commP_add_left_three`,
`mpcSx_commP_add_right_three`), so a builder who wants them term by term can have them; they are
left folded here because the folded form is what the rung consumes. -/
theorem mpcSx_mWord_six {p q r w σ τ ν z : levelQuot G 6}
    (hσ : σ ∈ lambdaImage G 2 6) (hτ : τ ∈ lambdaImage G 2 6)
    (hν : ν ∈ lambdaImage G 2 6) (hz : z ∈ lambdaImage G 3 6) :
    mWord 2 (p * z * σ) (q * τ) (q ^ 2 * r) (w * ν)
      = mWord 2 p q r w *
        (mpcSxE1 p σ z * mpcSxE2 p q σ τ z * mpcSxE3 q r * mpcSxE4 q r w ν *
          (commP (mpcSxE1 p σ z) (commP p q * r ^ 4 * commP r w) *
            commP (mpcSxE2 p q σ τ z) (r ^ 4 * commP r w))) := by
  have hpq : commP p q ∈ lambdaImage G 2 6 := mpcSx_commP_mem_two p q
  have hrw : commP r w ∈ lambdaImage G 2 6 := mpcSx_commP_mem_two r w
  have hr4 : r ^ 4 ∈ lambdaImage G 2 6 := mpcSx_lam_le (by omega) (mpcSx_pow_four_mem r)
  have hblk1 : commP p q * r ^ 4 * commP r w ∈ lambdaImage G 2 6 :=
    Subgroup.mul_mem _ (Subgroup.mul_mem _ hpq hr4) hrw
  have hblk2 : r ^ 4 * commP r w ∈ lambdaImage G 2 6 := Subgroup.mul_mem _ hr4 hrw
  simp only [mWord, show (2 : ℕ) ^ 2 = 4 from rfl]
  rw [mpcSx_sq_letA' hσ hz, mpcSx_comm_letAB' hσ hτ hz, mpcSx_pow_letC' q r,
    mpcSx_comm_letCD' hν]
  exact mpcSx_shuffle4 (cfive_swap_free _ _) (cfive_swap_free _ _)
    (mpcSx_mcomm (mpcSx_e3_mem q r) hrw)
    (mpcSx_zcomm (mpcSx_commP_lam (mpcSx_e1_mem hσ hz) hblk1))
    (mpcSx_zcomm (mpcSx_commP_lam (mpcSx_e2_mem hσ hτ hz) hblk2))

end Assembly

/-! ## §6 The class-six defect of the wave-87 class-five witness

§5 transported to `D_M 2 0` and evaluated at `mpcFvW5 = (W, W·B̄⁴, 1, B̄⁴·⁅B̄²,D̄⁆)`, whose pivot
correction is trivial, so §3 and §4 apply as they stand.  The marked relator is killed on the way
by `mpcOrb_relation`, exactly as `mpcFv_defect_five` does one class down. -/

section Witness

/-- `Ā` in `Q₆`. -/
def mpcSxA : levelQuot (DM 2 0 : Type) 6 := levelMk (DM 2 0 : Type) 6 (dmA 2 0)

/-- `B̄` in `Q₆`. -/
def mpcSxB : levelQuot (DM 2 0 : Type) 6 := levelMk (DM 2 0 : Type) 6 (dmB 2 0)

/-- `C̄₀` in `Q₆`. -/
def mpcSxC : levelQuot (DM 2 0 : Type) 6 := levelMk (DM 2 0 : Type) 6 (dmC 2 0)

/-- `D̄` in `Q₆`. -/
def mpcSxD : levelQuot (DM 2 0 : Type) 6 := levelMk (DM 2 0 : Type) 6 (dmD 2 0)

/-- The ansatz's head shift `z = (B̄⁴)⁻¹`, in `Q₆`.  At class five its square was `B̄⁸`, a central
involution; at class six `B̄⁸` is only an `M`-element, so the inverse does not simplify. -/
def mpcSxZ : levelQuot (DM 2 0 : Type) 6 := (mpcSxB ^ 4)⁻¹

/-- The wave-84 correction `W = ⁅D̄, B̄⁆`, in `Q₆`. -/
def mpcSxW : levelQuot (DM 2 0 : Type) 6 := commP mpcSxD mpcSxB

/-- The wave-87 witness's `D̄`-correction `B̄⁴·⁅B̄², D̄⁆`, in `Q₆`. -/
def mpcSxN : levelQuot (DM 2 0 : Type) 6 := mpcSxB ^ 4 * commP (mpcSxB ^ 2) mpcSxD

theorem mpcSx_z_mem : mpcSxZ ∈ lambdaImage (DM 2 0 : Type) 3 6 :=
  Subgroup.inv_mem _ (mpcSx_pow_four_mem _)

theorem mpcSx_w_mem : mpcSxW ∈ lambdaImage (DM 2 0 : Type) 2 6 :=
  mpcSx_commP_mem_two _ _

theorem mpcSx_n_mem : mpcSxN ∈ lambdaImage (DM 2 0 : Type) 2 6 :=
  Subgroup.mul_mem _ (mpcSx_lam_le (by omega) (mpcSx_pow_four_mem _))
    (mpcSx_commP_mem_two _ _)

/-- ⭐⭐⭐ **THE CLASS-SIX DEFECT OF THE WAVE-87 CLASS-FIVE WITNESS, IN CLOSED FORM.**  The
analogue of `mpcFv_witness_defect` one class up, and the input the class-six rung consumes.

Unlike its class-five counterpart this is **not** collapsed to a short product of survivors: at
class five the witness's defect had to lie in `λ₄/λ₅` and the collapse was forced, whereas here
the a-priori bound is only `λ₅/λ₆` and the cancellation among the four corrections has not been
carried out.  What is proved is the exact value, in the closed form of §5. -/
theorem mpcSx_w5_defect :
    levelMk (DM 2 0 : Type) 6 (mpcLadDefect mpcFvW5)
      = mpcSxE1 mpcSxA mpcSxW mpcSxZ *
        mpcSxE2 mpcSxA mpcSxB mpcSxW (mpcSxW * mpcSxB ^ 4) mpcSxZ *
        mpcSxE3 mpcSxB mpcSxC * mpcSxE4 mpcSxB mpcSxC mpcSxD mpcSxN *
        (commP (mpcSxE1 mpcSxA mpcSxW mpcSxZ)
            (commP mpcSxA mpcSxB * mpcSxC ^ 4 * commP mpcSxC mpcSxD) *
          commP (mpcSxE2 mpcSxA mpcSxB mpcSxW (mpcSxW * mpcSxB ^ 4) mpcSxZ)
            (mpcSxC ^ 4 * commP mpcSxC mpcSxD)) := by
  have hrel : mWord 2 mpcSxA mpcSxB mpcSxC mpcSxD = 1 := by
    simp only [mpcSxA, mpcSxB, mpcSxC, mpcSxD]
    rw [← map_mWord, mpcOrb_relation, map_one]
  have hτ : levelMk (DM 2 0 : Type) 6 (mpcBldW * mpcFvUt) = mpcSxW * mpcSxB ^ 4 := by
    rw [mpcBldW, mpcFvUt, map_mul, map_pow, mpcBld_map_commP]; rfl
  have hν : levelMk (DM 2 0 : Type) 6 mpcFvUn = mpcSxN := by
    rw [mpcFvUn, mpcSxN, map_mul, map_pow, mpcBld_map_commP, map_pow]; rfl
  have hA : levelMk (DM 2 0 : Type) 6 (mpcWordLetA (mpcBldW * 1))
      = mpcSxA * mpcSxZ * mpcSxW := by
    rw [mul_one, mpcWordLetA, mpcSxZ, map_mul, map_mul, map_inv, map_pow, mpcBldW,
      mpcBld_map_commP]; rfl
  have hB : levelMk (DM 2 0 : Type) 6 (mpcWordLetB (mpcBldW * mpcFvUt))
      = mpcSxB * (mpcSxW * mpcSxB ^ 4) := by rw [mpcWordLetB, map_mul, hτ]; rfl
  have hC : levelMk (DM 2 0 : Type) 6 (mpcWordLetC (1 * 1)) = mpcSxB ^ 2 * mpcSxC := by
    rw [mpcWordLetC, mul_one, mul_one, map_mul, map_pow]; rfl
  have hD : levelMk (DM 2 0 : Type) 6 (mpcWordLetD (1 * mpcFvUn)) = mpcSxD * mpcSxN := by
    rw [mpcWordLetD, one_mul, map_mul, hν]; rfl
  have hdef : mpcLadDefect mpcFvW5
      = mWord 2 (mpcWordLetA (mpcBldW * 1)) (mpcWordLetB (mpcBldW * mpcFvUt))
          (mpcWordLetC (1 * 1)) (mpcWordLetD (1 * mpcFvUn)) := rfl
  rw [hdef, map_mWord, hA, hB, hC, hD,
    mpcSx_mWord_six (G := (DM 2 0 : Type)) mpcSx_w_mem
      (Subgroup.mul_mem _ mpcSx_w_mem (mpcSx_lam_le (by omega) (mpcSx_pow_four_mem _)))
      mpcSx_n_mem mpcSx_z_mem, hrel, one_mul]

end Witness

/-! ## §7 Where the kills live: the marked carrier, uniform in class

Two rungs have been climbed and both used corrections of one shape.  Wave 85's class-four move is
`(W, W, 1, 1)` with `W = ⁅D̄, B̄⁆`, and wave 87's class-five move is
`(1, B̄⁴, 1, B̄⁴·⁅B̄², D̄⁆)`: every entry lies in the subgroup generated by the powers of `B̄` and
the commutators of `D_M 2 0`.  This section makes that a definition and proves the three things
that make it useful.

1. **The carrier is legal at every class** (`mpcSx_kill_le_corr`).  Legality has two halves, and
   the χ-half is the one that depth does not give: `χ_M` is `ℤ₂ˣ`-valued, and `λ₂` really does
   contain elements it sees.  `mpcSx_dmD_sq_not_corr` is the witness: `D̄² ∈ λ₂` but
   `χ_M(D̄²) = mUnit 2 ^ 2 ≠ 1`, so `D̄²` is **not** a legal correction in any slot at any class.
   So "lies in `λ_j`" does not by itself make an element usable, and the marked carrier is what
   supplies the missing half: `χ_M(B̄²) = 1` and every commutator is χ-trivial.

2. **The carrier is never exhausted** (`mpcSx_pow_mem_kill`).  At every class it contains one
   layer-adapted `B̄`-power, and every bracket that happens to lie that deep.  So the supply of
   legal marked corrections does not run out as the ladder climbs, which is what a
   uniform-in-class argument needs.

3. **The marked shift-producer** (`mpcSx_shift_of_marked_supply`).  `MpcPivShift 2` follows from
   one-step supply by marked corrections in the two bracket slots alone, at one class-`(j+1)`
   solution per class.

   **It is a specialization, not a sharpening**, and the direction matters.  Against
   `mpcLad_shift_of_exists_supply` its hypothesis is strictly **stronger** (two slots of four,
   and marked corrections rather than every legal one), and the proof is one application of that
   theorem.  Against `mpcBld_shift_of_bracket_supply` the comparison is mixed and is not an
   improvement: weaker in the quantifier (the defect of one solution per class, where that one
   asks for every `g ∈ λ_{j+1}` - the gap its own W86-HOUSE block records) but stronger in the
   carrier.  What it buys is not logical strength but a **concrete uniform search space**, of the
   shape the ladder has actually used.

**What is not claimed.**  Nothing here says the defect *does* lie in the marked span at every
class, and nothing says the marked carrier is the whole story.  §8's `MpcSxMarkedSix` is exactly
the class-six instance of the question, and it is open. -/

section Marked

/-- **The marked carrier**: the subgroup of `D_M 2 0` generated by `B̄²` and the commutators.
Every correction either climbed rung has used lies here. -/
def mpcSxMarked : Subgroup (DM 2 0 : Type) :=
  Subgroup.closure ({dmB 2 0 ^ 2} ∪ {x | ∃ a b : (DM 2 0 : Type), x = commP a b})

/-- ⭐ **THE MARKED CARRIER IS χ-TRIVIAL.**  This is the half of legality that does not come from
the tower: by `mpcSx_dmD_sq_not_corr`, `λ_j ≤ ker χ_M` is false at `j = 2`. -/
theorem mpcSx_marked_chi {x : (DM 2 0 : Type)} (hx : x ∈ mpcSxMarked) : chiM 2 0 x = 1 := by
  have hle : mpcSxMarked ≤ (chiM 2 0).toMonoidHom.ker := by
    refine (Subgroup.closure_le _).2 ?_
    rintro y (rfl | ⟨a, b, rfl⟩)
    · refine MonoidHom.mem_ker.2 ?_
      show chiM 2 0 (dmB 2 0 ^ 2) = 1
      rw [map_pow, chiM_dmB, neg_one_sq]
    · exact MonoidHom.mem_ker.2 (mpcBld_chi_commP a b)
  exact MonoidHom.mem_ker.1 (hle hx)

/-- ⭐⭐ **DEPTH ALONE IS NOT LEGALITY.**  `χ_M(D̄²) = mUnit 2 ^ 2 ≠ 1`, because `mUnit 2` is
inverse to `1 - 2² = -3` and a square root of one in `ℤ₂` would force `9 = 1`.  So the χ-side
condition of `mpcWordCorr` is a real constraint on `λ₂` and not a formality. -/
theorem mpcSx_chi_dmD_sq : chiM 2 0 (dmD 2 0 ^ 2) ≠ 1 := by
  rw [map_pow, chiM_dmD]
  intro h
  have hval : ((mUnit 2 : ℤ_[2]ˣ) : ℤ_[2]) * ((mUnit 2 : ℤ_[2]ˣ) : ℤ_[2]) = 1 := by
    have h2 := congrArg (fun u : ℤ_[2]ˣ => (u : ℤ_[2])) h
    simpa [pow_two] using h2
  have hm : ((mUnit 2 : ℤ_[2]ˣ) : ℤ_[2]) * (1 - 2 ^ 2) = 1 := mUnit_mul (α := 2) (by omega)
  have heq : ((mUnit 2 : ℤ_[2]ˣ) : ℤ_[2]) = 1 - 2 ^ 2 :=
    mul_left_cancel₀ (mUnit 2).ne_zero (hval.trans hm.symm)
  rw [heq] at hm
  norm_num at hm

/-- ⭐ **THE WITNESS THAT `λ₂ ⊄ mpcWordCorr`.**  `D̄²` lies two layers down and is still not a
legal correction.  This is why §7's legality lemma has content. -/
theorem mpcSx_dmD_sq_not_corr :
    dmD 2 0 ^ 2 ∈ twoCentralSeries (DM 2 0 : Type) 2 ∧ dmD 2 0 ^ 2 ∉ mpcWordCorr :=
  ⟨sq_mem_twoCentralSeries_succ _ (Subgroup.mem_top _), fun h => mpcSx_chi_dmD_sq h.2⟩

/-- **The marked kill carrier at class `j`**: the marked elements that lie `j` layers down. -/
def mpcSxKill (j : ℕ) : Subgroup (DM 2 0 : Type) :=
  mpcSxMarked ⊓ twoCentralSeries (DM 2 0 : Type) j

/-- ⭐⭐ **EVERY MARKED ELEMENT `j ≥ 2` LAYERS DOWN IS A LEGAL CORRECTION**, in all three free
slots.  Uniform in `j`, with no arithmetic input beyond `χ_M(B̄²) = 1`. -/
theorem mpcSx_kill_le_corr {j : ℕ} (hj : 2 ≤ j) : mpcSxKill j ≤ mpcWordCorr := fun _ hx =>
  ⟨twoCentralSeries_antitone (G := (DM 2 0 : Type)) hj hx.2, mpcSx_marked_chi hx.1⟩

theorem mpcSx_kill_le_lambda {j : ℕ} : mpcSxKill j ≤ twoCentralSeries (DM 2 0 : Type) j :=
  fun _ hx => hx.2

/-- Every commutator lying `j` layers down is a marked kill. -/
theorem mpcSx_commP_mem_kill {j : ℕ} (a b : (DM 2 0 : Type))
    (h : commP a b ∈ twoCentralSeries (DM 2 0 : Type) j) : commP a b ∈ mpcSxKill j :=
  ⟨Subgroup.subset_closure (Or.inr ⟨a, b, rfl⟩), h⟩

/-- ⭐⭐ **ONE `B̄`-POWER PER CLASS.**  `B̄^(2^(k+1))` is marked and lies `k+2` layers down, so the
marked carrier carries a `B̄`-power at every class from two up: the supply of legal marked
corrections does not run out as the ladder climbs. -/
theorem mpcSx_pow_mem_kill (k : ℕ) : dmB 2 0 ^ 2 ^ (k + 1) ∈ mpcSxKill (k + 2) := by
  have hgen : dmB 2 0 ^ 2 ∈ mpcSxMarked := Subgroup.subset_closure (Or.inl rfl)
  have hpow : (dmB 2 0 ^ 2) ^ 2 ^ k ∈ mpcSxMarked := Subgroup.pow_mem _ hgen _
  have h : dmB 2 0 ^ 2 ^ (k + 1) = (dmB 2 0 ^ 2) ^ 2 ^ k := by rw [← pow_mul, ← pow_succ']
  exact ⟨h ▸ hpow,
    pow_two_pow_mem_twoCentralSeries_succ (G := (DM 2 0 : Type)) (dmB 2 0) (k + 1)⟩

/-- The wave-85 class-four correction `W = ⁅D̄, B̄⁆` is a marked kill at class two. -/
theorem mpcSx_w4_marked : mpcBldW ∈ mpcSxKill 2 :=
  mpcSx_commP_mem_kill _ _ mpcBld_w_mem

/-- The wave-87 class-five `B̄`-slot move `B̄⁴` is a marked kill at class three. -/
theorem mpcSx_ut_marked : mpcFvUt ∈ mpcSxKill 3 := by
  have h : mpcFvUt = dmB 2 0 ^ 2 ^ 2 := by rw [mpcFvUt]; norm_num
  rw [h]
  exact mpcSx_pow_mem_kill 1

/-- ⭐ **The wave-87 class-five `D̄`-slot move `B̄⁴·⁅B̄², D̄⁆` is a marked kill at class three.**
With `mpcSx_w4_marked` and `mpcSx_ut_marked` this is the observation §7 is built on: every
correction either climbed rung has used is marked. -/
theorem mpcSx_un_marked : mpcFvUn ∈ mpcSxKill 3 :=
  Subgroup.mul_mem _ mpcSx_ut_marked
    (mpcSx_commP_mem_kill _ _ (cfour_commP_mem_three mpcFv_b2_mem_two _))

/-- The two-bracket increment: a move that touches only the `B̄`- and `D̄`-slots costs exactly
`⁅Ā, u⁆·⁅C̄₀, v⁆`, whatever the base point. -/
theorem mpcSx_incr_bracket (t n u v : (DM 2 0 : Type)) :
    mpcBldIncr t n 1 u 1 v = commP (dmA 2 0) u * commP (dmC 2 0) v := by
  simp only [mpcBldIncr, one_pow, cfour_one_comm, one_mul, mul_one]

/-- A marked two-bracket kill is one-step supply. -/
theorem mpcSx_supply_of_marked {j : ℕ} (hj : 2 ≤ j)
    {p : (DM 2 0 : Type) × (DM 2 0 : Type) × (DM 2 0 : Type) × (DM 2 0 : Type)}
    {u v : (DM 2 0 : Type)} (hu : u ∈ mpcSxKill j) (hv : v ∈ mpcSxKill j)
    (hkill : mpcLadDefect p * commP (dmA 2 0) u * commP (dmC 2 0) v
      ∈ twoCentralSeries (DM 2 0 : Type) (j + 2)) : MpcLadSupply j p := by
  refine ⟨1, u, 1, v, ⟨⟨one_mem _, one_mem _⟩, ⟨mpcSx_kill_le_corr hj hu, hu.2⟩,
    ⟨one_mem _, one_mem _⟩, ⟨mpcSx_kill_le_corr hj hv, hv.2⟩⟩, ?_⟩
  rw [mpcSx_incr_bracket, ← mul_assoc]
  exact hkill

/-- ⭐ **THE MARKED KILLS ARE REACHABLE.**  The two-bracket increment of a marked move lies in
wave 86's reachable `𝔽₂`-subspace, at every class and every base point.  This is the bridge
between §7's language and `mpcLadReach`. -/
theorem mpcSx_marked_mem_reach {j : ℕ} (hj : 2 ≤ j) (t n : (DM 2 0 : Type))
    {u v : (DM 2 0 : Type)} (hu : u ∈ mpcSxKill j) (hv : v ∈ mpcSxKill j) :
    levelMk (DM 2 0 : Type) (j + 2) (commP (dmA 2 0) u * commP (dmC 2 0) v)
      ∈ mpcLadReach j t n :=
  ⟨1, u, 1, v, ⟨⟨one_mem _, one_mem _⟩, ⟨mpcSx_kill_le_corr hj hu, hu.2⟩,
    ⟨one_mem _, one_mem _⟩, ⟨mpcSx_kill_le_corr hj hv, hv.2⟩⟩,
    by rw [mpcSx_incr_bracket]⟩

/-- ⭐⭐⭐ **THE SHIFT FROM MARKED SUPPLY ALONE.**  If at every class from three up **some**
class-`(j+1)` solution's defect is killed by one `Ā`-bracket and one `C̄₀`-bracket of **marked**
elements `j` layers down, then `MpcPivShift 2`.

**This is a specialization and not a strengthening.**  Its hypothesis is strictly stronger than
`mpcLad_shift_of_exists_supply`'s, which allows all four slots and every legal `λ_j` correction,
and the proof below is one application of that theorem.  Against
`mpcBld_shift_of_bracket_supply` the comparison is mixed: the quantifier is `∃ p ∈ mpcWordSet
(j+1)` instead of `∀ g ∈ λ_{j+1}`, which is weaker, but the two correction slots are confined to
`mpcSxKill j` instead of all of `mpcWordCorr ⊓ λ_j`, which is stronger.  Neither theorem implies
the other.

What this form buys is not logical strength.  It is that the hypothesis names a **concrete,
uniform, class-indexed search space** whose elements are exhibited (`mpcSx_pow_mem_kill`) and
whose legality is proved once for all classes (`mpcSx_kill_le_corr`), and that both climbed rungs
satisfy it (`mpcSx_w4_marked`, `mpcSx_marked_supply_three`).

[Scope, following W86-HOUSE.  The conclusion is `MpcPivShift 2` itself, not a statement about the
ansatz: this is a SUFFICIENT condition, and the ansatz-exhaustiveness gap does not arise in this
direction.  It would arise for the converse, which is not claimed.] -/
theorem mpcSx_shift_of_marked_supply
    (H : ∀ j, 3 ≤ j → ∃ p ∈ mpcWordSet (j + 1), ∃ u ∈ mpcSxKill j, ∃ v ∈ mpcSxKill j,
      mpcLadDefect p * commP (dmA 2 0) u * commP (dmC 2 0) v
        ∈ twoCentralSeries (DM 2 0 : Type) (j + 2)) : MpcPivShift 2 := by
  refine mpcLad_shift_of_exists_supply fun j hj => ?_
  obtain ⟨p, hp, u, hu, v, hv, hkill⟩ := H j hj
  exact ⟨p, hp, mpcSx_supply_of_marked (by omega) hu hv hkill⟩

/-- ⭐⭐ **THE CRITERION IS MET AT THE CLASS-FIVE RUNG.**  Wave 87's move, read in the marked
form: the class-five rung is an instance of `mpcSx_shift_of_marked_supply`'s hypothesis at
`j = 3`.  So the hypothesis is not vacuous, and the pattern §7 names is the pattern the ladder
has actually used. -/
theorem mpcSx_marked_supply_three :
    ∃ p ∈ mpcWordSet 4, ∃ u ∈ mpcSxKill 3, ∃ v ∈ mpcSxKill 3,
      mpcLadDefect p * commP (dmA 2 0) u * commP (dmC 2 0) v
        ∈ twoCentralSeries (DM 2 0 : Type) 5 := by
  refine ⟨mpcLadW4, mpcLad_w4_mem, mpcFvUt, mpcSx_ut_marked, mpcFvUn, mpcSx_un_marked, ?_⟩
  have h := mpcFv_supply_kill
  rw [mpcSx_incr_bracket, ← mul_assoc] at h
  exact h

end Marked

/-! ## §8 The class-six rung, as a named obstruction

The rung itself (`mpcLad_nonempty_iff 4` at the wave-87 witness) is `MpcSxRungSix`, an
`𝔽₂`-membership whose left-hand side is `mpcSx_w5_defect`'s closed form.  `MpcSxMarkedSix` is the
narrower marked question of §7 at `j = 4`, sufficient for it.

**Neither is decided here.**  This lane computed the class-six defect and did not evaluate the
membership: outcome (a) of the ticket (a supply move) and outcome (b) (proven non-membership at
this orbit) are both open, and outcome (b) would in any case say nothing beyond `mpcFvW5`'s own
`λ₄`-orbit without wave 86's orbit-space gap. -/

section RungSix

/-- **THE CLASS-SIX RUNG AT THE WAVE-87 WITNESS.**  Does the class-six defect of `mpcFvW5` lie in
the reachable `𝔽₂`-subspace `mpcLadReach 4`?  By `mpcLad_defect_orbit` this is the whole question
inside `mpcFvW5`'s own `λ₄`-orbit, and by `mpcLad_nonempty_iff 4` an affirmative answer climbs the
rung.  The left-hand side is in closed form at `mpcSx_w5_defect`. -/
def MpcSxRungSix : Prop :=
  levelMk (DM 2 0 : Type) 6 (mpcLadDefect mpcFvW5) ∈ mpcLadReach 4 mpcFvW5.2.1 mpcFvW5.2.2.2

/-- **THE MARKED CLASS-SIX QUESTION**: §7's pattern at `j = 4`.  Sufficient for `MpcSxRungSix`,
and the exact shape both climbed rungs took. -/
def MpcSxMarkedSix : Prop :=
  ∃ u ∈ mpcSxKill 4, ∃ v ∈ mpcSxKill 4,
    mpcLadDefect mpcFvW5 * commP (dmA 2 0) u * commP (dmC 2 0) v
      ∈ twoCentralSeries (DM 2 0 : Type) 6

/-- ⭐ **THE MARKED QUESTION GIVES ONE-STEP SUPPLY.** -/
theorem mpcSx_supply_of_markedSix (h : MpcSxMarkedSix) : MpcLadSupply 4 mpcFvW5 := by
  obtain ⟨u, hu, v, hv, hkill⟩ := h
  exact mpcSx_supply_of_marked (by omega) hu hv hkill

/-- ⭐ **THE MARKED QUESTION IMPLIES THE RUNG**, directly and not only through supply: a marked
kill exhibits the defect as a reachable increment, the layer having exponent two.  So
`MpcSxMarkedSix` is the narrower of the two Props in the strong sense. -/
theorem mpcSx_rungSix_of_markedSix (h : MpcSxMarkedSix) : MpcSxRungSix := by
  obtain ⟨u, hu, v, hv, hkill⟩ := h
  have hmem := mpcSx_marked_mem_reach (j := 4) (by omega) mpcFvW5.2.1 mpcFvW5.2.2.2 hu hv
  have hz : levelMk (DM 2 0 : Type) 6 (commP (dmA 2 0) u * commP (dmC 2 0) v)
      ∈ zLayer (DM 2 0 : Type) 5 := mpcLad_reach_subset_zLayer 4 _ _ hmem
  have hone : levelMk (DM 2 0 : Type) 6 (mpcLadDefect mpcFvW5) *
      levelMk (DM 2 0 : Type) 6 (commP (dmA 2 0) u * commP (dmC 2 0) v) = 1 := by
    rw [← map_mul]
    exact (mpcWord_mem_iff_levelMk 6 _).mp (by rw [← mul_assoc]; exact hkill)
  have hd : levelMk (DM 2 0 : Type) 6 (mpcLadDefect mpcFvW5)
      = levelMk (DM 2 0 : Type) 6 (commP (dmA 2 0) u * commP (dmC 2 0) v) := by
    rw [eq_inv_of_mul_eq_one_left hone, zLayer_inv_self hz]
  show levelMk (DM 2 0 : Type) 6 (mpcLadDefect mpcFvW5) ∈ mpcLadReach 4 _ _
  rw [hd]
  exact hmem

/-- ⭐⭐ **SUPPLY AT THE WITNESS CLIMBS THE CLASS-SIX RUNG**, through `mpcFv_w5_mem` and
`mpcLad_nonempty_iff 4`. -/
theorem mpcSx_nonempty_six_of_supply (h : MpcLadSupply 4 mpcFvW5) : (mpcWordSet 6).Nonempty :=
  (mpcLad_nonempty_iff 4).mpr ⟨mpcFvW5, mpcFv_w5_mem, h⟩

theorem mpcSx_nonempty_six_of_markedSix (h : MpcSxMarkedSix) : (mpcWordSet 6).Nonempty :=
  mpcSx_nonempty_six_of_supply (mpcSx_supply_of_markedSix h)

/-- ⭐ **THE RUNG IN ITS `𝔽₂`-MEMBERSHIP FORM ALSO CLIMBS IT.**  A defect equal to a reachable
increment is killed by that increment, the layer having exponent two. -/
theorem mpcSx_supply_of_rungSix (h : MpcSxRungSix) : MpcLadSupply 4 mpcFvW5 := by
  obtain ⟨us, ut, um, un, hm, heq⟩ := h
  have hz : levelMk (DM 2 0 : Type) 6 (mpcBldIncr mpcFvW5.2.1 mpcFvW5.2.2.2 us ut um un)
      ∈ zLayer (DM 2 0 : Type) 5 :=
    mpcLad_incr_mem_zLayer mpcFvW5.2.1 mpcFvW5.2.2.2 hm.1.2 hm.2.1.2 hm.2.2.1.2 hm.2.2.2.2
  refine ⟨us, ut, um, un, hm, ?_⟩
  rw [mpcWord_mem_iff_levelMk, map_mul, heq, ← pow_two]
  exact zLayer_sq _ hz

theorem mpcSx_nonempty_six_of_rungSix (h : MpcSxRungSix) : (mpcWordSet 6).Nonempty :=
  mpcSx_nonempty_six_of_supply (mpcSx_supply_of_rungSix h)

end RungSix

