import GQ2.Dyadic.Instances.AnchoredTameInertiaPrescribedUnramified

/-!
# Profinite parametrization of tame inertia and word correction

Every finite image of `inertiaPartQ q` lies on the cyclic line generated by `tqTau q`.
Compactness over all finite quotients upgrades those individually chosen integer exponents to
one compatible profinite exponent.  Thus the closed tame-inertia subgroup is exactly the image
of `z ↦ tqTau q ^ᶻ z`.

This gives a rank- and word-generic correction operation.  If a word's tame value lies in
inertia, append the inverse corresponding `tau`-power.  The corrected word specializes to the
ordinary tame quotient, while every pro-`2` evaluation and the complete `CorePresentation`
remain unchanged.
-/

namespace GQ2.Dyadic

noncomputable section

open GQ2
open GQ2.Dyadic.Count

private theorem one_zpowHat {G : Type} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [CompactSpace G] [T2Space G]
    [TotallyDisconnectedSpace G] (z : Zhat) :
    (1 : G) ^ᶻ z = 1 := by
  have hfun : (fun w : Zhat => (1 : G) ^ᶻ w) = fun _ => 1 := by
    apply Zhat.funext_ofInt (continuous_zpowHat _) continuous_const
    intro n
    rw [zpowHat_ofInt, one_zpow]
  exact congrFun hfun z

/-- Exponents which represent `x` modulo one finite quotient. -/
def tameInertiaExponentSet (q : ℕ) (x : Tq q)
    (U : OpenNormalSubgroup (Tq q)) : Set Zhat :=
  {z | (tqTau q) ^ᶻ z * x⁻¹ ∈ U.toSubgroup}

theorem tameInertiaExponentSet_isClosed (q : ℕ) (x : Tq q)
    (U : OpenNormalSubgroup (Tq q)) :
    IsClosed (tameInertiaExponentSet q x U) := by
  apply U.toOpenSubgroup.isClosed.preimage
  exact (continuous_zpowHat (tqTau q)).mul continuous_const.inv

theorem tameInertiaExponentSet_nonempty {q : ℕ} {x : Tq q}
    (hx : x ∈ inertiaPartQ q) (U : OpenNormalSubgroup (Tq q)) :
    (tameInertiaExponentSet q x U).Nonempty := by
  let c : ContinuousMonoidHom (Tq q) (Tq q ⧸ U.toSubgroup) :=
    ⟨QuotientGroup.mk' U.toSubgroup, QuotientGroup.continuous_mk⟩
  have hx' := inertiaPartQ_le_comap_zpowers_tqTau q c hx
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hx'
  refine ⟨Zhat.ofInt n, ?_⟩
  change (tqTau q) ^ᶻ Zhat.ofInt n * x⁻¹ ∈ U.toSubgroup
  rw [zpowHat_ofInt]
  apply (QuotientGroup.eq_one_iff _).mp
  change c ((tqTau q) ^ n * x⁻¹) = 1
  rw [map_mul, map_zpow, map_inv, hn]
  change c x * (c x)⁻¹ = 1
  exact mul_inv_cancel _

theorem tameInertiaExponentSet_inf_subset_left (q : ℕ) (x : Tq q)
    (U V : OpenNormalSubgroup (Tq q)) :
    tameInertiaExponentSet q x (U ⊓ V) ⊆ tameInertiaExponentSet q x U := by
  intro z hz
  exact hz.1

theorem tameInertiaExponentSet_inf_subset_right (q : ℕ) (x : Tq q)
    (U V : OpenNormalSubgroup (Tq q)) :
    tameInertiaExponentSet q x (U ⊓ V) ⊆ tameInertiaExponentSet q x V := by
  intro z hz
  exact hz.2

/-- The closed tame-inertia subgroup is parametrized by profinite powers of `tqTau`. -/
theorem exists_zpowHat_tqTau_of_mem_inertiaPartQ {q : ℕ} {x : Tq q}
    (hx : x ∈ inertiaPartQ q) :
    ∃ z : Zhat, (tqTau q) ^ᶻ z = x := by
  letI : Nonempty (OpenNormalSubgroup (Tq q)) :=
    ⟨topOpenNormalSubgroup (Tq q)⟩
  have hne : (⋂ U : OpenNormalSubgroup (Tq q),
      tameInertiaExponentSet q x U).Nonempty := by
    apply IsCompact.nonempty_iInter_of_directed_nonempty_isCompact_isClosed
    · intro U V
      exact ⟨U ⊓ V, tameInertiaExponentSet_inf_subset_left q x U V,
        tameInertiaExponentSet_inf_subset_right q x U V⟩
    · exact tameInertiaExponentSet_nonempty hx
    · exact fun U => (tameInertiaExponentSet_isClosed q x U).isCompact
    · exact tameInertiaExponentSet_isClosed q x
  obtain ⟨z, hz⟩ := hne
  refine ⟨z, ?_⟩
  rw [← mul_inv_eq_one]
  apply eq_one_of_forall_mem_openNormalSubgroup
  intro U
  exact Set.mem_iInter.mp hz U

theorem zpowHat_tqTau_mem_inertiaPartQ (q : ℕ) (z : Zhat) :
    (tqTau q) ^ᶻ z ∈ inertiaPartQ q := by
  rw [← quotientMk_eq_one_iff (N := inertiaPartQ q)]
  rw [map_zpowHat]
  have htau : qMkQ q (tqTau q) = 1 := by
    change quotientMk (inertiaPartQ q) (tqTau q) = 1
    rw [quotientMk_eq_one_iff]
    exact Subgroup.le_topologicalClosure _
      (Subgroup.subset_normalClosure (Set.mem_singleton _))
  change (qMkQ q (tqTau q)) ^ᶻ z = 1
  rw [htau, one_zpowHat]

theorem mem_inertiaPartQ_iff_exists_zpowHat_tqTau {q : ℕ} {x : Tq q} :
    x ∈ inertiaPartQ q ↔ ∃ z : Zhat, (tqTau q) ^ᶻ z = x := by
  constructor
  · exact exists_zpowHat_tqTau_of_mem_inertiaPartQ
  · rintro ⟨z, rfl⟩
    exact zpowHat_tqTau_mem_inertiaPartQ q z

/-- A profinite `tau`-power correction for a word whose tame defect lies in inertia. -/
noncomputable def tameCorrectionExponent {n q : ℕ}
    (R : PWord (Generator n))
    (hR : (tameMarking n q).eval R ∈ inertiaPartQ q) : Zhat :=
  Classical.choose (exists_zpowHat_tqTau_of_mem_inertiaPartQ hR)

theorem tameCorrectionExponent_spec {n q : ℕ}
    (R : PWord (Generator n))
    (hR : (tameMarking n q).eval R ∈ inertiaPartQ q) :
    (tqTau q) ^ᶻ tameCorrectionExponent R hR = (tameMarking n q).eval R :=
  Classical.choose_spec (exists_zpowHat_tqTau_of_mem_inertiaPartQ hR)

/-- Append the inverse tame-inertia defect without changing pro-`2` evaluations. -/
noncomputable def tameCorrectedWord {n q : ℕ}
    (R : PWord (Generator n))
    (hR : (tameMarking n q).eval R ∈ inertiaPartQ q) :
    PWord (Generator n) :=
  .mul R (.inv (.profPow (.gen .tau) (tameCorrectionExponent R hR)))

theorem tameCorrectedWord_specializes {n q : ℕ}
    (R : PWord (Generator n))
    (hR : (tameMarking n q).eval R ∈ inertiaPartQ q) :
    TameSpec.TameSpecializes n q (tameCorrectedWord R hR) := by
  rw [TameSpec.tameSpecializes_iff]
  simp only [tameCorrectedWord, Marking.eval_def, PWord.eval_mul, PWord.eval_inv,
    PWord.eval_profPow, PWord.eval_gen]
  rw [show (tameMarking n q) .tau = tqTau q from rfl,
    tameCorrectionExponent_spec]
  change (tameMarking n q).eval R * ((tameMarking n q).eval R)⁻¹ = 1
  exact mul_inv_cancel _

theorem eval_pro2_tameCorrectedWord {n q : ℕ}
    (R : PWord (Generator n))
    (hR : (tameMarking n q).eval R ∈ inertiaPartQ q)
    {Q : Type} [Group Q] [TopologicalSpace Q] [IsTopologicalGroup Q]
    [CompactSpace Q] [T2Space Q] [TotallyDisconnectedSpace Q]
    (hQ : IsProP 2 Q) (t : Marking n Q) (hTau : t.τ = 1) :
    t.eval (pro2 (tameCorrectedWord R hR)) = t.eval (pro2 R) := by
  calc
    t.eval (pro2 (tameCorrectedWord R hR)) =
        t.eval (tameCorrectedWord R hR) :=
      PWord.eval_pro2 _ hTau (zpowHat_omega2_eq_self_of_isProP hQ) _
    _ = t.eval R := by
      rw [tameCorrectedWord, Marking.eval_def, PWord.eval_mul,
        PWord.eval_inv, PWord.eval_profPow, PWord.eval_gen]
      have hTau' : t .tau = 1 := hTau
      rw [hTau', one_zpowHat, inv_one, mul_one]
      rfl
    _ = t.eval (pro2 R) :=
      (PWord.eval_pro2 _ hTau (zpowHat_omega2_eq_self_of_isProP hQ) R).symm

namespace CorePresentation

/-- Appending the tame-inertia correction preserves the complete pro-`2` presentation. -/
noncomputable def ofTameCorrection {n q : ℕ} {R : PWord (Generator n)}
    {P : ProfiniteGrp} (C : CorePresentation n R P)
    (hR : (tameMarking n q).eval R ∈ inertiaPartQ q) :
    CorePresentation n (tameCorrectedWord R hR) P where
  isProP := C.isProP
  mark := C.mark
  mark_tau := C.mark_tau
  rel := (eval_pro2_tameCorrectedWord R hR C.isProP C.mark C.mark_tau).trans C.rel
  liftHom hQ t hTau hrel := by
    have hrel' : t.eval (pro2 R) = 1 :=
      (eval_pro2_tameCorrectedWord R hR hQ t hTau).symm.trans hrel
    exact C.liftHom hQ t hTau hrel'
  liftHom_mark hQ t hTau hrel g := by
    have hrel' : t.eval (pro2 R) = 1 :=
      (eval_pro2_tameCorrectedWord R hR hQ t hTau).symm.trans hrel
    exact C.liftHom_mark hQ t hTau hrel' g
  hom_ext := C.hom_ext

end CorePresentation

#print axioms exists_zpowHat_tqTau_of_mem_inertiaPartQ
#print axioms mem_inertiaPartQ_iff_exists_zpowHat_tqTau
#print axioms tameCorrectedWord_specializes
#print axioms eval_pro2_tameCorrectedWord
#print axioms CorePresentation.ofTameCorrection

end


end GQ2.Dyadic
