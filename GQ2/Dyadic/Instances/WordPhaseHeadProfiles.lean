import GQ2.Dyadic.Instances.WordPhaseBoundaryMarking

/-!
# Actual faithful-head profiles for arbitrary source words

The unramified profile includes equality of the two-primary sigma component to one in
the faithful head group, not just triviality of its action. This distinction is needed
for extraspecial factor-set calculations.
-/

namespace GQ2.Dyadic.Instances.WordPhaseHeadProfiles
noncomputable section
open GQ2 GQ2.SectionEight
open SectionSeven AffineTLift CentralObstruction ContCoh FoxH
open GQ2.Dyadic GQ2.Dyadic.Count GQ2.Dyadic.LSquare

variable {q : ℕ} {P : ProfiniteGrp}
  {H E : Type} [Group H] [TopologicalSpace H] [DiscreteTopology H] [Finite H]
  [CommGroup E] [TopologicalSpace E] [DiscreteTopology E] [Finite E]
  {Y : Type} [Group Y] [TopologicalSpace Y] [DiscreteTopology Y] [Finite Y]
  (T : MarkedTarget H E Y) (Blk : SectionSeven.MinimalBlock T.LY)
  [Blk.frattiniK.Normal] [(Blk.S.subgroupOf Blk.P).Normal] [Blk.K.Normal]
  (hE2 : ∀ e : E, e ^ 2 = 1) (hq0 : q ≠ 0) (hqe : Even q)
  (F : BoundaryFrameK q P H E)

omit [TopologicalSpace Y] [DiscreteTopology Y] [Blk.frattiniK.Normal] in
/-- The unramified faithful head is generated by sigma. -/
theorem head_cyclic_of_unramified
    (hunram : letI := blockPS_commGroup Blk; letI := SectionNine.headAct T Blk
      ∀ v : Additive (↥Blk.P ⧸ Blk.S.subgroupOf Blk.P), F.alpha (tqTau q) • v = v) :
    hvTauK T Blk F = 1 ∧
      ∀ x : SectionNine.HVq T Blk, x ∈ Subgroup.zpowers (hvSigmaK T Blk F) := by
  letI := blockPS_commGroup Blk
  letI := SectionNine.headAct T Blk
  have htau : hvTauK T Blk F = 1 := by
    show QuotientGroup.mk' (SectionNine.headActKer T Blk) (F.alpha (tqTau q)) = 1
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact hunram
  refine ⟨htau, ?_⟩
  have hle : Subgroup.closure {hvSigmaK T Blk F, hvTauK T Blk F} ≤
      Subgroup.zpowers (hvSigmaK T Blk F) := by
    rw [Subgroup.closure_le, Set.pair_subset_iff]
    exact ⟨Subgroup.mem_zpowers _, htau ▸ Subgroup.one_mem _⟩
  rw [hv_genK T Blk F] at hle
  exact fun x ↦ hle (Subgroup.mem_top x)

/-- Sigma's two-primary part is actually one in the unramified faithful head. -/
theorem head_sigma_omega_eq_one
    (hVne : ∃ v : (blockEnrichmentDK T Blk hE2 hq0 hqe F).Vmod, v ≠ 0)
    (hunram : letI := blockPS_commGroup Blk; letI := SectionNine.headAct T Blk
      ∀ v : Additive (↥Blk.P ⧸ Blk.S.subgroupOf Blk.P), F.alpha (tqTau q) • v = v) :
    powOmega2 (hvSigmaK T Blk F) = 1 := by
  letI := blockPS_commGroup Blk
  letI := SectionNine.headAct T Blk
  letI := SectionNine.hvAct T Blk
  let En := blockEnrichmentDK T Blk hE2 hq0 hqe F
  letI : DistribMulAction (SectionNine.HVq T Blk) En.Vmod := SectionNine.hvAct T Blk
  have hsimpleHV : IsSimpleModTwo (SectionNine.HVq T Blk) En.Vmod := by
    obtain ⟨v, hv⟩ := hVne
    exact ⟨nontrivial_of_ne v 0 hv, SectionNine.hv_simple T Blk⟩
  have hzp := (head_cyclic_of_unramified T Blk F hunram).2
  apply SectionNine.hvAct_faithful T Blk
  apply pow2_smul_trivial_of_stable (SectionNine.blockPS_exp2 T Blk) hsimpleHV
    (powOmega2 (hvSigmaK T Blk F)) (isPGroup_zpowers_powOmega2 _)
  intro a v hv
  have hc : powOmega2 (hvSigmaK T Blk F) * a = a * powOmega2 (hvSigmaK T Blk F) :=
    comm_of_cyclic (hvSigmaK T Blk F) hzp _ _
  calc
    powOmega2 (hvSigmaK T Blk F) • (a • v) =
        (powOmega2 (hvSigmaK T Blk F) * a) • v := (mul_smul _ _ _).symm
    _ = (a * powOmega2 (hvSigmaK T Blk F)) • v := by rw [hc]
    _ = a • (powOmega2 (hvSigmaK T Blk F) • v) := mul_smul _ _ _
    _ = a • v := congrArg (a • ·) hv

/-- Sigma is fixed-point-free when the faithful cyclic head acts nontrivially. -/
theorem head_sigma_fixedPointFree
    (hnt : ∃ (g : (SectionNine.blockFrame T Blk hE2).YC)
      (v : (blockEnrichmentDK T Blk hE2 hq0 hqe F).Vmod), g • v ≠ v)
    (hunram : letI := blockPS_commGroup Blk; letI := SectionNine.headAct T Blk
      ∀ v : Additive (↥Blk.P ⧸ Blk.S.subgroupOf Blk.P), F.alpha (tqTau q) • v = v) :
    letI := blockPS_commGroup Blk
    letI := SectionNine.hvAct T Blk
    ∀ v : Additive (↥Blk.P ⧸ Blk.S.subgroupOf Blk.P), hvSigmaK T Blk F • v = v → v = 0 := by
  letI := blockPS_commGroup Blk
  letI := blockActV Blk
  letI := SectionNine.headAct T Blk
  letI := SectionNine.hvAct T Blk
  have hzp := (head_cyclic_of_unramified T Blk F hunram).2
  have htop : Subgroup.zpowers (hvSigmaK T Blk F) = ⊤ :=
    top_unique fun x _ ↦ hzp x
  have hnorm : (Subgroup.zpowers (hvSigmaK T Blk F)).Normal := by
    rw [htop]
    infer_instance
  have hntSigma : ∃ v : Additive (↥Blk.P ⧸ Blk.S.subgroupOf Blk.P),
      hvSigmaK T Blk F • v ≠ v := by
    classical
    by_contra hno
    have htriv : ∀ v : Additive (↥Blk.P ⧸ Blk.S.subgroupOf Blk.P),
        hvSigmaK T Blk F • v = v := by simpa only [not_exists, not_not] using hno
    obtain ⟨g, v, hv⟩ := hnt
    apply hv
    exact (SectionNine.blockProjF_compat T Blk g v).trans
      ((Subgroup.zpowers_le.mpr (MulAction.mem_stabilizer_iff.mpr (htriv v)))
        (hzp (SectionNine.blockProjF T Blk g)))
  exact tau_fixed_eq_zero_of_zpowers_normal (hvSigmaK T Blk F) hnorm
    (SectionNine.hv_simple T Blk) hntSigma

include hq0 hqe in
omit [TopologicalSpace Y] [DiscreteTopology Y] [Blk.frattiniK.Normal] in
/-- The ramified head has odd, fixed-point-free tau, uniformly in the source word. -/
theorem head_tau_ramified_profile
    (hram : letI := blockPS_commGroup Blk; letI := SectionNine.headAct T Blk
      ∃ v : Additive (↥Blk.P ⧸ Blk.S.subgroupOf Blk.P), F.alpha (tqTau q) • v ≠ v) :
    letI := blockPS_commGroup Blk
    letI := SectionNine.hvAct T Blk
    Odd (orderOf (hvTauK T Blk F)) ∧ powOmega2 (hvTauK T Blk F) = 1 ∧
      ∀ v : Additive (↥Blk.P ⧸ Blk.S.subgroupOf Blk.P), hvTauK T Blk F • v = v → v = 0 := by
  letI := blockPS_commGroup Blk
  letI := SectionNine.headAct T Blk
  letI := SectionNine.hvAct T Blk
  have hrel := hv_relK T Blk F
  have hnorm : (Subgroup.zpowers (hvTauK T Blk F)).Normal :=
    tame_zpowers_normal_pow (hv_genK T Blk F) hrel
  have hodd : Odd (orderOf (hvTauK T Blk F)) :=
    tame_odd_order_pow (orderOf_pos (hvSigmaK T Blk F)).ne' hq0 hqe hrel
  exact ⟨hodd, powOmega2_eq_one_of_odd hodd,
    tau_fixed_eq_zero_of_zpowers_normal (hvTauK T Blk F) hnorm
      (SectionNine.hv_simple T Blk) hram⟩

#print axioms head_cyclic_of_unramified
#print axioms head_sigma_omega_eq_one
#print axioms head_sigma_fixedPointFree
#print axioms head_tau_ramified_profile

end
end GQ2.Dyadic.Instances.WordPhaseHeadProfiles
