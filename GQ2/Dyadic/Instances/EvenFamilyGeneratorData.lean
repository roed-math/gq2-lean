import GQ2.Dyadic.Instances.EvenFamilyRangeBridge

/-!
# Marked generator data from the actual even cyclotomic range

The corrected family selector used to require a separate marked-generator packet even after the
actual cyclotomic image had been identified.  This module removes that duplication uniformly.

The field marking `lambda` is continuous.  Consequently a dense cyclic orientation subgroup has
cyclic image in its finite marked quotient.  For `imChiN alpha` this directly gives the whole-image
procyclic packet.  For `imChiM alpha`, the closed subgroup generated by `mUnit alpha` is the
principal-unit factor, and every element is uniquely in that factor up to multiplication by
`-1`; this gives the product packet and its mod-four clause.  No nilpotency class, handle count,
or selected presentation occurs.
-/

namespace GQ2.Dyadic

noncomputable section

open GQ2
open GQ2.Dyadic.MarkedCore

local notation "ℚ̄₂" => AlgebraicClosure ℚ_[2]

variable {R : LocalReciprocity}
  {K : IntermediateField ℚ_[2] ℚ̄₂} [FiniteDimensional ℚ_[2] K]

private theorem continuous_toZModPow_general (n : ℕ) :
    Continuous (PadicInt.toZModPow (p := 2) n) := by
  rw [continuous_def]
  intro T _
  exact isOpen_preimage_toZModPow n T

/-- The marked quotient on the actual field cyclotomic image is continuous. -/
theorem fieldMarkedPair_lambda_continuous
    [CompactSpace (GalK K)] [T2Space (GalK K)]
    (B : MarkedRecip R K) (FF : DyadicUnitFiltration K) :
    Continuous (B.fieldMarkedPair FF).lambda := by
  let P := B.fieldMarkedPair FF
  let f : GalKab K →* ↥P.C := (chiCycKAb K).rangeRestrict
  have hfcont : Continuous f :=
    (continuous_quot_lift _ (continuous_chiCycK K)).subtype_mk _
  have hfsurj : Function.Surjective f :=
    (chiCycKAb K).rangeRestrict_surjective
  have hquot : Topology.IsQuotientMap f :=
    hfcont.isClosedMap.isQuotientMap hfcont hfsurj
  apply hquot.continuous_iff.mpr
  change Continuous (fun g : GalKab K => P.lambda (f g))
  have hcomp : (fun g : GalKab K => P.lambda (f g)) =
      fun g => P.nuMod g := by
    funext g
    exact P.lambda_chi g
  rw [hcomp]
  exact continuous_ofAdd.comp
    ((continuous_toZModPow_general P.r).comp
      (continuous_toAdd.comp B.continuous_nu_ur))

/-- The actual `N` range supplies the corrected procyclic marked-generator packet. -/
noncomputable def procyclicMarkedGeneratorData_of_range_eq_imChiN
    [CompactSpace (GalK K)] [T2Space (GalK K)]
    [TotallyDisconnectedSpace (GalK K)]
    (B : MarkedRecip R K) (FF : DyadicUnitFiltration K) {alpha : ℕ}
    (hrange : MonoidHom.range (chiCycKTwo (K := K)).toMonoidHom =
      imChiN alpha) :
    ProcyclicMarkedGeneratorData (B.fieldMarkedPair FF) (nUnit alpha) := by
  let P := B.fieldMarkedPair FF
  have hC : P.C = imChiN alpha :=
    (GQ2.Dyadic.LSquare.range_chiCycKTwo_eq_fieldMarkedPairC K B FF).symm.trans
      hrange
  have hunit : nUnit alpha ∈ P.C := by
    rw [hC]
    exact EvenRowSupply.evenRow_nUnit_mem_imChiN alpha
  let g : ↥P.C := ⟨nUnit alpha, hunit⟩
  let Z : Subgroup ↥P.C := Subgroup.closure {g}
  have himage : ((↑) : ↥P.C → ℤ_[2]ˣ) '' (Z : Set ↥P.C) =
      (Subgroup.closure {(nUnit alpha : ℤ_[2]ˣ)} : Set ℤ_[2]ˣ) := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      obtain ⟨j, hj⟩ := Subgroup.mem_closure_singleton.mp hy
      exact Subgroup.mem_closure_singleton.mpr
        ⟨j, by simpa [g] using congrArg Subtype.val hj⟩
    · intro hx
      obtain ⟨j, hj⟩ := Subgroup.mem_closure_singleton.mp hx
      refine ⟨g ^ j, Subgroup.mem_closure_singleton.mpr ⟨j, rfl⟩, ?_⟩
      simpa [g] using hj
  have hZtop : Z.topologicalClosure = ⊤ := by
    apply SetLike.ext'
    rw [Subgroup.topologicalClosure_coe, Subgroup.coe_top]
    apply Set.eq_univ_of_forall
    intro w
    rw [closure_subtype, himage, ← Subgroup.topologicalClosure_coe]
    have hw : (w : ℤ_[2]ˣ) ∈ imChiN alpha := by
      rw [← hC]
      exact w.property
    exact hw
  have herase : Z.topologicalClosure.map P.lambda = Z.map P.lambda := by
    refine le_antisymm ?_ (Subgroup.map_mono Z.le_topologicalClosure)
    have hle : Z.topologicalClosure ≤ Subgroup.comap P.lambda (Z.map P.lambda) := by
      refine Subgroup.topologicalClosure_minimal Z (Subgroup.le_comap_map P.lambda Z) ?_
      exact (isClosed_discrete (((Z.map P.lambda : Subgroup
        (Multiplicative (ZMod (2 ^ P.r)))) : Set _))).preimage
          (fieldMarkedPair_lambda_continuous B FF)
    exact (Subgroup.map_mono hle).trans
      (Subgroup.map_comap_le P.lambda (Z.map P.lambda))
  have hmap : Z.map P.lambda = ⊤ := by
    rw [← herase, hZtop, Subgroup.map_top_of_surjective _ P.surjective_lambda]
  refine
    { generator := g
      generator_eq := rfl
      lambdaAdd_generated := ?_ }
  intro w
  have hw : P.lambda w ∈ Z.map P.lambda := by rw [hmap]; trivial
  obtain ⟨c, hc, hcw⟩ := Subgroup.mem_map.mp hw
  obtain ⟨j, hj⟩ := Subgroup.mem_closure_singleton.mp hc
  refine ⟨j, ?_⟩
  change (P.lambda w).toAdd = j • (P.lambda g).toAdd
  rw [← hcw, ← hj]
  simp

/-- The actual `M` range supplies its product marked-generator packet. -/
noncomputable def markedGeneratorData_of_range_eq_imChiM
    [CompactSpace (GalK K)] [T2Space (GalK K)]
    [TotallyDisconnectedSpace (GalK K)]
    (B : MarkedRecip R K) (FF : DyadicUnitFiltration K) {alpha : ℕ}
    (halpha : 2 ≤ alpha)
    (hrange : MonoidHom.range (chiCycKTwo (K := K)).toMonoidHom =
      imChiM alpha) :
    MarkedGeneratorData (B.fieldMarkedPair FF) (mUnit alpha) := by
  let P := B.fieldMarkedPair FF
  have hC : P.C = imChiM alpha :=
    (GQ2.Dyadic.LSquare.range_chiCycKTwo_eq_fieldMarkedPairC K B FF).symm.trans
      hrange
  have hunit : mUnit alpha ∈ P.C := by
    rw [hC]
    exact MarkedCore.mUnit_mem_imChiM alpha
  have hneg : (-1 : ℤ_[2]ˣ) ∈ P.C := by
    rw [hC]
    exact MarkedCore.neg_one_mem_imChiM alpha
  let g : ↥P.C := ⟨mUnit alpha, hunit⟩
  let negOne : ↥P.C := ⟨-1, hneg⟩
  let Z : Subgroup ↥P.C := Subgroup.closure {g}
  let procyclic : Subgroup ↥P.C := Z.topologicalClosure
  have himage : ((↑) : ↥P.C → ℤ_[2]ˣ) '' (Z : Set ↥P.C) =
      (Subgroup.closure {(mUnit alpha : ℤ_[2]ˣ)} : Set ℤ_[2]ˣ) := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      obtain ⟨j, hj⟩ := Subgroup.mem_closure_singleton.mp hy
      exact Subgroup.mem_closure_singleton.mpr
        ⟨j, by simpa [g] using congrArg Subtype.val hj⟩
    · intro hx
      obtain ⟨j, hj⟩ := Subgroup.mem_closure_singleton.mp hx
      refine ⟨g ^ j, Subgroup.mem_closure_singleton.mpr ⟨j, rfl⟩, ?_⟩
      simpa [g] using hj
  have hpro_iff (w : ↥P.C) : w ∈ procyclic ↔
      (w : ℤ_[2]ˣ) ∈ EvenCyclotomicRange.evenRangePrin alpha := by
    change w ∈ closure (Z : Set ↥P.C) ↔ _
    rw [closure_subtype, himage]
    change (w : ℤ_[2]ˣ) ∈
      (Subgroup.closure {(mUnit alpha : ℤ_[2]ˣ)}).topologicalClosure ↔ _
    rw [EvenCyclotomicRange.evenRange_closure_eq_prin halpha
      (MarkedCore.mUnit_sub_one (by omega))]
  have herase : Z.topologicalClosure.map P.lambda = Z.map P.lambda := by
    refine le_antisymm ?_ (Subgroup.map_mono Z.le_topologicalClosure)
    have hle : Z.topologicalClosure ≤ Subgroup.comap P.lambda (Z.map P.lambda) := by
      refine Subgroup.topologicalClosure_minimal Z (Subgroup.le_comap_map P.lambda Z) ?_
      exact (isClosed_discrete (((Z.map P.lambda : Subgroup
        (Multiplicative (ZMod (2 ^ P.r)))) : Set _))).preimage
          (fieldMarkedPair_lambda_continuous B FF)
    exact (Subgroup.map_mono hle).trans
      (Subgroup.map_comap_le P.lambda (Z.map P.lambda))
  refine
    { unit_mem := hunit
      negOne_mem := hneg
      procyclic := procyclic
      unit_mem_procyclic := ?_
      lambdaAdd_procyclic := ?_
      exists_decomp := ?_
      cyclotomic_trivial := ?_ }
  · exact Z.le_topologicalClosure
      (Subgroup.mem_closure_singleton.mpr ⟨1, by simp [g]⟩)
  · intro w hw
    have hwmap : P.lambda w ∈ Z.topologicalClosure.map P.lambda :=
      Subgroup.mem_map.mpr ⟨w, hw, rfl⟩
    rw [herase] at hwmap
    obtain ⟨c, hc, hcw⟩ := Subgroup.mem_map.mp hwmap
    obtain ⟨j, hj⟩ := Subgroup.mem_closure_singleton.mp hc
    refine ⟨j, ?_⟩
    change (P.lambda w).toAdd = j • (P.lambda g).toAdd
    rw [← hcw, ← hj]
    simp
  · intro c
    have hc : (c : ℤ_[2]ˣ) ∈ imChiM alpha := by
      rw [← hC]
      exact c.property
    rcases (EvenCyclotomicRange.evenRange_mem_imChiM_iff halpha).mp hc with hc | hc
    · exact ⟨c, hpro_iff c |>.mpr
        (EvenCyclotomicRange.evenRange_mem_prin_iff.mpr hc), Or.inl rfl⟩
    · let w : ↥P.C := negOne * c
      have hwval : ((w : ℤ_[2]ˣ) : ℤ_[2]) - 1 =
          -(((c : ℤ_[2]ˣ) : ℤ_[2]) + 1) := by
        simp [w, negOne]
        ring
      have hwprin : (w : ℤ_[2]ˣ) ∈
          EvenCyclotomicRange.evenRangePrin alpha := by
        rw [EvenCyclotomicRange.evenRange_mem_prin_iff, hwval]
        exact Dvd.dvd.neg_right hc
      refine ⟨w, hpro_iff w |>.mpr hwprin, Or.inr ?_⟩
      apply Subtype.ext
      simp [w, negOne]
  · intro w hw
    have hwprin : (w : ℤ_[2]ˣ) ∈
        EvenCyclotomicRange.evenRangePrin 2 :=
      EvenCyclotomicRange.evenRange_prin_antitone halpha
        (hpro_iff w |>.mp hw)
    exact EvenCyclotomicRange.evenRange_toZModPow_eq_one_iff.mpr
      (EvenCyclotomicRange.evenRange_mem_prin_iff.mp hwprin)

#print axioms fieldMarkedPair_lambda_continuous
#print axioms procyclicMarkedGeneratorData_of_range_eq_imChiN
#print axioms markedGeneratorData_of_range_eq_imChiM

end

end GQ2.Dyadic
