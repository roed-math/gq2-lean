import GQ2.Dyadic.Instances.MpcGeneralHandleDefectAbsorption
import GQ2.Dyadic.MarkedCore.MFrameApi

/-!
# An abelian obstruction to arbitrary one-handle Mpc defect absorption

The one-handle `D`-slot correction equation from
`MpcGeneralHandleDefectAbsorption.lean` is already sensitive to the choice of lifts before any
graded or inverse-limit issue appears.  `MpcOneHandleDAbsorbable` isolates that equation.  Every
abelian `ℤ₂`-character kills both commutators, so an absorbable tuple `(a,b,c,d)` must satisfy

`2 f(a) + 4 f(c) = 0`.

The first standard handle coordinate detects a sharp failure of arbitrary-lift absorption.
Multiplying `a` by `U₀` preserves its image under `dmForgetHandles`, preserves the subgroup
generated by the standard-handle marking, and does not change the universal `C + 2B` row.  But
it changes the necessary relation row by `2 ≠ 0`.  Hence the original tuple and its twist
cannot both be absorbable.  The final theorem packages this as an unconditional counterexample:
from any tuple satisfying the visible lift, generation, and row clauses it produces another
tuple satisfying the same clauses for which no one-slot `D` correction exists.

This does not disprove the existential predicate `MpcOneHandleDDefectAbsorption`; it shows that
a positive construction must select balanced lifts.  The remaining nonabelian problem is a
kernel-conjugacy orbit equation (or, at finite depth, compatible surjectivity of fixed-`C`
bracketing on the handle kernel), for which the current API has no producer.
-/

namespace GQ2.Dyadic.Instances.MpcOneHandleDefectObstruction

noncomputable section

open GQ2 GQ2.Dyadic Multiplicative
open GQ2.Dyadic.MarkedCore
open GQ2.Dyadic.Instances.MpcGeneralHandleStandardStabilization

/-- The equation-only part of one-handle `D`-slot absorption. -/
def MpcOneHandleDAbsorbable (a b c d : DM 2 1) : Prop :=
  ∃ z : DM 2 1,
    dmForgetHandles 2 1 z = 1 ∧
    conjP (commP c z) d =
      (mWord 2 a b c d)⁻¹ *
        (commP (dmGen 2 1 (handleIdxU (0 : Fin 1)))
          (dmGen 2 1 (handleIdxV (0 : Fin 1))))⁻¹

/-- Every abelian character kills the core defect of an absorbable tuple. -/
theorem mWord_char_eq_one_of_oneHandleDAbsorbable {a b c d : DM 2 1}
    (habs : MpcOneHandleDAbsorbable a b c d)
    (f : ContinuousMonoidHom (DM 2 1) (Multiplicative ℤ_[2])) :
    f (mWord 2 a b c d) = 1 := by
  obtain ⟨z, _, hcorr⟩ := habs
  have h := congrArg f hcorr
  have hcz : f (commP c z) = 1 := by
    change f.toMonoidHom (commP c z) = 1
    exact map_commP_eq_one f.toMonoidHom c z
  have huv : f (commP (dmGen 2 1 (handleIdxU (0 : Fin 1)))
      (dmGen 2 1 (handleIdxV (0 : Fin 1)))) = 1 := by
    change f.toMonoidHom (commP (dmGen 2 1 (handleIdxU (0 : Fin 1)))
      (dmGen 2 1 (handleIdxV (0 : Fin 1)))) = 1
    exact map_commP_eq_one f.toMonoidHom _ _
  rw [map_conjP_comm, hcz, map_mul, map_inv, map_inv, huv, inv_one, mul_one] at h
  simpa only [inv_eq_one] using h.symm

/-- The abelian relation vector is a necessary condition for one-slot absorption. -/
theorem oneHandleDAbsorbable_relationRow {a b c d : DM 2 1}
    (habs : MpcOneHandleDAbsorbable a b c d)
    (f : ContinuousMonoidHom (DM 2 1) (Multiplicative ℤ_[2])) :
    2 * toAdd (f a) + 4 * toAdd (f c) = 0 := by
  have h := congrArg toAdd (mWord_char_eq_one_of_oneHandleDAbsorbable habs f)
  rw [map_mWord, mWord_comm, toAdd_mul, toAdd_pow, toAdd_pow,
    toAdd_one, nsmul_eq_mul] at h
  norm_num at h ⊢
  exact h

/-- The additive coordinate of the first standard handle generator. -/
noncomputable def oneHandleUChar :
    ContinuousMonoidHom (DM 2 1) (Multiplicative ℤ_[2]) :=
  (mHHom 2 (mHandleCoordU (0 : Fin 1))).comp (mAbMkHom 2 1)

@[simp] theorem oneHandleUChar_gen (i : Fin (coreRank 1)) :
    oneHandleUChar (dmGen 2 1 i) =
      mHandleMark (mHandleCoordU (0 : Fin 1)) (ofAdd (1 : ℤ_[2])) i := by
  change mHHom 2 (mHandleCoordU (0 : Fin 1)) (mAbMkHom 2 1 (dmGen 2 1 i)) = _
  rw [mAbMkHom_apply, mHHom, mCoordHom_gen]

@[simp] theorem oneHandleUChar_handleU :
    oneHandleUChar (dmGen 2 1 (handleIdxU (0 : Fin 1))) = ofAdd (1 : ℤ_[2]) := by
  rw [oneHandleUChar_gen, ← mHandleIdx_coordU, mHandleMark_self]

/-- Twisting the `A`-lift by a standard handle generator does not change the subgroup generated
by the standard-handle marking. -/
theorem closure_standardHandleMark_handleU_mul_A_eq (a b c d : DM 2 1) :
    Subgroup.closure (Set.range (standardHandleMark
      (dmGen 2 1 (handleIdxU (0 : Fin 1)) * a) b c d)) =
      Subgroup.closure (Set.range (standardHandleMark a b c d)) := by
  apply le_antisymm
  · rw [Subgroup.closure_le]
    rintro _ ⟨i, rfl⟩
    let H := Subgroup.closure (Set.range (standardHandleMark a b c d))
    have hmem (j : Fin (coreRank 1)) :
        standardHandleMark a b c d j ∈ H :=
      Subgroup.subset_closure (Set.mem_range_self j)
    rcases mIdx_cases i with rfl | rfl | rfl | rfl | ⟨k, rfl⟩
    · have hu : dmGen 2 1 (handleIdxU (0 : Fin 1)) ∈ H := by
        simpa using hmem (handleIdxU (0 : Fin 1))
      have ha : a ∈ H := by simpa using hmem 0
      exact H.mul_mem hu ha
    · simpa using hmem 1
    · simpa using hmem 2
    · simpa using hmem 3
    · rcases mHandleCoord_cases k with ⟨j, rfl⟩ | ⟨j, rfl⟩
      · simpa [mHandleIdx_coordU] using hmem (handleIdxU j)
      · simpa [mHandleIdx_coordV] using hmem (handleIdxV j)
  · rw [Subgroup.closure_le]
    rintro _ ⟨i, rfl⟩
    let H := Subgroup.closure (Set.range (standardHandleMark
      (dmGen 2 1 (handleIdxU (0 : Fin 1)) * a) b c d))
    have hmem (j : Fin (coreRank 1)) :
        standardHandleMark (dmGen 2 1 (handleIdxU (0 : Fin 1)) * a) b c d j ∈ H :=
      Subgroup.subset_closure (Set.mem_range_self j)
    rcases mIdx_cases i with rfl | rfl | rfl | rfl | ⟨k, rfl⟩
    · have hu : dmGen 2 1 (handleIdxU (0 : Fin 1)) ∈ H := by
        simpa using hmem (handleIdxU (0 : Fin 1))
      have hua : dmGen 2 1 (handleIdxU (0 : Fin 1)) * a ∈ H := by
        simpa using hmem 0
      change a ∈ H
      simpa only [inv_mul_cancel_left] using H.mul_mem (H.inv_mem hu) hua
    · simpa using hmem 1
    · simpa using hmem 2
    · simpa using hmem 3
    · rcases mHandleCoord_cases k with ⟨j, rfl⟩ | ⟨j, rfl⟩
      · simpa [mHandleIdx_coordU] using hmem (handleIdxU j)
      · simpa [mHandleIdx_coordV] using hmem (handleIdxV j)

/-- Consequently the handle-`U` twist preserves topological generation. -/
theorem topGen_standardHandleMark_handleU_mul_A_iff (a b c d : DM 2 1) :
    (Subgroup.closure (Set.range (standardHandleMark
      (dmGen 2 1 (handleIdxU (0 : Fin 1)) * a) b c d))).topologicalClosure = ⊤ ↔
      (Subgroup.closure (Set.range (standardHandleMark a b c d))).topologicalClosure = ⊤ := by
  rw [closure_standardHandleMark_handleU_mul_A_eq]

@[simp] theorem dmForgetHandles_handleU_mul_A (a : DM 2 1) :
    dmForgetHandles 2 1 (dmGen 2 1 (handleIdxU (0 : Fin 1)) * a) =
      dmForgetHandles 2 1 a := by
  rw [map_mul, dmForgetHandles_handleU, one_mul]

/-- A tuple and the tuple obtained by multiplying its `A`-lift by the first handle generator
cannot both satisfy a one-slot `D` correction. -/
theorem not_both_oneHandleDAbsorbable_handleU_mul_A (a b c d : DM 2 1) :
    ¬ (MpcOneHandleDAbsorbable a b c d ∧
      MpcOneHandleDAbsorbable
        (dmGen 2 1 (handleIdxU (0 : Fin 1)) * a) b c d) := by
  rintro ⟨habs, habs'⟩
  have h := oneHandleDAbsorbable_relationRow habs oneHandleUChar
  have h' := oneHandleDAbsorbable_relationRow habs' oneHandleUChar
  rw [map_mul, toAdd_mul, oneHandleUChar_handleU, toAdd_ofAdd] at h'
  have htwo : (2 : ℤ_[2]) = 0 := by
    linear_combination h' - h
  norm_num at htwo

/-- Lift, generation, and the universal `C + 2B` row do not force one-slot absorption.
From every tuple with those data, either it or its handle-`U` twist is another tuple with the
same data and no `D`-slot correction.  Thus a future positive theorem must choose balanced lifts,
not merely arbitrary lifts satisfying the visible extension clauses. -/
theorem exists_nonabsorbable_with_same_lift_gen_row
    (Psi0 : ContinuousMulEquiv (DM 2 0) (DM 2 0))
    (a b c d : DM 2 1)
    (ha : dmForgetHandles 2 1 a = Psi0 (dmA 2 0))
    (hb : dmForgetHandles 2 1 b = Psi0 (dmB 2 0))
    (hc : dmForgetHandles 2 1 c = Psi0 (dmC 2 0))
    (hd : dmForgetHandles 2 1 d = Psi0 (dmD 2 0))
    (hgen : (Subgroup.closure
      (Set.range (standardHandleMark a b c d))).topologicalClosure = ⊤)
    (hrow : ∀ f : ContinuousMonoidHom (DM 2 1) (Multiplicative ℤ_[2]),
      toAdd (f c) = toAdd (f (dmC 2 1)) + 2 * toAdd (f (dmB 2 1))) :
    ∃ a' : DM 2 1,
      dmForgetHandles 2 1 a' = Psi0 (dmA 2 0) ∧
      dmForgetHandles 2 1 b = Psi0 (dmB 2 0) ∧
      dmForgetHandles 2 1 c = Psi0 (dmC 2 0) ∧
      dmForgetHandles 2 1 d = Psi0 (dmD 2 0) ∧
      (Subgroup.closure
        (Set.range (standardHandleMark a' b c d))).topologicalClosure = ⊤ ∧
      (∀ f : ContinuousMonoidHom (DM 2 1) (Multiplicative ℤ_[2]),
        toAdd (f c) = toAdd (f (dmC 2 1)) + 2 * toAdd (f (dmB 2 1))) ∧
      ¬ MpcOneHandleDAbsorbable a' b c d := by
  by_cases habs : MpcOneHandleDAbsorbable a b c d
  · refine ⟨dmGen 2 1 (handleIdxU (0 : Fin 1)) * a, ?_, hb, hc, hd, ?_, hrow, ?_⟩
    · simpa using ha
    · exact (topGen_standardHandleMark_handleU_mul_A_iff a b c d).2 hgen
    · intro habs'
      exact not_both_oneHandleDAbsorbable_handleU_mul_A a b c d ⟨habs, habs'⟩
  · exact ⟨a, ha, hb, hc, hd, hgen, hrow, habs⟩

#print axioms MpcOneHandleDAbsorbable
#print axioms mWord_char_eq_one_of_oneHandleDAbsorbable
#print axioms oneHandleDAbsorbable_relationRow
#print axioms oneHandleUChar
#print axioms closure_standardHandleMark_handleU_mul_A_eq
#print axioms topGen_standardHandleMark_handleU_mul_A_iff
#print axioms dmForgetHandles_handleU_mul_A
#print axioms not_both_oneHandleDAbsorbable_handleU_mul_A
#print axioms exists_nonabsorbable_with_same_lift_gen_row

end
end GQ2.Dyadic.Instances.MpcOneHandleDefectObstruction
