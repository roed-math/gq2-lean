import GQ2.Dyadic.Instances.AnchoredInvolutionNormOddness
import GQ2.Dyadic.RamificationInertiaBridge

/-!
# Relative ramification of the anchored tame-inertia field

The remaining premise of `AnchoredInvolutionNormOddness` asks for odd absolute ramification of
the canonical anchored tame-inertia field.  At the campaign's actual subgroup
`U = GalKsub K`, that field canonically contains `K`.  The ramification tower identity therefore
gives

`e(F₀/ℚ₂) = e(F₀/K) * e(K/ℚ₂)`.

The fundamental identity `[K : ℚ₂] = e(K/ℚ₂) * f(K/ℚ₂)` makes the second factor odd
whenever `K` has odd degree.  This module consequently reduces the remaining absolute premise,
in both directions, to the exact relative premise that `e(F₀/K)` is odd.  The `At` form preserves
the compatible-use quantification and the caller's custom action verbatim.

This is the current irreducible field-theoretic boundary.  The tame orientation says that units
die under `nuTq`, but the tame quotient API does not identify `ker nuTq` with the closed subgroup
generated by `tqTau`.  Even such an identification would still need a relative local-CFT theorem
identifying the resulting anchored field with the corresponding norm kernel over `K`.
`MarkedRecip` deliberately omits that finite-layer theorem; the existing
`FiniteAbelianTwoNormReciprocity` constructs some realizing layer for an abstract finite
`2`-primary kernel, not this prescribed anchored field.  Thus no parity of `e(F₀/K)` follows from
the presently exported AX3/AX4 interfaces alone.
-/

namespace GQ2.Dyadic

noncomputable section

open GQ2

local notation "ℚ̄₂" => AlgebraicClosure ℚ_[2]

variable {C : Type} [Group C] [TopologicalSpace C]

/-- The anchored tame-inertia field over `GalKsub K` contains its base field `K`. -/
theorem baseField_le_anchoredTameInertiaField
    (K : IntermediateField ℚ_[2] ℚ̄₂)
    (rho : ContinuousMonoidHom ↑(GalKsub K) C) (t : C) :
    K ≤ anchoredTameInertiaField (GalKsub K) rho t := by
  intro x hx
  rw [anchoredTameInertiaField, IntermediateField.mem_fixedField_iff]
  intro y hy
  obtain ⟨g, hg, rfl⟩ := hy
  have hx' : x ∈ IntermediateField.fixedField K.fixingSubgroup :=
    (InfiniteGalois.fixedField_fixingSubgroup K).symm ▸ hx
  exact hx' g

/-- An odd absolute degree forces the ramification index of every filtration of `K` to be odd. -/
theorem odd_filtration_e_of_odd_finrank_tower
    (K : IntermediateField ℚ_[2] ℚ̄₂) [FiniteDimensional ℚ_[2] K]
    (FK : DyadicUnitFiltration K) (hodd : Odd (Module.finrank ℚ_[2] K)) :
    Odd FK.e := by
  rw [SpectralLocalField.field_finrank_eq_e_mul_f (K := K) (FF := FK)] at hodd
  exact (Nat.odd_mul.mp hodd).1

/-- Over an odd-degree base, odd absolute ramification of the anchored tame-inertia field is
equivalent to oddness of its relative ramification index over the base. -/
theorem odd_anchoredTameInertiaField_e_iff_odd_relE
    (K : IntermediateField ℚ_[2] ℚ̄₂) [FiniteDimensional ℚ_[2] K]
    (FK : DyadicUnitFiltration K) (rho : ContinuousMonoidHom ↑(GalKsub K) C) (t : C)
    (F₀F : DyadicUnitFiltration (anchoredTameInertiaField (GalKsub K) rho t))
    (hodd : Odd (Module.finrank ℚ_[2] K)) :
    Odd F₀F.e ↔
      Odd (GaloisCosetNorm.relE FK F₀F
        (baseField_le_anchoredTameInertiaField K rho t)) := by
  have hKe : Odd FK.e := odd_filtration_e_of_odd_finrank_tower K FK hodd
  have hKeZ : Odd (FK.e : ℤ) := by exact_mod_cast hKe
  have htower := GaloisCosetNorm.e_eq_relE_mul FK F₀F
    (baseField_le_anchoredTameInertiaField K rho t)
  constructor
  · intro hF₀e
    have hF₀eZ : Odd (F₀F.e : ℤ) := by exact_mod_cast hF₀e
    rw [htower] at hF₀eZ
    exact (Int.odd_mul.mp hF₀eZ).1
  · intro hrel
    have hF₀eZ : Odd (F₀F.e : ℤ) := by
      rw [htower]
      exact hrel.mul hKeZ
    exact_mod_cast hF₀eZ

/-- The exact relative-index form of odd anchored tame-inertia data over a specified base. -/
def AnchoredTameInertiaRelativeOddData
    (K : IntermediateField ℚ_[2] ℚ̄₂) [FiniteDimensional ℚ_[2] K]
    (FK : DyadicUnitFiltration K) (rho : ContinuousMonoidHom ↑(GalKsub K) C) (t : C) : Prop :=
  ∃ F₀F : DyadicUnitFiltration (anchoredTameInertiaField (GalKsub K) rho t),
    Odd (GaloisCosetNorm.relE FK F₀F
      (baseField_le_anchoredTameInertiaField K rho t))

/-- At odd base degree, the absolute and relative oddness packets are equivalent. -/
theorem anchoredTameInertiaOddData_iff_relativeOdd
    (K : IntermediateField ℚ_[2] ℚ̄₂) [FiniteDimensional ℚ_[2] K]
    (FK : DyadicUnitFiltration K) (rho : ContinuousMonoidHom ↑(GalKsub K) C) (t : C)
    (hodd : Odd (Module.finrank ℚ_[2] K)) :
    AnchoredTameInertiaOddData (GalKsub K) rho t ↔
      AnchoredTameInertiaRelativeOddData K FK rho t := by
  constructor
  · rintro ⟨F₀F, hF₀e⟩
    exact ⟨F₀F, (odd_anchoredTameInertiaField_e_iff_odd_relE K FK rho t F₀F hodd).mp hF₀e⟩
  · rintro ⟨F₀F, hrel⟩
    exact ⟨F₀F, (odd_anchoredTameInertiaField_e_iff_odd_relE K FK rho t F₀F hodd).mpr hrel⟩

variable [DiscreteTopology C] [Finite C]

/-- The relative-index residual with exactly the compatible ramified-use quantification and
custom action of the determinant consumer. -/
def AnchoredTameInertiaRelativeOddDataAt
    (P : FieldParameters) (K : IntermediateField ℚ_[2] ℚ̄₂)
    [FiniteDimensional ℚ_[2] K] (FK : DyadicUnitFiltration K)
    (tame : ContinuousMonoidHom ↑(GalKsub K) (Tq P.qK)) : Prop :=
  ∀ {D : Type} [Group D] [TopologicalSpace D] [DiscreteTopology D] [Finite D]
    (V : Type) [AddCommGroup V] [DistribMulAction D V]
    (c : ContinuousMonoidHom (Tq P.qK) D)
    (rho : ContinuousMonoidHom ↑(GalKsub K) D),
    (∀ g : ↑(GalKsub K), rho g = c (tame g)) →
      (∃ v : V, c (tqTau P.qK) • v ≠ v) →
        AnchoredTameInertiaRelativeOddData K FK rho (c (tqTau P.qK))

/-- At odd base degree, the compatible-use absolute and relative oddness residuals coincide. -/
theorem anchoredTameInertiaOddDataAt_iff_relativeOdd
    (P : FieldParameters) (K : IntermediateField ℚ_[2] ℚ̄₂)
    [FiniteDimensional ℚ_[2] K] (FK : DyadicUnitFiltration K)
    (tame : ContinuousMonoidHom ↑(GalKsub K) (Tq P.qK))
    (hodd : Odd (Module.finrank ℚ_[2] K)) :
    AnchoredTameInertiaOddDataAt P (GalKsub K) tame ↔
      AnchoredTameInertiaRelativeOddDataAt P K FK tame := by
  constructor
  · intro H D _ _ _ _ V _ _ c rho hfac hram
    exact (anchoredTameInertiaOddData_iff_relativeOdd K FK rho
      (c (tqTau P.qK)) hodd).mp (H V c rho hfac hram)
  · intro H D _ _ _ _ V _ _ c rho hfac hram
    exact (anchoredTameInertiaOddData_iff_relativeOdd K FK rho
      (c (tqTau P.qK)) hodd).mpr (H V c rho hfac hram)

/-- Odd relative ramification of each compatible canonical tame-inertia field supplies the
existing absolute oddness packet. -/
theorem anchoredTameInertiaOddDataAt_of_relativeOdd
    (P : FieldParameters) (K : IntermediateField ℚ_[2] ℚ̄₂)
    [FiniteDimensional ℚ_[2] K] (FK : DyadicUnitFiltration K)
    (tame : ContinuousMonoidHom ↑(GalKsub K) (Tq P.qK))
    (hodd : Odd (Module.finrank ℚ_[2] K))
    (Hrel : AnchoredTameInertiaRelativeOddDataAt P K FK tame) :
    AnchoredTameInertiaOddDataAt P (GalKsub K) tame :=
  (anchoredTameInertiaOddDataAt_iff_relativeOdd P K FK tame hodd).mpr Hrel

/-- The relative-index residual is sufficient for equal norm value groups in every compatible
canonical involution tower. -/
theorem anchoredInvolutionEqualNormValueGroupsAt_of_relativeOddTameInertia
    (P : FieldParameters) (K : IntermediateField ℚ_[2] ℚ̄₂)
    [FiniteDimensional ℚ_[2] K] (FK : DyadicUnitFiltration K)
    (tame : ContinuousMonoidHom ↑(GalKsub K) (Tq P.qK))
    (htame : Function.Surjective tame) (hodd : Odd (Module.finrank ℚ_[2] K))
    (Hrel : AnchoredTameInertiaRelativeOddDataAt P K FK tame) :
    AnchoredInvolutionEqualNormValueGroupsAt P (GalKsub K) tame :=
  anchoredInvolutionEqualNormValueGroupsAt_of_oddTameInertia P (GalKsub K)
    (isOpen_fixingSubgroup K) tame htame
    (anchoredTameInertiaOddDataAt_of_relativeOdd P K FK tame hodd Hrel)

#print axioms baseField_le_anchoredTameInertiaField
#print axioms odd_filtration_e_of_odd_finrank_tower
#print axioms odd_anchoredTameInertiaField_e_iff_odd_relE
#print axioms AnchoredTameInertiaRelativeOddData
#print axioms anchoredTameInertiaOddData_iff_relativeOdd
#print axioms AnchoredTameInertiaRelativeOddDataAt
#print axioms anchoredTameInertiaOddDataAt_iff_relativeOdd
#print axioms anchoredTameInertiaOddDataAt_of_relativeOdd
#print axioms anchoredInvolutionEqualNormValueGroupsAt_of_relativeOddTameInertia

end
end GQ2.Dyadic
