import GQ2.Dyadic.SqCore.GradedExtraction
import GQ2.Dyadic.SqCore.GradedDepthThree

/-!
# W80-XFREE: the `x₁`-free dressings

Wave 79 (`docs/dyadic/w79-extract-note.md`) found that the extraction interface
`GTowerKnobRealizable h` does not close **as quantified**: an admissible dressing may carry an
`x₁`-component, and the far letters then need the bracket against the `x₁`-slot frame value,
which the moves supply only bundled with a square.  Its scoped repair is to carry an
`x₁`-freeness clause on the dressing through the supply recursion.

This file states that clause and proves the two facts that make it a genuine invariant of the
committed chain: it holds at the class-three base, and it is preserved by every clearing step.

## The clause

`gXfSpan h` is the subgroup generated by the `x₁`-free letter span `gTowerFar h` together with
`γ₂`.  `GXfFree a` says every slot of the dressing tuple lies in it.  Two remarks on the
shape:

* it is a **subgroup**, so preservation under `a ↦ a · d` is immediate for any `γ₂`-valued
  correction, and in particular for the depth-`k` corrections (`k ≥ 2`) the recursion produces;
* the `γ₂` summand is not slack: the class-three base dressing is `γ₂`-free (it lies in
  `gTowerFar h` outright), but every later correction is only a `γ_k`-element, so the invariant
  that survives the recursion has to allow a `γ₂` factor.  It costs nothing downstream: the
  bracket `commP t (-)` of an admissible correction kills `γ₂` (`gTower_commP_vanish`).
-/

open Multiplicative

open scoped Pointwise

namespace GQ2

open Roe Roe.Labute FoxH

namespace Dyadic

namespace SqCore

open MarkedCore
open scoped commutatorElement

/-! ## §1 The `x₁`-free span, and the freeness clause -/

section Span

variable {h : ℕ}

variable (h) in
/-- **The `x₁`-free half-space**: the far letter span together with `γ₂`.  Modulo the Frattini
subgroup this is the hyperplane spanned by the `2 + 2h` letters other than `x₁`; the point of
taking it as a subgroup of `D_sq h` is that the clause below is then closed under
multiplication for free. -/
noncomputable def gXfSpan : Subgroup (DSq h : Type) :=
  gTowerFar h ⊔ twoCentralSeries (DSq h : Type) 2

/-- The far span sits inside the `x₁`-free half-space. -/
theorem gXf_far_le_span : gTowerFar h ≤ gXfSpan h := le_sup_left

/-- `γ₂` sits inside the `x₁`-free half-space. -/
theorem gXf_gammaTwo_le_span : twoCentralSeries (DSq h : Type) 2 ≤ gXfSpan h := le_sup_right

/-- A `γ_k`-element with `k ≥ 2` is `x₁`-free. -/
theorem gXf_mem_span_of_gamma {k : ℕ} (hk : 2 ≤ k) {t : (DSq h : Type)}
    (ht : t ∈ twoCentralSeries (DSq h : Type) k) : t ∈ gXfSpan h :=
  gXf_gammaTwo_le_span (twoCentralSeries_antitone (DSq h : Type) hk ht)

variable (h) in
/-- **The `x₁`-freeness clause on a dressing tuple**: every slot lies in the `x₁`-free
half-space. -/
def GXfFree (a : Fin (sqRank h) → (DSq h : Type)) : Prop := ∀ i, a i ∈ gXfSpan h

/-- The clause is preserved by any `γ₂`-valued correction, in particular by the depth-`k`
corrections (`k ≥ 2`) the clearing recursion produces. -/
theorem gXf_free_mul {a d : Fin (sqRank h) → (DSq h : Type)} (ha : GXfFree h a)
    (hd : ∀ i, d i ∈ gXfSpan h) : GXfFree h (fun i => a i * d i) :=
  fun i => Subgroup.mul_mem _ (ha i) (hd i)

/-- The clause is preserved by a depth-`k` correction for any `k ≥ 2`. -/
theorem gXf_free_mul_gamma {k : ℕ} (hk : 2 ≤ k) {a d : Fin (sqRank h) → (DSq h : Type)}
    (ha : GXfFree h a) (hd : ∀ i, d i ∈ twoCentralSeries (DSq h : Type) k) :
    GXfFree h (fun i => a i * d i) :=
  gXf_free_mul ha fun i => gXf_mem_span_of_gamma hk (hd i)

end Span

/-! ## §2 The base: the class-three witness dressing is `x₁`-free

Wave 68's `bridgeDress` is `u_j^{ν'(v_j)}·v_j^{ν'(u_j)}·w^{-2ν'(u_j)ν'(v_j)}`: two handle
letters and the pivot, every factor a `ℤ₂`-power of a far-span element.  So it lies in
`gTowerFar h` outright, with no `γ₂` slack, and a fortiori in `gXfSpan h`. -/

section Base

variable {h : ℕ} (nu' : ContinuousMonoidHom (DSq h : Type) (Multiplicative ℤ_[2])) (j : Fin h)

/-- ⭐ **The witness dressing is far**: a product of `ℤ₂`-powers of two handle letters and the
pivot, all three in the far span, which is closed. -/
theorem gXf_bridgeDress_far : bridgeDress nu' j ∈ gTowerFar h := by
  have hcl : IsClosed ((gTowerFar h : Subgroup (DSq h : Type)) : Set (DSq h : Type)) :=
    Subgroup.isClosed_topologicalClosure _
  rw [bridgeDress]
  exact Subgroup.mul_mem _
    (Subgroup.mul_mem _ (gTower_zpow_mem hcl (gBase_handleU_far j) _)
      (gTower_zpow_mem hcl (gBase_handleV_far j) _))
    (gTower_zpow_mem hcl gAbs_pivot_far _)

/-- ⭐⭐ **The base of the invariant**: the committed class-three witness dressing
(`bridgeTuple`, the tuple of `gJoin_chiSupply_three` and `sqClassThree_supply`) is `x₁`-free. -/
theorem gXf_bridgeTuple_free : GXfFree h (bridgeTuple nu' j) := by
  intro i
  rw [bridgeTuple]
  by_cases h0 : (i : ℕ) = 0
  · rw [if_pos h0]
    exact gXf_far_le_span (gXf_bridgeDress_far nu' j)
  · rw [if_neg h0]
    by_cases h1 : (i : ℕ) = 1
    · rw [if_pos h1]
      exact gXf_far_le_span (gXf_bridgeDress_far nu' j)
    · rw [if_neg h1]
      exact Subgroup.one_mem _

end Base

/-! ## §3 The far span is an exact half-space

Wave 79's repair needs one fact the note argued on paper: the `2 + 2h` non-`x₁` frame slots
**span** the far half-space, not merely sit inside it.  The tool is the characteristic
character `ε` of the mod-two cup form (`sqEps`, `DsqDemushkin.lean` §2), whose defining property
is exactly the one wanted: `ε` reads the `x₁`-coordinate of a letter and nothing else
(`toAdd_sqEps_gen`).  So `ker ε` is a half-space containing the far span, missing `x₁`, and
containing `γ₂`; and a closed subgroup of `D_sq h` that contains `γ₂` and the `2 + 2h` non-`x₁`
slots of a mod-two independent frame, and that lies inside `ker ε`, must contain the whole far
span - otherwise its union with the `x₁`-slot coset would be a proper closed subgroup carrying
every slot, which `SqModTwoIndep` forbids. -/

section Half

variable {h : ℕ}

variable (h) in
/-- **The `x₁`-coordinate half-space**: the kernel of the characteristic character of the
mod-two cup form. -/
noncomputable def gXfHalf : Subgroup (DSq h : Type) := MonoidHom.ker (sqEps h).toMonoidHom

theorem gXf_mem_half_iff {g : (DSq h : Type)} : g ∈ gXfHalf h ↔ sqEps h g = 1 := Iff.rfl

/-- The half-space is closed: `ε` is continuous into a Hausdorff group. -/
theorem gXf_half_isClosed :
    IsClosed ((gXfHalf h : Subgroup (DSq h : Type)) : Set (DSq h : Type)) :=
  isClosed_singleton.preimage (sqEps h).continuous_toFun

/-- Every element of `Multiplicative (ZMod 2)` squares to `1`. -/
theorem gXf_sq_one (y : Multiplicative (ZMod 2)) : y ^ 2 = 1 := by
  refine Multiplicative.toAdd.injective ?_
  rw [toAdd_pow, toAdd_one]
  revert y
  decide

/-- `ε` kills every letter but `x₁`. -/
theorem gXf_gen_mem_half {i : Fin (sqRank h)} (hne : i ≠ 2) : sqGen h i ∈ gXfHalf h := by
  have hval : sqEps h (sqGen h i) = 1 := by
    refine Multiplicative.toAdd.injective ?_
    rw [toAdd_sqEps_gen, if_neg hne, toAdd_one]
  exact hval

/-- Slot indices with different values are different. -/
theorem gXf_ne_of_val_ne {i i' : Fin (sqRank h)} (hne : (i : ℕ) ≠ (i' : ℕ)) : i ≠ i' :=
  fun hc => hne (congrArg Fin.val hc)

/-- The `σ`-slot index is not the `x₁`-slot index. -/
theorem gXf_zero_ne_two : (0 : Fin (sqRank h)) ≠ 2 :=
  gXf_ne_of_val_ne (by rw [sqVal_zero, sqVal_two]; omega)

/-- The `x₀`-slot index is not the `x₁`-slot index. -/
theorem gXf_one_ne_two : (1 : Fin (sqRank h)) ≠ 2 :=
  gXf_ne_of_val_ne (by rw [sqVal_one, sqVal_two]; omega)

/-- The `σ`-slot index is not the `x₀`-slot index. -/
theorem gXf_zero_ne_one : (0 : Fin (sqRank h)) ≠ 1 :=
  gXf_ne_of_val_ne (by rw [sqVal_zero, sqVal_one]; omega)

/-- The `x₀`-slot index is not the `σ`-slot index. -/
theorem gXf_one_ne_zero : (1 : Fin (sqRank h)) ≠ 0 := gXf_zero_ne_one.symm

/-- The `x₁`-slot index is not the `σ`-slot index. -/
theorem gXf_two_ne_zero : (2 : Fin (sqRank h)) ≠ 0 := gXf_zero_ne_two.symm

/-- The `x₁`-slot index is not the `x₀`-slot index. -/
theorem gXf_two_ne_one : (2 : Fin (sqRank h)) ≠ 1 := gXf_one_ne_two.symm

/-- `ε` does **not** kill `x₁`: this is the one place the half-space is a *proper* subgroup. -/
theorem gXf_xOne_notMem_half : dsqX1 h ∉ gXfHalf h := by
  intro hc
  have hval := congrArg Multiplicative.toAdd (gXf_mem_half_iff.1 hc)
  rw [show dsqX1 h = sqGen h 2 from rfl, toAdd_sqEps_gen, if_pos rfl, toAdd_one] at hval
  exact one_ne_zero hval

/-- ⭐ **The far span lies in the half-space**: the `2 + 2h` far letters do, and the half-space
is closed. -/
theorem gXf_far_le_half : gTowerFar h ≤ gXfHalf h := by
  refine Subgroup.topologicalClosure_minimal _ ((Subgroup.closure_le _).2 ?_) gXf_half_isClosed
  intro x hx
  simp only [Set.mem_union, Set.mem_insert_iff, Set.mem_singleton_iff, Set.mem_range] at hx
  rcases hx with ((rfl | rfl) | ⟨j, rfl⟩) | ⟨j, rfl⟩
  · exact gXf_gen_mem_half (h := h) (i := 0) gXf_zero_ne_two
  · exact gXf_gen_mem_half (h := h) (i := 1) gXf_one_ne_two
  · exact gXf_gen_mem_half (SqHandleIdx.u_ne_of_val_lt j (by rw [sqVal_two]; omega))
  · exact gXf_gen_mem_half (SqHandleIdx.v_ne_of_val_lt j (by rw [sqVal_two]; omega))

/-- ⭐ **`γ₂` lies in the half-space**: the target of `ε` is commutative of exponent two, so
every square and every commutator dies, and the half-space is closed. -/
theorem gXf_gammaTwo_le_half : twoCentralSeries (DSq h : Type) 2 ≤ gXfHalf h := by
  rw [cfour_lambda_two, twoCentralSucc]
  refine Subgroup.topologicalClosure_minimal _ (sup_le ?_ ?_) gXf_half_isClosed
  · refine (Subgroup.closure_le _).2 ?_
    rintro _ ⟨v, -, rfl⟩
    show sqEps h (v ^ 2) = 1
    rw [map_pow]
    exact gXf_sq_one _
  · rw [Subgroup.commutator_le]
    intro g _ k _
    show sqEps h ⁅g, k⁆ = 1
    rw [map_commutatorElement]
    exact commutatorElement_eq_one_iff_commute.2 (Commute.all _ _)

/-- The `x₁`-free span sits inside the half-space: both of its halves do. -/
theorem gXf_span_le_half : gXfSpan h ≤ gXfHalf h :=
  sup_le gXf_far_le_half gXf_gammaTwo_le_half

/-- An `x₁`-free dressing slot is killed by `ε`. -/
theorem gXf_free_mem_half {a : Fin (sqRank h) → (DSq h : Type)} (ha : GXfFree h a)
    (i : Fin (sqRank h)) : a i ∈ gXfHalf h := gXf_span_le_half (ha i)

/-- **The generation criterion**: a closed subgroup carrying every slot of a mod-two
independent frame is everything.  This is `SqModTwoIndep` read through the pro-`2` Frattini
criterion, at the subgroup rather than the endomorphism. -/
theorem gXf_eq_top_of_indep {m : Fin (sqRank h) → (DSq h : Type)} (hm : SqModTwoIndep m)
    {T : Subgroup (DSq h : Type)}
    (hc : IsClosed ((T : Subgroup (DSq h : Type)) : Set (DSq h : Type)))
    (hmem : ∀ i, m i ∈ T) : T = ⊤ := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  refine eq_top_of_forall_not_le_index_p (isProP_DSq h) hc fun M hM hle => ?_
  obtain ⟨i, hi⟩ := hm M hM
  exact hi (hle (hmem i))

/-- A subgroup containing `γ₂` is normal: the quotient by `γ₂` is abelian. -/
theorem gXf_normal_of_gammaTwo_le {S : Subgroup (DSq h : Type)}
    (hS : twoCentralSeries (DSq h : Type) 2 ≤ S) : S.Normal := by
  constructor
  intro n hn g
  have hrw : g * n * g⁻¹ = n * ⁅n⁻¹, g⁆ := by
    rw [commutatorElement_def]
    group
  rw [hrw]
  refine S.mul_mem hn (hS ?_)
  exact commutator_mem_twoCentralSeries_succ (DSq h : Type) (k := 1) (Subgroup.mem_top _) g

/-- ⭐⭐⭐ **The far span is spanned by the non-`x₁` slots**: let `K` be a closed subgroup
carrying `γ₂`, carrying the `2 + 2h` non-`x₁` slots of a mod-two independent frame, killed by
`ε` on those slots, and with the `x₁`-slot **not** killed by `ε`.  Then `K` contains the whole
far span.

This is the paper dimension count of `docs/dyadic/w79-extract-note.md` ("what repairs it"),
done with cosets instead of dimensions: `S = K ⊓ ker ε` together with the `x₁`-slot coset
`m₂·S` is a closed subgroup carrying every slot, hence everything; a far element therefore lies
in `S` or in `m₂·S`, and `ε` excludes the second. -/
theorem gXf_far_le_of_slots {m : Fin (sqRank h) → (DSq h : Type)} (hm : SqModTwoIndep m)
    {K : Subgroup (DSq h : Type)}
    (hKc : IsClosed ((K : Subgroup (DSq h : Type)) : Set (DSq h : Type)))
    (hgam : twoCentralSeries (DSq h : Type) 2 ≤ K)
    (hne : ∀ i, i ≠ (2 : Fin (sqRank h)) → m i ∈ K)
    (hhalf : ∀ i, i ≠ (2 : Fin (sqRank h)) → m i ∈ gXfHalf h)
    (h2 : m 2 ∉ gXfHalf h) :
    gTowerFar h ≤ K := by
  classical
  set S : Subgroup (DSq h : Type) := K ⊓ gXfHalf h with hSdef
  have hgamS : twoCentralSeries (DSq h : Type) 2 ≤ S := le_inf hgam gXf_gammaTwo_le_half
  haveI hSn : S.Normal := gXf_normal_of_gammaTwo_le hgamS
  have hSc : IsClosed ((S : Subgroup (DSq h : Type)) : Set (DSq h : Type)) := by
    rw [Subgroup.coe_inf]
    exact hKc.inter gXf_half_isClosed
  have hsq : m 2 ^ 2 ∈ S := hgamS (by
    have := sq_mem_twoCentralSeries_succ (G := (DSq h : Type)) (k := 1) (Subgroup.mem_top (m 2))
    exact this)
  -- the two-coset set
  set C : Set (DSq h : Type) := (S : Set (DSq h : Type)) ∪ (fun s => m 2 * s) '' S with hCdef
  set T : Subgroup (DSq h : Type) := Subgroup.closure {m 2} ⊔ S with hTdef
  have hsqZ : m 2 ^ (2 : ℤ) ∈ S := by
    rw [zpow_two, ← pow_two]
    exact hsq
  have hmul : ((T : Subgroup (DSq h : Type)) : Set (DSq h : Type))
      = ((Subgroup.closure {m 2} : Subgroup (DSq h : Type)) : Set (DSq h : Type)) *
        ((S : Subgroup (DSq h : Type)) : Set (DSq h : Type)) := by
    rw [hTdef, Subgroup.mul_normal]
  have hTC : (T : Set (DSq h : Type)) = C := by
    apply Set.Subset.antisymm
    · rw [hmul]
      rintro _ ⟨z, hz, s, hs, rfl⟩
      obtain ⟨n, rfl⟩ := Subgroup.mem_closure_singleton.1 hz
      rcases Int.even_or_odd n with ⟨t, rfl⟩ | ⟨t, rfl⟩
      · refine Or.inl (S.mul_mem ?_ hs)
        have hrw : m 2 ^ (t + t) = (m 2 ^ (2 : ℤ)) ^ t := by
          rw [← zpow_mul]
          congr 1
          ring
        rw [hrw]
        exact Subgroup.zpow_mem _ hsqZ t
      · refine Or.inr ⟨m 2 ^ (2 * t) * s, S.mul_mem ?_ hs, ?_⟩
        · have hrw : m 2 ^ (2 * t) = (m 2 ^ (2 : ℤ)) ^ t := by rw [← zpow_mul]
          rw [hrw]
          exact Subgroup.zpow_mem _ hsqZ t
        · show m 2 * (m 2 ^ (2 * t) * s) = m 2 ^ (2 * t + 1) * s
          calc m 2 * (m 2 ^ (2 * t) * s) = m 2 * m 2 ^ (2 * t) * s := by rw [mul_assoc]
            _ = m 2 ^ (2 * t) * m 2 * s := by
                rw [((Commute.refl (m 2)).zpow_right (2 * t)).eq]
            _ = m 2 ^ (2 * t + 1) * s := by rw [zpow_add_one]
    · rintro x (hx | ⟨s, hs, rfl⟩)
      · exact (le_sup_right : S ≤ T) hx
      · exact T.mul_mem ((le_sup_left : Subgroup.closure {m 2} ≤ T)
          (Subgroup.subset_closure rfl)) ((le_sup_right : S ≤ T) hs)
  have hTc : IsClosed ((T : Subgroup (DSq h : Type)) : Set (DSq h : Type)) := by
    rw [hTC, hCdef]
    exact hSc.union ((Homeomorph.mulLeft (m 2)).isClosedMap _ hSc)
  have hTtop : T = ⊤ := by
    refine gXf_eq_top_of_indep hm hTc fun i => ?_
    by_cases hi : i = 2
    · subst hi
      exact (le_sup_left : Subgroup.closure {m 2} ≤ T) (Subgroup.subset_closure rfl)
    · exact (le_sup_right : S ≤ T) ⟨hne i hi, hhalf i hi⟩
  intro q hq
  have hqC : q ∈ C := by rw [← hTC, hTtop]; trivial
  rcases hqC with hqS | ⟨s, hs, rfl⟩
  · exact hqS.1
  · exact absurd (by
      have hqh : m 2 * s ∈ gXfHalf h := gXf_far_le_half hq
      have : m 2 = (m 2 * s) * s⁻¹ := by group
      rw [this]
      exact (gXfHalf h).mul_mem hqh ((gXfHalf h).inv_mem hs.2)) h2

end Half

/-! ## §4 The bracket span, restricted to the far slots

`gTower_commHom_span` reduces a bracket `[v, g]` to the span of the `3 + 2h` letter brackets.
For the extraction that is one letter too many: the `x₁`-bracket is exactly what the moves do
not supply unbundled.  The same closure argument run against `gTowerFar`'s own generators gives
the reduction to the `2 + 2h` far letters. -/

section FarSpan

variable {h : ℕ}

variable (h) in
/-- The far letter brackets of a fixed correction, as a generating set in `Q_{k+2}`. -/
def gXfFarKnobs {k : ℕ} (v : (DSq h : Type)) : Set (levelQuot (DSq h : Type) (k + 2)) :=
  {z | ∃ i : Fin (sqRank h), i ≠ 2 ∧ z = levelMk (DSq h : Type) (k + 2) (commP v (sqGen h i))}

/-- ⭐⭐ **The far-slot letter reduction**: for `v ∈ γ_k` and `q` in the `x₁`-free letter span,
the bracket class `[v, q]` lies in the span of the **non-`x₁`** letter brackets. -/
theorem gXf_commHom_far_span {k : ℕ} {v : (DSq h : Type)}
    (hv : v ∈ twoCentralSeries (DSq h : Type) k) {q : (DSq h : Type)} (hq : q ∈ gTowerFar h) :
    levelMk (DSq h : Type) (k + 2) (commP v q) ∈ Subgroup.closure (gXfFarKnobs h (k := k) v) := by
  haveI : DiscreteTopology (levelQuot (DSq h : Type) (k + 2)) := gTower_discrete (k + 2)
  set S' := Subgroup.closure (gXfFarKnobs h (k := k) v) with hS'
  have hpre : IsClosed ((Subgroup.comap (cfiveCommHom hv) S' :
      Subgroup (DSq h : Type)) : Set (DSq h : Type)) := by
    rw [Subgroup.coe_comap]
    refine IsClosed.preimage ?_ (isClosed_discrete _)
    show Continuous fun g => levelMk (DSq h : Type) (k + 2) (commP v g)
    simp only [commP]
    exact (continuous_levelMk (DSq h : Type) (k + 2)).comp (by fun_prop)
  refine Subgroup.topologicalClosure_minimal _ ((Subgroup.closure_le _).2 ?_) hpre hq
  intro x hx
  simp only [Set.mem_union, Set.mem_insert_iff, Set.mem_singleton_iff, Set.mem_range] at hx
  rcases hx with ((rfl | rfl) | ⟨j, rfl⟩) | ⟨j, rfl⟩
  · exact Subgroup.subset_closure ⟨0, gXf_zero_ne_two, rfl⟩
  · exact Subgroup.subset_closure ⟨1, gXf_one_ne_two, rfl⟩
  · exact Subgroup.subset_closure
      ⟨sqHandleIdxU j, SqHandleIdx.u_ne_of_val_lt j (by rw [sqVal_two]; omega), rfl⟩
  · exact Subgroup.subset_closure
      ⟨sqHandleIdxV j, SqHandleIdx.v_ne_of_val_lt j (by rw [sqVal_two]; omega), rfl⟩

end FarSpan

/-! ## §5 The move is a homomorphism of the correction tuple

`gExtMove` reads each slot of the correction through one of three shapes: a bracket in the left
slot (the `σ`-slot and the `u`-slots), a bracket in the right slot (the `x₀`-slot and the
`v`-slots), and the square-plus-bracket bundle (the `x₁`-slot).  All three are multiplicative in
the correction once the correction sits in `γ_k` with `k ≥ 2`: the correction terms of
`cfour_commP_mul_left`/`_right` are brackets against a top-layer element, and the correction
term of `cfour_sq_mul` is a bracket of two `γ_k`-slots.  Every value in sight is central, so the
blocks recombine with no further bookkeeping. -/

section MoveHom

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] {k : ℕ}

/-- The bracket is multiplicative in a **correction** left slot. -/
theorem gXf_commP_left {c c' : levelQuot G (k + 2)} (hc : c ∈ lambdaImage G k (k + 2))
    (q : levelQuot G (k + 2)) : commP (c * c') q = commP c q * commP c' q := by
  rw [cfour_commP_mul_left,
    cfive_commP_zLayer_left (cfive_commP_mem_zLayer_left hc q) c', mul_one]

/-- The bracket is multiplicative in a **correction** right slot. -/
theorem gXf_commP_right (p : levelQuot G (k + 2)) {c c' : levelQuot G (k + 2)}
    (hc : c ∈ lambdaImage G k (k + 2)) :
    commP p (c * c') = commP p c * commP p c' := by
  rw [cfour_commP_mul_right,
    cfive_commP_zLayer_left (cfive_commP_mem_zLayer_right p hc) c', mul_one]
  exact gTower_zLayer_comm (cfive_commP_mem_zLayer_right p hc) (commP p c')

/-- The square is multiplicative on `γ_k`-slots, `k ≥ 2`: the defect of `cfour_sq_mul` is a
bracket of two `γ_k`-slots, which dies. -/
theorem gXf_sq_mul (hk : 2 ≤ k) {c c' : levelQuot G (k + 2)} (hc : c ∈ lambdaImage G k (k + 2))
    (hc' : c' ∈ lambdaImage G k (k + 2)) : (c * c') ^ 2 = c ^ 2 * c' ^ 2 := by
  rw [cfour_sq_mul, gTower_commP_vanish hc' (gTower_lambdaImage_le hk hc), cfour_one_comm,
    mul_one, mul_one]

/-- The two-block shuffle, with the second factor of the first block central. -/
theorem gXf_shuffle {Q : Type*} [Group Q] {a₁ a₂ b₁ b₂ : Q} (ha : a₂ ∈ Subgroup.center Q) :
    a₁ * a₂ * (b₁ * b₂) = a₁ * b₁ * (a₂ * b₂) := by
  have hcomm : a₂ * b₁ = b₁ * a₂ := (Subgroup.mem_center_iff.1 ha b₁).symm
  calc a₁ * a₂ * (b₁ * b₂) = a₁ * (a₂ * b₁) * b₂ := by group
    _ = a₁ * (b₁ * a₂) * b₂ := by rw [hcomm]
    _ = a₁ * b₁ * (a₂ * b₂) := by group

/-- The four-block shuffle: three applications of `gXf_shuffle`. -/
theorem gXf_shuffle4 {Q : Type*} [Group Q] {a₁ a₂ b₁ b₂ c₁ c₂ d₁ d₂ : Q}
    (ha : a₂ ∈ Subgroup.center Q) (hb : b₂ ∈ Subgroup.center Q)
    (hc : c₂ ∈ Subgroup.center Q) :
    a₁ * a₂ * (b₁ * b₂) * (c₁ * c₂) * (d₁ * d₂)
      = a₁ * b₁ * c₁ * d₁ * (a₂ * b₂ * c₂ * d₂) := by
  rw [gXf_shuffle ha, gXf_shuffle (Subgroup.mul_mem _ ha hb),
    gXf_shuffle (Subgroup.mul_mem _ (Subgroup.mul_mem _ ha hb) hc)]

/-- Every knob value of a correction is central in the layer quotient. -/
theorem gXf_zLayer_center {z : levelQuot G (k + 2)} (hz : z ∈ zLayer G (k + 1)) :
    z ∈ Subgroup.center (levelQuot G (k + 2)) := zLayer_le_center G (k + 1) hz

/-- ⭐⭐⭐ **The move is a homomorphism in the correction tuple.**  Slotwise multiplicativity
plus the four-block shuffle; no hypothesis on the frame `m` at all. -/
theorem gXf_move_mul (hk : 2 ≤ k) {n : ℕ} (m : Fin (sqRank n) → levelQuot G (k + 2))
    {c c' : Fin (sqRank n) → levelQuot G (k + 2)}
    (hc : ∀ i, c i ∈ lambdaImage G k (k + 2)) (hc' : ∀ i, c' i ∈ lambdaImage G k (k + 2)) :
    gExtMove k m (fun i => c i * c' i) = gExtMove k m c * gExtMove k m c' := by
  have hA : commP (c 0 * c' 0) (m 1) = commP (c 0) (m 1) * commP (c' 0) (m 1) :=
    gXf_commP_left (hc 0) (m 1)
  have hB : commP (m 0) (c 1 * c' 1) = commP (m 0) (c 1) * commP (m 0) (c' 1) :=
    gXf_commP_right (m 0) (hc 1)
  have hC : (c 2 * c' 2) ^ 2 * commP (c 2 * c' 2) (m 2)
      = c 2 ^ 2 * commP (c 2) (m 2) * (c' 2 ^ 2 * commP (c' 2) (m 2)) := by
    rw [gXf_sq_mul hk (hc 2) (hc' 2), gXf_commP_left (hc 2) (m 2)]
    exact gXf_shuffle (gXf_zLayer_center (gTower_sq_mem_zLayer (hc' 2)))
  have hDcen : ∀ i : Fin n, commP (c (sqHandleIdxU i)) (m (sqHandleIdxV i)) *
      commP (m (sqHandleIdxU i)) (c (sqHandleIdxV i))
        ∈ Subgroup.center (levelQuot G (k + 2)) := fun i =>
    gXf_zLayer_center (Subgroup.mul_mem _ (cfive_commP_mem_zLayer_left (hc _) _)
      (cfive_commP_mem_zLayer_right _ (hc _)))
  have hD : (List.ofFn fun i : Fin n =>
        commP (c (sqHandleIdxU i) * c' (sqHandleIdxU i)) (m (sqHandleIdxV i)) *
          commP (m (sqHandleIdxU i)) (c (sqHandleIdxV i) * c' (sqHandleIdxV i))).prod
      = (List.ofFn fun i : Fin n => commP (c (sqHandleIdxU i)) (m (sqHandleIdxV i)) *
            commP (m (sqHandleIdxU i)) (c (sqHandleIdxV i))).prod *
          (List.ofFn fun i : Fin n => commP (c' (sqHandleIdxU i)) (m (sqHandleIdxV i)) *
            commP (m (sqHandleIdxU i)) (c' (sqHandleIdxV i))).prod := by
    have hentry : (fun i : Fin n =>
        commP (c (sqHandleIdxU i) * c' (sqHandleIdxU i)) (m (sqHandleIdxV i)) *
          commP (m (sqHandleIdxU i)) (c (sqHandleIdxV i) * c' (sqHandleIdxV i)))
        = fun i : Fin n => (commP (c (sqHandleIdxU i)) (m (sqHandleIdxV i)) *
            commP (m (sqHandleIdxU i)) (c (sqHandleIdxV i))) *
          (commP (c' (sqHandleIdxU i)) (m (sqHandleIdxV i)) *
            commP (m (sqHandleIdxU i)) (c' (sqHandleIdxV i))) := by
      funext i
      rw [gXf_commP_left (hc _) _, gXf_commP_right _ (hc _)]
      exact gXf_shuffle (gXf_zLayer_center (cfive_commP_mem_zLayer_left (hc' _) _))
    rw [gExt_ofFn_mul _ _ hDcen, hentry]
  simp only [gExtMove, hA, hB, hC, hD]
  exact gXf_shuffle4 (gXf_zLayer_center (cfive_commP_mem_zLayer_left (hc' 0) _))
    (gXf_zLayer_center (cfive_commP_mem_zLayer_right _ (hc' 1)))
    (gXf_zLayer_center (Subgroup.mul_mem _ (gTower_sq_mem_zLayer (hc' 2))
      (cfive_commP_mem_zLayer_left (hc' 2) _)))

/-- An ordered product of trivial factors is trivial. -/
theorem gXf_ofFn_one {Q : Type*} [Group Q] : ∀ n : ℕ,
    (List.ofFn fun _ : Fin n => (1 : Q)).prod = 1
  | 0 => by simp
  | (n + 1) => by rw [List.ofFn_succ, List.prod_cons, gXf_ofFn_one n, one_mul]

/-- The trivial correction moves nothing. -/
theorem gXf_move_one {n : ℕ} (m : Fin (sqRank n) → levelQuot G (k + 2)) :
    gExtMove k m (fun _ => 1) = 1 := by
  simp only [gExtMove, cfour_one_comm, cfour_comm_one, one_pow, one_mul, mul_one]
  exact gXf_ofFn_one n

end MoveHom

/-! ## §6 The single-slot moves -/

section Slots

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] {k : ℕ} {n : ℕ}

/-- The move of a correction with no handle content: the three core knobs alone. -/
theorem gXf_move_core (m c : Fin (sqRank n) → levelQuot G (k + 2))
    (hU : ∀ i, c (sqHandleIdxU i) = 1) (hV : ∀ i, c (sqHandleIdxV i) = 1) :
    gExtMove k m c = commP (c 0) (m 1) * commP (m 0) (c 1) * (c 2 ^ 2 * commP (c 2) (m 2)) := by
  have hfun : (fun i : Fin n => commP (c (sqHandleIdxU i)) (m (sqHandleIdxV i)) *
      commP (m (sqHandleIdxU i)) (c (sqHandleIdxV i)))
      = fun _ : Fin n => (1 : levelQuot G (k + 2)) := by
    funext i
    rw [hU i, hV i, cfour_one_comm, cfour_comm_one, one_mul]
  rw [gExtMove, hfun, gXf_ofFn_one, mul_one]

/-- The move of a correction with no core content: the handle knobs alone. -/
theorem gXf_move_handles (m c : Fin (sqRank n) → levelQuot G (k + 2))
    (h0 : c 0 = 1) (h1 : c 1 = 1) (h2 : c 2 = 1) :
    gExtMove k m c = (List.ofFn fun i : Fin n => commP (c (sqHandleIdxU i)) (m (sqHandleIdxV i)) *
      commP (m (sqHandleIdxU i)) (c (sqHandleIdxV i))).prod := by
  simp only [gExtMove, h0, h1, h2, cfour_one_comm, cfour_comm_one, one_pow, one_mul, mul_one]

/-- The `σ`-slot move: the bracket against the `x₀`-slot frame value. -/
theorem gXf_move_zero (m c : Fin (sqRank n) → levelQuot G (k + 2)) (h1 : c 1 = 1) (h2 : c 2 = 1)
    (hU : ∀ i, c (sqHandleIdxU i) = 1) (hV : ∀ i, c (sqHandleIdxV i) = 1) :
    gExtMove k m c = commP (c 0) (m 1) := by
  rw [gXf_move_core m c hU hV]
  simp only [h1, h2, cfour_one_comm, cfour_comm_one, one_pow, mul_one]

/-- The `x₀`-slot move: the bracket against the `σ`-slot frame value, on the other side. -/
theorem gXf_move_one_slot (m c : Fin (sqRank n) → levelQuot G (k + 2)) (h0 : c 0 = 1)
    (h2 : c 2 = 1) (hU : ∀ i, c (sqHandleIdxU i) = 1) (hV : ∀ i, c (sqHandleIdxV i) = 1) :
    gExtMove k m c = commP (m 0) (c 1) := by
  rw [gXf_move_core m c hU hV]
  simp only [h0, h2, cfour_one_comm, one_pow, one_mul, mul_one]

/-- The `x₁`-slot move: the square-plus-bracket bundle. -/
theorem gXf_move_two (m c : Fin (sqRank n) → levelQuot G (k + 2)) (h0 : c 0 = 1) (h1 : c 1 = 1)
    (hU : ∀ i, c (sqHandleIdxU i) = 1) (hV : ∀ i, c (sqHandleIdxV i) = 1) :
    gExtMove k m c = c 2 ^ 2 * commP (c 2) (m 2) := by
  rw [gXf_move_core m c hU hV]
  simp only [h0, h1, cfour_one_comm, cfour_comm_one, one_mul, mul_one]

/-- The `u_{j}`-slot move: the bracket against the partner `v_j`-slot frame value. -/
theorem gXf_move_handleU (m c : Fin (sqRank n) → levelQuot G (k + 2)) (j : Fin n) (h0 : c 0 = 1)
    (h1 : c 1 = 1) (h2 : c 2 = 1) (hU : ∀ i, i ≠ j → c (sqHandleIdxU i) = 1)
    (hV : ∀ i, c (sqHandleIdxV i) = 1) :
    gExtMove k m c = commP (c (sqHandleIdxU j)) (m (sqHandleIdxV j)) := by
  rw [gXf_move_handles m c h0 h1 h2, gExt_ofFn_single _ j]
  · simp only [hV j, cfour_comm_one, mul_one]
  · intro i hij
    simp only [hU i hij, hV i, cfour_one_comm, cfour_comm_one, one_mul]

/-- The `v_{j}`-slot move: the bracket against the partner `u_j`-slot frame value. -/
theorem gXf_move_handleV (m c : Fin (sqRank n) → levelQuot G (k + 2)) (j : Fin n) (h0 : c 0 = 1)
    (h1 : c 1 = 1) (h2 : c 2 = 1) (hU : ∀ i, c (sqHandleIdxU i) = 1)
    (hV : ∀ i, i ≠ j → c (sqHandleIdxV i) = 1) :
    gExtMove k m c = commP (m (sqHandleIdxU j)) (c (sqHandleIdxV j)) := by
  rw [gXf_move_handles m c h0 h1 h2, gExt_ofFn_single _ j]
  · simp only [hU j, cfour_one_comm, one_mul]
  · intro i hij
    simp only [hU i, hV i hij, cfour_one_comm, cfour_comm_one, one_mul]

end Slots

/-! ## §7 The move subgroup, and the extraction on `x₁`-free dressings -/

section Extraction

variable {h : ℕ} {nu' : ContinuousMonoidHom (DSq h : Type) (Multiplicative ℤ_[2])} {k : ℕ}

variable (h) in
/-- The correction tuple carrying `t` on slot `i₀` and nothing anywhere else. -/
noncomputable def gXfSlot (i₀ : Fin (sqRank h)) (t : (DSq h : Type)) :
    Fin (sqRank h) → (DSq h : Type) := fun i => if i = i₀ then t else 1

@[simp] theorem gXfSlot_self (i₀ : Fin (sqRank h)) (t : (DSq h : Type)) :
    gXfSlot h i₀ t i₀ = t := if_pos rfl

theorem gXfSlot_ne {i i₀ : Fin (sqRank h)} (hne : i ≠ i₀) (t : (DSq h : Type)) :
    gXfSlot h i₀ t i = 1 := if_neg hne

/-- The trivial correction is admissible at every depth. -/
theorem gXf_adm_one : GTowerAdm h nu' k 1 :=
  ⟨Subgroup.one_mem _, map_one _, map_one _⟩

/-- A single-slot correction tuple is admissible when its one entry is. -/
theorem gXf_slot_adm {t : (DSq h : Type)} (ht : GTowerAdm h nu' k t) (i₀ i : Fin (sqRank h)) :
    GTowerAdm h nu' k (gXfSlot h i₀ t i) := by
  by_cases hi : i = i₀
  · rw [hi, gXfSlot_self]
    exact ht
  · rw [gXfSlot_ne hi]
    exact gXf_adm_one

variable (nu') in
/-- ⭐⭐ **The move subgroup of a frame**: the layer classes by which an admissible depth-`k`
correction tuple multiplies the relator.  It is a subgroup precisely because `gExtMove` is a
homomorphism in the correction tuple (`gXf_move_mul`). -/
noncomputable def gXfMove (hk : 2 ≤ k)
    (m : Fin (sqRank h) → levelQuot (DSq h : Type) (k + 2)) :
    Subgroup (levelQuot (DSq h : Type) (k + 2)) where
  carrier := {z | ∃ d : Fin (sqRank h) → (DSq h : Type), (∀ i, GTowerAdm h nu' k (d i)) ∧
    z = gExtMove k m (fun i => levelMk (DSq h : Type) (k + 2) (d i))}
  one_mem' := by
    refine ⟨fun _ => 1, fun _ => gXf_adm_one, ?_⟩
    simp only [map_one]
    exact (gXf_move_one m).symm
  mul_mem' := by
    rintro _ _ ⟨d, hd, rfl⟩ ⟨d', hd', rfl⟩
    refine ⟨fun i => d i * d' i, fun i => ⟨Subgroup.mul_mem _ (hd i).1 (hd' i).1, ?_, ?_⟩, ?_⟩
    · rw [map_mul, (hd i).2.1, (hd' i).2.1, one_mul]
    · rw [map_mul, (hd i).2.2, (hd' i).2.2, one_mul]
    · simp only [map_mul]
      exact (gXf_move_mul hk m (fun i => ⟨d i, (hd i).1, rfl⟩)
        (fun i => ⟨d' i, (hd' i).1, rfl⟩)).symm
  inv_mem' := by
    rintro _ ⟨d, hd, rfl⟩
    refine ⟨fun i => (d i)⁻¹, fun i => ⟨Subgroup.inv_mem _ (hd i).1, ?_, ?_⟩, ?_⟩
    · rw [map_inv, (hd i).2.1, inv_one]
    · rw [map_inv, (hd i).2.2, inv_one]
    · have hfun : (fun i => levelMk (DSq h : Type) (k + 2) (d i) *
          levelMk (DSq h : Type) (k + 2) ((d i)⁻¹))
          = fun _ : Fin (sqRank h) => (1 : levelQuot (DSq h : Type) (k + 2)) := by
        funext i
        rw [map_inv, mul_inv_cancel]
      have hmul := gXf_move_mul hk m (fun i => ⟨d i, (hd i).1, rfl⟩)
        (fun i => ⟨(d i)⁻¹, Subgroup.inv_mem _ (hd i).1, rfl⟩)
      rw [hfun, gXf_move_one] at hmul
      exact inv_eq_of_mul_eq_one_right hmul.symm

theorem gXf_mem_move {hk : 2 ≤ k} {m : Fin (sqRank h) → levelQuot (DSq h : Type) (k + 2)}
    {z : levelQuot (DSq h : Type) (k + 2)} :
    z ∈ gXfMove nu' hk m ↔ ∃ d : Fin (sqRank h) → (DSq h : Type),
      (∀ i, GTowerAdm h nu' k (d i)) ∧
        z = gExtMove k m (fun i => levelMk (DSq h : Type) (k + 2) (d i)) := Iff.rfl

/-- The bracket swaps its slots up to inversion, exactly. -/
theorem gXf_commP_swap (p q : levelQuot (DSq h : Type) (k + 2)) :
    commP p q = (commP q p)⁻¹ := by
  simp only [commP]
  group

/-- ⭐⭐ **The bracket against a non-`x₁` frame slot is a move.**  Slot `0` supplies the bracket
against `m 1`, slot `1` the bracket against `m 0` (on the other side, so its inverse), and the
handle slots pair up the same way: slot `u_j` supplies the bracket against `m (v_j)` and slot
`v_j` the bracket against `m (u_j)`.  The `x₁`-slot is the one index left out - there the move
is the bundle, not the bare bracket. -/
theorem gXf_frame_mem_move {hk : 2 ≤ k}
    {m : Fin (sqRank h) → levelQuot (DSq h : Type) (k + 2)} {t : (DSq h : Type)}
    (ht : GTowerAdm h nu' k t) {i : Fin (sqRank h)} (hi : i ≠ 2) :
    commP (levelMk (DSq h : Type) (k + 2) t) (m i) ∈ gXfMove nu' hk m := by
  have hcls : ∀ i₀ i : Fin (sqRank h), i ≠ i₀ →
      levelMk (DSq h : Type) (k + 2) (gXfSlot h i₀ t i) = 1 := by
    intro i₀ i hne
    rw [gXfSlot_ne hne, map_one]
  have hself : ∀ i₀ : Fin (sqRank h),
      levelMk (DSq h : Type) (k + 2) (gXfSlot h i₀ t i₀)
        = levelMk (DSq h : Type) (k + 2) t := by
    intro i₀
    rw [gXfSlot_self]
  rcases sqIdx_cases i with rfl | rfl | rfl | ⟨j, rfl⟩ | ⟨j, rfl⟩
  · -- the `σ`-slot value: dress the `x₀`-slot
    rw [gXf_commP_swap]
    refine Subgroup.inv_mem _ ⟨gXfSlot h 1 t, gXf_slot_adm ht 1, ?_⟩
    rw [gXf_move_one_slot _ _ (hcls 1 0 gXf_zero_ne_one) (hcls 1 2 gXf_two_ne_one)
      (fun i => hcls 1 _ (SqHandleIdx.u_ne_of_val_lt i (by rw [sqVal_one]; omega)))
      (fun i => hcls 1 _ (SqHandleIdx.v_ne_of_val_lt i (by rw [sqVal_one]; omega))), hself 1]
  · -- the `x₀`-slot value: dress the `σ`-slot
    refine ⟨gXfSlot h 0 t, gXf_slot_adm ht 0, ?_⟩
    rw [gXf_move_zero _ _ (hcls 0 1 gXf_one_ne_zero) (hcls 0 2 gXf_two_ne_zero)
      (fun i => hcls 0 _ (SqHandleIdx.u_ne_of_val_lt i (by rw [sqVal_zero]; omega)))
      (fun i => hcls 0 _ (SqHandleIdx.v_ne_of_val_lt i (by rw [sqVal_zero]; omega))), hself 0]
  · exact absurd rfl hi
  · -- the `u_j`-slot value: dress the `v_j`-slot
    rw [gXf_commP_swap]
    refine Subgroup.inv_mem _ ⟨gXfSlot h (sqHandleIdxV j) t, gXf_slot_adm ht _, ?_⟩
    rw [gXf_move_handleV _ _ j
      (hcls _ 0 (SqHandleIdx.v_ne_of_val_lt j (by rw [sqVal_zero]; omega)).symm)
      (hcls _ 1 (SqHandleIdx.v_ne_of_val_lt j (by rw [sqVal_one]; omega)).symm)
      (hcls _ 2 (SqHandleIdx.v_ne_of_val_lt j (by rw [sqVal_two]; omega)).symm)
      (fun i => hcls _ _ (SqHandleIdx.u_ne_v i j))
      (fun i hij => hcls _ _ (fun hc => hij (SqHandleIdx.v_injective hc))), hself _]
  · -- the `v_j`-slot value: dress the `u_j`-slot
    refine ⟨gXfSlot h (sqHandleIdxU j) t, gXf_slot_adm ht _, ?_⟩
    rw [gXf_move_handleU _ _ j
      (hcls _ 0 (SqHandleIdx.u_ne_of_val_lt j (by rw [sqVal_zero]; omega)).symm)
      (hcls _ 1 (SqHandleIdx.u_ne_of_val_lt j (by rw [sqVal_one]; omega)).symm)
      (hcls _ 2 (SqHandleIdx.u_ne_of_val_lt j (by rw [sqVal_two]; omega)).symm)
      (fun i hij => hcls _ _ (fun hc => hij (SqHandleIdx.u_injective hc)))
      (fun i => hcls _ _ (SqHandleIdx.v_ne_u i j)), hself _]

/-! ### The knobs of an `x₁`-free frame -/

section Knobs

variable {j : Fin h} {a : Fin (sqRank h) → (DSq h : Type)}

/-- The undressed frame is far away from `x₁` at every slot but the `x₁`-slot. -/
theorem gXf_arbBase_far {i : Fin (sqRank h)} (hi : i ≠ 2) :
    sqArbBase h nu' j i ∈ gTowerFar h := by
  rcases sqIdx_cases i with rfl | rfl | rfl | ⟨j', rfl⟩ | ⟨j', rfl⟩
  · rw [sqArbBase_zero]
    exact gBase_sigma_far
  · rw [sqArbBase_one]
    exact gBase_x0_far
  · exact absurd rfl hi
  · by_cases hjj : j' = j
    · subst hjj
      rw [sqArbBase_handleU]
      exact gAbs_eichU_far j'
    · rw [sqArbBase_handleU_ne hjj]
      exact gBase_handleU_far j'
  · by_cases hjj : j' = j
    · subst hjj
      rw [sqArbBase_handleV]
      exact gAbs_eichV_far j'
    · rw [sqArbBase_handleV_ne hjj]
      exact gBase_handleV_far j'

/-- ⭐ **The non-`x₁` slots of an `x₁`-free frame are `x₁`-free**: the base letter is far and the
dressing is `x₁`-free. -/
theorem gXf_frame_mem_half (hfree : GXfFree h a) {i : Fin (sqRank h)} (hi : i ≠ 2) :
    sqArbFrame h nu' j a i ∈ gXfHalf h :=
  (gXfHalf h).mul_mem (gXf_far_le_half (gXf_arbBase_far hi)) (gXf_free_mem_half hfree i)

/-- ⭐ **The `x₁`-slot of an `x₁`-free frame is not `x₁`-free**: its base letter is `x₁`. -/
theorem gXf_frame_two_notMem_half (hfree : GXfFree h a) :
    sqArbFrame h nu' j a 2 ∉ gXfHalf h := by
  intro hc
  refine gXf_xOne_notMem_half (h := h) ?_
  have hx : dsqX1 h = sqArbFrame h nu' j a 2 * (a 2)⁻¹ := by
    show dsqX1 h = sqArbBase h nu' j 2 * a 2 * (a 2)⁻¹
    rw [sqArbBase_two]
    group
  rw [hx]
  exact (gXfHalf h).mul_mem hc ((gXfHalf h).inv_mem (gXf_free_mem_half hfree 2))

/-- The class of a group-level bracket is the bracket of the classes. -/
theorem gXf_levelMk_commP (g g' : (DSq h : Type)) :
    levelMk (DSq h : Type) (k + 2) (commP g g')
      = commP (levelMk (DSq h : Type) (k + 2) g) (levelMk (DSq h : Type) (k + 2) g') := by
  simp only [commP, map_mul, map_inv]

/-- ⭐⭐⭐ **On an `x₁`-free frame, the bracket of an admissible correction against any
`x₁`-free element is a move.**  This is where the half-space theorem of §3 is spent: the
comap of the move subgroup along the bracket is a closed subgroup carrying `γ₂` and the
`2 + 2h` non-`x₁` frame slots, so it carries the whole far span. -/
theorem gXf_span_mem_move (hk : 2 ≤ k) (hfree : GXfFree h a)
    (hindep : SqModTwoIndep (sqArbFrame h nu' j a)) {t : (DSq h : Type)}
    (ht : GTowerAdm h nu' k t) {q : (DSq h : Type)} (hq : q ∈ gXfSpan h) :
    levelMk (DSq h : Type) (k + 2) (commP t q)
      ∈ gXfMove nu' hk (fun i => levelMk (DSq h : Type) (k + 2) (sqArbFrame h nu' j a i)) := by
  set m := fun i => levelMk (DSq h : Type) (k + 2) (sqArbFrame h nu' j a i) with hm
  set K := Subgroup.comap (cfiveCommHom ht.1) (gXfMove nu' hk m) with hK
  have hKc : IsClosed ((K : Subgroup (DSq h : Type)) : Set (DSq h : Type)) := by
    haveI : DiscreteTopology (levelQuot (DSq h : Type) (k + 2)) := gTower_discrete (k + 2)
    rw [hK, Subgroup.coe_comap]
    refine IsClosed.preimage ?_ (isClosed_discrete _)
    show Continuous fun g => levelMk (DSq h : Type) (k + 2) (commP t g)
    simp only [commP]
    exact (continuous_levelMk (DSq h : Type) (k + 2)).comp (by fun_prop)
  have hgam : twoCentralSeries (DSq h : Type) 2 ≤ K := by
    intro z hz
    show cfiveCommHom ht.1 z ∈ gXfMove nu' hk m
    rw [cfive_commHom_apply, gXf_levelMk_commP,
      gTower_commP_vanish ⟨t, ht.1, rfl⟩ ⟨z, hz, rfl⟩]
    exact Subgroup.one_mem _
  have hfar : gTowerFar h ≤ K := by
    refine gXf_far_le_of_slots hindep hKc hgam (fun i hi => ?_)
      (fun i hi => gXf_frame_mem_half hfree hi) (gXf_frame_two_notMem_half hfree)
    show cfiveCommHom ht.1 (sqArbFrame h nu' j a i) ∈ gXfMove nu' hk m
    rw [cfive_commHom_apply, gXf_levelMk_commP]
    exact gXf_frame_mem_move ht hi
  exact sup_le hfar hgam hq

/-- ⭐⭐⭐ **Every knob generator of an `x₁`-free frame is a move.**  The far knobs are the
previous theorem.  The bundle knob is the `x₁`-slot move corrected by one far knob: the
`x₁`-slot frame value is `x₁` times its own `x₁`-free dressing, and the bracket against that
dressing is itself a move. -/
theorem gXf_knobSet_le_move (hk : 2 ≤ k) (hfree : GXfFree h a)
    (hindep : SqModTwoIndep (sqArbFrame h nu' j a)) :
    gTowerKnobSet h nu' k ⊆
      gXfMove nu' hk (fun i => levelMk (DSq h : Type) (k + 2) (sqArbFrame h nu' j a i)) := by
  set m := fun i => levelMk (DSq h : Type) (k + 2) (sqArbFrame h nu' j a i) with hm
  rintro z (⟨t, q, ht, hq, rfl⟩ | ⟨t, ht, rfl⟩)
  · exact gXf_span_mem_move hk hfree hindep ht (gXf_far_le_span hq)
  · set T := levelMk (DSq h : Type) (k + 2) t with hT
    set X := levelMk (DSq h : Type) (k + 2) (dsqX1 h) with hX
    set A := levelMk (DSq h : Type) (k + 2) (a 2) with hA
    have hTmem : T ∈ lambdaImage (DSq h : Type) k (k + 2) := ⟨t, ht.1, rfl⟩
    have hm2 : m 2 = X * A := by
      show levelMk (DSq h : Type) (k + 2) (sqArbBase h nu' j 2 * a 2) = X * A
      rw [sqArbBase_two, map_mul]
    have hzX : commP T X ∈ zLayer (DSq h : Type) (k + 1) :=
      cfive_commP_mem_zLayer_left hTmem X
    have hzA : commP T A ∈ zLayer (DSq h : Type) (k + 1) :=
      cfive_commP_mem_zLayer_left hTmem A
    have hslot : gExtMove k m (fun i => levelMk (DSq h : Type) (k + 2) (gXfSlot h 2 t i))
        = T ^ 2 * commP T X * commP T A := by
      have hcls : ∀ i : Fin (sqRank h), i ≠ 2 →
          levelMk (DSq h : Type) (k + 2) (gXfSlot h 2 t i) = 1 := by
        intro i hne
        rw [gXfSlot_ne hne, map_one]
      rw [gXf_move_two _ _ (hcls 0 gXf_zero_ne_two) (hcls 1 gXf_one_ne_two)
        (fun i => hcls _ (SqHandleIdx.u_ne_of_val_lt i (by rw [sqVal_two]; omega)))
        (fun i => hcls _ (SqHandleIdx.v_ne_of_val_lt i (by rw [sqVal_two]; omega)))]
      rw [show gXfSlot h 2 t 2 = t from gXfSlot_self 2 t, ← hT, hm2,
        cfour_commP_mul_right, cfive_commP_zLayer_left hzX A, mul_one,
        ← gTower_zLayer_comm hzA (commP T X), ← mul_assoc]
    have hmove : T ^ 2 * commP T X * commP T A ∈ gXfMove nu' hk m :=
      hslot ▸ ⟨gXfSlot h 2 t, gXf_slot_adm ht 2, rfl⟩
    have hAmove : commP T A ∈ gXfMove nu' hk m := by
      have hspan := gXf_span_mem_move hk hfree hindep ht (hfree 2)
      rwa [gXf_levelMk_commP] at hspan
    have hbundle : levelMk (DSq h : Type) (k + 2) (t ^ 2 * commP t (dsqX1 h))
        = T ^ 2 * commP T X := by
      rw [map_mul, map_pow, gXf_levelMk_commP]
    rw [hbundle]
    have hfin := Subgroup.mul_mem _ hmove (Subgroup.inv_mem _ hAmove)
    rwa [mul_inv_cancel_right] at hfin

/-- ⭐⭐⭐ **The whole knob span consists of moves**, on an `x₁`-free frame. -/
theorem gXf_knobSpan_le_move (hk : 2 ≤ k) (hfree : GXfFree h a)
    (hindep : SqModTwoIndep (sqArbFrame h nu' j a)) :
    Subgroup.closure (gTowerKnobSet h nu' k) ≤
      gXfMove nu' hk (fun i => levelMk (DSq h : Type) (k + 2) (sqArbFrame h nu' j a i)) :=
  (Subgroup.closure_le _).2 (gXf_knobSet_le_move hk hfree hindep)

/-- ⭐⭐⭐ **The extraction, on `x₁`-free dressings**: a knob-span defect class of an `x₁`-free
frame is killed by an admissible depth-`k` correction tuple.  This is wave 74's item (ii),
closed at the quantifier wave 79 showed it does close at.

No row hypothesis on `a` and no `γ_{k+1}`-membership of the relator is used: the only inputs
are the mod-two independence of the frame, the `x₁`-freeness of its dressing, and the knob-span
membership of the defect. -/
theorem gXf_realizable (hk : 2 ≤ k) (hfree : GXfFree h a)
    (hindep : SqModTwoIndep (sqArbFrame h nu' j a))
    (hknob : levelMk (DSq h : Type) (k + 2) (sqRelWord (sqArbFrame h nu' j a))
      ∈ Subgroup.closure (gTowerKnobSet h nu' k)) :
    ∃ d : Fin (sqRank h) → (DSq h : Type),
      (∀ i, d i ∈ twoCentralSeries (DSq h : Type) k) ∧
        (∀ i, nuLam h (d i) = 1) ∧ (∀ i, nu' (d i) = 1) ∧
          sqRelWord (sqArbFrame h nu' j (fun i => a i * d i))
            ∈ twoCentralSeries (DSq h : Type) (k + 2) := by
  obtain ⟨d, hd, hEq⟩ := gXf_knobSpan_le_move hk hfree hindep (Subgroup.inv_mem _ hknob)
  refine ⟨d, fun i => (hd i).1, fun i => (hd i).2.1, fun i => (hd i).2.2, ?_⟩
  rw [lim_mem_twoCentralSeries_iff_levelMk, gExt_frame_move j hk a d (fun i => (hd i).1), ← hEq,
    mul_inv_cancel]

