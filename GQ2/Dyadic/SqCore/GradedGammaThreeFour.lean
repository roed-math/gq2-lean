/-! ## §1 The two homomorphisms `Y → Z` -/

section LayerHom

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- **Left additivity with a `Y`-element in the near slot**: `commP (y * p) q = commP y q *
commP p q`.  The correction term of `cfour_commP_mul_left` is a bracket against the `Z`-element
`commP y q`, so it dies. -/
theorem gThreeFour_ad_left {y : levelQuot G 4} (hy : y ∈ lambdaImage G 2 4)
    (p q : levelQuot G 4) : commP (y * p) q = commP y q * commP p q := by
  rw [cfour_commP_mul_left, cfour_commP_zLayer_left (cfour_commP_mem_zLayer_left hy q) p, mul_one]

/-- **Right additivity with a `Y`-element in the near slot**: `commP p (y * q) = commP p q *
commP p y`. -/
theorem gThreeFour_ad_right (p : levelQuot G 4) {y : levelQuot G 4}
    (hy : y ∈ lambdaImage G 2 4) (q : levelQuot G 4) :
    commP p (y * q) = commP p q * commP p y := by
  rw [cfour_commP_mul_right, cfour_commP_zLayer_left (cfour_commP_mem_zLayer_right p hy) q,
    mul_one]

/-- A bracket with a `Y`-slot is its own inverse: it lies in the exponent-two layer `Z`. -/
theorem gThreeFour_ad_inv_self {y : levelQuot G 4} (hy : y ∈ lambdaImage G 2 4)
    (q : levelQuot G 4) : (commP y q)⁻¹ = commP y q :=
  zLayer_inv_self (cfour_commP_mem_zLayer_left hy q)

/-- **An inverse in the near slot is invisible**: `commP y⁻¹ q = commP y q` for `y ∈ Y`. -/
theorem gThreeFour_ad_inv_left {y : levelQuot G 4} (hy : y ∈ lambdaImage G 2 4)
    (q : levelQuot G 4) : commP y⁻¹ q = commP y q := by
  have h := gThreeFour_ad_left hy y⁻¹ q
  rw [mul_inv_cancel, cfour_one_comm] at h
  have h3 : (commP y q)⁻¹ = commP y⁻¹ q := inv_eq_iff_mul_eq_one.mpr h.symm
  rw [← h3, gThreeFour_ad_inv_self hy]

/-- **An inverse in the far slot is invisible**: `commP p y⁻¹ = commP p y` for `y ∈ Y`. -/
theorem gThreeFour_ad_inv_right (p : levelQuot G 4) {y : levelQuot G 4}
    (hy : y ∈ lambdaImage G 2 4) : commP p y⁻¹ = commP p y := by
  have h := gThreeFour_ad_right p hy p⁻¹
  have hinv : y⁻¹ ∈ lambdaImage G 2 4 := (lambdaImage G 2 4).inv_mem hy
  have hsw : ∀ a b : levelQuot G 4, commP a b = (commP b a)⁻¹ := by
    intro a b; simp only [commP]; group
  rw [hsw p y⁻¹, hsw p y, gThreeFour_ad_inv_left hy p]

/-- ⭐ **A square in the near slot**: `commP (p ^ 2) q = (commP p q) ^ 2 * commP (commP p q) p`.
This is the group form of `ad (x^{[2]}) = (ad x) ∘ (ad x)` in the restricted Lie algebra
`gr`, and it is what makes the square class of a generator a usable `γ₂`-correction: the
knob it buys against a slot `q` is the iterated bracket `commP (commP p q) p`, modulo the
square `(commP p q) ^ 2`.  Compare `cfour_commP_sq_left`, where the far slot is a `Y`-element
and the whole expression dies. -/
theorem gThreeFour_commP_sq_left (p q : levelQuot G 4) :
    commP (p ^ 2) q = (commP p q) ^ 2 * commP (commP p q) p := by
  have hz : commP (commP p q) p ∈ zLayer G 3 :=
    cfour_commP_mem_zLayer_left (cfour_commP_mem_lambdaTwo p q) p
  conv_lhs => rw [pow_two, cfour_commP_mul_left]
  rw [mul_assoc, cfour_zLayer_comm hz, ← mul_assoc, ← pow_two]

end LayerHom

/-! ## §2 Jacobi -/

section HallWitt

variable {Q : Type*} [Group Q]

/-- **The Hall-Witt identity**, in the repo's `commP`/`conjP` conventions.  It is an identity
in the free group, so `group` closes it; every class-four consequence below is a reduction of
this one word. -/
theorem gThreeFour_hallWitt (x y z : Q) :
    conjP (commP (commP x y⁻¹) z) y * conjP (commP (commP y z⁻¹) x) z *
      conjP (commP (commP z x⁻¹) y) x = 1 := by
  simp only [commP, conjP]
  group

/-- ⭐⭐ **Jacobi from Hall-Witt, in any group where the two reductions hold.**  The passage from
`gThreeFour_hallWitt` to Jacobi needs exactly two facts about the ambient group, and nothing
else: a triple bracket is unmoved by conjugation, and an inverse in the middle slot of a triple
bracket is invisible.  Stated abstractly so that a run at any other layer supplies its own two
facts and gets Jacobi, instead of redoing the Hall-Witt reduction.  The `γ₃/γ₄` instance is
`gThreeFour_jacobi`. -/
theorem gThreeFour_jacobi_of
    (hcentral : ∀ p q r t : Q, conjP (commP (commP p q) r) t = commP (commP p q) r)
    (hinvmid : ∀ p q r : Q, commP (commP p q⁻¹) r = commP (commP p q) r) (p q r : Q) :
    commP (commP p q) r * commP (commP q r) p * commP (commP r p) q = 1 := by
  have h := gThreeFour_hallWitt p q r
  rw [hcentral, hcentral, hcentral, hinvmid, hinvmid, hinvmid] at h
  exact h

end HallWitt

section JacobiFour

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- A triple bracket lies in the central layer `Z`. -/
theorem gThreeFour_triple_mem (p q r : levelQuot G 4) :
    commP (commP p q) r ∈ zLayer G 3 :=
  cfour_commP_mem_zLayer_left (cfour_commP_mem_lambdaTwo p q) r

/-- **Conjugation is invisible on a triple bracket**: the triple bracket is central. -/
theorem gThreeFour_conj_triple (p q r t : levelQuot G 4) :
    conjP (commP (commP p q) r) t = commP (commP p q) r := by
  have hconj : ∀ a b : levelQuot G 4, conjP a b = a * commP a b := by
    intro a b; simp only [conjP, commP]; group
  rw [hconj, cfour_commP_zLayer_left (gThreeFour_triple_mem p q r) t, mul_one]

/-- **An inverse in the middle slot of a triple bracket is invisible.**  The two inner brackets
differ by a `Z`-element and by an inversion, and the outer bracket sees neither. -/
theorem gThreeFour_triple_inv_mid (p q r : levelQuot G 4) :
    commP (commP p q⁻¹) r = commP (commP p q) r := by
  have hB : commP p q ∈ lambdaImage G 2 4 := cfour_commP_mem_lambdaTwo p q
  have hz : commP (commP p q) q⁻¹ ∈ zLayer G 3 := cfour_commP_mem_zLayer_left hB q⁻¹
  have hid := cfour_commP_mul_right p q q⁻¹
  rw [mul_inv_cancel, cfour_comm_one] at hid
  have hC : commP p q⁻¹ = (commP p q * commP (commP p q) q⁻¹)⁻¹ :=
    eq_inv_of_mul_eq_one_left (by rw [← mul_assoc, ← hid])
  have hzY : (commP (commP p q) q⁻¹)⁻¹ ∈ lambdaImage G 2 4 :=
    (lambdaImage G 2 4).inv_mem (cfour_zLayer_le_lambdaTwo hz)
  rw [hC, mul_inv_rev, gThreeFour_ad_left hzY,
    cfour_commP_zLayer_left ((zLayer G 3).inv_mem hz) r, one_mul,
    gThreeFour_ad_inv_left hB]

/-- ⭐⭐ **Jacobi in the layer `γ₃/γ₄`**: the three rotations of a triple bracket multiply to
`1` in `Q₄`.  This is the relation that lets a bracket whose outer slot is a given frame letter
be rewritten as a product of brackets whose outer slots are the other two, and it is the tool
wave 69 named as missing when it recorded the `x₁`-bundle analysis. -/
theorem gThreeFour_jacobi (p q r : levelQuot G 4) :
    commP (commP p q) r * commP (commP q r) p * commP (commP r p) q = 1 :=
  gThreeFour_jacobi_of gThreeFour_conj_triple gThreeFour_triple_inv_mid p q r

end JacobiFour

/-! ## §3 The layer is generated by squares and brackets of `Y` -/

section Generation

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- The mathlib bracket `⁅a, b⁆`, written out and read in `Q₄`, is a `commP` bracket of the
inverted entries.  It is spelled out rather than written with the bracket notation because
`Bracket G G` is not synthesizable inside this namespace (wave 69's finding). -/
theorem gThreeFour_levelMk_commutator (a b : G) :
    levelMk G 4 (a * b * a⁻¹ * b⁻¹) = commP (levelMk G 4 a⁻¹) (levelMk G 4 b⁻¹) := by
  simp only [commP, map_mul, map_inv]
  group

/-- ⭐⭐ **The layer `γ₃/γ₄` is generated by the squares and the brackets of `Y`.**  A closed
subgroup of `Q₄` containing `y ^ 2` for every `y ∈ Y` and `commP y q` for every `y ∈ Y` and
every `q ∈ Q₄` contains the whole central layer `Z`.

This is the tower form of the graded decomposition `γ₃/γ₄ = V^{[4]} ⊕ (Λ²V)^{[2]} ⊕ L₃(V)`:
the squares of `Y` supply the two restricted summands `V^{[4]}` (as `(g²)²`) and `(Λ²V)^{[2]}`
(as squares of brackets), and the brackets `commP Y Q₄` supply `L₃(V)`.  Only the "generated
by" half is stated, because that is the half a witness construction consumes; the closedness
hypothesis is exactly what pays for the topological closure inside `twoCentralSucc`.  The
class-two analogue is `Levelwise`'s `zLayer_two_le_of_gens`. -/
theorem gThreeFour_zLayer_le {S : Subgroup (levelQuot G 4)}
    (hS : IsClosed ((S : Subgroup (levelQuot G 4)) : Set (levelQuot G 4)))
    (hsq : ∀ y ∈ lambdaImage G 2 4, y ^ 2 ∈ S)
    (hcomm : ∀ y ∈ lambdaImage G 2 4, ∀ q, commP y q ∈ S) :
    zLayer G 3 ≤ S := by
  rintro _ ⟨v, hv, rfl⟩
  have hpre : IsClosed ((Subgroup.comap (levelMk G 4) S : Subgroup G) : Set G) := by
    rw [Subgroup.coe_comap]
    exact hS.preimage (continuous_levelMk G 4)
  have hsub : twoCentralSeries G 3 ≤ Subgroup.comap (levelMk G 4) S := by
    rw [cfour_lambda_three, twoCentralSucc]
    refine Subgroup.topologicalClosure_minimal _ (sup_le ?_ ?_) hpre
    · refine (Subgroup.closure_le _).2 ?_
      rintro _ ⟨g, hg, rfl⟩
      show levelMk G 4 (g ^ 2) ∈ S
      rw [map_pow]
      exact hsq _ ⟨g, hg, rfl⟩
    · refine Subgroup.commutator_le.2 fun a ha b _ => ?_
      rw [commutatorElement_def]
      show levelMk G 4 (a * b * a⁻¹ * b⁻¹) ∈ S
      rw [gThreeFour_levelMk_commutator]
      exact hcomm _ ⟨a⁻¹, (twoCentralSeries G 2).inv_mem ha, rfl⟩ _
  exact hsub hv

end Generation

